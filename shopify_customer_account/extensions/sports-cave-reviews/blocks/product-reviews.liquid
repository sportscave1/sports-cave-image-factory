<sports-cave-reviews id="sc-product-reviews-{{ product.id }}" data-mode="product" data-product="{{ product.id }}" data-endpoint="{{ block.settings.endpoint | escape }}" {{ block.shopify_attributes }}>
  <h2>{{ block.settings.heading | escape }}</h2>
  <p data-summary role="status">Customer reviews</p>
  <div data-controls></div><div data-list></div><p data-error role="status"></p>
  <button type="button" data-more hidden>Load more</button>
</sports-cave-reviews>
{% schema %}
{
 "name":"Sports Cave Reviews","target":"section","enabled_on":{"templates":["product"]},
 "stylesheet":"reviews.css","javascript":"reviews.js",
 "settings":[{"type":"text","id":"heading","label":"Heading","default":"Customer reviews"},
 {"type":"url","id":"endpoint","label":"Sports Cave public Reviews API URL"}]
}
{% endschema %}
