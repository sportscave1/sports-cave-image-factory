<sports-cave-reviews data-mode="stars" data-product="{{ product.id }}" data-endpoint="{{ block.settings.endpoint | escape }}" {{ block.shopify_attributes }}>
 <a href="#sc-product-reviews-{{ product.id }}" data-summary aria-label="Read customer reviews">Customer reviews</a>
 <span data-error role="status"></span>
</sports-cave-reviews>
{% schema %}
{
 "name":"Sports Cave Review Stars","target":"section","enabled_on":{"templates":["product"]},
 "stylesheet":"reviews.css","javascript":"reviews.js",
 "settings":[{"type":"url","id":"endpoint","label":"Sports Cave public Reviews API URL"}]
}
{% endschema %}
