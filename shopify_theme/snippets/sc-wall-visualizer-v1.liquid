</div>
<button type="button" class="sc-wall-v1__flow-link sc-wall-v1__flow-link--skip" data-sc-wall-quick-preview>Skip scale — just show me</button>
<p class="sc-wall-v1__flow-error" data-sc-wall-flow-error aria-live="polite"></p>
</div>

<button type="button" class="sc-wall-v1__scale-help-reopen" data-sc-wall-scale-help-reopen hidden aria-label="Show scale help">?</button>

</div>
</div>

<div class="sc-wall-v1__landscape-scale-dock" data-sc-wall-landscape-scale-dock hidden aria-label="Scale instructions"></div>

<div class="sc-wall-v1__landscape-controls" data-sc-wall-landscape-controls hidden aria-label="Wall preview controls"></div>

