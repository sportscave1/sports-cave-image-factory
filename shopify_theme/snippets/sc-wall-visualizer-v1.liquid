<path d="M7 3H4a1 1 0 0 0-1 1v3M13 3h3a1 1 0 0 1 1 1v3M17 13v3a1 1 0 0 1-1 1h-3M7 17H4a1 1 0 0 1-1-1v-3"></path>
<circle cx="10" cy="10" r="2.25"></circle>
</svg>
</span>
<span data-sc-wall-confirm-label aria-live="polite" aria-atomic="true">Place</span>
<span class="sc-wall-v1__confirm-spinner" aria-hidden="true"></span>
</button>
</div>

<div class="sc-wall-v1__scale-help" data-sc-wall-scale-help hidden>
<button type="button" class="sc-wall-v1__scale-help-close" data-sc-wall-scale-help-close aria-label="Close scale help">
