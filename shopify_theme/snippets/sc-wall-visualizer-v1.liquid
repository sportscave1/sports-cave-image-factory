type="button"
class="sc-wall-v1__launch sc-wall-v1__launch--premium"
data-sc-wall-open
aria-haspopup="dialog"
aria-expanded="false"
aria-controls="{{ sc_wall_id }}-dialog"
aria-label="See {{ sc_wall_product.title | escape }} on your wall"
