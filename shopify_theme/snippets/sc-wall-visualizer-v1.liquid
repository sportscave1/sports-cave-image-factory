<path d="M6 6l12 12M18 6 6 18"></path>
</svg>
</button>
<div class="sc-wall-v1__scale-help-head">
<div class="sc-wall-v1__scale-help-heading">
<span class="sc-wall-v1__scale-help-eyebrow">TRUE SCALE</span>
<strong data-sc-wall-scale-help-title>Get the real size</strong>
</div>
</div>
