<input type="text" min="0.1" max="10000" step="0.1" inputmode="decimal" enterkeyhint="done" autocomplete="off" autocapitalize="off" autocorrect="off" spellcheck="false" data-sc-wall-reference-measurement aria-label="Measured distance">
<span data-sc-wall-measurement-unit>{{ sc_wall_unit }}</span>
</div>
