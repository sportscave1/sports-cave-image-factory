<button type="button" class="sc-wall-v1__sticky-size-btn" data-sc-wall-size-option data-size-raw="M - 30 × 45 cm (11.8 × 17.7 in)" data-size-index="1" aria-pressed="false"><span data-sc-wall-size-token>M</span><small data-sc-wall-size-dims></small><em data-sc-wall-upsize-badge hidden>Try next size</em></button>
<button type="button" class="sc-wall-v1__sticky-size-btn" data-sc-wall-size-option data-size-raw="L - 45 × 62 cm (17.7 × 24.4 in)" data-size-index="2" aria-pressed="true"><span data-sc-wall-size-token>L</span><small data-sc-wall-size-dims></small><em data-sc-wall-upsize-badge hidden>Try next size</em></button>
<button type="button" class="sc-wall-v1__sticky-size-btn" data-sc-wall-size-option data-size-raw="XL - 62 × 87 cm (24.4 × 34.3 in)" data-size-index="3" aria-pressed="false"><span data-sc-wall-size-token>XL</span><small data-sc-wall-size-dims></small><em data-sc-wall-upsize-badge hidden>Try next size</em></button>
{%- endunless -%}
</div>
<button type="button" class="sc-wall-v1__sticky-secure" data-sc-wall-sticky-secure>
<span class="sc-wall-v1__sticky-secure-label" data-sc-wall-cart-label>Add To Cart</span>
<span class="sc-wall-v1__sticky-secure-price" data-sc-wall-cart-price></span>
<span class="sc-wall-v1__sticky-secure-spinner" aria-hidden="true"></span>
</button>
<button type="button" class="sc-wall-v1__keep-browsing" data-sc-wall-keep-browsing>Keep browsing</button>
<p class="sc-wall-v1__cart-error" data-sc-wall-cart-error role="alert"></p>
</div>

<div class="sc-wall-v1__download-gate" data-sc-wall-download-gate hidden aria-hidden="true">
<div class="sc-wall-v1__download-card" role="dialog" aria-modal="true" aria-labelledby="{{ sc_wall_id }}-download-title">
<button type="button" class="sc-wall-v1__download-close" data-sc-wall-download-close aria-label="Close download form">
<svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
<path d="M6 6l12 12M18 6 6 18"></path>
</svg>
</button>
<div class="sc-wall-v1__download-eyebrow">SPORTS CAVE</div>
<h3 id="{{ sc_wall_id }}-download-title">Download your wall preview</h3>
<p class="sc-wall-v1__download-copy">Enter your details to save your finished preview.</p>
<div class="sc-wall-v1__download-fields">
<input type="text" autocomplete="name" maxlength="120" placeholder="Name" data-sc-wall-download-name aria-label="Name">
<input type="email" autocomplete="email" inputmode="email" maxlength="254" placeholder="Email" data-sc-wall-download-email aria-label="Email address">
</div>
<label class="sc-wall-v1__download-consent">
<input type="checkbox" data-sc-wall-download-consent checked>
<span>Allow Sports Cave to feature this wall preview.</span>
</label>
<p class="sc-wall-v1__download-error" data-sc-wall-download-error aria-live="polite"></p>
<button type="button" class="sc-wall-v1__download-confirm" data-sc-wall-download-confirm>Download Preview</button>
</div>
</div>

<div class="sc-wall-v1__rotate-guard" data-sc-wall-rotate-guard hidden aria-hidden="true">
<div class="sc-wall-v1__rotate-card" role="status" aria-live="polite">
<div class="sc-wall-v1__rotate-phone" aria-hidden="true">
<span class="sc-wall-v1__rotate-phone-screen"></span>
</div>
<strong>Rotate phone to continue</strong>
</div>
</div>
</div>
</div>
</div>

