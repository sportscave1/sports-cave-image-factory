<button type="button" class="sc-wall-v1__sticky-size-btn" data-sc-wall-size-option data-size-raw="M - 30 × 45 cm (11.8 × 17.7 in)" data-size-index="1" aria-pressed="false"><span data-sc-wall-size-token>M</span><small data-sc-wall-size-dims></small><em data-sc-wall-upsize-badge hidden>Try next size</em></button>
<button type="button" class="sc-wall-v1__sticky-size-btn" data-sc-wall-size-option data-size-raw="L - 45 × 62 cm (17.7 × 24.4 in)" data-size-index="2" aria-pressed="true"><span data-sc-wall-size-token>L</span><small data-sc-wall-size-dims></small><em data-sc-wall-upsize-badge hidden>Try next size</em></button>
<button type="button" class="sc-wall-v1__sticky-size-btn" data-sc-wall-size-option data-size-raw="XL - 62 × 87 cm (24.4 × 34.3 in)" data-size-index="3" aria-pressed="false"><span data-sc-wall-size-token>XL</span><small data-sc-wall-size-dims></small><em data-sc-wall-upsize-badge hidden>Try next size</em></button>
{%- endunless -%}
</div>
<button type="button" class="sc-wall-v1__sticky-secure" data-sc-wall-sticky-secure>
<span class="sc-wall-v1__sticky-secure-label" data-sc-wall-cart-label>Add To Cart</span>
