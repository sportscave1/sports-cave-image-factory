{%- assign sc_wall_rendered_sizes = false -%}
{%- for option in sc_wall_product.options_with_values -%}
{%- assign sc_wall_size_name = option.name | downcase -%}
{%- if sc_wall_size_name contains 'size' -%}
{%- assign sc_wall_rendered_sizes = true -%}
{%- for value in option.values -%}
<button
type="button"
class="sc-wall-v1__sticky-size-btn"
data-sc-wall-size-option
data-size-raw="{{ value | escape }}"
data-size-index="{{ forloop.index0 }}"
aria-pressed="{% if value.selected %}true{% else %}false{% endif %}"
>
