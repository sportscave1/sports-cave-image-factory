99a34;\n                          font-family:Arial,Helvetica,sans-serif;\n                          font-size:18px;\n                          line-height:34px;\n                          font-weight:400;\n                          text-align:center;\n                        \"\n                      >\n                        &#10003;\n                      </td>\n                    </tr>\n                  </table>\n                </td>\n              </tr>\n\n              <tr>\n                <td\n                  height=\"42\"\n                  align=\"center\"\n                  valign=\"top\"\n                  style=\"height:42px;padding-top:7px;\"\n                >\n                  <div\n                    class=\"sc-collector-label\"\n                    style=\"\n                      margin:0;\n                      color:#171717;\n                      font-family:Arial,Helvetica,sans-serif;\n                      font-size:10px;\n                      line-height:14px;\n                      font-weight:700;\n                      letter-spacing:1.45px;\n                      text-align:center;\n                      text-transform:uppercase;\n                    \"\n                  >\n                    Certificate<br>\n                    Included\n                  </div>\n                </td>\n              </tr>\n            </table>\n          </td>\n\n        </tr>\n      </table>\n\n    </td>\n  </tr>\n</table>\n\n<!-- /SPORTS CAVE — BALANCED COLLECTOR TRUST BAR -->",
