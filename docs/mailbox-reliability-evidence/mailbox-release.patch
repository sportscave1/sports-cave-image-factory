+        self.reads.restore()
+        self.assertEqual(self.reads.health_snapshot()['state'], 'CONNECTED')
+        self.assertEqual(self.reads.health_snapshot()['diagnosis'], '')
+
+    def test_dead_idle_and_outbox_workers_restart_once_and_shutdown_is_respected(self):
