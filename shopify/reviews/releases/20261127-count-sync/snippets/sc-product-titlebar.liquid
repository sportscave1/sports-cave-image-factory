@media(max-width:989px){
 #scx-titlebar-{{ product.id }} .scx-center{width:100%;max-width:100%;min-width:0;}
 #scx-titlebar-{{ product.id }} .scx-title{max-width:100%;white-space:nowrap;overflow:visible;text-overflow:clip;}
}
</style>

<section
  id="scx-titlebar-{{ product.id }}"
  class="scx-titlebar"
  role="region"
  aria-label="Product title and customer reviews"
  data-limited="{{ is_limited }}">

  <div class="scx-titlewrap">

    <div class="scx-side scx-left">
      <div class="scx-breadcrumbs not-in-quickbuy" aria-label="Product breadcrumb">
        {% render 'breadcrumbs', show_next_prev: true %}
      </div>

      {% if is_limited %}
        <span class="scx-badge" aria-label="Limited Edition">Limited&nbsp;Edition</span>
      {% endif %}
    </div>

    <div class="scx-center">
      <h1 class="scx-title">
        {{ title_clean }}
      </h1>

      <span class="scx-underline" aria-hidden="true"></span>
    </div>

    <div class="scx-side scx-right">
      <button class="scx-review-inline" type="button" aria-busy="true" aria-label="Jump to customer reviews">
        <span class="scx-stars" aria-hidden="true" style="opacity:.35">★★★★★</span>
        <span class="scx-review-text">
          <strong style="display:inline-block;min-inline-size:3ch;font-variant-numeric:tabular-nums">{{ scx_rating }}</strong>
          <span>•</span>
          <span style="display:inline-block;min-inline-size:11ch;font-variant-numeric:tabular-nums">{{ scx_review_count }} reviews</span>
        </span>
      </button>
    </div>

  </div>
</section>



<script>
(function(){
  var ROOT_ID = 'scx-titlebar-{{ product.id }}';
  var root = document.getElementById(ROOT_ID);
  if(!root || root.dataset.scxReady === '1') return;
  root.dataset.scxReady = '1';

  function fit(){
    var title=root.querySelector('.scx-title');
    var center=root.querySelector('.scx-center');
    if(!title || !center)return;
    title.style.removeProperty('font-size');
    title.style.removeProperty('transform');
    title.style.removeProperty('letter-spacing');
    if(!window.matchMedia('(max-width:989px)').matches)return;
    var available=center.clientWidth-2;
    if(available<=0)return;
    var range=document.createRange();
    range.selectNodeContents(title);
    var size=parseFloat(getComputedStyle(title).fontSize);
    for(var pass=0;pass<4;pass++){
      var width=range.getBoundingClientRect().width;
      if(width<=available || !width)break;
      size=size*available/width*.995;
      title.style.setProperty('font-size',size+'px','important');
    }
  }

  function stickyOffset(){
    var s = document.querySelector('.shopify-section-header-sticky, .shopify-section-header, header[role="banner"], header.site-header, header.header');
    if(!s) return 0;

    var cs = getComputedStyle(s);
    var fixed = cs.position === 'fixed' || cs.position === 'sticky' || s.classList.contains('is-sticky');

    return fixed ? Math.min(120, Math.round(s.getBoundingClientRect().height || 0)) : 0;
  }

  function getReviewsTarget(){
    var selectors = [
      'sc-customer-reviews', '#scx-reviews-anchor',
    ];

    for(var i = 0; i < selectors.length; i++){
      var el = document.querySelector(selectors[i]);
      if(el) return el;
    }

    return null;
  }

  function bindReviewJump(){
    var btn = root.querySelector('.scx-review-inline');
    if(!btn) return;

    btn.addEventListener('click', function(){
      var target = getReviewsTarget();
      if(!target) return;

      var top = target.getBoundingClientRect().top + window.pageYOffset - (stickyOffset() + 10);

      window.scrollTo({
        top:top,
        behavior:'smooth'
      });

      target.classList.add('scx-reviews-target-highlight');

      setTimeout(function(){
        target.classList.remove('scx-reviews-target-highlight');
      }, 1500);
    });
  }

  function schedule(){
    fit();
  }

  if(document.readyState !== 'loading'){
    schedule();
  }else{
    document.addEventListener('DOMContentLoaded', schedule, { once:true });
  }

  if(document.fonts && document.fonts.ready){
    document.fonts.ready.then(fit);
  }

  window.addEventListener('load', fit, { once:true });

  var tm;
  function debouncedFit(){
    cancelAnimationFrame(tm);
    tm = requestAnimationFrame(fit);
  }

  window.addEventListener('resize', debouncedFit, { passive:true });
  window.addEventListener('orientationchange', debouncedFit, { passive:true });

  if('ResizeObserver' in window){
    var wrap = document.querySelector('#' + ROOT_ID + ' .scx-titlewrap');
    if(wrap){
      new ResizeObserver(debouncedFit).observe(wrap);
    }
  }

  var titleNode=root.querySelector('.scx-title');
  if(titleNode)new MutationObserver(debouncedFit).observe(titleNode,{childList:true,characterData:true,subtree:true});
  bindReviewJump();
})();
</script>
{% endif %}