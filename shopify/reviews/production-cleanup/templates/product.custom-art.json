        "code": "<!-- SPORTS CAVE • Bulk Discounts (readability tuned) -->\n<section id=\"sc-bulk-bf\" class=\"sc-bulk\" aria-label=\"Black Friday discounts\">\n  <div class=\"sc-bulk__wrap\">\n    <p class=\"sc-bulk__kicker\">BUNDLE DEALS SALE</p>\n    <h2 class=\"sc-bulk__title\">Buy More, Save More!</h2>\n    <p class=\"sc-bulk__sub\">Sitewide on Sports Cave art. <strong>Auto-applied at checkout.</strong></p>\n\n    <div class=\"sc-bulk__tiers\" role=\"list\">\n      <!-- Tier 1 -->\n      <div class=\"sc-tier\" role=\"listitem\" aria-label=\"Buy 2, get 20% off\">\n        <div class=\"sc-tier__badge\">20% OFF</div>\n        <div class=\"sc-tier__line\"><strong>Buy 2</strong> pieces</div>\n        <div class=\"sc-tier__note\">Mix & match frames or prints</div>\n      </div>\n\n      <!-- Tier 2 (highlight) -->\n      <div class=\"sc-tier sc-tier--best\" role=\"listitem\" aria-label=\"Buy 3 or more, get 25% off\">\n        <div class=\"sc-tier__badge\">25% OFF</div>\n        <div class=\"sc-tier__line\"><strong>Buy 3+</strong> pieces</div>\n        <div class=\"sc-tier__note\">Best value • Limited allocation</div>\n      </div>\n    </div>\n\n    <div class=\"sc-bulk__footer\">\n      <span class=\"sc-chip\">Fast, tracked shipping</span>\n      <span class=\"sc-sep\" aria-hidden=\"true\">•</span>\n      <span class=\"sc-chip\">Sale ends soon</span>\n      <span class=\"sc-sep\" aria-hidden=\"true\">•</span>\n      <span class=\"sc-chip\">No code needed</span>\n    </div>\n  </div>\n</section>\n\n<style>\n\n#sc-bulk-bf.sc-bulk{\n  --bg:#0b0b0f; --ink:#fff; --muted:#c7c7d1;\n  --gold:#F7A007; --gold2:#e88800; --line:rgba(255,255,255,.10); --radius:14px;\n  font-family:var(--sc-font-ui);\n  color:var(--ink);\n  \n  background:linear-gradient(180deg,#141418 0%, #0b0b0f 100%);\n  border:1px solid var(--line); border-radius:var(--radius);\n  padding:14px clamp(12px,2vw,18px); margin:14px 0;\n  box-shadow:0 12px 28px rgba(0,0,0,.18);\n  contain:content; content-visibility:auto;\n}\n.sc-bulk__wrap{ text-align:center; max-width:1100px; margin:0 auto; }\n\n.sc-bulk__kicker{\n  display:inline-block; margin-bottom:6px;\n  color:var(--gold); font-weight:700; letter-spacing:.18em; font-size:.76rem; text-transform:uppercase;\n}\n.sc-bulk__title{\n  margin:0; line-height:1.08; font-weight:700; letter-spacing:.015em;\n  font-size:clamp(20px,3.6vw,30px);\n  background:linear-gradient(180deg,#ffffff 0%, #ececec 65%);\n  -webkit-background-clip:text; background-clip:text; color:transparent;\n}\n.sc-bulk__sub{\n  margin:6px 0 12px; color:#e2e3ea; font-weight:700; letter-spacing:.02em;\n  font-size:clamp(13px,1.6vw,15px);\n}\n\n\n.sc-bulk__tiers{\n  display:grid; gap:10px; grid-template-columns:repeat(2,minmax(0,1fr));\n  max-width:780px; margin:0 auto 8px;\n}\n.sc-tier{\n  position:relative; border:1px solid rgba(255,255,255,.14); border-radius:12px;\n  background:rgba(255,255,255,.06);\n  box-shadow:0 1px 0 rgba(255,255,255,.05) inset, 0 10px 22px rgba(0,0,0,.22);\n  padding:12px;\n}\n.sc-tier--best{\n  outline:2px solid var(--gold);\n  background:linear-gradient(180deg, rgba(247,160,7,.06), rgba(255,255,255,.04));\n}\n.sc-tier__badge{\n  display:inline-block; font-weight:700; letter-spacing:.06em;\n  font-size:clamp(12px,1.8vw,14px); padding:6px 10px; border-radius:999px;\n  background:linear-gradient(90deg,var(--gold),var(--gold2)); color:#121212;\n  box-shadow:0 1px 0 rgba(255,255,255,.35) inset, 0 6px 14px rgba(247,160,7,.25);\n}\n\n\n.sc-tier__line{\n  color:#F4F6FA; font-weight:700; font-size:clamp(16px,2.4vw,20px);\n  line-height:1.3; letter-spacing:.01em;\n  text-shadow:0 1px 1px rgba(0,0,0,.45);\n  display:flex; justify-content:center; align-items:center; gap:.35ch;\n  margin-top:8px;\n}\n.sc-tier__line strong{\n  display:inline-block; padding:3px 10px; border-radius:999px;\n  background:linear-gradient(90deg,#FFD062,#F7A007); \n  color:#121212; border:1px solid rgba(0,0,0,.22);\n  box-shadow:0 1px 0 rgba(255,255,255,.35) inset, 0 6px 12px rgba(247,160,7,.28);\n  text-shadow:none;\n}\n.sc-tier__note{\n  color:#d7d9e0; font-size:clamp(12px,1.6vw,14px); margin-top:2px; font-weight:600; letter-spacing:.01em;\n}\n\n\n.sc-bulk__footer{ color:#e3e4ea; display:flex; gap:10px; justify-content:center; align-items:center; flex-wrap:wrap; margin-top:8px; }\n.sc-chip{\n  display:inline-block; background:rgba(255,255,255,.08); border:1px solid rgba(255,255,255,.14);\n  padding:6px 10px; border-radius:999px; font-weight:700; font-size:.78rem;\n}\n.sc-sep{ opacity:.7; }\n\n\n@media (max-width:600px){\n  .sc-bulk__tiers{ grid-template-columns:1fr; }\n  .sc-tier__line{ font-size:clamp(17px,5vw,20px); }\n  .sc-tier__badge{ font-size:clamp(12px,3.6vw,14px); }\n  .sc-chip{ font-size:.8rem; padding:7px 12px; }\n}\n</style>"
      }
    },
    "custom_liquid_GD9r4U": {
      "type": "custom-liquid",
      "name": "Upsell HTML",
      "settings": {
        "full_width": true,
        "show_space": false,
        "code": "<!-- ========== SPORTS CAVE • Bundle Up & Save More (v3.5 — premium header, fast, no-jump) ========== -->\n\n<div id=\"sc-upsell-bundle\"\n     data-collection=\"best-selling-sports-art\"\n     data-limit=\"4\"\n     data-title=\"Bundle up & save more\"\n     data-subtitle=\"\">\n</div>\n\n<script>\n(function(){\n  const root = document.getElementById('sc-upsell-bundle'); if(!root || root.dataset.hydrated) return;\n  root.dataset.hydrated = '1';\n\n  const limit  = Math.max(1, parseInt(root.dataset.limit || '4', 10));\n  const handle = root.dataset.collection || 'best-selling-sports-art';\n  const title  = root.dataset.title || 'Bundle up & save more';\n\n  // ---------- currency formatter ----------\n  let fmt = v => '$' + (+v||0).toFixed(2);\n  try{\n    const cur = (window.Shopify && Shopify.currency && Shopify.currency.active) || 'AUD';\n    const nf  = new Intl.NumberFormat(undefined, { style:'currency', currency:String(cur), maximumFractionDigits:2 });\n    fmt = v => nf.format(+v||0);\n  }catch(_){}\n\n  // ---------- helpers ----------\n  const esc = s => String(s??'').replace(/[&<>\"']/g, m=>({ '&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;' }[m]));\n  const toMajor = n => { if(n==null) return 0; const x=+n; return (Number.isInteger(x) && Math.abs(x)>=1000) ? x/100 : (parseFloat(n)||0); };\n  const firstAvail = p => (p.variants && p.variants.find(v=>v.available)) || (p.variants && p.variants[0]) || null;\n  const optionNames  = p => !p.options ? [] : (typeof p.options[0]==='string' ? p.options : p.options.map(o=>o && (o.name||o)).filter(Boolean));\n  const optionValues = (p, i) => { const set=new Set(); (p.variants||[]).forEach(v=>{const k='option'+(i+1); if(v && v[k]) set.add(String(v[k]));}); return Array.from(set); };\n  const findVariant  = (p, sels) => (p.variants||[]).find(v => sels.every((val,i)=>String(v['option'+(i+1)])===String(val))) || null;\n  const optTitle = names => names.length ? ('Choose ' + names.join(' & ')) : 'Options';\n  const imgObj = (p) => {\n    const base = (p.images && p.images[0] && (p.images[0].src||p.images[0])) || p.featured_image || p.image || '';\n    const withW = (u,w)=>{ try{ const a=new URL(u,location.origin); if(!a.searchParams.get('width')) a.searchParams.set('width',String(w)); return a.toString(); }catch(_){ return u+(u.includes('?')?'&':'?')+'width='+w; } };\n    const s240 = withW(base,240), s360 = withW(base,360), s540 = withW(base,540), s720=withW(base,720);\n    return { src:s360, srcset:`${s240} 240w, ${s360} 360w, ${s540} 540w, ${s720} 720w`, sizes:'(max-width:900px) 45vw, 260px' };\n  };\n\n  // ---------- skeleton HTML + CSS ----------\n  root.innerHTML = `\n    <style>\n      #sc-upsell-bundle{\n        --gold:#F7A007; --card:#0B0B0B; --line:rgba(255,255,255,.10);\n        font-family:var(--sc-font-ui);\n        margin:10px 0 4px; isolation:isolate; contain:content; overflow-anchor:none;\n      }\n      #sc-upsell-bundle *{ box-sizing:border-box }\n\n      \n      #sc-upsell-bundle .scb-head{ margin:0 0 10px }\n      #sc-upsell-bundle .scb-banner{\n        --ink:#EDEDED;\n        --hi:#FFFBE6; --l1:#FFE9B2; --core:#FFD16B; --mid:#E7B557; --deep:#8A5B12;\n        --foil:linear-gradient(100deg,var(--hi) 0%,var(--l1) 14%,var(--core) 36%,var(--l1) 58%,var(--mid) 78%,var(--deep) 100%);\n        background:#0A0A0A; color:var(--ink);\n        border:1px solid rgba(255,255,255,.10);\n        border-radius:12px; padding:10px 12px; text-align:center;\n        box-shadow:0 6px 16px rgba(0,0,0,.16);\n      }\n      #sc-upsell-bundle .scb-title{\n        margin:0; font-weight:700; letter-spacing:.01em; line-height:1.05;\n        font-size:clamp(18px,3.4vw,24px);\n        color:#F6D073; background:var(--foil); -webkit-background-clip:text; background-clip:text; color:transparent;\n        text-shadow:0 .5px 0 rgba(0,0,0,.35), 0 0 1px rgba(0,0,0,.12); -webkit-text-stroke:.25px rgba(0,0,0,.25);\n      }\n      #sc-upsell-bundle .scb-chips{ display:flex; flex-wrap:wrap; justify-content:center; gap:6px; margin:8px 0 0 }\n      #sc-upsell-bundle .chip{\n        list-style:none; font:800 11px/1.1 \"Montserrat\",system-ui,-apple-system,Segoe UI,Roboto,Arial;\n        color:#EED9A5; background:#0C0C0C; border:1px solid rgba(247,160,7,.45);\n        padding:6px 10px; border-radius:999px; white-space:nowrap\n      }\n      #sc-upsell-bundle .chip strong{ color:var(--sc-brand-ivory) }\n      #sc-upsell-bundle .chip-live{\n        background:linear-gradient(180deg,rgba(255,255,255,.12),rgba(255,255,255,0) 52%), var(--gold);\n        color:#0B0B0B; border-color:color-mix(in srgb,#000 20%, var(--gold) 80%);\n      }\n\n      \n      #sc-upsell-bundle .scb-grid{ display:grid; grid-template-columns:repeat(2,1fr); gap:8px; margin:0; overflow-anchor:none }\n      @media (min-width:900px){ #sc-upsell-bundle .scb-grid{ grid-template-columns:repeat(4,1fr); gap:10px } }\n\n      #sc-upsell-bundle .scb-it{\n        background:var(--card); border:1px solid var(--line); border-radius:12px; padding:6px; overflow:hidden;\n        content-visibility:auto; contain:layout paint style; contain-intrinsic-size: 370px 280px;\n      }\n      #sc-upsell-bundle .scb-img{ position:relative; display:block; aspect-ratio:1/1; border-radius:10px; overflow:hidden; background:#0E0E0E; box-shadow:inset 0 0 0 1px rgba(255,255,255,.04) }\n      #sc-upsell-bundle .scb-img img{ width:100%; height:100%; object-fit:contain }\n\n      #sc-upsell-bundle .scb-pill{\n        position:absolute; top:8px; right:8px; text-transform:uppercase;\n        background:linear-gradient(180deg, rgba(255,255,255,.16), rgba(255,255,255,0) 52%), var(--gold);\n        color:#0B0B0B; border-radius:999px; padding:.26em .58em; font:900 10.5px/1 \"Montserrat\"; letter-spacing:.06em;\n        border:1px solid color-mix(in srgb,#000 16%,var(--gold) 84%); box-shadow:0 8px 18px rgba(0,0,0,.22), inset 0 0 0 1px color-mix(in srgb,#000 20%,var(--gold) 80%)\n      }\n\n      #sc-upsell-bundle .scb-t{ margin:6px 0 4px; font:800 12.5px/1.25 \"Montserrat\"; color:var(--sc-brand-ivory); display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; min-height:32px }\n      #sc-upsell-bundle .scb-row{ display:flex; align-items:center; justify-content:space-between; gap:8px }\n      #sc-upsell-bundle .scb-price{ display:flex; align-items:baseline; gap:6px; font:900 13px/1 \"Montserrat\"; color:var(--gold) }\n      #sc-upsell-bundle .scb-compare{ font:800 12px/1 \"Montserrat\"; color:#9CA3AF; text-decoration:line-through; text-decoration-thickness:.10em; opacity:.95 }\n\n      #sc-upsell-bundle details.scb-opts{ margin:4px 0 6px; border:1px solid rgba(255,255,255,.10); border-radius:10px; overflow:hidden; background:#0A0A0A }\n      #sc-upsell-bundle details.scb-opts > summary{ list-style:none; cursor:pointer; padding:6px 10px; font:800 11px/1 \"Montserrat\"; color:#E4E4E4 }\n      #sc-upsell-bundle details.scb-opts > summary::-webkit-details-marker{ display:none }\n      #sc-upsell-bundle .scb-optrow{ display:grid; gap:6px; padding:6px 8px 8px }\n      #sc-upsell-bundle .scb-optlab{ font:700 10px/1 \"Montserrat\"; color:#BDBDBD }\n      #sc-upsell-bundle .scb-opt{ width:100%; font:600 11px/1.3 \"Montserrat\"; padding:6px 9px; border:1px solid rgba(255,255,255,.14); border-radius:999px; background:#0B0B0B; color:var(--sc-brand-ivory); outline:none }\n\n      #sc-upsell-bundle .scb-btn{ background:var(--gold); color:#111; border:none; border-radius:999px; padding:8px 12px; min-width:86px; font:900 12px/1 \"Montserrat\"; cursor:pointer; display:inline-flex; align-items:center; gap:8px }\n      #sc-upsell-bundle .scb-btn[disabled]{ opacity:.6; cursor:not-allowed }\n      #sc-upsell-bundle .spin{ width:14px; height:14px; border-radius:50%; border:2px solid rgba(0,0,0,.28); border-top-color:#111; display:none; animation:scbspin .8s linear infinite }\n      #sc-upsell-bundle .scb-btn[data-busy=\"1\"] .spin{ display:inline-block }\n      @keyframes scbspin{ to { transform:rotate(360deg) } }\n\n      #sc-upsell-bundle .scb-more{ display:block; width:100%; margin:10px 0 0; border:1px solid rgba(247,160,7,.45); background:#0F0F0F; color:#EDEDED; border-radius:999px; padding:9px 14px; font:900 12px/1 \"Montserrat\"; cursor:pointer; text-align:center; overflow-anchor:none }\n      @media(min-width:900px){ #sc-upsell-bundle .scb-more{ max-width:520px; margin:12px auto 0 } }\n    </style>\n\n    <div class=\"scb-head\">\n      <div class=\"scb-banner\" role=\"note\" aria-label=\"Bundle & Save — Collector pricing\">\n        <h2 class=\"scb-title\">${esc(title)}</h2>\n        <ul class=\"scb-chips\" role=\"list\">\n          <li class=\"chip chip-live\">35% OFF live</li>\n          <li class=\"chip\">Add <b>2+</b> editions: <strong>+20%</strong></li>\n          <li class=\"chip\"><b>3+</b> editions: <strong>+30%</strong></li>\n          <li class=\"chip\">Auto-applied</li>\n        </ul>\n      </div>\n    </div>\n\n    <div class=\"scb-grid\" role=\"list\"></div>\n    <button class=\"scb-more\" type=\"button\">Show more editions</button>\n  `;\n\n  // ---------- data + rendering ----------\n  let page = 1, busy = false;\n  const cache = [], seen = new Set();\n  root._map = new Map();\n\n  async function fetchPage(p){\n    try{\n      const url = `/collections/${handle}/products.json?limit=${limit}&page=${p}`;\n      const r = await fetch(url, {headers:{Accept:'application/json'}});\n      const j = await r.json(); const arr = (j && j.products) || [];\n      return arr.filter(x => x && x.handle && !seen.has(x.handle));\n    }catch(_){ return []; }\n  }\n\n  const buildCard = (p)=>{\n    const v = firstAvail(p) || {};\n    const names = optionNames(p);\n    const {src, srcset, sizes} = imgObj(p);\n    const price = toMajor(v.price ?? p.price);\n    const cmp   = toMajor(v.compare_at_price ?? p.compare_at_price ?? 0);\n    const pct   = cmp>price ? Math.round((cmp-price)*100/cmp) : 0;\n\n    const opts = names.length ? `\n      <details class=\"scb-opts\">\n        <summary>${esc(optTitle(names))}</summary>\n        <div class=\"scb-optrow\">\n          ${names.map((name, idx)=>`\n            <label class=\"scb-optlab\">${esc(name)}</label>\n            <select class=\"scb-opt\" data-idx=\"${idx}\">\n              ${optionValues(p, idx).map(val=>`\n                <option value=\"${esc(val)}\"${String(v['option'+(idx+1)])===String(val)?' selected':''}>${esc(val)}</option>\n              `).join('')}\n            </select>\n          `).join('')}\n        </div>\n      </details>` : '';\n\n    return `\n      <article class=\"scb-it\" role=\"listitem\" data-handle=\"${esc(p.handle)}\">\n        <a class=\"scb-img\" href=\"/products/${esc(p.handle)}\" aria-label=\"${esc(p.title)}\">\n          <img loading=\"lazy\" decoding=\"async\" fetchpriority=\"low\" src=\"${src}\" srcset=\"${srcset}\" sizes=\"${sizes}\" alt=\"${esc(p.title)}\">\n          ${pct ? `<span class=\"scb-pill\">SAVE ${pct}%</span>` : ``}\n        </a>\n        <h3 class=\"scb-t\" title=\"${esc(p.title)}\">${esc(p.title)}</h3>\n        ${opts}\n        <div class=\"scb-row\">\n          <div class=\"scb-price\" aria-live=\"polite\">\n            ${fmt(price)} ${cmp>price ? `<span class=\"scb-compare\">${esc(fmt(cmp))}</span>` : ``}\n          </div>\n          <button class=\"scb-btn\" data-id=\"${v.id||''}\" ${v && v.id ? '' : 'disabled'} aria-label=\"Add ${esc(p.title)} to cart\">\n            <span class=\"spin\" aria-hidden=\"true\"></span><span>Add</span>\n          </button>\n        </div>\n      </article>`;\n  };\n\n  function appendItems(products){\n    const grid = root.querySelector('.scb-grid'); if(!grid) return;\n    const html = products.map(buildCard).join('');\n    // Append (not replace) to avoid scroll jumps\n    grid.insertAdjacentHTML('beforeend', html);\n  }\n\n  function updateCard(card, product){\n    const selects = Array.from(card.querySelectorAll('.scb-opt'));\n    const chosen = selects.map(s => s.value);\n    const variant = findVariant(product, chosen) || firstAvail(product);\n    const priceEl = card.querySelector('.scb-price');\n    const pill = card.querySelector('.scb-pill');\n    const btn = card.querySelector('.scb-btn');\n    if(!variant || !priceEl) return;\n\n    const pr = toMajor(variant.price);\n    const ca = toMajor(variant.compare_at_price||0);\n    const pct = ca>pr ? Math.round((ca-pr)*100/ca) : 0;\n\n    priceEl.innerHTML = `${fmt(pr)} ${ca>pr ? `<span class=\"scb-compare\">${esc(fmt(ca))}</span>` : ``}`;\n    if(pill){ if(pct){ pill.textContent=`SAVE ${pct}%`; pill.style.display=''; } else { pill.style.display='none'; } }\n    if(variant.available){ btn.disabled=false; btn.dataset.id = variant.id; } else { btn.disabled=true; btn.dataset.id=''; }\n  }\n\n  // ---------- events ----------\n  root.addEventListener('change', (e)=>{\n    const sel = e.target.closest('.scb-opt'); if(!sel) return;\n    const card = sel.closest('.scb-it'); if(!card) return;\n    const product = root._map.get(card.getAttribute('data-handle')); if(!product) return;\n    updateCard(card, product);\n  }, { passive:true });\n\n  // Cart drawer helpers\n  function getDrawerEl(){ return document.querySelector('cart-drawer, #CartDrawer, #Cart-Drawer, .cart-drawer, .drawer.js-cart-drawer'); }\n  function openCartDrawer(){\n    try{ window.dispatchEvent(new CustomEvent('cart:open',{bubbles:true,detail:{source:'upsell'}})); }catch(_){}\n    try{\n      if(window.CartDrawer && typeof window.CartDrawer.open==='function'){ window.CartDrawer.open(); return; }\n      const el=getDrawerEl(); if(!el) return;\n      if(typeof el.open==='function'){ el.open(); return; }\n      if((el.tagName||'').toLowerCase()==='cart-drawer'){ el.setAttribute('open',''); return; }\n      el.setAttribute('aria-hidden','false'); el.classList.add('is-open'); document.documentElement.classList.add('no-scroll');\n    }catch(_){}\n  }\n  function detectSectionIds(){\n    const ids=new Set(); const drawer=getDrawerEl();\n    if(drawer){\n      const sec=drawer.closest('section[id^=\"shopify-section-\"]'); if(sec){ ids.add(sec.id.replace('shopify-section-','')); }\n      drawer.querySelectorAll('[data-section-id]').forEach(n=>{ if(n.dataset.sectionId) ids.add(n.dataset.sectionId); });\n    }\n    if(document.getElementById('shopify-section-header')) ids.add('header');\n    ids.add('cart-drawer'); ids.add('cart-icon-bubble');\n    return Array.from(ids);\n  }\n  function applySectionsHTML(map){ if(!map) return; Object.keys(map).forEach(id=>{ const html=map[id]; const host=document.getElementById('shopify-section-'+id); if(host && html) host.innerHTML=html; }); }\n  function updateHeaderBubbles(count){\n    try{\n      Array.from(document.querySelectorAll('#cart-icon-bubble, .cart-count-bubble, [data-cart-count-bubble], [data-cart-count], .header__icon--cart .cart-count, .cart__badge, #CartCount, .site-header__cart .count'))\n        .forEach(el=>{\n          const span = el.querySelector('[aria-hidden=\"true\"]') || el.firstElementChild || el;\n          if(span){ span.textContent = String(count); }\n          el.setAttribute('data-cart-count', String(count));\n          if('hidden' in el) el.hidden = (count===0);\n          el.classList.toggle('is-empty', count===0);\n        });\n    }catch(_){}\n  }\n  async function refreshSectionsAndCounts(ids){\n    try{\n      if(ids && ids.length){\n        const res = await fetch('/?sections=' + encodeURIComponent(ids.join(',')), { headers:{'Accept':'application/json'} });\n        const json = await res.json(); applySectionsHTML(json);\n      }\n    }catch(_){}\n    try{\n      const r = await fetch('/cart.js', { headers:{'Accept':'application/json'} });\n      const j = await r.json(); const c = j && typeof j.item_count==='number' ? j.item_count : 0;\n      updateHeaderBubbles(c);\n    }catch(_){}\n  }\n  async function addToCartAndOpenDrawer(variantId){\n    const ids = detectSectionIds();\n    const fd = new FormData(); fd.set('id', String(variantId)); fd.set('quantity','1');\n    if(ids.length){ fd.set('sections', ids.join(',')); fd.set('sections_url', window.location.pathname); }\n    let data=null;\n    try{\n      const res = await fetch('/cart/add.js',{ method:'POST', headers:{'Accept':'application/json'}, body:fd, credentials:'same-origin' });\n      try{ data = await res.json(); }catch(_){}\n      if(data && data.sections){ applySectionsHTML(data.sections); }\n      await refreshSectionsAndCounts(ids);\n    }catch(_){}\n    openCartDrawer();\n    setTimeout(openCartDrawer, 160);\n  }\n\n  root.addEventListener('click', async (e)=>{\n    const b = e.target.closest('.scb-btn'); if(b){\n      e.preventDefault(); const id = Number(b.dataset.id||0); if(!id) return;\n      b.setAttribute('data-busy','1'); b.disabled = true;\n      try{ await addToCartAndOpenDrawer(id); }catch(_){}\n      b.removeAttribute('data-busy'); b.disabled = false;\n      return;\n    }\n    const more = e.target.closest('.scb-more'); if(more){\n      if(busy) return; busy = true; more.textContent='Loading…';\n      const prevY = window.scrollY; // lock scroll position (no jump)\n      let batch = [];\n      if(cache.length >= limit){ batch = cache.splice(0,limit); }\n      else {\n        const arr = await fetchPage(++page);\n        const next = arr.length ? arr : (page=1, await fetchPage(page));\n        cache.push(...next.slice(limit));\n        batch = next.slice(0,limit);\n      }\n      batch.forEach(p=>{ seen.add(p.handle); root._map.set(p.handle,p); });\n      appendItems(batch);\n      more.textContent='Show more editions'; busy=false;\n      requestAnimationFrame(()=>window.scrollTo(0, prevY));\n      if('requestIdleCallback' in window){ requestIdleCallback(topUpCache,{timeout:1200}); } else { setTimeout(topUpCache,0); }\n    }\n  });\n\n  async function topUpCache(){\n    if(cache.length >= limit*2) return;\n    const arr = await fetchPage(page+1);\n    if(arr.length){ page += 1; cache.push(...arr.filter(p=>!seen.has(p.handle))); }\n  }\n\n  async function hydrate(){\n    const arr = await fetchPage(page);\n    const head = arr.slice(0,limit), rest = arr.slice(limit);\n    head.forEach(p=>{ seen.add(p.handle); root._map.set(p.handle,p); });\n    cache.push(...rest);\n    appendItems(head);\n    if('requestIdleCallback' in window){ requestIdleCallback(topUpCache,{timeout:1200}); } else { setTimeout(topUpCache,0); }\n  }\n\n  if('IntersectionObserver' in window){\n    const io = new IntersectionObserver(es=>{ if(es.some(e=>e.isIntersecting)){ io.disconnect(); hydrate(); } },{ rootMargin:'300px' });\n    io.observe(root);\n  } else { setTimeout(hydrate, 0); }\n})();\n</script>"
      }
