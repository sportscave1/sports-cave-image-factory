le.fontSize = cur.toFixed(2) + 'px';\n      guard++;\n    }\n\n    // Pass 3: micro tighten tracking if still a hair over\n    if(title.scrollWidth > containerW){\n      title.style.letterSpacing='-0.02em';\n    }\n\n    // Absolute last resort on quirky Samsung rounding: tiny scale (visual only, no crop)\n    if(title.scrollWidth > containerW){\n      var s = Math.max(0.92, Math.min(1, containerW / title.scrollWidth));\n      title.style.transform='scale('+s+')';\n      title.style.transformOrigin='center center';\n    }\n  }\n\n  function schedule(){\n    fit();\n    // Retry after common reflows\n    setTimeout(fit, 120);\n    setTimeout(fit, 400);\n    setTimeout(fit, 900);\n    setTimeout(fit, 1400);\n  }\n\n  if(document.readyState!=='loading') schedule();\n  else document.addEventListener('DOMContentLoaded', schedule, {once:true});\n\n  if(document.fonts && document.fonts.ready){ document.fonts.ready.then(fit); }\n  window.addEventListener('load', fit, {once:true});\n\n  var tm; function deb(){ clearTimeout(tm); tm=setTimeout(fit, 120); }\n  window.addEventListener('resize', deb, {passive:true});\n  window.addEventListener('orientationchange', deb, {passive:true});\n  document.addEventListener('visibilitychange', function(){ if(!document.hidden) setTimeout(fit,60); });\n\n  if('ResizeObserver' in window){\n    var wrap=document.querySelector('#'+ROOT+' .scx-titlewrap');\n    if(wrap){ new ResizeObserver(function(){ deb(); }).observe(wrap); }\n  }\n})();\n</script>\n{% endif %}",
