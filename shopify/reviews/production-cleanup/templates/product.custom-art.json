        "html_ijEYXF": {
          "type": "html",
          "name": "Description HTML",
          "disabled": true,
          "settings": {
            "width": "half",
            "code": "{%- comment -%}\nSPORTS CAVE • LEGACY / DESCRIPTION CARD (v3)\n- Commanding typographic card with gallery-level vibes\n- Subtle CTA that jumps to the variant area/top\n- No \"More/Less\"—always shows full content\n{%- endcomment -%}\n\n<section id=\"scx-legacy\" class=\"scx-legacy\" role=\"region\" aria-label=\"Artwork story\">\n  <header class=\"scx-legacy__head\">\n    <h2 class=\"scx-legacy__title\">LEGACY</h2>\n    <button type=\"button\" class=\"scx-legacy__cta\" data-scroll-to=\"form\">\n      <svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" aria-hidden=\"true\">\n        <path d=\"M4 7h16M4 12h16M4 17h10\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"/>\n      </svg>\n      <span>Choose frame &amp; size</span>\n    </button>\n  </header>\n\n  <div class=\"scx-legacy__body rte\" id=\"scx-legacy-body-{{ product.id }}\">\n    {{ product.description }}\n  </div>\n</section>\n\n<style>\n\n#scx-legacy.scx-legacy{\n  --paper:#0E1012;        \n  --panel:#111417;        \n  --ink:#F5F7FA;          \n  --muted:#D6DBE1;        \n  --gold:#F7A007;         \n  --edge:rgba(255,255,255,.06);\n  --glow:0 10px 28px rgba(0,0,0,.4);\n  --radius:16px;\n\n  background:linear-gradient(180deg, rgba(247,160,7,.10), transparent 40%), var(--panel);\n  color:var(--ink);\n  border:1px solid var(--edge);\n  border-radius:var(--radius);\n  box-shadow:var(--glow);\n  padding:22px 24px 24px;\n  margin:0;\n  font-family:var(--sc-font-ui);\n  contain:layout paint style;\n}\n\n\n.scx-legacy__head{\n  display:flex; align-items:center; gap:12px; justify-content:space-between;\n  margin:0 0 10px;\n  position:relative;\n}\n.scx-legacy__title{\n  margin:0; letter-spacing:.08em; font-weight:700;\n  font-size:clamp(18px,1.65vw,22px); color:var(--ink);\n  text-transform:uppercase;\n  position:relative; padding-top:4px;\n}\n.scx-legacy__title::after{\n  content:\"\"; display:block; height:3px; margin:10px 0 0;\n  background:linear-gradient(90deg, rgba(247,160,7,0) 0%, var(--gold) 18%, rgba(247,160,7,.2) 55%, transparent 100%);\n  border-radius:2px;\n}\n\n\n.scx-legacy__cta{\n  display:inline-flex; align-items:center; gap:8px;\n  padding:9px 12px; border-radius:999px;\n  font-weight:700; font-size:13px; letter-spacing:.02em;\n  color:var(--ink); background:transparent; border:1px solid var(--edge);\n  cursor:pointer; transition:transform .18s ease, background-color .18s ease, border-color .18s ease;\n  white-space:nowrap;\n}\n.scx-legacy__cta:hover{ background:rgba(255,255,255,.05); border-color:rgba(255,255,255,.12) }\n.scx-legacy__cta:active{ transform:translateY(1px) }\n\n\n.scx-legacy__body{\n  --measure:66ch;\n  position:relative;\n  max-width:var(--measure);\n  line-height:1.58;\n  font-size:clamp(15.5px,1.1vw,17px);\n  color:var(--muted);\n  padding-left:16px; margin-top:4px;\n}\n.scx-legacy__body::before{\n  content:\"\"; position:absolute; left:0; top:.35rem; bottom:.35rem; width:2px; border-radius:2px;\n  background:linear-gradient(180deg, var(--gold), rgba(247,160,7,.45));\n  box-shadow:0 0 0 1px rgba(247,160,7,.08);\n}\n.scx-legacy__body p{ margin:0 0 10px }\n.scx-legacy__body p:first-child{\n  color:var(--ink); font-weight:700; letter-spacing:.004em;\n}\n.scx-legacy__body strong{ color:var(--ink) }\n\n\n@media (max-width: 989px){\n  #scx-legacy.scx-legacy{ padding:18px 16px 18px; border-radius:14px }\n  .scx-legacy__head{ margin-bottom:6px }\n  .scx-legacy__body{ font-size:15.5px; line-height:1.54; max-width:none }\n  .scx-legacy__cta{ font-size:12.5px; padding:8px 11px }\n}\n\n\n@media (prefers-reduced-motion: reduce){\n  .scx-legacy__cta{ transition:none }\n}\n</style>\n\n<script>\n\n(function(){\n  var btn = document.querySelector('#scx-legacy .scx-legacy__cta');\n  if(!btn) return;\n\n  function headerOffsetY(targetY){\n    var h = 0, header = document.querySelector('#shopify-section-header, header.site-header, .header-wrapper');\n    if(header){ h = header.offsetHeight || 0; }\n    return Math.max(0, (targetY - (h + 8)));\n  }\n\n  function findProductForm(){\n    var selectors = [\n      '[id^=\"product-form-\"]',\n      'form[action*=\"/cart/add\"]',\n      'product-form',\n      '#MainProduct', '#MainContent [data-product-form]'\n    ];\n    for(var i=0;i<selectors.length;i++){\n      var el = document.querySelector(selectors[i]);\n      if(el) return el;\n    }\n    return null;\n  }\n\n  btn.addEventListener('click', function(){\n    var target = findProductForm();\n    if(target){\n      var y = target.getBoundingClientRect().top + window.scrollY;\n      window.scrollTo({ top: headerOffsetY(y), behavior: 'smooth' });\n    } else {\n      window.scrollTo({ top: 0, behavior: 'smooth' });\n    }\n  }, { passive:true });\n})();\n</script>"
          }
        }
