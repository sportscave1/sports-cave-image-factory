    "custom_content_cwnpXQ": {
      "type": "custom-content",
      "blocks": {
        "html_P3LFrT": {
          "type": "html",
          "name": "TABS HTML",
          "settings": {
            "width": "half",
            "code": "{%- comment -%} ===== PLAIN DESCRIPTION (no tab, default page background) ===== {%- endcomment -%}\n<section id=\"scx-desc-plain-{{ product.id }}\" class=\"scx-desc-plain\">\n  <div class=\"rte\" id=\"scx-legacy-body-{{ product.id }}\">{{ product.description }}</div>\n</section>\n\n{%- comment -%} ===== SPORTS CAVE • COLLECTOR TABS (FAQ / Shipping / Returns) ===== {%- endcomment -%}\n<section id=\"scx-tabs-{{ product.id }}\" class=\"scx-tabs\" role=\"region\" aria-label=\"Product information tabs\">\n  <nav class=\"scx-tabs__nav\" id=\"scx-tabs-{{ product.id }}-nav\" role=\"tablist\">\n    <button class=\"scx-tab-btn is-active\" role=\"tab\" aria-selected=\"true\" aria-controls=\"scx-pane-faq-{{ product.id }}\"  id=\"scx-tab-faq-{{ product.id }}\">FAQs</button>\n    <button class=\"scx-tab-btn\" role=\"tab\" aria-selected=\"false\" aria-controls=\"scx-pane-ship-{{ product.id }}\" id=\"scx-tab-ship-{{ product.id }}\">Shipping</button>\n    <button class=\"scx-tab-btn\" role=\"tab\" aria-selected=\"false\" aria-controls=\"scx-pane-returns-{{ product.id }}\" id=\"scx-tab-returns-{{ product.id }}\">30-Day Returns</button>\n  </nav>\n\n  <!-- FAQ -->\n  <section class=\"scx-pane is-active\" id=\"scx-pane-faq-{{ product.id }}\" role=\"tabpanel\" aria-labelledby=\"scx-tab-faq-{{ product.id }}\">\n    <div class=\"scx-pane__scroll\">\n      <div class=\"scx-faq\" id=\"scx-faq-live-{{ product.id }}\">\n        <div class=\"scx-faq__body\" id=\"scx-faq-body-{{ product.id }}\">\n          <p class=\"scx-loading\">Loading FAQs…</p>\n          <p class=\"scx-fallback\" hidden><a href=\"/pages/faqs\">View full FAQs</a></p>\n        </div>\n      </div>\n      <div class=\"scx-backtop\"><a href=\"#scx-tabs-{{ product.id }}-nav\" class=\"scx-backtop__btn\">Return to top</a></div>\n    </div>\n  </section>\n\n  <!-- Shipping -->\n  <section class=\"scx-pane\" id=\"scx-pane-ship-{{ product.id }}\" role=\"tabpanel\" aria-labelledby=\"scx-tab-ship-{{ product.id }}\">\n    <div class=\"scx-pane__scroll\">\n      <article class=\"scx-policy\" id=\"scx-ship-policy-{{ product.id }}\"><p class=\"scx-loading\">Loading Shipping policy…</p></article>\n      <div class=\"scx-backtop\"><a href=\"#scx-tabs-{{ product.id }}-nav\" class=\"scx-backtop__btn\">Return to top</a></div>\n    </div>\n  </section>\n\n  <!-- Returns -->\n  <section class=\"scx-pane\" id=\"scx-pane-returns-{{ product.id }}\" role=\"tabpanel\" aria-labelledby=\"scx-tab-returns-{{ product.id }}\">\n    <div class=\"scx-pane__scroll\">\n      <article class=\"scx-policy\" id=\"scx-returns-policy-{{ product.id }}\"><p class=\"scx-loading\">Loading Returns policy…</p></article>\n      <div class=\"scx-backtop\"><a href=\"#scx-tabs-{{ product.id }}-nav\" class=\"scx-backtop__btn\">Return to top</a></div>\n    </div>\n  </section>\n</section>\n\n<style>\n\n#scx-desc-plain-{{ product.id }}{ margin:0 0 12px; }\n\n\n#scx-tabs-{{ product.id }}{\n  --bg:#0B0B0B; --panel:#101217; --card:#0F1115;\n  --ink:#F5F7FA; --muted:#C9CED6; --edge:#1E2228; --gold:#F7A007;\n  --radius:16px; --shadow:0 10px 28px rgba(0,0,0,.28);\n  font-family:\"Montserrat\",system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif; color:var(--ink);\n}\n.scx-tabs__nav{ display:grid; grid-template-columns:repeat(3,1fr); gap:10px; background:linear-gradient(180deg,rgba(247,160,7,.10), transparent 60%), var(--card); border:1px solid var(--edge); border-radius:var(--radius); padding:8px; margin:8px 0 12px; box-shadow:var(--shadow); }\n.scx-tab-btn{ display:inline-flex; align-items:center; justify-content:center; width:100%; height:40px; padding:0 12px; border-radius:999px; border:1px solid rgba(255,255,255,.06); color:var(--ink); background:rgba(255,255,255,.03); font-weight:700; font-size:14px; letter-spacing:.01em; cursor:pointer; transition:background .18s ease,border-color .18s ease; }\n.scx-tab-btn:hover{ background:rgba(255,255,255,.06); border-color:rgba(255,255,255,.12) }\n.scx-tab-btn.is-active{ background:radial-gradient(120% 140% at 50% 0, rgba(247,160,7,.20), transparent 70%), #121319; border-color:rgba(247,160,7,.55); box-shadow:0 0 0 1px rgba(247,160,7,.28) inset; }\n\n.scx-pane{ display:none; background:var(--panel); border:1px solid var(--edge); border-radius:var(--radius); padding:14px 14px 8px; position:relative; box-shadow:var(--shadow); }\n.scx-pane.is-active{ display:block }\n.scx-pane::before{ content:\"\"; position:absolute; left:10px; top:14px; bottom:14px; width:3px; border-radius:2px; background:linear-gradient(180deg, var(--gold), rgba(247,160,7,.45)); box-shadow:0 0 0 1px rgba(247,160,7,.08); }\n.scx-pane__scroll{ position:relative; overflow:visible }\n@media(min-width:990px){ .scx-pane__scroll{ max-height:620px; overflow:auto; padding-right:6px; } }\n\n\n.scx-faq__body{ position:relative; background:#0E1116; border:1px solid var(--edge); border-radius:12px; padding:10px; }\n.scx-loading{ color:var(--muted); padding:8px 0; margin:0 }\n.scx-faq__body details{ margin:6px 0; border:1px solid #1A1E24; border-radius:10px; background:#11151B; overflow:hidden; }\n.scx-faq__body details > summary{\n  list-style:none; cursor:pointer; display:flex; align-items:center; justify-content:space-between;\n  gap:10px; padding:10px 12px; font-weight:700; font-size:14px; color:var(--ink);\n}\n.scx-faq__body details > summary::-webkit-details-marker{ display:none !important; }\n.scx-faq__body details > summary::marker{ content:\"\" !important; }\n.scx-faq__body details > summary::after{ content:none !important; display:none !important; }\n.scx-faq__body .accordion__icon, .scx-faq__body [class*=\"icon-\"]{ display:none !important; }\n\n.scx-faq__body details .scx-a,\n.scx-faq__body details > *:not(summary){\n  padding:10px 12px 12px; color:var(--muted); font-size:13.5px; line-height:1.5; border-top:1px solid #181C22;\n  background:linear-gradient(180deg,#0F1318 0%, #0D1116 100%);\n}\n\n.scx-policy{ background:#0E1116; border:1px solid var(--edge); border-radius:12px; padding:12px; }\n.scx-policy, .scx-policy p, .scx-policy li{ color:var(--muted) }\n.scx-policy h1, .scx-policy h2, .scx-policy h3, .scx-policy h4{ color:var(--ink) !important }\n\n.scx-backtop{ text-align:right; margin-top:10px }\n.scx-backtop__btn{ display:inline-flex; align-items:center; gap:8px; padding:8px 12px; border-radius:999px; text-decoration:none; background:rgba(255,255,255,.05); border:1px solid rgba(255,255,255,.08); color:var(--ink); font-weight:700; font-size:13px; }\n.scx-backtop__btn:hover{ background:rgba(255,255,255,.09) }\n\n\n@media(max-width: 749px){\n  #scx-tabs-{{ product.id }} .scx-tabs__nav{ display:none; }\n\n  #scx-tabs-{{ product.id }} .scx-mobtab{\n    width:100%; display:flex; align-items:center; justify-content:space-between;\n    margin:8px 0 0; padding:10px 12px;\n    background:#0B0B0B; color:#F5F7FA; border:1px solid var(--gold);\n    border-radius:12px; font-weight:700; font-size:14px; letter-spacing:.01em;\n  }\n  \n  #scx-tabs-{{ product.id }} .scx-mobtab .chev{\n    width:18px; height:18px; stroke:var(--gold); fill:none; stroke-width:2;\n    transform:rotate(0deg); transition:transform .18s ease;\n  }\n  #scx-tabs-{{ product.id }} .scx-mobtab.is-open .chev{ transform:rotate(180deg); }\n\n  #scx-tabs-{{ product.id }} .scx-pane{\n    display:none; background:#FFF7E6; border:1px solid #EAD9B0; color:#111;\n    box-shadow:none; border-radius:12px; padding:12px; margin-top:6px;\n  }\n}\n</style>\n\n<script>\n(function(){\n  var root = document.getElementById('scx-tabs-{{ product.id }}'); if(!root) return;\n\n  \n  root.querySelectorAll('.scx-tab-btn').forEach(function(btn){\n    btn.addEventListener('click', function(){\n      if (window.matchMedia('(max-width: 749px)').matches) return; // desktop only\n      root.querySelectorAll('.scx-tab-btn').forEach(function(b){ b.classList.remove('is-active'); b.setAttribute('aria-selected','false'); });\n      root.querySelectorAll('.scx-pane').forEach(function(p){ p.classList.remove('is-active'); });\n      btn.classList.add('is-active'); btn.setAttribute('aria-selected','true');\n      var pane = document.getElementById(btn.getAttribute('aria-controls')); if(pane){ pane.classList.add('is-active'); }\n    });\n  });\n\n  \n  function buildMobile(){\n    // clear any previously built headers to avoid duplicates\n    root.querySelectorAll('.scx-mobtab').forEach(function(h){ h.remove(); });\n    root.querySelectorAll('.scx-pane').forEach(function(p){ p.style.display='none'; });\n\n    root.querySelectorAll('.scx-tab-btn').forEach(function(tb){\n      var paneId = tb.getAttribute('aria-controls');\n      var pane = document.getElementById(paneId); if(!pane) return;\n\n      var h = document.createElement('button');\n      h.className = 'scx-mobtab';\n      h.type = 'button';\n      h.setAttribute('aria-expanded','false');\n      h.innerHTML = '<span>'+ tb.textContent +'</span><svg class=\"chev\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M6 9l6 6 6-6\"/></svg>';\n      pane.parentNode.insertBefore(h, pane);\n\n      h.addEventListener('click', function(){\n        var isOpen = h.classList.contains('is-open');\n        // close all\n        root.querySelectorAll('.scx-mobtab').forEach(function(x){ x.classList.remove('is-open'); x.setAttribute('aria-expanded','false'); });\n        root.querySelectorAll('.scx-pane').forEach(function(p){ p.style.display='none'; });\n\n        // toggle this\n        if(!isOpen){\n          h.classList.add('is-open');\n          h.setAttribute('aria-expanded','true');\n          pane.style.display='block';\n        }\n      });\n    });\n  }\n\n  function destroyMobile(){\n    root.querySelectorAll('.scx-mobtab').forEach(function(h){ h.remove(); });\n    root.querySelectorAll('.scx-pane').forEach(function(p){ p.style.display=''; });\n    // restore desktop default (first tab active)\n    root.querySelectorAll('.scx-tab-btn').forEach(function(b,i){\n      b.classList.toggle('is-active', i===0);\n      b.setAttribute('aria-selected', i===0 ? 'true' : 'false');\n    });\n    root.querySelectorAll('.scx-pane').forEach(function(p,i){\n      p.classList.toggle('is-active', i===0);\n    });\n  }\n\n  function onMode(){\n    if(window.matchMedia('(max-width: 749px)').matches){ buildMobile(); }\n    else{ destroyMobile(); }\n  }\n  onMode();\n  window.addEventListener('resize', onMode, {passive:true});\n\n  \n  var faqBody = document.getElementById('scx-faq-body-{{ product.id }}');\n  function emitSchema(rootEl){\n    try{\n      if((document.head.textContent||'').indexOf('\"@type\":\"FAQPage\"')>-1) return;\n      var QAs=[], ds=rootEl.querySelectorAll('details');\n      ds.forEach(function(d){\n        var q=(d.querySelector('summary')||{}).innerText||'';\n        var a=[].slice.call(d.children).filter(function(n){return n.tagName!=='SUMMARY';}).map(function(n){return n.innerText;}).join('\\n').trim();\n        if(q&&a) QAs.push({q:q.trim(),a:a});\n      });\n      if(!QAs.length) return;\n      var json={\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"name\":\"Sports Cave FAQs\",\"url\":location.href,\"mainEntity\":QAs.slice(0,20).map(function(qa){return {\"@type\":\"Question\",\"name\":qa.q,\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":qa.a}};})};\n      var s=document.getElementById('scx-faq-ld')||document.createElement('script'); s.type='application/ld+json'; s.id='scx-faq-ld'; s.text=JSON.stringify(json);\n      document.head.appendChild(s);\n    }catch(e){}\n  }\n\n  fetch('/pages/faqs',{credentials:'same-origin'}).then(function(r){return r.text();}).then(function(html){\n    var doc=new DOMParser().parseFromString(html,'text/html');\n    var best=null,max=0;\n    [].slice.call(doc.querySelectorAll('main,#MainContent,section,article,.page,.container,.faq')).forEach(function(el){ var n=el.querySelectorAll('details').length; if(n>max){max=n;best=el;} });\n    var source=best||doc.body;\n    faqBody.innerHTML=source.innerHTML;\n    var l=faqBody.querySelector('.scx-loading'); if(l) l.remove();\n    // remove any built-in icons/markers inside details\n    faqBody.querySelectorAll('svg, .icon-plus, .icon-minus, .accordion__icon').forEach(function(el){ el.style.display='none'; });\n    emitSchema(faqBody);\n  }).catch(function(){ var fb=faqBody.querySelector('.scx-fallback'); if(fb){ fb.hidden=false; }});\n\n  function mountPolicy(url, hostId){\n    var host=document.getElementById(hostId); if(!host) return;\n    fetch(url,{credentials:'same-origin'}).then(function(r){return r.text();}).then(function(html){\n      var doc=new DOMParser().parseFromString(html,'text/html');\n      var main=doc.querySelector('main,#MainContent,article,section,.page,.rte')||doc.body;\n      host.innerHTML=main.innerHTML||'';\n      var l=host.querySelector('.scx-loading'); if(l) l.remove();\n    }).catch(function(){ host.innerHTML='<p class=\"scx-fallback\">Please see our <a href=\"'+url+'\">policy page</a>.</p>'; });\n  }\n  mountPolicy('/policies/shipping-policy','scx-ship-policy-{{ product.id }}');\n  mountPolicy('/policies/refund-policy','scx-returns-policy-{{ product.id }}');\n})();\n</script>"
          }
