        "custom_liquid_LUWNc9": {
          "type": "custom-liquid",
          "name": "STICKY ADD TO CART HTML",
          "settings": {
            "custom_liquid": "{%- assign sticky_form_id = 'sticky-' | append: product.id -%}\n{%- assign user_iso = localization.country.iso_code | default: 'AU' -%}\n\n<section id=\"scx-stickyp-{{ product.id }}\" class=\"scx-stickyp\" role=\"region\" aria-roledescription=\"Sticky buy bar\" aria-label=\"Sticky add to cart for {{ product.title | escape }}\" aria-live=\"polite\" data-nosnippet=\"true\">\n  <div class=\"scx-wrap\">\n    <div class=\"scx-line\">\n\n      <!-- ───────────────── SWATCHES (Frame stays as swatches) ───────────────── -->\n      <div class=\"scx-swatches\" role=\"group\" aria-label=\"Choose options\">\n        <!-- FRAME / STYLE -->\n        <fieldset class=\"option-selector scx-vp-frame\" data-option=\"Frame\" aria-label=\"Frame\">\n          <legend class=\"visually-hidden\">Frame</legend>\n          <div class=\"option-selector__btns scx-row scx-row--frames\">\n            {%- for option in product.options_with_values -%}\n              {%- assign od = option.name | downcase -%}\n              {%- if od contains 'frame' or od contains 'style' -%}\n                {%- for value in option.values -%}{%- assign i0 = forloop.index0 -%}\n                  <input class=\"opt-btn visually-hidden focus-label js-frame\" type=\"radio\" name=\"{{ sticky_form_id }}-frame\" id=\"{{ sticky_form_id }}-frame-{{ i0 }}\" value=\"{{ value | escape }}\"{% if value.selected %} checked{% endif %} aria-labelledby=\"{{ sticky_form_id }}-frame-{{ i0 }}-lbl\">\n                  <label for=\"{{ sticky_form_id }}-frame-{{ i0 }}\" id=\"{{ sticky_form_id }}-frame-{{ i0 }}-lbl\" class=\"opt-label opt-label--swatch opt-label--frame\" data-swatch=\"{{ value | replace:'\"','' | downcase }}\">\n                    <span class=\"visually-hidden js-value\">{{ value }}</span>\n                  </label>\n                {%- endfor -%}\n              {%- endif -%}\n            {%- endfor -%}\n          </div>\n        </fieldset>\n\n        <!-- SIZE (DROPDOWN) -->\n        <fieldset class=\"option-selector scx-vp-size\" data-option=\"Size\" aria-label=\"Size\">\n          <legend class=\"visually-hidden\">Size</legend>\n          <label class=\"visually-hidden\" for=\"{{ sticky_form_id }}-size-select\">Choose size</label>\n          <div class=\"scx-size-dd\">\n            <select id=\"{{ sticky_form_id }}-size-select\" class=\"scx-size-select js-size-dd\" name=\"{{ sticky_form_id }}-size\" aria-label=\"Size\">\n              {%- for option in product.options_with_values -%}\n                {%- assign od = option.name | downcase -%}\n                {%- if od contains 'size' -%}\n                  {%- for value in option.values -%}\n                    <option value=\"{{ value | escape }}\"{% if value.selected %} selected{% endif %}>{{ value }}</option>\n                  {%- endfor -%}\n                {%- endif -%}\n              {%- endfor -%}\n            </select>\n            <svg class=\"scx-dd-caret\" viewBox=\"0 0 20 20\" aria-hidden=\"true\"><path fill=\"currentColor\" d=\"M5 7l5 6 5-6z\"/></svg>\n          </div>\n        </fieldset>\n      </div>\n\n      <!-- ─────────────── DESKTOP TRUST RAIL (unchanged) ─────────────── -->\n      <div class=\"scx-trustrail\" id=\"scx-trustrail-{{ product.id }}\" aria-label=\"Shop assurances\">\n        <div class=\"trail-item\" title=\"Customer reviews\">\n          <svg viewBox=\"0 0 20 20\" aria-hidden=\"true\"><path fill=\"currentColor\" d=\"M10 15.3l-5.3 2.8 1-5.9L1 7.9l6-.9L10 2l3 5 6 .9-4.7 4.3 1 5.9z\"/></svg>\n          <span><strong>4.9★</strong> Google Reviews</span>\n        </div>\n        <div class=\"trail-item\" id=\"scx-ship-item-{{ product.id }}\" data-iso=\"{{ user_iso }}\" title=\"Fast shipping to your country\">\n          <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path fill=\"currentColor\" d=\"M3 7h11v6h2.5l3-3H21V7h-3l-3-3H3v3zm0 10a2 2 0 1 0 4 0 2 2 0 0 0-4 0zm12 0a2 2 0 1 0 4 0 2 2 0 0 0-4 0zM1 9h11v6H7.8a3.5 3.5 0 0 0-6.8 0H1V9zm17.5 0 2 2H20V9h-1.5z\"/></svg>\n          <span><span class=\"js-ship-fast\">Fast</span> <span class=\"js-ship-country\">AU</span> Shipping</span>\n        </div>\n        <div class=\"trail-item\" title=\"Secure checkout\">\n          <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path fill=\"currentColor\" d=\"M17 9V7a5 5 0 0 0-10 0v2H5v12h14V9h-2zm-8 0V7a3 3 0 0 1 6 0v2H9z\"/></svg>\n          <span>Secure Checkout</span>\n        </div>\n      </div>\n\n      <!-- ─────────────── % OFF PILL (smaller) ─────────────── -->\n      {%- assign v = product.selected_or_first_available_variant -%}\n      {%- assign show_pill = false -%}\n      {%- if v and v.price and v.compare_at_price and v.compare_at_price > v.price -%}{%- assign show_pill = true -%}{%- endif -%}\n      <div class=\"scx-sticky-pill\" id=\"scx-sticky-pill-{{ product.id }}\" aria-live=\"polite\">\n        <div class=\"scsp-pill\" data-scsp-pill{% unless show_pill %} style=\"display:none\"{% endunless %}>\n          <span class=\"scsp-num\">\n            {%- if show_pill -%}{%- assign pct = v.compare_at_price | minus: v.price | times: 100.0 | divided_by: v.compare_at_price | round -%}{{ pct }}% OFF{%- endif -%}\n          </span>\n        </div>\n      </div>\n\n      <!-- ─────────────── PRICE (mirrors native; moved inside CTA) ─────────────── -->\n      <div class=\"scx-price\" id=\"scx-price-{{ product.id }}\" role=\"status\" aria-live=\"polite\" aria-atomic=\"true\" translate=\"no\"></div>\n\n      <!-- ─────────────── CTA ─────────────── -->\n      <div class=\"scx-atc-cell\">\n        <button id=\"scx-atc-btn-{{ product.id }}\" type=\"button\" class=\"scx-atc-btn\" aria-label=\"Add to cart\" aria-describedby=\"scx-atc-help-{{ product.id }}\">\n          <span class=\"scx-atc-label\">ADD TO CART</span>\n          <span class=\"scx-spinner\" aria-hidden=\"true\"><span class=\"i\"></span></span>\n        </button>\n      </div>\n      <span id=\"scx-atc-help-{{ product.id }}\" class=\"visually-hidden\">Adds your selected frame and size to cart.</span>\n\n    </div>\n  </div>\n\n  <!-- Variant map -->\n  <script type=\"application/json\" id=\"scx-variant-map-{{ product.id }}\">\n  {\n    {% for v in product.variants %}\n    \"{{ v.id }}\": {\n      \"id\": {{ v.id }},\n      \"available\": {{ v.available | json }},\n      \"price\": {{ v.price | json }},\n      \"compare_at_price\": {{ v.compare_at_price | json }},\n      \"option1\": {{ v.option1 | json }},\n      \"option2\": {{ v.option2 | json }},\n      \"option3\": {{ v.option3 | json }}\n    }{% unless forloop.last %},{% endunless %}\n    {% endfor %}\n  }\n  </script>\n</section>\n\n<style>\n\n#scx-stickyp-{{ product.id }}{\n  --ink:#111; --bg:#F5F5F5; --price-current:#F7A007; --price-was-ink:#9AA0A6;\n  --cta-font: clamp(14px, 1vw + 12px, 20px);\n  --ctaH: 44px;\n  --label-scale: 1;\n  --cta-left-pad: 96px;\n  --cta-right-pad: 118px;\n  z-index:2140; position:fixed; left:0; right:0; bottom:0; width:100vw;\n  background:var(--bg); color:var(--ink); border-top:1px solid rgba(0,0,0,.08);\n  box-shadow:0 -8px 20px rgba(0,0,0,.08);\n  padding:0 clamp(8px,1vw,14px) calc(4px + env(safe-area-inset-bottom,0));\n  font-family:\"Montserrat\",system-ui,Arial,sans-serif;\n  box-sizing:border-box; overflow:hidden; -webkit-font-smoothing:antialiased;\n}\n#scx-stickyp-{{ product.id }} *{ min-width:0; box-sizing:border-box }\n#scx-stickyp-{{ product.id }} .scx-wrap{ max-width:1600px; margin:0 auto }\n#scx-stickyp-{{ product.id }} .scx-line{\n  position:relative; display:grid; gap:6px 8px; grid-template-columns:1fr;\n  grid-template-areas:\"swatches\" \"atc\"; align-items:center;\n}\n\n\n.scx-trustrail{ display:none }\n\n\n#scx-stickyp-{{ product.id }} .option-selector{ margin:0; padding:0; border:0 }\n#scx-stickyp-{{ product.id }} .opt-label--swatch{\n  width:var(--deskTile,42px); height:var(--deskTile,42px);\n  border-radius:10px; background:transparent; border:1px solid #E6E6E6;\n  display:inline-flex; align-items:center; justify-content:center;\n  transition:border-color .12s ease, box-shadow .12s ease, transform .06s ease;\n}\n#scx-stickyp-{{ product.id }} .opt-label--swatch:active{ transform:scale(.98) }\n#scx-stickyp-{{ product.id }} .opt-btn:focus + .opt-label{ outline:2px solid rgba(0,0,0,.18); outline-offset:2px }\n#scx-stickyp-{{ product.id }} .opt-btn:checked + .opt-label{ border-color:#D9A441; box-shadow:0 0 0 1.5px #D9A441 inset }\n\n\n#scx-stickyp-{{ product.id }} .scx-size-dd{ position:relative; min-width:120px; }\n#scx-stickyp-{{ product.id }} .scx-size-select{\n  appearance:none; -webkit-appearance:none; -moz-appearance:none;\n  width:100%; height:var(--ctaH);\n  padding:0 36px 0 12px;\n  border:1px solid #E6E6E6; border-radius:10px; background:#fff;\n  font:700 14px/1 Montserrat,system-ui,sans-serif; letter-spacing:.01em;\n}\n#scx-stickyp-{{ product.id }} .scx-size-select:focus{ outline:2px solid rgba(0,0,0,.18); outline-offset:2px }\n#scx-stickyp-{{ product.id }} .scx-dd-caret{\n  position:absolute; right:10px; top:50%; transform:translateY(-50%);\n  width:16px; height:16px; pointer-events:none; color:#6B7280;\n}\n\n\n#scx-stickyp-{{ product.id }} .scx-atc-btn{\n  width:100%; height:var(--ctaH);\n  background:#111; color:#fff; border:1px solid #111; border-radius:12px;\n  font-weight:700; text-transform:uppercase; font-size:var(--cta-font); line-height:1; letter-spacing:.02em;\n  position:relative; display:flex; align-items:center; justify-content:center;\n  padding-left:var(--cta-left-pad); padding-right:var(--cta-right-pad); overflow:hidden;\n}\n#scx-stickyp-{{ product.id }} .scx-atc-label{\n  position:relative; z-index:2; pointer-events:none; white-space:nowrap !important;\n  color:#fff !important; line-height:1; font-size: calc(var(--cta-font) * var(--label-scale));\n}\n\n\n#scx-stickyp-{{ product.id }} .scx-atc-btn .scsp-pill{\n  --pill-top:#F3A51A; --pill-bottom:#D58908; --pill-border:#B67006; --pill-ink:#0D0D0D;\n  position:absolute; left:8px; top:50%; transform:translateY(-50%) scale(.88); transform-origin:left center; z-index:1; pointer-events:none;\n  display:inline-flex; align-items:center; justify-content:center; padding:.22em .56em; border-radius:999px; min-width:66px;\n  background: linear-gradient(180deg, rgba(255,255,255,.25), rgba(255,255,255,0) 58%), linear-gradient(180deg, var(--pill-top), var(--pill-bottom));\n  color:var(--pill-ink); font:900 calc(var(--cta-font) * .72)/1 Montserrat,system-ui,sans-serif; letter-spacing:.03em; white-space:nowrap;\n  box-shadow:0 6px 14px rgba(0,0,0,.14), 0 2px 5px rgba(0,0,0,.12); border:1px solid var(--pill-border);\n}\n#scx-stickyp-{{ product.id }} .scx-atc-btn .scx-price{\n  position:absolute; right:10px; top:50%; transform:translateY(-50%); z-index:1; pointer-events:none;\n  display:flex; flex-direction:column; align-items:flex-end; max-width:44%;\n}\n#scx-stickyp-{{ product.id }} .scx-atc-btn .scx-price .price{ line-height:1.05; display:flex; flex-direction:column; align-items:flex-end; gap:2px }\n#scx-stickyp-{{ product.id }} .scx-atc-btn .scx-price .price .price__current,\n#scx-stickyp-{{ product.id }} .scx-atc-btn .scx-price .price .price__regular,\n#scx-stickyp-{{ product.id }} .scx-atc-btn .scx-price .price .price__sale{\n  color:var(--price-current) !important; font-weight:700 !important; font-size:var(--cta-font) !important; letter-spacing:.01em;\n}\n#scx-stickyp-{{ product.id }} .scx-atc-btn .scx-price .price.price--on-sale .price__was,\n#scx-stickyp-{{ product.id }} .scx-atc-btn .scx-price .price.price--on-sale s,\n#scx-stickyp-{{ product.id }} .scx-atc-btn .scx-price .price.price--on-sale del{\n  color:var(--price-was-ink) !important; font-size:calc(var(--cta-font) * .78) !important; text-decoration:line-through !important; text-decoration-thickness:.10em !important; opacity:.95;\n}\n\n\n#scx-stickyp-{{ product.id }} .scx-atc-btn .scx-spinner{ position:absolute; left:50%; top:50%; transform:translate(-50%,-50%); width:1.1em; height:1.1em; z-index:3; pointer-events:none; display:none; }\n#scx-stickyp-{{ product.id }} .scx-atc-btn .scx-spinner .i{ display:block; width:100%; height:100%; box-sizing:border-box; border:2px solid rgba(255,255,255,.8); border-left-color:transparent; border-radius:50%; animation:scx-spin .8s linear infinite; }\n#scx-stickyp-{{ product.id }} .scx-atc-btn.loading .scx-spinner,\n#scx-stickyp-{{ product.id }} .scx-atc-btn[aria-busy=\"true\"] .scx-spinner{ display:block; }\n#scx-stickyp-{{ product.id }} .scx-atc-btn.loading .scx-atc-label,\n#scx-stickyp-{{ product.id }} .scx-atc-btn[aria-busy=\"true\"] .scx-atc-label{ opacity:0; }\n@keyframes scx-spin{ to{ transform:rotate(360deg); } }\n\n\n@media(max-width:1199px){\n  #scx-stickyp-{{ product.id }}{ --ctaH:40px; padding-top:0; padding-bottom:0; }\n  #scx-stickyp-{{ product.id }} .scx-line{ gap:3px 6px; }\n\n  \n  #scx-stickyp-{{ product.id }} .scx-row--frames{\n    display:grid;\n    grid-template-columns:repeat(auto-fit, minmax(0, 1fr));\n    gap:6px;\n    width:100%;\n  }\n  \n  #scx-stickyp-{{ product.id }} .opt-label--frame{\n    width:100% !important;\n    height:42px !important;\n    border-radius:10px;\n  }\n\n  \n  #scx-stickyp-{{ product.id }} .scx-size-select{ height:36px; border-radius:7px; }\n}\n\n\n@media(min-width:1200px){\n  #scx-stickyp-{{ product.id }}{ --ctaH:42px; --cta-font: clamp(15px, 1vw + 10px, 20px); --deskTile: clamp(57px, 4.66vw, 71px); padding:2px clamp(10px,1.2vw,16px) calc(6px + env(safe-area-inset-bottom,0)); }\n  #scx-stickyp-{{ product.id }} .scx-line{ grid-template-columns:max-content 1fr; grid-template-areas:\"swatches atc\"; align-items:center; gap:10px 12px; }\n  #scx-stickyp-{{ product.id }} .scx-swatches{ display:flex; align-items:center; gap:10px }\n  #scx-stickyp-{{ product.id }} .scx-row{ display:inline-flex; flex-wrap:nowrap; gap:10px }\n  .scx-trustrail{ position:absolute; right:0; bottom:calc(100% + 8px); display:flex; justify-content:flex-end; align-items:center; gap:12px; }\n  .scx-trustrail .trail-item{ display:inline-flex; align-items:center; gap:8px; font:600 12px/1.2 Montserrat,system-ui,sans-serif; color:#6B7280; background:#fff; border:1px solid rgba(0,0,0,.06); border-radius:999px; padding:6px 10px; box-shadow:0 1px 2px rgba(0,0,0,.04), inset 0 0 0 .5px rgba(255,255,255,.6); white-space:nowrap; }\n  .scx-trustrail svg{ width:16px; height:16px; display:block }\n}\n\n\n#scx-stickyp-{{ product.id }} .scx-sticky-pill{ display:none }\n\n\n.pswp, .pswp--open, .fancybox__container, .media-modal[open], .product-media-modal[open], .modal--product[open], .product__modal[open], dialog[open][id*=\"ProductModal\"], #ProductModal[open]{ z-index:2147483647 !important; }\n.drawer, .js-cart-drawer, [data-drawer], .cart-drawer, .modal, .Modal, .popup, .Popover, .popover, [aria-modal=\"true\"], .header__search, .search-modal, .predictive-search, .Dialog, .dialog, #CartDrawer, #Cart-Drawer, .side-drawer, .quick-add-modal{ z-index:9999 !important; }\n</style>\n\n<script id=\"scx-stickyp-logic-{{ product.id }}\">\n\n(function(){\n  function initSticky(){\n    var bar=document.getElementById('scx-stickyp-{{ product.id }}'); if(!bar||bar.dataset.bound==='1') return; bar.dataset.bound='1';\n    try{ if(bar.parentNode!==document.body){ document.body.appendChild(bar); } }catch(_){}\n    var mainForm=(document.querySelector('form[action*=\"/cart/add\"]'))||null; if(!mainForm) return;\n    var mainPicker=document.querySelector('variant-picker.sc-vp:not(.sc-vp--sticky)') || document.querySelector('variant-picker');\n\n    \n    var priceNode=document.getElementById('scx-price-{{ product.id }}'); var _priceSrc=null,_priceMO=null;\n    function priceHost(){ var scope=mainForm.closest('[id^=\"ProductInfo-\"]')||document; return scope.querySelector('[data-product-price], .price__container, .product__price, .product-info__price, .price'); }\n    function getPriceWrapper(src){ if(!src) return null; if(src.classList && src.classList.contains('price')) return src; return src.querySelector('.price') || src; }\n    function stripCurrencyCodesForMobile(){ if(window.matchMedia('(max-width: 1199px)').matches){ var p=priceNode.querySelector('.price')||priceNode; if(!p) return; var w=document.createTreeWalker(p, NodeFilter.SHOW_TEXT, null), n; while(n=w.nextNode()){ n.nodeValue = n.nodeValue.replace(/\\s?[A-Z]{3}\\b/g,''); } } }\n    function mirrorPrice(){ if(!priceNode) return; var src=getPriceWrapper(_priceSrc||priceHost()); if(!src) return; priceNode.innerHTML=''; try{ priceNode.appendChild(src.cloneNode(true)); }catch(_){ priceNode.innerHTML=src.outerHTML || src.innerHTML; } stripCurrencyCodesForMobile(); scheduleLayout(); }\n    function bindPriceObserver(){\n      var fresh=priceHost(); if(!fresh) return;\n      if(fresh!==_priceSrc){\n        if(_priceMO){ try{ _priceMO.disconnect(); }catch(_){ } }\n        _priceSrc=fresh;\n        _priceMO=new MutationObserver(function(){ requestAnimationFrame(mirrorPrice); });\n        _priceMO.observe(_priceSrc,{subtree:true,childList:true,attributes:true,characterData:true});\n      }\n      mirrorPrice();\n    }\n    bindPriceObserver();\n    ['country:changed','currency:changed','localization:updated','cc:currency:updated','product:variant-change','shopify:section:load','shopify:section:select','ajaxProduct:updated'].forEach(function(ev){ window.addEventListener(ev, bindPriceObserver, {capture:true}); });\n\n    \n    var VARIANT_MAP={}; try{ VARIANT_MAP=JSON.parse(document.getElementById('scx-variant-map-{{ product.id }}').textContent||'{}'); }catch(e){ VARIANT_MAP={}; }\n    var pillEl=bar.querySelector('[data-scsp-pill]');\n    function currentVariant(){ var idInput=mainForm.querySelector('input[name=\"id\"]'); return idInput && VARIANT_MAP[idInput.value] ? VARIANT_MAP[idInput.value] : null; }\n    function renderStickyPill(v){\n      if(!pillEl) return;\n      if(v && Number(v.compare_at_price||0) > Number(v.price||0)){\n        var pct=Math.round((v.compare_at_price - v.price) * 100 / v.compare_at_price);\n        pillEl.style.display=''; var n=pillEl.querySelector('.scsp-num'); if(n) n.textContent=pct + '% OFF';\n      }else{ pillEl.style.display='none'; }\n      scheduleLayout();\n    }\n    function setByCurrentVariant(){ var v=currentVariant(); var atc=document.getElementById('scx-atc-btn-{{ product.id }}'); if(atc) atc.disabled = v ? !v.available : false; renderStickyPill(v); mirrorPrice(); }\n\n    \n    function groupByKey(picker,key){ key=String(key||'').toLowerCase(); var gs=picker?picker.querySelectorAll('.option-selector[data-option]'):[]; for(var i=0;i<gs.length;i++){ if((gs[i].getAttribute('data-option')||'').toLowerCase().indexOf(key)>-1) return gs[i]; } return null; }\n    var mainSizeGroup=groupByKey(mainPicker,'size');\n    var mainFrameGroup=groupByKey(mainPicker,'frame') || groupByKey(mainPicker,'style');\n    function norm(s){ return String(s||'').toLowerCase().replace(/\\s+/g,'').replace(/×/g,'x').replace(/\\(.*?\\)/g,''); }\n    var stickySizeGroup=bar.querySelector('.scx-vp-size'); var stickyFrameGroup=bar.querySelector('.scx-vp-frame');\n\n    \n    function syncFromMain(){\n      if(mainSizeGroup && stickySizeGroup){\n        var chosen=''; var r=mainSizeGroup.querySelector('input[type=\"radio\"]:checked');\n        if(r){ var lbl=mainPicker && mainPicker.querySelector('label[for=\"'+r.id+'\"] .js-value'); chosen=(lbl?lbl.textContent:r.value).trim(); }\n        else{ var sel=mainSizeGroup.querySelector('select'); if(sel){ chosen=(sel.value||sel.options[sel.selectedIndex].text).trim(); } }\n        if(chosen){\n          var want=norm(chosen);\n          var dd=stickySizeGroup.querySelector('select');\n          if(dd){\n            var found=false;\n            for(var k=0;k<dd.options.length;k++){\n              var txt=(dd.options[k].text||dd.options[k].value).trim();\n              if(norm(txt)===want){ dd.selectedIndex=k; found=true; break; }\n            }\n            if(!found && dd.options.length){ dd.selectedIndex=0; }\n          }\n        }\n      }\n      if(mainFrameGroup && stickyFrameGroup){\n        var rf=mainFrameGroup.querySelector('input[type=\"radio\"]:checked');\n        if(rf){\n          var lf=mainPicker && mainPicker.querySelector('label[for=\"'+rf.id+'\"] .js-value'); var chosenF=(lf?lf.textContent:rf.value).trim(); var wantF=norm(chosenF);\n          stickyFrameGroup.querySelectorAll('input[type=\"radio\"]').forEach(function(inp){\n            var l=stickyFrameGroup.querySelector('label[for=\"'+inp.id+'\"] .js-value'); var txt=(l?l.textContent:inp.value).trim();\n            inp.checked = norm(txt)===wantF;\n          });\n        }\n      }\n      setByCurrentVariant();\n    }\n    if(mainPicker){\n      document.addEventListener('product:variant-change', syncFromMain, {capture:true});\n      ['change','input','click'].forEach(function(evt){ mainPicker.addEventListener(evt, syncFromMain, {capture:true}); });\n      new MutationObserver(syncFromMain).observe(mainPicker,{subtree:true,childList:true,characterData:true,attributes:true});\n    }\n    syncFromMain();\n\n    \n    function setMainBy(group,label){\n      if(!group) return; var want=norm(label); var rads=[].slice.call(group.querySelectorAll('input[type=\"radio\"]'));\n      if(rads.length){\n        for(var i=0;i<rads.length;i++){\n          var rid=rads[i].id; var lbl=mainPicker && mainPicker.querySelector('label[for=\"'+rid+'\"] .js-value');\n          var txt=(lbl?lbl.textContent:rads[i].value).trim();\n          if(norm(txt)===want && !rads[i].checked){\n            rads[i].checked=true; rads[i].dispatchEvent(new Event('input',{bubbles:true})); rads[i].dispatchEvent(new Event('change',{bubbles:true}));\n            document.dispatchEvent(new Event('product:variant-change',{bubbles:true})); break;\n          }\n        }\n      }else{\n        var sel=group.querySelector('select'); if(sel){\n          for(var j=0;j<sel.options.length;j++){ var cand=(sel.options[j].value||sel.options[j].text).trim(); if(norm(cand)===want){ sel.value=sel.options[j].value; break; } }\n          sel.dispatchEvent(new Event('input',{bubbles:true})); sel.dispatchEvent(new Event('change',{bubbles:true}));\n          document.dispatchEvent(new Event('product:variant-change',{bubbles:true}));\n        }\n      }\n    }\n\n    function scrollToTop(){ window.scrollTo({ top: 0, behavior: 'smooth' }); }\n    function isDesktop(){ return window.matchMedia('(min-width: 1200px)').matches; }\n\n    // SIZE (sticky ➜ main) — dropdown\n    stickySizeGroup && stickySizeGroup.addEventListener('change', function(e){\n      var sel=e.target.closest('select'); if(!sel) return;\n      var txt = (sel.options[sel.selectedIndex] ? sel.options[sel.selectedIndex].text : sel.value) || '';\n      setMainBy(mainSizeGroup, txt.trim()); setByCurrentVariant();\n      if(isDesktop()) scrollToTop();\n    }, {capture:true});\n\n    // FRAME (sticky ➜ main) — radios\n    stickyFrameGroup && stickyFrameGroup.addEventListener('change', function(e){\n      var r=e.target.closest('input[type=\"radio\"]'); if(!r) return;\n      var l=stickyFrameGroup.querySelector('label[for=\"'+r.id+'\"] .js-value');\n      setMainBy(mainFrameGroup,(l?l.textContent:r.value).trim()); setByCurrentVariant();\n      if(isDesktop()) scrollToTop();\n    }, {capture:true});\n\n    // Desktop jump on main picker change\n    if(mainPicker){\n      mainPicker.addEventListener('change', function(ev){\n        if(isDesktop() && ev.target && ev.target.matches('input[type=\"radio\"], select')) scrollToTop();\n      }, {capture:true});\n    }\n\n    \n    (function syncAtcFromNative(){\n      var nativeBtn=mainForm.querySelector('.product-form__submit, [type=\"submit\"]');\n      var stickyBtn=document.getElementById('scx-atc-btn-{{ product.id }}');\n      var stickyLbl=stickyBtn && stickyBtn.querySelector('.scx-atc-label');\n      if(!nativeBtn||!stickyLbl||!stickyBtn) return;\n      function copyLabel(){ var t=(nativeBtn.innerText || nativeBtn.textContent || 'Add to cart').replace(/\\s+/g,' ').trim(); if(!t) t='Add to cart'; stickyLbl.textContent=t; scheduleLayout(); }\n      function copyState(){\n        stickyBtn.disabled = !!nativeBtn.disabled;\n        if(nativeBtn.getAttribute('aria-busy')==='true'){ stickyBtn.setAttribute('aria-busy','true'); stickyBtn.classList.add('loading'); }\n        else{ stickyBtn.removeAttribute('aria-busy'); stickyBtn.classList.remove('loading'); }\n      }\n      copyLabel(); copyState();\n      new MutationObserver(function(){ copyLabel(); copyState(); })\n        .observe(nativeBtn,{subtree:true,childList:true,characterData:true,attributes:true,attributeFilter:['disabled','aria-busy','class']});\n    })();\n\n    \n    function getDrawerEl(){ return document.querySelector('cart-drawer, #CartDrawer, #Cart-Drawer, .cart-drawer, .drawer.js-cart-drawer'); }\n    function openDrawerFallback(){\n      try{ window.dispatchEvent(new CustomEvent('cart:open',{bubbles:true,detail:{source:'sticky'}})); }catch(_){}\n      try{\n        if(window.CartDrawer && typeof window.CartDrawer.open==='function'){ window.CartDrawer.open(); return; }\n        var el=getDrawerEl(); if(!el) return;\n        if(typeof el.open==='function'){ el.open(); return; }\n        if((el.tagName||'').toLowerCase()==='cart-drawer'){ el.setAttribute('open',''); return; }\n        el.setAttribute('aria-hidden','false'); el.classList.add('is-open'); document.documentElement.classList.add('no-scroll');\n      }catch(_){}\n    }\n    function detectCartSectionIds(){\n      var ids=new Set(); var drawer=getDrawerEl();\n      if(drawer){\n        var sec=drawer.closest('section[id^=\"shopify-section-\"]'); if(sec){ ids.add(sec.id.replace('shopify-section-','')); }\n        drawer.querySelectorAll('[data-section-id]').forEach(function(n){ if(n.dataset.sectionId) ids.add(n.dataset.sectionId); });\n      }\n      if(document.getElementById('shopify-section-header')) ids.add('header');\n      ids.add('cart-drawer'); ids.add('cart-icon-bubble');\n      return Array.from(ids);\n    }\n    function applySectionsHTML(map){ if(!map) return; Object.keys(map).forEach(function(id){ var host=document.getElementById('shopify-section-'+id); if(host){ host.innerHTML=map[id]; } }); }\n    function updateHeaderBubbles(count){\n      try{\n        var nodes=[].slice.call(document.querySelectorAll('#cart-icon-bubble, .cart-count-bubble, [data-cart-count-bubble], [data-cart-count], .header__icon--cart .cart-count, .cart__badge, #CartCount'));\n        nodes.forEach(function(el){\n          var span = el.querySelector('[aria-hidden=\"true\"]') || el.firstElementChild || el; if(span){ span.textContent = String(count); }\n          el.setAttribute('data-cart-count', String(count)); if('hidden' in el) el.hidden = (count===0); el.classList.toggle('is-empty', count===0);\n        });\n      }catch(_){}\n    }\n    async function refreshSectionsAndCounts(sectionIds){\n      try{\n        if(sectionIds && sectionIds.length){\n          var secRes = await fetch('/?sections=' + encodeURIComponent(sectionIds.join(',')), { headers:{'Accept':'application/json'} });\n          var secJson = await secRes.json(); applySectionsHTML(secJson);\n        }\n      }catch(_){}\n      try{\n        var cartRes = await fetch('/cart.js', { headers:{'Accept':'application/json'} });\n        var cartJson = await cartRes.json(); var count = cartJson && typeof cartJson.item_count==='number' ? cartJson.item_count : 0;\n        updateHeaderBubbles(count);\n      }catch(_){}\n    }\n\n    var atcBtn=document.getElementById('scx-atc-btn-{{ product.id }}');\n    atcBtn && atcBtn.addEventListener('click', async function(e){\n      e.preventDefault(); var btn=this; if(btn.disabled) return;\n      btn.disabled=true; btn.setAttribute('aria-busy','true'); btn.classList.add('loading');\n      var sectionIds = detectCartSectionIds();\n      try{\n        var fd=new FormData(mainForm);\n        var idField=fd.get('id') || (mainForm.querySelector('input[name=\"id\"]')||{}).value;\n        if(!fd.get('id') && idField){ fd.set('id', idField); }\n        if(!fd.get('quantity')){ fd.set('quantity','1'); }\n        if(sectionIds.length){ fd.set('sections', sectionIds.join(',')); fd.set('sections_url', window.location.pathname); }\n        var res = await fetch('/cart/add.js',{ method:'POST', headers:{'Accept':'application/json'}, body:fd, credentials:'same-origin' });\n        var data = null; try{ data = await res.json(); }catch(_){}\n        if(data && data.sections){ applySectionsHTML(data.sections); }\n        await refreshSectionsAndCounts(sectionIds);\n        openDrawerFallback();\n      }catch(_){ }\n      finally{\n        btn.disabled=false; btn.removeAttribute('aria-busy'); btn.classList.remove('loading');\n        setByCurrentVariant();\n      }\n    });\n\n    \n    var btn = document.getElementById('scx-atc-btn-{{ product.id }}');\n    function placeInsideCTA(){\n      var pill=document.querySelector('#scx-stickyp-{{ product.id }} [data-scsp-pill]');\n      var price=document.getElementById('scx-price-{{ product.id }}');\n      if(!btn||!pill||!price) return;\n      if(pill.parentNode!==btn) btn.appendChild(pill);\n      if(price.parentNode!==btn) btn.appendChild(price);\n      price.style.position='absolute'; price.style.right='10px'; price.style.top='50%'; price.style.transform='translateY(-50%)';\n      pill.style.position='absolute'; pill.style.left='8px'; pill.style.top='50%'; pill.style.transform='translateY(-50%) scale(.88)'; pill.style.transformOrigin='left center';\n      scheduleLayout();\n    }\n    function measureAndPad(){\n      if(!btn) return;\n      var pill=btn.querySelector('[data-scsp-pill]'); var price=btn.querySelector('#scx-price-{{ product.id }}');\n      var leftW=(pill && pill.style.display!=='none') ? pill.getBoundingClientRect().width : 0;\n      var rightW=price ? price.getBoundingClientRect().width : 0;\n      var btnW = btn.getBoundingClientRect().width || 0;\n      var maxSide = Math.max(56, Math.floor(btnW * 0.40));\n      var leftPad = Math.min(maxSide, Math.max(18, Math.ceil(leftW) + 14));\n      var rightPad= Math.min(maxSide, Math.max(18, Math.ceil(rightW) + 14));\n      bar.style.setProperty('--cta-left-pad', leftPad + 'px'); bar.style.setProperty('--cta-right-pad', rightPad + 'px');\n    }\n    function adjustAtcLabel(){\n      if(!btn) return;\n      var label = btn.querySelector('.scx-atc-label'); if(!label) return;\n      var leftPad = parseFloat(getComputedStyle(bar).getPropertyValue('--cta-left-pad')) || 0;\n      var rightPad = parseFloat(getComputedStyle(bar).getPropertyValue('--cta-right-pad')) || 0;\n      var avail = (btn.getBoundingClientRect().width || 0) - leftPad - rightPad - 10;\n      var measure = label.getBoundingClientRect().width || 0; var scale = 1;\n      if(avail > 0 && measure > 0 && measure > avail){ scale = Math.max(0.70, Math.min(1, avail / measure)); }\n      btn.style.setProperty('--label-scale', String(scale));\n    }\n    var _raf=0; function scheduleLayout(){ if(_raf) cancelAnimationFrame(_raf); _raf = requestAnimationFrame(function(){ measureAndPad(); adjustAtcLabel(); _raf = 0; }); }\n    placeInsideCTA(); window.addEventListener('resize', scheduleLayout, {passive:true});\n\n    \n    function setShipCountry(){\n      var el=document.getElementById('scx-ship-item-{{ product.id }}'); if(!el) return;\n      var iso=(el.getAttribute('data-iso')||'AU').toUpperCase();\n      var map={ 'GB':'UK','US':'US','AU':'AU','CA':'CA','NZ':'NZ','IE':'IE','DE':'DE','FR':'FR','NL':'NL','SE':'SE' };\n      var out=map[iso]||iso; var tgt=el.querySelector('.js-ship-country'); if(tgt){ tgt.textContent=out; }\n    }\n    setShipCountry(); window.addEventListener('localization:updated', setShipCountry, {capture:true}); window.addEventListener('country:changed', setShipCountry, {capture:true});\n\n    \n    function bumpZ(el){ try{ el && el.style && el.style.setProperty('z-index','2147483647','important'); }catch(_){ } }\n    function findMediaOverlays(){ return [].slice.call(document.querySelectorAll('.pswp, .pswp--open, .fancybox__container,dialog[open][id*=\"ProductModal\"], #ProductModal[open],.media-modal[open], .product-media-modal[open], .modal--product[open], .product__modal[open]')); }\n    function elevateMediaOverlays(){ findMediaOverlays().forEach(bumpZ); }\n    elevateMediaOverlays(); new MutationObserver(elevateMediaOverlays).observe(document.body,{subtree:true,childList:true,attributes:true,attributeFilter:['class','open','style']});\n    window.addEventListener('shopify:section:load', elevateMediaOverlays, {capture:true});\n  }\n\n  \n  if(!window.__scxStickyBoot){\n    window.__scxStickyBoot = true;\n    var booted=false; function boot(){ if(booted) return; booted=true; try{ initSticky(); }catch(_){} }\n    ['pointerdown','touchstart','keydown','scroll'].forEach(function(ev){ window.addEventListener(ev, boot, {once:true, passive:true}); });\n    if('requestIdleCallback' in window){ requestIdleCallback(boot, {timeout:1800}); } else { setTimeout(boot, 1800); }\n    if(document.readyState === 'complete'){ boot(); } else { window.addEventListener('load', boot, {once:true}); }\n  }\n})();\n</script>",
