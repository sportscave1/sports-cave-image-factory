        "custom_liquid_9hztnx": {
          "type": "custom-liquid",
          "name": "REDUCTION RRP PILL HTML",
          "disabled": true,
          "settings": {
            "custom_liquid": "{%- assign v = product.selected_or_first_available_variant -%}\n{%- assign pct_off = 0 -%}\n{%- if v and v.compare_at_price > v.price -%}\n  {%- assign pct_off = v.compare_at_price | minus: v.price | times: 100 | divided_by: v.compare_at_price -%}\n{%- endif -%}\n\n<!-- ========== SPORTS CAVE • % OFF PILL (v3.9 — self-scoped, collision-safe) ========== -->\n<div class=\"scx-pill-rail\" data-scx-pill data-product-id=\"{{ product.id }}\" aria-live=\"polite\">\n  <div class=\"scx-pill\" data-sale-pill {% unless pct_off > 0 %}style=\"display:none\"{% endunless %}>\n    <span class=\"scx-pill__num\">{% if pct_off > 0 %}{{ pct_off }}% OFF{% endif %}</span>\n    <span class=\"scx-pill__tag\" aria-hidden=\"true\">SALE</span>\n  </div>\n\n  <!-- Local variants JSON (instance-scoped, no global IDs) -->\n  <script type=\"application/json\" data-scx-variants>\n  [\n    {%- for variant in product.variants -%}\n      {\"id\":{{ variant.id }},\"price\":{{ variant.price | default: 0 }},\"compare_at_price\":{{ variant.compare_at_price | default: 0 }} }{% unless forloop.last %},{% endunless %}\n    {%- endfor -%}\n  ]\n  </script>\n</div>\n\n<style>\n\n.scx-pill-rail{\n  --pill-bg:#F7A007;\n  --pill-ink:#0D0D0D;\n  --pill-overlap:.50em;\n  --pill-top-adjust:2px;\n  --pill-inset-x:16px;\n  --pad-extra:12px;\n  --tag-overlap:4px;\n  position:relative;\n  height:0;\n  pointer-events:none;\n  z-index:999; \n}\n.scx-pill-rail .scx-pill{\n  position:absolute;\n  right:calc(var(--pill-inset-x) + var(--pad-extra));\n  left:auto;\n  top:calc((0px - var(--pill-overlap)) + var(--pill-top-adjust));\n  display:grid; place-items:center; text-align:center;\n  padding:.40em .82em; border-radius:999px; min-width:112px;\n  background:linear-gradient(180deg, rgba(255,255,255,.22), rgba(255,255,255,0) 55%), var(--pill-bg);\n  color:var(--pill-ink);\n  font:900 .92rem/1 Montserrat,system-ui,sans-serif; letter-spacing:.03em; text-transform:uppercase; white-space:nowrap;\n  box-shadow:0 10px 22px rgba(0,0,0,.22), 0 2px 7px rgba(0,0,0,.18), inset 0 0 0 1px color-mix(in srgb,#000 22%,var(--pill-bg) 78%);\n  border:1px solid color-mix(in srgb,#000 18%,var(--pill-bg) 82%);\n}\n.scx-pill-rail .scx-pill__num{ transform:translateY(.01em); }\n.scx-pill-rail .scx-pill__tag{\n  position:absolute; left:50%; top:100%;\n  transform:translate(-50%, calc(-1 * var(--tag-overlap)));\n  padding:.18em .56em; border-radius:999px;\n  background:#0B0B0B; color:var(--sc-brand-ivory); border:1px solid rgba(247,160,7,.55);\n  box-shadow:0 4px 10px rgba(0,0,0,.18), inset 0 1px 0 rgba(255,255,255,.08);\n  font:900 .60rem/1 Montserrat,system-ui,sans-serif; letter-spacing:.14em; pointer-events:none;\n}\n@media (max-width:740px){\n  .scx-pill-rail{ --pill-overlap:.44em; --pad-extra:10px; --tag-overlap:3px; }\n  .scx-pill-rail .scx-pill{ padding:.34em .70em; font-size:.86rem; min-width:104px; }\n  .scx-pill-rail .scx-pill__tag{ font-size:.58rem; letter-spacing:.12em; }\n}\n</style>\n\n<script>\n\n(function(){\n  // Init every instance separately (no IDs → no collisions)\n  var rails = document.querySelectorAll('[data-scx-pill]');\n  if(!rails.length) return;\n\n  rails.forEach(function(rail){\n    if(rail.__scxInit) return; // guard\n    rail.__scxInit = true;\n\n    var pill  = rail.querySelector('[data-sale-pill]');\n    var numEl = pill ? pill.querySelector('.scx-pill__num') : null;\n    var localJsonEl = rail.querySelector('script[data-scx-variants]');\n    var productId = Number(rail.getAttribute('data-product-id')) || null;\n\n    if(!pill || !numEl || !localJsonEl) return;\n\n    // Local variants (scoped to THIS pill only)\n    var VARIANTS = [];\n    try { VARIANTS = JSON.parse(localJsonEl.textContent || '[]') || []; } catch(e){ VARIANTS = []; }\n    var VARSET = new Set(VARIANTS.map(function(v){ return Number(v.id); }));\n\n    // Read current variant ID safely, preferring any source that resolves to one of our VARIANTS\n    function getCurrentVariantId(){\n      // 1) Theme analytics (fast), but only if it belongs to this product\n      try{\n        var s = window.ShopifyAnalytics && ShopifyAnalytics.meta;\n        if(s && s.product && Number(s.product.id) === productId && s.selectedVariantId && VARSET.has(Number(s.selectedVariantId))){\n          return Number(s.selectedVariantId);\n        }\n      }catch(e){}\n\n      // 2) Nearest form first (keeps it scoped to this area)\n      var form = rail.closest('form[action*=\"/cart/add\"]');\n      if(form){\n        var hid = form.querySelector('input[name=\"id\"][type=\"hidden\"]');\n        if(hid && VARSET.has(Number(hid.value))) return Number(hid.value);\n\n        var sel = form.querySelector('select[name=\"id\"]');\n        if(sel && VARSET.has(Number(sel.value))) return Number(sel.value);\n\n        var radio = form.querySelector('input[name=\"id\"][type=\"radio\"]:checked');\n        if(radio && VARSET.has(Number(radio.value))) return Number(radio.value);\n      }\n\n      // 3) Fall back to ANY matching input on page that belongs to our product’s variants\n      var any = document.querySelectorAll('input[name=\"id\"], select[name=\"id\"]');\n      for(var i=0;i<any.length;i++){\n        var v = Number(any[i].value);\n        if(VARSET.has(v)) return v;\n      }\n\n      // 4) URL ?variant=\n      var vqs = new URLSearchParams(location.search).get('variant');\n      if(vqs && VARSET.has(Number(vqs))) return Number(vqs);\n\n      // 5) Default to first variant in our set\n      return VARIANTS.length ? Number(VARIANTS[0].id) : null;\n    }\n\n    function byId(id){\n      id = Number(id);\n      for(var i=0;i<VARIANTS.length;i++){ if(Number(VARIANTS[i].id)===id) return VARIANTS[i]; }\n      return null;\n    }\n\n    function render(variant){\n      if(!variant){ pill.style.display = 'none'; numEl.textContent=''; return; }\n      var cmp = Number(variant.compare_at_price || 0);\n      var prc = Number(variant.price || 0);\n\n      if(cmp > prc && prc > 0){\n        var pct = Math.round((cmp - prc) * 100 / cmp);\n        numEl.textContent = pct + '% OFF';\n        pill.style.display = ''; // show (don’t remove from DOM)\n      }else{\n        pill.style.display = 'none'; // hide but keep mounted\n        numEl.textContent = '';\n      }\n    }\n\n    function setInset(){\n      // Try to align with the nearest width container (local scope only)\n      var container = rail.closest('.container, .page-width, .content, .container--flush');\n      var inset = 16, vw = document.documentElement.clientWidth;\n      if(container){\n        var r = container.getBoundingClientRect();\n        var gutter = Math.max(0, vw - (r.left + r.width));\n        inset = Math.max(10, Math.min(40, gutter + 8));\n      }\n      rail.style.setProperty('--pill-inset-x', inset + 'px');\n    }\n\n    // Color sync with the previous sibling (local only; safe if absent)\n    (function(){\n      var prev = rail.previousElementSibling;\n      if(!prev) return;\n      try{\n        var priceColor = getComputedStyle(prev).color;\n        if(priceColor) rail.style.setProperty('--pill-bg', priceColor);\n      }catch(e){}\n    })();\n\n    // Lightweight, collision-safe listeners\n    function update(){ requestAnimationFrame(function(){ render(byId(getCurrentVariantId())); setInset(); }); }\n\n    // Theme events (will fire once per instance; scoped by our guards)\n    ['variant:change','product:variant-change','variantChange','theme:variant:change']\n      .forEach(function(evt){ document.addEventListener(evt, update); });\n\n    // Local form changes\n    var localForm = rail.closest('form[action*=\"/cart/add\"]');\n    if(localForm){\n      localForm.addEventListener('change', update, true);\n      localForm.addEventListener('input',  function(e){ if(e && e.target && e.target.name==='id') update(); }, true);\n    }\n\n    // URL variant changes\n    ['pushState','replaceState'].forEach(function(key){\n      var orig = history[key];\n      history[key] = function(){ var ret = orig.apply(this, arguments); update(); return ret; };\n    });\n    window.addEventListener('popstate', update);\n    window.addEventListener('resize', setInset);\n\n    // First paint\n    update();\n  });\n})();\n</script>",
