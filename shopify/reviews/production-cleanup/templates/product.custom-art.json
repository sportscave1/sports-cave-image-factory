        "custom_liquid_tiTtcd": {
          "type": "custom-liquid",
          "name": "Trust Icons html",
          "disabled": true,
          "settings": {
            "custom_liquid": "{%- comment -%} SPORTS CAVE • Trust micro-badges v7 (mobile: 2-line labels, icons inline; desktop: single-line) {%- endcomment -%}\n<div id=\"sc-pills-{{ product.id }}\" class=\"sc-pills\" role=\"group\" aria-label=\"Store guarantees\">\n  <ul class=\"sc-pills__row\" role=\"list\">\n    <!-- Badge 1 -->\n    <li class=\"sc-pill\" role=\"listitem\" aria-label=\"Over one thousand happy customers\">\n      <span class=\"sc-pill__icon\" aria-hidden=\"true\">\n        <!-- Smile -->\n        <svg viewBox=\"0 0 24 24\" width=\"14\" height=\"14\" fill=\"none\" stroke=\"#0e0e0e\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n          <circle cx=\"12\" cy=\"12\" r=\"9\"></circle>\n          <path d=\"M8.5 10.5h.01M15.5 10.5h.01M8.2 14.2c1.1 1 2.4 1.5 3.8 1.5s2.7-.5 3.8-1.5\"></path>\n        </svg>\n      </span>\n      <span class=\"sc-pill__label\"><strong>1,000+ happy</strong> customers</span>\n    </li>\n\n    <!-- Badge 2 -->\n    <li class=\"sc-pill\" role=\"listitem\" aria-label=\"Thirty day guarantee\">\n      <span class=\"sc-pill__icon\" aria-hidden=\"true\">\n        <!-- Shield + check -->\n        <svg viewBox=\"0 0 24 24\" width=\"14\" height=\"14\" fill=\"none\" stroke=\"#0e0e0e\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n          <path d=\"M12 3l7 3v5c0 5-3.5 8-7 10-3.5-2-7-5-7-10V6l7-3z\"></path>\n          <path d=\"M9 12l2 2 4-4\"></path>\n        </svg>\n      </span>\n      <span class=\"sc-pill__label\"><strong>30&#8209;day</strong> guarantee</span>\n    </li>\n  </ul>\n</div>\n\n<style>\n  \n  #sc-pills-{{ product.id }}.sc-pills{\n    --gold:#F7A007;\n    --ink:#0e0e0e;\n    --hairline:rgba(0,0,0,.14);\n    --surface:rgba(255,255,255,.58);\n    --icon:22px;                \n    --gap:8px;\n    --pad-y:6px; --pad-x:10px;\n    --fz:clamp(11px, 3.3vw, 14px);\n    font:var(--fz)/1.2 \"Montserrat\",system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif;\n    color:var(--ink);\n    margin:6px 0 0;\n  }\n\n  \n  .sc-pills__row{\n    display:flex; align-items:stretch; gap:var(--gap);\n    flex-wrap:nowrap; width:100%;\n    padding:0; margin:0; list-style:none;\n  }\n\n  \n  .sc-pill{\n    flex:1 1 0; min-width:0;\n    display:inline-flex; gap:8px;\n    padding:var(--pad-y) var(--pad-x);\n    border:1px solid var(--hairline);\n    border-radius:9999px;\n    background:var(--surface);\n    -webkit-backdrop-filter:saturate(140%) blur(2px);\n            backdrop-filter:saturate(140%) blur(2px);\n  }\n\n  .sc-pill__icon{\n    width:var(--icon); height:var(--icon);\n    border-radius:9999px; background:var(--gold);\n    display:inline-flex; align-items:center; justify-content:center;\n    flex:0 0 var(--icon);\n    box-shadow:0 1px 3px rgba(247,160,7,.22);\n  }\n  .sc-pill__icon svg{ width:14px; height:14px; display:block }\n\n  .sc-pill__label{ font-weight:600; white-space:nowrap }\n  .sc-pill__label strong{ font-weight:700 }\n\n  \n  @media (max-width: 480px){\n    .sc-pill{ align-items:flex-start }              \n    .sc-pill__label{\n      white-space:normal;                           \n      line-height:1.06;                             \n      display:-webkit-box;                          \n      -webkit-line-clamp:2;\n      -webkit-box-orient:vertical;\n      overflow:hidden;\n    }\n  }\n\n  \n  @media (min-width: 992px){\n    #sc-pills-{{ product.id }}.sc-pills{ font-size:14px }\n    .sc-pill{ align-items:center }\n    .sc-pill__label{ white-space:nowrap }\n  }\n\n  \n  .theme-dark #sc-pills-{{ product.id }}.sc-pills{\n    --hairline:rgba(255,255,255,.16);\n    --surface:rgba(18,18,18,.55);\n    color:#f1f1f1;\n  }\n</style>",
