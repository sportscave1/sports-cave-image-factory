        "custom_liquid_UKBQjn": {
          "type": "custom-liquid",
          "name": "Description HTML",
          "disabled": true,
          "settings": {
            "custom_liquid": "{%- if product.description != blank -%}\n<!-- SPORTS CAVE • Product Description — v15.1 (4-line clamp, minimal toggle, debugged) -->\n<section id=\"scx-desc\" class=\"scx-desc is-collapsed\" role=\"region\" aria-label=\"Product description\" itemprop=\"description\">\n  <header class=\"scx-desc__head\">\n    <h2 class=\"scx-desc__title\">OWN THE MOMENT</h2>\n  </header>\n\n  <div class=\"scx-desc__rte rte\" id=\"scx-desc-body-{{ product.id }}\">\n    {{ product.description }}\n  </div>\n\n  <button\n    type=\"button\"\n    class=\"scx-desc__toggle\"\n    aria-controls=\"scx-desc-body-{{ product.id }}\"\n    aria-expanded=\"false\"\n  >\n    <svg class=\"scx-desc__chev\" viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n      <path d=\"M6 9l6 6 6-6\"></path>\n    </svg>\n    <span class=\"scx-desc__label\">More</span>\n  </button>\n</section>\n{%- endif -%}\n\n<style>\n#scx-desc.scx-desc{\n  --ink:#121212; --gold:#F7A007; --hairline:rgba(0,0,0,.14);\n  --fade:linear-gradient(180deg, rgba(255,255,255,0) 0%, rgba(255,255,255,.75) 70%, rgba(255,255,255,1) 100%);\n  margin:10px auto 0; padding:0 10px; max-width:980px;\n  content-visibility:auto; contain:layout paint style;\n  font-family:var(--sc-font-ui);\n}\n\n\n.scx-desc__head{ margin:2px 0 6px }\n.scx-desc__title{\n  position:relative; display:inline-block; padding-left:12px; margin:0;\n  font-weight:700; font-size:clamp(15px,1.55vw,18px); letter-spacing:.06em; text-transform:uppercase; color:var(--ink);\n}\n.scx-desc__title:before{\n  content:\"\"; position:absolute; left:0; top:50%; transform:translateY(-50%);\n  width:6px; height:6px; border-radius:9999px; background:var(--gold);\n}\n\n\n.scx-desc__rte{ position:relative; color:var(--ink); max-width:62ch; padding-left:14px }\n.scx-desc__rte:before{\n  content:\"\"; position:absolute; left:0; top:.25rem; bottom:.25rem; width:2px; border-radius:2px;\n  background:linear-gradient(180deg,var(--gold),rgba(247,160,7,.55));\n}\n.scx-desc__rte > p:first-child{ font-weight:500; letter-spacing:.0025em; text-wrap:balance; margin-top:0 }\n.scx-desc__rte p{\n  margin:0 0 8px; font-weight:500; font-size:clamp(15px,1.4vw,16px); line-height:1.55;\n  hyphens:none; word-break:normal; overflow-wrap:normal; text-wrap:pretty;\n}\n.scx-desc__rte strong, .scx-desc__rte b{ font-weight:600 }\n\n\n#scx-desc.is-collapsed .scx-desc__rte{\n  display:-webkit-box; -webkit-box-orient:vertical; -webkit-line-clamp:4; overflow:hidden; position:relative;\n}\n#scx-desc.is-collapsed .scx-desc__rte:after{\n  content:\"\"; position:absolute; left:0; right:0; bottom:0; height:2.4rem; background:var(--fade);\n}\n\n\n.scx-desc__toggle{\n  display:inline-flex; align-items:center; gap:6px; margin:.5rem 0 0 14px;\n  padding:6px 10px; font-size:13.5px; font-weight:700; letter-spacing:.02em; color:var(--ink);\n  background:transparent; border:1px solid var(--hairline); border-radius:9999px; cursor:pointer;\n  transition:background-color .18s ease, transform .18s ease;\n}\n.scx-desc__toggle:hover{ background:rgba(0,0,0,.035) }\n.scx-desc__toggle:active{ transform:translateY(1px) }\n\n.scx-desc__chev{\n  width:14px; height:14px; stroke:var(--gold); fill:none; stroke-width:2; stroke-linecap:round; stroke-linejoin:round;\n  transition:transform .18s ease;\n}\n#scx-desc:not(.is-collapsed) .scx-desc__chev{ transform:rotate(180deg) }\n\n.scx-desc__label{ line-height:1 }\n\n.scx-desc__label::before, .scx-desc__label::after{ content:none !important }\n\n\n@media (max-width:720px){\n  #scx-desc.scx-desc{ max-width:100%; padding:0 10px; margin-top:8px }\n  .scx-desc__rte{ max-width:none }\n  .scx-desc__rte p{ margin:0 0 7px; line-height:1.52 }\n  .scx-desc__rte:before{ top:.2rem; bottom:.2rem }\n}\n\n\n@media (prefers-reduced-motion:reduce){\n  .scx-desc__chev, .scx-desc__toggle{ transition:none }\n}\n</style>\n\n<script>\n\n(function(){\n  var root = document.getElementById('scx-desc');\n  if(!root) return;\n\n  var body  = root.querySelector('.scx-desc__rte');\n  var btn   = root.querySelector('.scx-desc__toggle');\n  var label = root.querySelector('.scx-desc__label');\n\n  // Lazy images\n  body.querySelectorAll('img:not([loading])').forEach(function(img){\n    img.loading='lazy'; img.decoding='async';\n  });\n\n  function calcNeedsToggle(){\n    // measure unclamped height vs clamped height\n    root.classList.remove('is-collapsed');\n    var full = body.scrollHeight;\n    root.classList.add('is-collapsed');\n    var clamped = body.clientHeight;\n    return (full - clamped) > 8;\n  }\n\n  function setState(collapsed){\n    root.classList.toggle('is-collapsed', collapsed);\n    var expanded = !collapsed;\n    btn.setAttribute('aria-expanded', String(expanded));\n    // Single source of truth for label text\n    label.textContent = expanded ? 'Less' : 'More';\n  }\n\n  // Initialize\n  if (!calcNeedsToggle()){\n    btn.style.display = 'none';\n    setState(false); // show full content if short\n  } else {\n    setState(true);  // start collapsed\n  }\n\n  // Click handler\n  btn.addEventListener('click', function(){\n    setState(root.classList.contains('is-collapsed') ? false : true);\n  }, { passive:true });\n\n})();\n</script>",
            "show_in_quickbuy": true
          }
        },
