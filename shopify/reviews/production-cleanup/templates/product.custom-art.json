        "custom_liquid_XBjNDg": {
          "type": "custom-liquid",
          "name": "inventory html",
          "disabled": true,
          "settings": {
            "custom_liquid": "<!-- ========== SPORTS CAVE • Limited Release Banner (stand-alone CUSTOM HTML) ========== -->\n<!-- Drop this into a “Custom liquid/HTML” block on the product page. No product-inventory element needed. -->\n\n<div id=\"sc-limit-{{ section.id }}\" class=\"sc-inv-banner\"\n     data-edition-total=\"100\"          <!-- ← change if your edition size differs -->\n     data-inventory-threshold=\"5\"      <!-- ← when qty ≤ threshold, show “Limited stock” -->\n     data-current-id=\"{{ product.selected_or_first_available_variant.id }}\"\n     data-current-qty=\"{{ product.selected_or_first_available_variant.inventory_quantity | default: 0 }}\">\n\n  <div class=\"sc-card\" role=\"status\" aria-live=\"polite\">\n    <!-- Stopwatch icon -->\n    <svg class=\"sc-ico\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\">\n      <defs>\n        <linearGradient id=\"scGold\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n          <stop offset=\"0\" stop-color=\"#d9bd6a\"/><stop offset=\"1\" stop-color=\"#c6a04f\"/>\n        </linearGradient>\n      </defs>\n      <circle cx=\"12\" cy=\"13\" r=\"7.5\" fill=\"#d7efe0\" stroke=\"url(#scGold)\" stroke-width=\"1.5\"/>\n      <path d=\"M12 9v4l3 2\" fill=\"none\" stroke=\"#1a1a1a\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.8\"/>\n      <rect x=\"10\" y=\"3\" width=\"4\" height=\"2.5\" rx=\"0.6\" fill=\"url(#scGold)\"/>\n      <path d=\"M16.5 6.5l1.5-1.5M7.5 6.5L6 5\" stroke=\"url(#scGold)\" stroke-width=\"1.4\" stroke-linecap=\"round\"/>\n    </svg>\n\n    <div class=\"sc-copy\">\n      <div class=\"sc-head\">LIMITED RELEASE! Edition of <span class=\"js-edition\">100</span></div>\n      <div class=\"sc-sub\">Limited stock — don’t miss out.</div>\n    </div>\n  </div>\n\n  {%- comment -%} Variant inventory map for this product (only >0 shown) {%- endcomment -%}\n  {%- capture quantity_json -%}\n    {%- for variant in product.variants -%}\n      {%- if variant.inventory_management != blank and variant.inventory_quantity > 0 -%}\n        ,{ \"id\":{{- variant.id -}}, \"inventory_quantity\":{{- variant.inventory_quantity -}} }\n      {%- endif -%}\n    {%- endfor -%}\n  {%- endcapture -%}\n  <script type=\"application/json\" class=\"sc-inv-data\">[{{- quantity_json | replace_first: ',', '' -}}]</script>\n</div>\n\n<style>\n\n.sc-inv-banner{\n  --bg:#F4EFE3;          \n  --border:#c6a04f;      \n  --ink:#111;            \n  --muted:#4f4f4f;       \n  --shadow:0 4px 14px rgba(0,0,0,.08);\n  font-family:var(--sc-font-ui);\n}\n\n.sc-inv-banner .sc-card{\n  display:flex; align-items:center; gap:12px;\n  background:var(--bg);\n  border:1.5px solid var(--border);\n  border-radius:4px;\n  padding:10px 12px;\n  box-shadow:var(--shadow);\n  margin: -5px 0 8px;   \n}\n\n.sc-inv-banner .sc-ico{ width:24px; height:24px; flex:0 0 24px; display:block; }\n.sc-inv-banner .sc-copy{ line-height:1.15; }\n.sc-inv-banner .sc-head{ font-size:14px; font-weight:700; color:var(--ink); letter-spacing:.2px; }\n.sc-inv-banner .sc-sub{ margin-top:2px; font-size:12.5px; color:var(--muted); font-weight:600; }\n\n.sc-inv-banner .sc-card.low{ outline:1px solid rgba(198,160,79,.35); }\n.sc-inv-banner .sc-card.hidden{ display:none !important; }\n\n@media (max-width:520px){\n  .sc-inv-banner .sc-card{ padding:9px 10px; gap:10px; }\n  .sc-inv-banner .sc-head{ font-size:13.5px; }\n  .sc-inv-banner .sc-sub{ font-size:12px; }\n}\n</style>\n\n<script>\n\n(function(){\n  const root = document.getElementById('sc-limit-{{ section.id }}'); if(!root) return;\n\n  const card = root.querySelector('.sc-card');\n  const headEdition = root.querySelector('.js-edition');\n  const sub  = root.querySelector('.sc-sub');\n\n  const editionTotal = Number(root.getAttribute('data-edition-total') || '100');\n  const threshold    = Number(root.getAttribute('data-inventory-threshold') || '5');\n  headEdition && (headEdition.textContent = editionTotal);\n\n  // Build qty map from embedded JSON\n  let qtyMap = {};\n  try{\n    const json = root.querySelector('.sc-inv-data')?.textContent || '[]';\n    qtyMap = JSON.parse(json).reduce((m,o)=>{ m[o.id]=o.inventory_quantity; return m; }, {});\n  }catch(e){ qtyMap = {}; }\n\n  function update(qty){\n    if(!card) return;\n    if(!qty || qty < 1){ card.classList.add('hidden'); return; }\n    card.classList.remove('hidden');\n    card.classList.toggle('low', qty <= threshold);\n    sub.textContent = (qty <= threshold)\n      ? 'Limited stock — don’t miss out.'\n      : 'Get it before it’s gone!';\n  }\n\n  // Initial state\n  const initialId  = Number(root.getAttribute('data-current-id') || '0');\n  const initialQty = Number(root.getAttribute('data-current-qty') || qtyMap[initialId] || 0);\n  update(initialQty);\n\n  // Listen for theme variant events + input changes\n  const onVariant = (e)=>{\n    const v = e?.detail?.variant;\n    if(v && v.id){ update(Number(qtyMap[v.id] || 0)); }\n  };\n  document.addEventListener('variant:change', onVariant, {passive:true, capture:true});\n  document.addEventListener('product:variant-change', onVariant, {passive:true, capture:true});\n\n  const scope   = document.querySelector('[id^=\"ProductInfo-\"]') || document;\n  const idInput = scope.querySelector('form[action*=\"/cart/add\"] input[name=\"id\"]');\n  if(idInput){\n    const sync = ()=>{ const vid = Number(idInput.value); if(vid) update(Number(qtyMap[vid] || 0)); };\n    new MutationObserver(sync).observe(idInput, {attributes:true, attributeFilter:['value']});\n    scope.addEventListener('change', sync, {passive:true, capture:true});\n    scope.addEventListener('input',  sync, {passive:true, capture:true});\n  }\n})();\n</script>",
            "show_in_quickbuy": false
          }
        },
        "custom_liquid_3qbQAY": {
          "type": "custom-liquid",
          "name": "Countdown Timer HTML",
          "settings": {
            "custom_liquid": "{% if product.compare_at_price_max > product.price %}\n<section\n  id=\"scx-countdown-{{ product.id }}\"\n  class=\"scx-countdown\"\n  data-market=\"{{ localization.country.iso_code | default: shop.address.country_code }}\"\n  data-shop-tz=\"{{ shop.timezone | escape }}\"\n  data-now=\"{{ 'now' | date: '%s' }}\"\n  role=\"region\"\n  aria-label=\"Sale countdown\">\n  <span class=\"scx-countdown__icon\" aria-hidden=\"true\">\n    <svg viewBox=\"0 0 64 64\" width=\"18\" height=\"18\" aria-hidden=\"true\" focusable=\"false\">\n      <circle cx=\"32\" cy=\"34\" r=\"20\" fill=\"none\" stroke=\"#F7A007\" stroke-width=\"2\"></circle>\n      <path d=\"M26 12h12\" stroke=\"#F7A007\" stroke-width=\"3\" stroke-linecap=\"round\"></path>\n      <path d=\"M32 22v12l9 6\" fill=\"none\" stroke=\"#FFFFFF\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path>\n    </svg>\n  </span>\n\n  <span class=\"scx-countdown__label\">35% Off Sale ends in</span>\n\n  <span class=\"scx-countdown__timer\" aria-live=\"polite\" role=\"timer\">\n    <b data-h>00</b><span class=\"u\">h</span>&nbsp;\n    <b data-m>00</b><span class=\"u\">m</span>&nbsp;\n    <b data-s>00</b><span class=\"u\">s</span>\n    <noscript> — sale ends tonight</noscript>\n  </span>\n</section>\n{% endif %}\n\n<style>\n  \n  .scx-countdown{\n    --bg:#0B0B0B; --ink:#FFFFFF; --gold:#F7A007; --ring:rgba(247,160,7,.28);\n    --r:14px; --pull-next:22px;\n    background:var(--bg); color:var(--ink);\n    border:1px solid var(--ring); border-radius:var(--r);\n    box-shadow:0 6px 14px rgba(0,0,0,.06), inset 0 1px 0 rgba(255,255,255,.04);\n    display:flex; align-items:center; gap:10px;\n    padding:6px 10px; width:100%; max-width:760px;\n    margin:-4px 0 calc(-1 * var(--pull-next));\n    font-family:inherit;\n    content-visibility:auto; contain:layout paint style;\n  }\n  .scx-countdown__icon{ display:inline-flex }\n  .scx-countdown__label{ font-weight:700; letter-spacing:.01em; font-size:14px; line-height:1.2; white-space:nowrap }\n  .scx-countdown__timer{\n    margin-left:auto; display:flex; align-items:center; gap:3px; white-space:nowrap;\n    font-size:14px; line-height:1.2; font-variant-numeric:tabular-nums;\n    -webkit-font-feature-settings:\"tnum\" 1; font-feature-settings:\"tnum\" 1;\n    will-change:contents;\n  }\n  .scx-countdown__timer b{\n    color:var(--gold); font-weight:700;\n    text-shadow:0 0 8px rgba(247,160,7,.35);\n    transition:text-shadow .2s ease, transform .2s ease;\n  }\n  .scx-countdown__timer .u{ opacity:.85 }\n\n  \n  .scx-countdown.is-hot{ border-color:rgba(247,160,7,.55) }\n  .scx-countdown.is-hot .scx-countdown__timer b{ text-shadow:0 0 10px rgba(247,160,7,.6) }\n  .scx-countdown.is-burning{ border-color:rgba(247,160,7,.85) }\n  .scx-countdown.is-burning .scx-countdown__timer b{ animation:scx-pulse 1s infinite }\n\n  @keyframes scx-pulse{\n    0%{ text-shadow:0 0 6px rgba(247,160,7,.5); transform:translateZ(0) }\n    50%{ text-shadow:0 0 16px rgba(247,160,7,.9); transform:translateZ(0) }\n    100%{ text-shadow:0 0 6px rgba(247,160,7,.5); transform:translateZ(0) }\n  }\n  @media (prefers-reduced-motion:reduce){\n    .scx-countdown.is-burning .scx-countdown__timer b{ animation:none }\n  }\n\n  @media (max-width:600px){\n    .scx-countdown{ padding:6px 8px; gap:8px; --pull-next:18px }\n    .scx-countdown__label{ font-size:13px }\n    .scx-countdown__timer{ font-size:13px }\n  }\n  @media (max-width:360px){ .scx-countdown__icon{ display:none } }\n\n  \n  .scx-countdown + .product-form,\n  .scx-countdown + .product-form__buttons,\n  .scx-countdown + form[action*=\"/cart\"],\n  .scx-countdown + * .product-form__buttons{ margin-top:6px !important }\n</style>\n\n<script>\n\n(function(){\n  var root = document.getElementById('scx-countdown-{{ product.id }}');\n  if(!root) return;\n\n  var hEl = root.querySelector('[data-h]');\n  var mEl = root.querySelector('[data-m]');\n  var sEl = root.querySelector('[data-s]');\n\n  var country = (root.getAttribute('data-market') || '').toUpperCase();\n  var shopTz  = root.getAttribute('data-shop-tz') || '';\n  var deviceTz = (Intl.DateTimeFormat().resolvedOptions().timeZone || '');\n  var serverNowSec = parseInt(root.getAttribute('data-now'), 10);\n  if (!isFinite(serverNowSec)) serverNowSec = Math.floor(Date.now()/1000);\n  var drift = Date.now() - (serverNowSec * 1000); // client - server; align to server clock\n  function nowMs(){ return Date.now() - drift; }\n\n  // Market → representative IANA time zone\n  var TZS = {\n    AU:'Australia/Sydney', NZ:'Pacific/Auckland',\n    GB:'Europe/London', IE:'Europe/Dublin',\n    US:'America/New_York', CA:'America/Toronto',\n    EU:'Europe/Berlin', DE:'Europe/Berlin', FR:'Europe/Paris', IT:'Europe/Rome',\n    ES:'Europe/Madrid', NL:'Europe/Amsterdam', BE:'Europe/Brussels',\n    DK:'Europe/Copenhagen', SE:'Europe/Stockholm', NO:'Europe/Oslo',\n    FI:'Europe/Helsinki', CH:'Europe/Zurich'\n  };\n\n  function pickTz(){\n    if (TZS[country]) return TZS[country];\n    if (deviceTz) return deviceTz;\n    if (shopTz) return shopTz;\n    return 'UTC';\n  }\n  var tz = pickTz();\n\n  // Get a Date representing \"now\" in the chosen tz (difference-based trick)\n  function tzNow(tz){\n    return new Date(new Date(nowMs()).toLocaleString('en-US', { timeZone: tz }));\n  }\n\n  // Compute absolute epoch for next midnight in tz, then convert to real epoch\n  function nextMidnightEpochMs(){\n    var n = tzNow(tz);           // \"fake local\" Date in tz\n    var end = new Date(n);       // clone\n    end.setHours(24,0,0,0);      // next day 00:00\n    var diff = end - n;          // ms left in that tz day\n    return nowMs() + diff;       // absolute target epoch\n  }\n\n  var target = nextMidnightEpochMs();\n\n  function pad2(n){ return n < 10 ? ('0'+n) : ''+n; }\n  var last = -1;\n\n  function tick(){\n    var secs = Math.max(0, ((target - nowMs())/1000) | 0);\n\n    if (secs !== last){\n      last = secs;\n      var h = (secs/3600)|0,\n          m = ((secs%3600)/60)|0,\n          s = (secs%60)|0;\n      if(hEl) hEl.textContent = pad2(h);\n      if(mEl) mEl.textContent = pad2(m);\n      if(sEl) sEl.textContent = pad2(s);\n\n      root.classList.toggle('is-hot', secs > 0 && secs <= 600);    // ≤ 10m\n      root.classList.toggle('is-burning', secs > 0 && secs <= 180);// ≤ 3m\n    }\n\n    if (secs > 0){\n      requestAnimationFrame(tick);\n    } else {\n      // New local day → roll target forward to next midnight again\n      target = nextMidnightEpochMs();\n      requestAnimationFrame(tick);\n    }\n  }\n\n  requestAnimationFrame(tick);\n})();\n</script>",
            "show_in_quickbuy": false
          }
        },
