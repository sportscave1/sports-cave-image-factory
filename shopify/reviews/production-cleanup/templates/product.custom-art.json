; grid-template-columns:1fr auto 1fr; align-items:center; column-gap:8px;\n  container-type:inline-size;\n  overflow-x:hidden; \n}\n#scx-titlebar-{{ product.id }} .scx-side{ min-width:0; }\n\n\n@media (max-width:480px){\n  #scx-titlebar-{{ product.id }} .scx-titlewrap{ padding-left:4px; padding-right:4px; column-gap:6px; }\n  #scx-titlebar-{{ product.id }} .scx-left .scx-badge{ display:none; }\n}\n\n\n#scx-titlebar-{{ product.id }} .scx-title{\n  justify-self:center; text-align:center;\n  font-family:\"Montserrat\",system-ui,-apple-system,\"Segoe UI\",Roboto,Arial,sans-serif;\n  font-weight:700; letter-spacing:.005em; line-height:1.08; \n  white-space:nowrap; max-width:100%;\n  padding-inline:1px; padding-block:1px; \n  color:var(--ink);\n  -webkit-text-stroke:0.28px var(--stroke);\n  text-shadow:0 .45px 0 rgba(0,0,0,.32);\n  font-size:clamp(10.5px, 5vw, 22px); \n  overflow:visible; text-overflow:clip; \n}\n@supports (font-size: clamp(1px, 1cqw, 2px)) {\n  #scx-titlebar-{{ product.id }} .scx-title{ font-size:clamp(10.5px, 4.8cqw, 22px); }\n}\n#scx-titlebar-{{ product.id }} .scx-title .scx-gold{\n  color:var(--gold);\n  -webkit-text-stroke:0 transparent;\n  text-shadow:0 .45px 0 rgba(0,0,0,.22);\n}\n\n\n#scx-titlebar-{{ product.id }} .scx-badge{\n  display:inline-flex; align-items:center; padding:1px 8px; border-radius:999px;\n  font:600 11px/1 \"Apple Chancery\",\"Snell Roundhand\",\"Segoe Script\",\"Lucida Handwriting\",\"Brush Script MT\",cursive;\n  background:linear-gradient(100deg,#FFF2C2 0%,#FFD77A 40%,#F7A007 70%,#8A5B12 100%);\n  color:#0B0B0B; border:1px solid rgba(138,91,18,.42);\n  box-shadow:0 4px 10px rgba(0,0,0,.10); white-space:nowrap;\n}\n\n\n@media (min-width:1200px){\n  #scx-titlebar-{{ product.id }}.scx-titlebar{ --pull-next:-30px; }\n\n  #scx-titlebar-{{ product.id }} + .breadcrumb,\n  #scx-titlebar-{{ product.id }} + .breadcrumbs,\n  #scx-titlebar-{{ product.id }} + nav.breadcrumbs,\n  #scx-titlebar-{{ product.id }} + .breadcrumb-wrapper,\n  #scx-titlebar-{{ product.id }} + .page-breadcrumbs,\n  #scx-titlebar-{{ product.id }} + .product__breadcrumbs,\n  #scx-titlebar-{{ product.id }} + [class*=\"bread\"]{\n    margin-top:0 !important;\n  }\n}\n</style>\n\n<script>\n\n(function(){\n  var ROOT='scx-titlebar-{{ product.id }}';\n\n  function visWidth(node){\n    if(!node) return 0;\n    var cs=getComputedStyle(node);\n    if(cs.display==='none' || cs.visibility==='hidden') return 0;\n    var r=node.getBoundingClientRect();\n    return Math.max(0, r.width || 0);\n  }\n\n  function fit(){\n    var wrap=document.querySelector('#'+ROOT+' .scx-titlewrap');\n    var title=document.querySelector('#'+ROOT+' .scx-title');\n    if(!wrap || !title) return;\n\n    // Reset any transforms/spacing from prior runs\n    title.style.transform='none';\n    title.style.letterSpacing='.005em';\n\n    var cs=getComputedStyle(wrap);\n    var padL=parseFloat(cs.paddingLeft)||0, padR=parseFloat(cs.paddingRight)||0;\n    var leftW=visWidth(wrap.querySelector('.scx-left'));\n    var rightW=visWidth(wrap.querySelector('.scx-right'));\n    var safety = (window.innerWidth<=480)? 6 : 10;\n\n    var containerW = wrap.clientWidth - padL - padR - leftW - rightW - safety;\n    containerW = Math.max(0, containerW);\n\n    // Start from computed size\n    var cur=parseFloat(getComputedStyle(title).fontSize)||22;\n    var min=(window.matchMedia('(max-width:480px)').matches? 9.0 : 10.5); // smaller floor on tight mobiles\n\n    // If already fits, bail early\n    if(title.scrollWidth <= containerW){ return; }\n\n    // Pass 1: proportional downscale\n    var scale=(containerW / title.scrollWidth) || 1;\n    var target=Math.max(min, Math.min(cur, cur * scale * 0.99));\n    if(target < cur){ cur = target; title.style.fontSize = cur.toFixed(2) + 'px'; }\n\n    // Pass 2: step down by small increments until it fits\n    var guard=0;\n    while(title.scrollWidth > containerW && cur > min && guard < 60){\n      cur -= 0.35;\n      title.style.fontSize = cur.toFixed(2) + 'px';\n      guard++;\n    }\n\n    // Pass 3: micro tighten tracking if still a hair over\n    if(title.scrollWidth > containerW){\n      title.style.letterSpacing='-0.02em';\n    }\n\n    // Absolute last resort on quirky Samsung rounding: tiny scale (visual only, no crop)\n    if(title.scrollWidth > containerW){\n      var s = Math.max(0.92, Math.min(1, containerW / title.scrollWidth));\n      title.style.transform='scale('+s+')';\n      title.style.transformOrigin='center center';\n    }\n  }\n\n  function schedule(){\n    fit();\n    // Retry after common reflows\n    setTimeout(fit, 120);\n    setTimeout(fit, 400);\n    setTimeout(fit, 900);\n    setTimeout(fit, 1400);\n  }\n\n  if(document.readyState!=='loading') schedule();\n  else document.addEventListener('DOMContentLoaded', schedule, {once:true});\n\n  if(document.fonts && document.fonts.ready){ document.fonts.ready.then(fit); }\n  window.addEventListener('load', fit, {once:true});\n\n  var tm; function deb(){ clearTimeout(tm); tm=setTimeout(fit, 120); }\n  window.addEventListener('resize', deb, {passive:true});\n  window.addEventListener('orientationchange', deb, {passive:true});\n  document.addEventListener('visibilitychange', function(){ if(!document.hidden) setTimeout(fit,60); });\n\n  if('ResizeObserver' in window){\n    var wrap=document.querySelector('#'+ROOT+' .scx-titlewrap');\n    if(wrap){ new ResizeObserver(function(){ deb(); }).observe(wrap); }\n  }\n})();\n</script>\n{% endif %}"
