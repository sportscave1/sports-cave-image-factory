            "code": "<!-- SPORTS CAVE • What You’ll Love (mobile-tuned, 2-up, shorter copy) -->\n<section class=\"scx-collector scx-collector--embedded\" role=\"region\" aria-label=\"What you'll love about this artwork\">\n  \n  <style>\n    \n    .scx-collector{\n      --gold:#F7A007; --ink:#EDEDED; --muted:#C7C7C7;\n      --panel:#0E0E0E; --stroke:#222; --radius:14px;\n      --shadow:0 10px 24px rgba(0,0,0,.18);\n      font-family:var(--sc-font-ui);\n    }\n    .scx-collector--embedded{ margin:10px 0 6px; padding:0; }\n\n    \n    .scx-collector .scx-con{\n      width:min(100%, 720px); margin:0 auto;\n      padding:14px 14px 12px;\n      background:\n        radial-gradient(140% 90% at 50% 0, #171717 0%, #101010 60%, #0C0C0C 100%),\n        var(--panel);\n      border:1px solid var(--stroke); border-radius:var(--radius);\n      box-shadow:var(--shadow), inset 0 1px 0 rgba(255,255,255,.02);\n      color:var(--ink);\n    }\n\n    \n    .scx-collector .scx-head{ text-align:left; margin:0 0 8px }\n    .scx-collector .scx-title{\n      margin:2px 0 4px;\n      font:900 clamp(22px,3.6vw,32px)/1.05 \"Montserrat\",system-ui,sans-serif;\n      text-transform:uppercase; letter-spacing:.02em;\n      background:linear-gradient(180deg,#F1D089 0%, #C9962D 58%, #B37E19 100%);\n      -webkit-background-clip:text; background-clip:text; color:transparent;\n    }\n    .scx-collector .scx-tag{\n      margin:0; font:700 clamp(12px,2vw,14px)/1.35 \"Montserrat\",system-ui,sans-serif; color:#E8E8E8;\n    }\n    .scx-collector .scx-underline{\n      display:block; height:2px; width:100%; max-width:520px; margin:10px 0 6px; border-radius:2px;\n      background:linear-gradient(90deg, transparent 0%, var(--gold) 12%, var(--gold) 88%, transparent 100%); opacity:.9;\n    }\n\n    \n    .scx-collector .scx-grid{\n      list-style:none; margin:6px 0 0; padding:0;\n      display:grid; gap:10px; grid-template-columns:repeat(2,minmax(0,1fr));\n    }\n    @media (min-width:900px){ .scx-collector .scx-grid{ gap:12px; } }\n\n    \n    .scx-collector .scx-item{\n      display:flex; align-items:center; gap:10px;\n      background:linear-gradient(180deg,#121212 0%, #0F0F0F 100%);\n      border:1px solid #1E1E1E; border-radius:12px; padding:10px 10px;\n      box-shadow: inset 0 0 0 1px rgba(255,255,255,.02);\n      min-height:64px;\n    }\n\n    \n    .scx-collector .scx-ico{\n      flex:0 0 46px; height:46px; display:grid; place-items:center; border-radius:12px;\n      background:linear-gradient(180deg, rgba(247,160,7,.12), rgba(247,160,7,0) 70%);\n      border:1.1px solid rgba(247,160,7,.55); box-shadow: inset 0 0 0 1px rgba(247,160,7,.18);\n    }\n    .scx-collector .scx-ico img{ width:24px; height:24px; object-fit:contain; display:block }\n\n    \n    .scx-collector .scx-copy strong{\n      display:block; color:#F7F7F7;\n      font:900 clamp(13.5px,2.3vw,15.5px)/1.15 \"Montserrat\",system-ui,sans-serif;\n      letter-spacing:.01em;\n    }\n    .scx-collector .scx-copy span{\n      display:block; margin-top:2px; color:var(--muted);\n      font:700 clamp(11.6px,2.1vw,13px)/1.33 \"Montserrat\",system-ui,sans-serif;\n    }\n\n    \n    .d-only{ display:block; } .m-only{ display:none; }\n    @media (max-width:720px){\n      .d-only{ display:none; } .m-only{ display:block; }\n    }\n\n    \n    @media (max-width:360px){\n      .scx-collector .scx-item{ padding:9px }\n      .scx-collector .scx-ico{ width:44px; height:44px }\n      .scx-collector .scx-copy strong{ font-size:13.5px }\n      .scx-collector .scx-copy span{ font-size:11.4px }\n    }\n  </style>\n\n  <div class=\"scx-con\">\n    <header class=\"scx-head\">\n      <h2 class=\"scx-title\">What You’ll Love</h2>\n      <p class=\"scx-tag\">Limited runs. Hand-crafted. Built to last.</p>\n      <span class=\"scx-underline\" aria-hidden=\"true\"></span>\n    </header>\n\n    <ul class=\"scx-grid\" role=\"list\">\n      <!-- 1 Fast dispatch -->\n      <li class=\"scx-item\" role=\"listitem\">\n        <span class=\"scx-ico\" aria-hidden=\"true\">\n          <img src=\"https://cdn.shopify.com/s/files/1/0722/2332/6515/files/fast-deliovery-icon.png?v=1758763561\" loading=\"lazy\" decoding=\"async\" alt=\"\">\n        </span>\n        <div class=\"scx-copy\">\n          <strong>Fast dispatch</strong>\n          <span class=\"m-only\"></span>\n          <span class=\"d-only\">2–8 business days.</span>\n        </div>\n      </li>\n\n      <!-- 2 Ready to hang -->\n      <li class=\"scx-item\" role=\"listitem\">\n        <span class=\"scx-ico\" aria-hidden=\"true\">\n          <img src=\"https://cdn.shopify.com/s/files/1/0722/2332/6515/files/hanging-wire-icon.png?v=1758763368\" loading=\"lazy\" decoding=\"async\" alt=\"\">\n        </span>\n        <div class=\"scx-copy\">\n          <strong>Ready to hang</strong>\n          <span class=\"m-only\">Hanging wire fitted.</span>\n          <span class=\"d-only\"></span>\n        </div>\n      </li>\n\n      <!-- 3 Fade-safe inks -->\n      <li class=\"scx-item\" role=\"listitem\">\n        <span class=\"scx-ico\" aria-hidden=\"true\">\n          <img src=\"https://cdn.shopify.com/s/files/1/0722/2332/6515/files/uv-icon.png?v=1758763386\" loading=\"lazy\" decoding=\"async\" alt=\"\">\n        </span>\n        <div class=\"scx-copy\">\n          <strong>Fade-safe inks</strong>\n          <span class=\"m-only\"></span>\n          <span class=\"d-only\">Archival pigments stay rich for years.</span>\n        </div>\n      </li>\n\n      <!-- 4 Gallery print -->\n      <li class=\"scx-item\" role=\"listitem\">\n        <span class=\"scx-ico\" aria-hidden=\"true\">\n          <img src=\"https://cdn.shopify.com/s/files/1/0722/2332/6515/files/gallery-icon.png?v=1758763369\" loading=\"lazy\" decoding=\"async\" alt=\"\">\n        </span>\n        <div class=\"scx-copy\">\n          <strong>Gallery print</strong>\n          <span class=\"m-only\"></span>\n          <span class=\"d-only\">200g museum-grade, glare-safe.</span>\n        </div>\n      </li>\n\n      <!-- 5 Securely packed -->\n      <li class=\"scx-item\" role=\"listitem\">\n        <span class=\"scx-ico\" aria-hidden=\"true\">\n          <img src=\"https://cdn.shopify.com/s/files/1/0722/2332/6515/files/Securely_Packaged_Icon_7caf0268-bf14-45ed-bcb0-9bbb0d93aaf0.png?v=1745111986\" loading=\"lazy\" decoding=\"async\" alt=\"\">\n        </span>\n        <div class=\"scx-copy\">\n          <strong>Securely packed</strong>\n          <span class=\"m-only\"></span>\n          <span class=\"d-only\">Corner-protected, bubble-wrapped.</span>\n        </div>\n      </li>\n\n      <!-- 6 Built to last -->\n      <li class=\"scx-item\" role=\"listitem\">\n        <span class=\"scx-ico\" aria-hidden=\"true\">\n          <img src=\"https://cdn.shopify.com/s/files/1/0722/2332/6515/files/hammer-icon.png?v=1758763561\" loading=\"lazy\" decoding=\"async\" alt=\"\">\n        </span>\n        <div class=\"scx-copy\">\n          <strong>Built to last</strong>\n          <span class=\"m-only\"></span>\n          <span class=\"d-only\">Solid hand-made timber frames.</span>\n        </div>\n      </li>\n    </ul>\n  </div>\n</section>"
