    "custom_content_88k7iR": {
      "type": "custom-content",
      "blocks": {
        "html_n3RgFH": {
          "type": "html",
          "settings": {
            "width": "full",
            "code": "{%- comment -%}\nSPORTS CAVE • LEGACY / DESCRIPTION CARD — v4 (Commanding + Top-scroll CTA)\n- Bold typographic lede\n- Gold accent spine + animated title sheen (very subtle)\n- CTA small + premium, jumps to TOP of page\n{%- endcomment -%}\n\n<section id=\"scx-legacy\" class=\"scx-legacy\" role=\"region\" aria-label=\"Artwork story\">\n  <header class=\"scx-legacy__head\">\n    <h2 class=\"scx-legacy__title\">LEGACY</h2>\n    <button type=\"button\" class=\"scx-legacy__cta\" aria-label=\"Choose frame and size (scroll to top)\">\n      <svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" aria-hidden=\"true\">\n        <path d=\"M4 7h16M4 12h16M4 17h10\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"/>\n      </svg>\n      <span>Choose frame &amp; size</span>\n    </button>\n  </header>\n\n  <div class=\"scx-legacy__body rte\" id=\"scx-legacy-body-{{ product.id }}\">\n    {{ product.description }}\n  </div>\n</section>\n\n<style>\n\n#scx-legacy.scx-legacy{\n  --panel-top:#1A1712;       \n  --panel:#0E1114;           \n  --ink:#F7F9FC;             \n  --muted:#D5DBE2;           \n  --gold:#F7A007;            \n  --edge:rgba(255,255,255,.06);\n  --inset:inset 0 1px 0 rgba(255,255,255,.04);\n  --glow:0 18px 34px rgba(0,0,0,.45);\n  --radius:18px;\n\n  background:\n    linear-gradient(180deg, rgba(247,160,7,.10) 0%, rgba(247,160,7,0) 36%),\n    linear-gradient(180deg, var(--panel-top) 0%, var(--panel) 52%);\n  color:var(--ink);\n  border:1px solid var(--edge);\n  border-radius:var(--radius);\n  box-shadow:var(--glow), var(--inset);\n  padding:22px 26px 24px;\n  margin:0;\n  font-family:var(--sc-font-ui);\n  contain:layout paint style;\n}\n\n\n.scx-legacy__head{\n  display:flex; align-items:center; justify-content:space-between; gap:12px;\n  margin:2px 0 12px;\n}\n.scx-legacy__title{\n  margin:0; letter-spacing:.09em; font-weight:700;\n  font-size:clamp(18px,1.7vw,22px); color:var(--ink);\n  text-transform:uppercase; position:relative; padding-top:3px;\n}\n.scx-legacy__title::after{\n  content:\"\"; display:block; height:3px; margin:10px 0 0; border-radius:2px;\n  background:linear-gradient(90deg, rgba(247,160,7,0) 0%, var(--gold) 18%, rgba(247,160,7,.2) 55%, rgba(247,160,7,0) 100%);\n  animation:scx-sheen 5.5s ease-in-out infinite;\n}\n@keyframes scx-sheen{\n  0%,65%,100% { filter:brightness(1); opacity:.9 }\n  40% { filter:brightness(1.25); opacity:1 }\n}\n\n\n.scx-legacy__cta{\n  display:inline-flex; align-items:center; gap:8px;\n  padding:8px 12px; border-radius:999px;\n  font-weight:700; font-size:13px; letter-spacing:.02em;\n  color:var(--ink); background:transparent; border:1px solid var(--edge);\n  cursor:pointer; transition:transform .18s ease, background-color .18s ease, border-color .18s ease;\n  white-space:nowrap;\n}\n.scx-legacy__cta:hover{ background:rgba(255,255,255,.05); border-color:rgba(255,255,255,.12) }\n.scx-legacy__cta:active{ transform:translateY(1px) }\n\n\n.scx-legacy__body{\n  --measure:70ch;\n  position:relative;\n  max-width:var(--measure);\n  line-height:1.6;\n  font-size:clamp(15.5px,1.08vw,17px);\n  color:var(--muted);\n  padding-left:18px; margin-top:2px;\n}\n.scx-legacy__body::before{\n  content:\"\"; position:absolute; left:0; top:.4rem; bottom:.4rem; width:3px; border-radius:2px;\n  background:linear-gradient(180deg, var(--gold), rgba(247,160,7,.45));\n  box-shadow:0 0 0 1px rgba(247,160,7,.06);\n}\n.scx-legacy__body p{ margin:0 0 10px }\n.scx-legacy__body p:first-child{ color:var(--ink); font-weight:700; letter-spacing:.0035em }\n\n\n@media (max-width: 989px){\n  #scx-legacy.scx-legacy{ padding:18px 14px 18px; border-radius:16px }\n  .scx-legacy__head{ margin-bottom:8px }\n  .scx-legacy__body{ font-size:15.5px; line-height:1.55; max-width:none }\n  .scx-legacy__cta{ font-size:12.5px; padding:7px 10px }\n}\n\n\n@media (prefers-reduced-motion:reduce){\n  .scx-legacy__cta{ transition:none }\n  .scx-legacy__title::after{ animation:none }\n}\n</style>\n\n<script>\n\n(function(){\n  var btn = document.querySelector('#scx-legacy .scx-legacy__cta');\n  if(!btn) return;\n  btn.addEventListener('click', function(){\n    window.scrollTo({ top: 0, behavior: 'smooth' });\n  }, { passive:true });\n})();\n</script>"
