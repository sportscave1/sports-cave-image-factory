        "custom_liquid_jtRdhV": {
          "type": "custom-liquid",
          "name": "Delivery Country HTML",
          "settings": {
            "custom_liquid": "{%- comment -%}\nSPORTS CAVE • Free Delivery Line — v2.2 (ultra-light, SEO friendly)\n- Centered one-line row with Montserrat + bold weight\n- Uses Shopify Markets country (no JS needed)\n- Lazy, async icon; explicit dimensions to avoid CLS\n- Vertical pull using *negative margins* (padding can’t be negative):\n  top: -8px, bottom: -1px\n{%- endcomment -%}\n\n<div class=\"sc-delivery-line\"\n     aria-label=\" {{ localization.country.name | default: 'your country' }}\">\n  <style>\n    .sc-delivery-line{\n      display:flex; align-items:center; justify-content:center; gap:8px;\n      margin:-8px 0 -1px;       \n      font-family:var(--sc-font-ui);\n      font-weight:700;          \n      font-size:clamp(14px, 2.6vw, 16px);\n      line-height:1.2; color:#2b2b2b;\n      white-space:nowrap;       \n    }\n    .sc-delivery-line .ic{\n      width:18px; height:18px; flex:0 0 18px; object-fit:contain;\n      margin-top:1px;           \n    }\n    .sc-delivery-line .txt{ overflow:hidden; text-overflow:ellipsis; }\n    .sc-delivery-line .country{ font-weight:700; }\n    @media (max-width:480px){\n      .sc-delivery-line{ gap:7px; }\n      .sc-delivery-line .ic{ width:17px; height:17px; flex-basis:17px; }\n    }\n  </style>\n\n  <img class=\"ic\"\n       src=\"https://cdn.shopify.com/s/files/1/0722/2332/6515/files/delivery-icon.png?v=1757418503\"\n       alt=\"\" width=\"18\" height=\"18\" loading=\"lazy\" decoding=\"async\" aria-hidden=\"true\">\n  <span class=\"txt\"> 2-6 Days Delivery to\n    <span class=\"country\">{{ localization.country.name | default: 'your country' }} </span>\n  </span>\n</div>",
            "show_in_quickbuy": false
          }
        },
        "custom_liquid_4rDqmW": {
          "type": "custom-liquid",
          "name": "Payment Icons HTML",
          "settings": {
            "custom_liquid": "{%- comment -%} SPORTS CAVE • Payment icons (AMEX first, PayPal 4th) {%- endcomment -%}\n<div class=\"verna-pay\" role=\"region\" aria-label=\"Accepted payment methods\">\n  <span class=\"sr-only\">Swipe or scroll to view all accepted payment methods</span>\n  <ul class=\"verna-pay__list\" role=\"list\" tabindex=\"0\">\n    {%- assign icons = '\n      american_express|American Express|https://cdn.shopify.com/s/files/1/0673/9928/6958/files/american-express-icon.svg?v=1757323240,\n      visa|Visa|https://cdn.shopify.com/s/files/1/0673/9928/6958/files/visa-icon.svg?v=1757323240,\n      mastercard|Mastercard|https://cdn.shopify.com/s/files/1/0673/9928/6958/files/mastercard-icon.svg?v=1757323240,\n      paypal|PayPal|https://cdn.shopify.com/s/files/1/0673/9928/6958/files/paypal-icon.svg?v=1757323240,\n      apple_pay|Apple Pay|https://cdn.shopify.com/s/files/1/0673/9928/6958/files/apple-pay-icon.svg?v=1757323240,\n      google_pay|Google Pay|https://cdn.shopify.com/s/files/1/0673/9928/6958/files/google-pay-icon.svg?v=1757323240,\n      shop_pay|Shop Pay|https://cdn.shopify.com/s/files/1/0673/9928/6958/files/shop-pay-icon.svg?v=1757323240,\n      eftpos|eftpos|https://cdn.shopify.com/s/files/1/0673/9928/6958/files/eftpos-icon.svg?v=1757323240,\n      unionpay|UnionPay|https://cdn.shopify.com/s/files/1/0673/9928/6958/files/union-pay-icon.svg?v=1757323240\n    ' | strip | split: ',' -%}\n\n    {%- for row in icons -%}\n      {%- assign p = row | strip | split: '|' -%}\n      <li class=\"verna-pay__item\">\n        <img\n          class=\"verna-pay__img\"\n          src=\"{{ p[2] | strip }}\"\n          alt=\"{{ p[1] | strip }}\"\n          width=\"72\" height=\"40\"\n          loading=\"lazy\" decoding=\"async\" fetchpriority=\"low\">\n      </li>\n    {%- endfor -%}\n  </ul>\n</div>\n\n<style>\n  \n  .sr-only{position:absolute!important;width:1px;height:1px;overflow:hidden;clip:rect(1px,1px,1px,1px);white-space:nowrap}\n\n  .verna-pay{margin:6px 0 0}\n\n  \n  .verna-pay__list{\n    --gap:6px;\n    display:flex;align-items:center;gap:var(--gap);\n    list-style:none;margin:0;padding:0 4px;\n    overflow-x:auto;overflow-y:hidden;\n    scroll-snap-type:x proximity;scrollbar-gutter:stable both-edges;\n    content-visibility:auto;contain-intrinsic-size:44px 360px;\n  }\n  .verna-pay__item{\n    flex:0 0 auto;scroll-snap-align:start;\n    width:clamp(58px,6vw,84px);min-width:54px;\n    padding:5px 8px;border:1px solid rgba(0,0,0,.06);border-radius:8px;background:var(--sc-brand-ivory);\n    box-shadow:0 1px 2px rgba(0,0,0,.05)\n  }\n  .verna-pay__img{display:block;width:100%;height:auto;object-fit:contain}\n\n  \n  .verna-pay__list::-webkit-scrollbar{height:4px}\n  .verna-pay__list::-webkit-scrollbar-track{background:transparent}\n  .verna-pay__list::-webkit-scrollbar-thumb{background:rgba(0,0,0,.16);border-radius:6px}\n  @media (max-width:600px){\n    .verna-pay__list{padding:0 8px;-webkit-overflow-scrolling:touch;mask-image:linear-gradient(to right,transparent 0,#000 12px,#000 calc(100% - 12px),transparent 100%);-webkit-mask-image:linear-gradient(to right,transparent 0,#000 12px,#000 calc(100% - 12px),transparent 100%)}\n    .verna-pay__item{width:clamp(58px,16vw,78px);padding:6px 8px;scroll-snap-align:center}\n    .verna-pay__list::-webkit-scrollbar{display:none}\n    .verna-pay__list{scrollbar-width:none}\n  }\n</style>",
            "show_in_quickbuy": false
          }
        },
        "custom_liquid_a3VDRM": {
          "type": "custom-liquid",
          "name": "Delivery Country HTML",
          "disabled": true,
          "settings": {
            "custom_liquid": "{%- comment -%}\nSPORTS CAVE • Delivery + Trust Chips • v11\n- Icons remain on ONE horizontal line (even on mobile)\n- Text forced to two compact lines via <br> and vertically centered to the icon\n- Icon + text perfectly centered/aligned\n- Extra space between “Delivery to …” and chips\n- Whole block pulled up with a small negative top margin (padding can’t be negative)\n{%- endcomment -%}\n\n<div id=\"sc-chips-{{ product.id }}\"\n     class=\"sc-chips\"\n     data-country-name=\"{{ localization.country.name | default: 'your country' }}\"\n     data-country-iso=\"{{ localization.country.iso_code | default: '' }}\">\n\n  <style>\n    .sc-chips{\n      --gold:#F7A007;\n      --divider:#1d1d1f;\n      --inkDark:#0e0e0e;\n      --blob:28px;               \n      --gap:14px;                \n      font:14px/1.35 \"Montserrat\",system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif;\n      color:var(--inkDark);\n      margin:-5px 0 8px;         \n    }\n\n    \n    .sc-chips .heading{\n      display:flex; align-items:center; justify-content:center;\n      gap:8px; font-size:15px; margin:0 8px 14px; font-weight:500; text-align:center; \n    }\n    .sc-chips .heading .ic{ width:20px; height:20px; flex:0 0 20px; object-fit:contain }\n    .sc-chips .heading b{ font-weight:700 }\n    .sc-chips .country{\n      display:inline-block; max-width:clamp(48px,14vw,120px);\n      white-space:nowrap; overflow:hidden; text-overflow:ellipsis; vertical-align:bottom;\n    }\n\n    \n    .sc-chips .row{\n      display:flex; align-items:center; justify-content:center;\n      gap:var(--gap); margin:0 auto; padding:0; max-width:980px;\n      flex-wrap:nowrap;\n    }\n\n    \n    .sc-chips .chip{\n      flex:1 1 0;\n      min-width:0;\n      display:flex; align-items:center; justify-content:center; \n      gap:10px; padding:2px 0; position:relative;\n    }\n    .sc-chips .chip + .chip:before{\n      content:\"\"; position:absolute; left:calc(-.5 * var(--gap)); top:50%; transform:translateY(-50%);\n      width:1px; height:18px; background:var(--divider); opacity:.9;\n    }\n\n    \n    .sc-chips .blob{\n      width:var(--blob); height:var(--blob); border-radius:9999px; background:var(--gold);\n      display:inline-flex; align-items:center; justify-content:center; flex:0 0 var(--blob);\n      box-shadow:0 2px 6px rgba(247,160,7,.28);\n    }\n    .sc-chips .blob img{ width:62%; height:62%; object-fit:contain }\n\n    \n    .sc-chips .label{\n      display:flex; align-items:center; justify-content:center; \n      height:var(--blob);               \n      text-align:center;\n      white-space:normal;               \n      max-width:100%;\n    }\n    .sc-chips .label-inner{\n      font-weight:700; color:#000;\n      font-size:clamp(11px, 3.2vw, 13px);\n      line-height:1.05;                 \n      transform:translateY(0.5px);      \n    }\n\n    \n    @media (min-width:481px){\n      .sc-chips{ --blob:30px; --gap:18px; }\n      .sc-chips .label-inner{ font-size:13px }\n    }\n\n    \n    @media (max-width:480px){\n      \n      .sc-chips .label{\n        max-width:calc((100vw - var(--gap) - (2 * var(--blob)) - 32px) / 2);\n      }\n    }\n  </style>\n\n  <!-- Delivery -->\n  <p class=\"heading\">\n    <img class=\"ic\" src=\"https://cdn.shopify.com/s/files/1/0722/2332/6515/files/delivery-icon.png?v=1757418503\"\n         alt=\"\" width=\"20\" height=\"20\" loading=\"lazy\" decoding=\"async\" aria-hidden=\"true\">\n    <span>Delivery to <b class=\"country\">AUS</b> in <b>2–6 business days</b></span>\n  </p>\n\n  <!-- Trust chips (icons on one line, text = 2 lines next to icon) -->\n  <div class=\"row\" role=\"list\">\n    <span class=\"chip\" role=\"listitem\" aria-label=\"Happy customers\">\n      <span class=\"blob\" aria-hidden=\"true\">\n        <img src=\"https://cdn.shopify.com/s/files/1/0722/2332/6515/files/smiley-face-icon.png?v=1757416423\" alt=\"\">\n      </span>\n      <span class=\"label\"><span class=\"label-inner\">1000+ Happy<br>customers</span></span>\n    </span>\n\n    <span class=\"chip\" role=\"listitem\" aria-label=\"30-day guarantee\">\n      <span class=\"blob\" aria-hidden=\"true\">\n        <img src=\"https://cdn.shopify.com/s/files/1/0722/2332/6515/files/return-icon.png?v=1757416422\" alt=\"\">\n      </span>\n      <span class=\"label\"><span class=\"label-inner\">30-Day<br>guarantee</span></span>\n    </span>\n  </div>\n\n  <script>\n  (function(){\n    var root = document.getElementById('sc-chips-{{ product.id }}');\n    if(!root || root.dataset.init==='1') return;\n    root.dataset.init='1';\n\n    var els  = root.querySelectorAll('.country');\n    var iso  = (root.getAttribute('data-country-iso')||'').toUpperCase();\n    var name = (root.getAttribute('data-country-name')||'');\n\n    // Preferred abbreviations\n    var MAP = { AU:'AUS', US:'USA', GB:'UK', NZ:'NZ', CA:'CAN', IE:'IRE', AE:'UAE' };\n\n    function abbr(iso, name){\n      if(MAP[iso]) return MAP[iso];\n      var n = (name||'').toLowerCase();\n      if(n.includes('united states')) return 'USA';\n      if(n.includes('united kingdom')) return 'UK';\n      if(n.includes('new zealand'))   return 'NZ';\n      if(n.includes('australia'))     return 'AUS';\n      if(n.includes('canada'))        return 'CAN';\n      if(iso) return iso; // fallback for DE, FR, etc.\n      return (name||'your country');\n    }\n\n    var out = abbr(iso, name);\n\n    // Fallback for theme preview / missing Liquid data\n    if(!out || /your country/i.test(out)){\n      try{\n        var region = (navigator.language||'').split('-')[1]||'';\n        out = abbr(region.toUpperCase(), '');\n      }catch(e){}\n    }\n\n    els.forEach(function(n){ n.textContent = out; });\n  })();\n  </script>\n</div>",
            "show_in_quickbuy": false
          }
        },
