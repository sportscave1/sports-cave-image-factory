      "settings": {
        "full_width": true,
        "show_space": true,
        "code": "<!-- SPORTS CAVE • Legends in Motion (SEO-indexable • ultra-light • keyword-optimized captions) -->\n\n<section id=\"sc-video-carousel\" class=\"scv\" aria-label=\"Legends in Motion\">\n  <h2 class=\"scv__title\">\n    Legends in Motion\n    <span class=\"scv__rule\" aria-hidden=\"true\"></span>\n  </h2>\n\n  <style>\n    .scv{\n      --gold:#F7A007; --ink:#fff; --edge:#1b1b1b;\n      background:#0B0B0B; margin:0; padding:16px 0 8px;\n      isolation:isolate; contain:content; color:var(--ink);\n      font-family:var(--sc-font-ui);\n    }\n    .scv__title{\n      color:var(--sc-brand-ivory); text-align:center; margin:0 0 10px; letter-spacing:.02em;\n      font:900 18px/1.2 Montserrat,system-ui,sans-serif;\n    }\n    .scv__rule{\n      display:block; width:140px; height:4px; margin:8px auto 0; border-radius:999px;\n      background:linear-gradient(90deg,#B27812,#F7A007,#B27812);\n      box-shadow:0 0 8px rgba(247,160,7,.18);\n    }\n\n    \n    .scv__track{\n      display:flex; gap:12px; overflow-x:auto; scroll-snap-type:x mandatory;\n      padding:0 9vw; -ms-overflow-style:none; scrollbar-width:none; overscroll-behavior-x:contain;\n    }\n    .scv__track::-webkit-scrollbar{display:none}\n\n    .scv__card{\n      position:relative; flex:0 0 70vw; scroll-snap-align:center; scroll-snap-stop:always;\n      border-radius:14px; overflow:hidden; background:#000; border:1px solid var(--edge);\n      box-shadow:0 10px 24px rgba(0,0,0,.32); aspect-ratio:9/16;\n    }\n    @supports not (aspect-ratio:9/16){ .scv__card::before{content:\"\";display:block;padding-top:177.78%} }\n\n    \n    .scv__card::after{\n      content:\"\"; position:absolute; inset:0; pointer-events:none;\n      background:linear-gradient(135deg,#151515,#0e0e0e); opacity:1; transition:opacity .14s ease;\n    }\n    .scv__card.is-loaded::after{opacity:0}\n\n    .scv__video{\n      position:absolute; inset:0; width:100%; height:100%;\n      object-fit:cover; display:block; background:#000;\n    }\n\n    .scv__caption{position:absolute; inset:auto 10px 8px 10px; font:600 12px/1.3 Montserrat,sans-serif; color:#e7e7e7}\n    .sr-only{position:absolute!important;clip:rect(1px,1px,1px,1px)!important;width:1px!important;height:1px!important;overflow:hidden!important;white-space:nowrap!important}\n\n    \n    @media (min-width:1024px){\n      .scv__track{display:grid; overflow:visible; padding:0; gap:12px; grid-template-columns:repeat(4,minmax(0,1fr))}\n      .scv__card{flex:initial}\n    }\n    @media (prefers-reduced-motion:reduce){ .scv__video{animation:none;transition:none} }\n  </style>\n\n  <div class=\"scv__track\" role=\"list\" aria-live=\"polite\">\n    <!-- CARD 1 -->\n    <figure class=\"scv__card\"\n            role=\"listitem\"\n            itemscope itemtype=\"https://schema.org/VideoObject\"\n            data-name=\"Limited Edition Sports Wall Art — Collector Video 1\"\n            data-desc=\"Limited edition sports wall art for man cave decor. Premium framed or unframed prints — the ultimate gift for sports fans.\"\n            data-src=\"https://cdn.shopify.com/videos/c/o/v/d30e5ba1bb7a49069713efc63ddcd828.mp4\"\n            data-thumb=\"https://cdn.shopify.com/s/files/1/0722/2332/6515/files/preview_images/d30e5ba1bb7a49069713efc63ddcd828.thumbnail.0000000000.jpg?v=1760168943\">\n      <video class=\"scv__video\"\n             muted playsinline loop preload=\"none\"\n             aria-label=\"Limited edition sports wall art — man cave decor highlight (video 1)\"\n             poster=\"https://cdn.shopify.com/s/files/1/0722/2332/6515/files/preview_images/d30e5ba1bb7a49069713efc63ddcd828.thumbnail.0000000000.jpg?v=1760168943\">\n          <track kind=\"captions\" srclang=\"en\" label=\"English captions\" src=\"{{ 'scv-accessible-caption-5.vtt' | asset_url }}\">\n        </video>\n      <figcaption class=\"scv__caption\">Limited Edition Sports Art</figcaption>\n      <meta itemprop=\"name\" content=\"Limited Edition Sports Wall Art — Collector Video 1\">\n      <meta itemprop=\"description\" content=\"Limited edition sports wall art for man cave decor. Premium framed or unframed prints — the ultimate gift for sports fans.\">\n      <meta itemprop=\"thumbnailUrl\" content=\"https://cdn.shopify.com/s/files/1/0722/2332/6515/files/preview_images/d30e5ba1bb7a49069713efc63ddcd828.thumbnail.0000000000.jpg?v=1760168943\">\n      <meta itemprop=\"contentUrl\"   content=\"https://cdn.shopify.com/videos/c/o/v/d30e5ba1bb7a49069713efc63ddcd828.mp4\">\n      <meta itemprop=\"keywords\" content=\"limited edition sports art, sports wall art, man cave decor, framed sports prints, sports gifts\">\n    </figure>\n\n    <!-- CARD 2 -->\n    <figure class=\"scv__card\"\n            role=\"listitem\"\n            itemscope itemtype=\"https://schema.org/VideoObject\"\n            data-name=\"Man Cave Decor — Premium Framed Sports Art — Video 2\"\n            data-desc=\"Premium framed sports art for man cave decor. High-impact designs and collector quality — perfect gift for sports lovers.\"\n            data-src=\"https://cdn.shopify.com/videos/c/o/v/a1fa2f132dc144309952645fbd4bb814.mp4\"\n            data-thumb=\"https://cdn.shopify.com/s/files/1/0722/2332/6515/files/preview_images/a1fa2f132dc144309952645fbd4bb814.thumbnail.0000000000.jpg?v=1743979525\">\n      <video class=\"scv__video\"\n             muted playsinline loop preload=\"none\"\n             aria-label=\"Man cave decor — premium framed sports art highlight (video 2)\"\n             poster=\"https://cdn.shopify.com/s/files/1/0722/2332/6515/files/preview_images/a1fa2f132dc144309952645fbd4bb814.thumbnail.0000000000.jpg?v=1743979525\">\n          <track kind=\"captions\" srclang=\"en\" label=\"English captions\" src=\"{{ 'scv-accessible-caption-6.vtt' | asset_url }}\">\n        </video>\n      <figcaption class=\"scv__caption\">Man Cave Decor</figcaption>\n      <meta itemprop=\"name\" content=\"Man Cave Decor — Premium Framed Sports Art — Video 2\">\n      <meta itemprop=\"description\" content=\"Premium framed sports art for man cave decor. High-impact designs and collector quality — perfect gift for sports lovers.\">\n      <meta itemprop=\"thumbnailUrl\" content=\"https://cdn.shopify.com/s/files/1/0722/2332/6515/files/preview_images/a1fa2f132dc144309952645fbd4bb814.thumbnail.0000000000.jpg?v=1743979525\">\n      <meta itemprop=\"contentUrl\"   content=\"https://cdn.shopify.com/videos/c/o/v/a1fa2f132dc144309952645fbd4bb814.mp4\">\n      <meta itemprop=\"keywords\" content=\"man cave decor, framed sports art, sports wall art, collector prints, sports gifts\">\n    </figure>\n\n    <!-- CARD 3 -->\n    <figure class=\"scv__card\"\n            role=\"listitem\"\n            itemscope itemtype=\"https://schema.org/VideoObject\"\n            data-name=\"Ultimate Gift for Sports Fans — Sports Wall Art — Video 3\"\n            data-desc=\"Ultimate gift for sports fans: premium sports wall art for home, office, or game room. Collector-grade quality, framed or unframed.\"\n            data-src=\"https://cdn.shopify.com/videos/c/o/v/f68df3ea92ce4152bb7f542098ee7165.mp4\"\n            data-thumb=\"https://cdn.shopify.com/s/files/1/0722/2332/6515/files/preview_images/f68df3ea92ce4152bb7f542098ee7165.thumbnail.0000000000.jpg?v=1760167345\">\n      <video class=\"scv__video\"\n             muted playsinline loop preload=\"none\"\n             aria-label=\"Ultimate gift for sports fans — sports wall art highlight (video 3)\"\n             poster=\"https://cdn.shopify.com/s/files/1/0722/2332/6515/files/preview_images/f68df3ea92ce4152bb7f542098ee7165.thumbnail.0000000000.jpg?v=1760167345\">\n          <track kind=\"captions\" srclang=\"en\" label=\"English captions\" src=\"{{ 'scv-accessible-caption-7.vtt' | asset_url }}\">\n        </video>\n      <figcaption class=\"scv__caption\">Ultimate Gift for Sports Fans</figcaption>\n      <meta itemprop=\"name\" content=\"Ultimate Gift for Sports Fans — Sports Wall Art — Video 3\">\n      <meta itemprop=\"description\" content=\"Ultimate gift for sports fans: premium sports wall art for home, office, or game room. Collector-grade quality, framed or unframed.\">\n      <meta itemprop=\"thumbnailUrl\" content=\"https://cdn.shopify.com/s/files/1/0722/2332/6515/files/preview_images/f68df3ea92ce4152bb7f542098ee7165.thumbnail.0000000000.jpg?v=1760167345\">\n      <meta itemprop=\"contentUrl\"   content=\"https://cdn.shopify.com/videos/c/o/v/f68df3ea92ce4152bb7f542098ee7165.mp4\">\n      <meta itemprop=\"keywords\" content=\"gift for sports fans, sports wall art, man cave ideas, framed sports prints, collector series\">\n    </figure>\n\n    <!-- CARD 4 -->\n    <figure class=\"scv__card\"\n            role=\"listitem\"\n            itemscope itemtype=\"https://schema.org/VideoObject\"\n            data-name=\"Framed Sports Wall Art — Limited-Edition Collector Series — Video 4\"\n            data-desc=\"Framed sports wall art from our limited-edition collector series. High-impact decor for serious fans and collectors.\"\n            data-src=\"https://cdn.shopify.com/videos/c/o/v/7be9bb66579e4bd194dfffc61f61590a.mp4\"\n            data-thumb=\"https://cdn.shopify.com/s/files/1/0722/2332/6515/files/preview_images/7be9bb66579e4bd194dfffc61f61590a.thumbnail.0000000000.jpg?v=1743979616\">\n      <video class=\"scv__video\"\n             muted playsinline loop preload=\"none\"\n             aria-label=\"Framed sports wall art — limited-edition collector series highlight (video 4)\"\n             poster=\"https://cdn.shopify.com/s/files/1/0722/2332/6515/files/preview_images/7be9bb66579e4bd194dfffc61f61590a.thumbnail.0000000000.jpg?v=1743979616\">\n          <track kind=\"captions\" srclang=\"en\" label=\"English captions\" src=\"{{ 'scv-accessible-caption-8.vtt' | asset_url }}\">\n        </video>\n      <figcaption class=\"scv__caption\">Framed Sports Wall Art</figcaption>\n      <meta itemprop=\"name\" content=\"Framed Sports Wall Art — Limited-Edition Collector Series — Video 4\">\n      <meta itemprop=\"description\" content=\"Framed sports wall art from our limited-edition collector series. High-impact decor for serious fans and collectors.\">\n      <meta itemprop=\"thumbnailUrl\" content=\"https://cdn.shopify.com/s/files/1/0722/2332/6515/files/preview_images/7be9bb66579e4bd194dfffc61f61590a.thumbnail.0000000000.jpg?v=1743979616\">\n      <meta itemprop=\"contentUrl\"   content=\"https://cdn.shopify.com/videos/c/o/v/7be9bb66579e4bd194dfffc61f61590a.mp4\">\n      <meta itemprop=\"keywords\" content=\"framed sports wall art, limited edition sports art, collector series, sports decor, man cave wall art\">\n    </figure>\n  </div>\n\n  <!-- JSON-LD (auto-built so Google can index each video) -->\n  <script>\n  (() => {\n    const root  = document.getElementById('sc-video-carousel');\n    if (!root) return;\n\n    const track = root.querySelector('.scv__track');\n    const cards = [...root.querySelectorAll('.scv__card')];\n    const vids  = cards.map(c => c.querySelector('.scv__video'));\n\n    \n    const setSrcIfNeeded = (fig) => {\n      const v = fig.querySelector('video');\n      if (!v || v.dataset.bound) return;\n      const src = fig.dataset.src;\n      if (!src) return;\n      const source = document.createElement('source');\n      source.src = src; source.type = 'video/mp4';\n      v.appendChild(source);\n      v.dataset.bound = '1';\n      v.addEventListener('loadeddata', () => fig.classList.add('is-loaded'), { once:true });\n      v.addEventListener('error',      () => fig.classList.add('is-loaded'), { once:true });\n    };\n\n    const srcIO = new IntersectionObserver(entries => {\n      entries.forEach(e => { if (e.isIntersecting) { setSrcIfNeeded(e.target); srcIO.unobserve(e.target); } });\n    }, { rootMargin: '300px 0px', threshold: 0.01 });\n    cards.forEach(c => srcIO.observe(c));\n\n    const pauseAll = () => vids.forEach(v => v && v.pause());\n\n    \n    const centerScore = (el) => {\n      const r = el.getBoundingClientRect();\n      const center = window.innerWidth / 2;\n      const elCenter = r.left + r.width / 2;\n      return Math.max(0, 1 - Math.abs(elCenter - center) / (window.innerWidth * 0.5));\n    };\n    let ticking = false;\n    const updateMobilePlayback = () => {\n      let best = { v:null, score:0 };\n      vids.forEach(v => {\n        if (!v?.parentElement?.dataset?.src) return;\n        const s = centerScore(v);\n        if (s > best.score) best = { v, score:s };\n      });\n      vids.forEach(v => (v === best.v && best.score >= 0.6) ? v.play().catch(()=>{}) : v.pause());\n    };\n    const onTrackScroll = () => {\n      if (ticking) return;\n      ticking = true;\n      requestAnimationFrame(() => { updateMobilePlayback(); ticking = false; });\n    };\n\n    \n    let playIO = null;\n    const enableDesktopObserver = () => {\n      if (playIO) playIO.disconnect();\n      playIO = new IntersectionObserver(entries => {\n        entries.forEach(e => {\n          const v = e.target;\n          if (e.isIntersecting && e.intersectionRatio >= 0.6) v.play().catch(()=>{});\n          else v.pause();\n        });\n      }, { threshold:[0,.25,.5,.6,.75,1] });\n      vids.forEach(v => v && playIO.observe(v));\n    };\n    const disableDesktopObserver = () => { if (playIO) { playIO.disconnect(); playIO = null; } };\n\n    const mql = window.matchMedia('(min-width: 1024px)');\n    const applyMode = (isDesktop) => {\n      pauseAll();\n      if (isDesktop){\n        track.removeEventListener('scroll', onTrackScroll, { passive:true });\n        ['resize','orientationchange'].forEach(ev => removeEventListener(ev, onTrackScroll, { passive:true }));\n        enableDesktopObserver();\n      } else {\n        disableDesktopObserver();\n        track.addEventListener('scroll', onTrackScroll, { passive:true });\n        ['resize','orientationchange'].forEach(ev => addEventListener(ev, onTrackScroll, { passive:true }));\n        updateMobilePlayback();\n      }\n    };\n    applyMode(mql.matches);\n    if (mql.addEventListener) mql.addEventListener('change', e => applyMode(e.matches));\n    else mql.addListener(e => applyMode(e.matches));\n\n    document.addEventListener('visibilitychange', () => {\n      if (document.hidden) pauseAll(); else applyMode(mql.matches);\n    });\n\n    addEventListener('touchstart', () => vids.forEach(v => v && v.play().catch(()=>{})), { once:true });\n\n    \n    try{\n      const pageUrl = location.href.split('#')[0];\n      const graph = cards.map((fig, i) => {\n        const name = fig.dataset.name || `Sports Wall Art — Video ${i+1}`;\n        const desc = fig.dataset.desc || 'Sports Cave collector video highlight.';\n        const contentUrl = fig.dataset.src;\n        const thumb = fig.dataset.thumb || '';\n        const node = {\n          \"@type\":\"VideoObject\",\n          \"@id\": pageUrl + `#video-${i+1}`,\n          \"name\": name,\n          \"description\": desc,\n          \"inLanguage\": \"en\",\n          \"isFamilyFriendly\": true,\n          \"embedUrl\": pageUrl + \"#sc-video-carousel\",\n          ...(thumb ? {\"thumbnailUrl\":[thumb]} : {}),\n          ...(contentUrl ? {\"contentUrl\": contentUrl} : {})\n        };\n        return node;\n      });\n      const ld = document.createElement('script');\n      ld.type = 'application/ld+json';\n      ld.text = JSON.stringify({ \"@context\":\"https://schema.org\", \"@graph\": graph });\n      root.appendChild(ld);\n    }catch(e){}\n  })();\n  </script>\n\n  <noscript>\n    <div class=\"sr-only\">\n      Sports Cave videos: limited edition sports wall art, framed sports art, man cave decor ideas, and gifts for sports fans.\n    </div>\n  </noscript>\n</section>"
      }
    },
