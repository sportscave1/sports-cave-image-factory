        "code": "<!-- Sports Cave Premium Collector Header -->\n<section class=\"sc-strap-elite\"\n         role=\"region\"\n         aria-label=\"Michael Jordan collection intro\">\n\n  <style>\n    .sc-strap-elite{\n      --bg:#060606;\n      --gold:#F7A007;\n      --gold2:#FFD06A;\n      --ink:#F5F5F5;\n      --max:1180px;\n\n      background:\n        radial-gradient(circle at top center, rgba(247,160,7,.08), transparent 40%),\n        linear-gradient(180deg, #060606 0%, #0b0b0b 100%);\n\n      border-bottom:1px solid rgba(247,160,7,.15);\n      font-family:var(--sc-font-ui);\n    }\n\n    .sc-strap-elite .wrap{\n      max-width:var(--max);\n      margin:0 auto;\n      padding:22px 16px 20px;\n      text-align:center;\n    }\n\n    \n    .sc-strap-elite .eyebrow{\n      color:rgba(247,160,7,.85);\n      font-size:.72rem;\n      letter-spacing:.25em;\n      font-weight:700;\n      margin-bottom:10px;\n    }\n\n    \n    .sc-strap-elite h1{\n      margin:0;\n      font-weight:700;\n      letter-spacing:.02em;\n      font-size:clamp(1.4rem,2.4vw,2.1rem);\n      color:var(--ink);\n    }\n\n    \n    .sc-strap-elite .line{\n      width:120px;\n      height:3px;\n      margin:14px auto 12px;\n      border-radius:999px;\n      background:linear-gradient(90deg, transparent, var(--gold), transparent);\n      box-shadow:0 0 18px rgba(247,160,7,.25);\n    }\n\n    \n    .sc-strap-elite .traits{\n      display:flex;\n      justify-content:center;\n      gap:14px;\n      font-size:.8rem;\n      font-weight:700;\n      color:rgba(255,255,255,.85);\n      letter-spacing:.02em;\n    }\n\n    .sc-strap-elite .dot{\n      opacity:.4;\n    }\n\n    @media (max-width:760px){\n      .sc-strap-elite .wrap{\n        padding:18px 12px;\n      }\n      .sc-strap-elite .traits{\n        flex-wrap:wrap;\n        gap:10px;\n      }\n    }\n  </style>\n\n  <div class=\"wrap\">\n    <div class=\"eyebrow\">COLLECTOR SERIES</div>\n\n    <h1>\n      Michael Jordan Wall Art\n    </h1>\n\n    <div class=\"line\"></div>\n\n    <div class=\"traits\">\n      <span>Premium Frames</span>\n      <span class=\"dot\">•</span>\n      <span>Limited Editions</span>\n      <span class=\"dot\"></span>\n      <span></span>\n    </div>\n  </div>\n<style>\n  .scx-collection-intro{\n    margin:0.8rem auto 1.1rem;\n    padding:0 1rem;\n    font-family:inherit; \n  }\n\n  .scx-collection-intro__inner{\n    max-width:780px;\n    margin:0 auto;\n    padding:1rem 1.4rem 1.1rem;\n    border-radius:18px;\n    border:1px solid rgba(120,82,32,.35);\n    background:\n      linear-gradient(135deg,#f9f2de 0%,#f3e1c4 40%,#f8f0dd 100%);\n    box-shadow:\n      0 12px 32px rgba(0,0,0,.16),\n      0 0 0 1px rgba(255,255,255,.7) inset;\n    text-align:center;\n    position:relative;\n  }\n\n  .scx-collection-intro__inner::before,\n  .scx-collection-intro__inner::after{\n    content:\"\";\n    position:absolute;\n    width:22px;\n    height:22px;\n    border-radius:50%;\n    border:1px solid rgba(120,82,32,.25);\n    background:radial-gradient(circle at 30% 30%, #ffffff 0, #f0dec4 60%, #e2c59b 100%);\n    top:-11px;\n  }\n  .scx-collection-intro__inner::before{\n    left:24px;\n  }\n  .scx-collection-intro__inner::after{\n    right:24px;\n  }\n\n  .scx-collection-intro__divider{\n    width:72px;\n    height:3px;\n    border-radius:999px;\n    margin:0.1rem auto 0.55rem;\n    background:linear-gradient(90deg,#F7A007,#C79A32);\n  }\n\n  .scx-collection-intro p{\n    margin:0;\n    font-size:.95rem;\n    line-height:1.6;\n    color:#3b2b16;\n  }\n\n  .scx-collection-intro p strong{\n    color:#b66a00;\n    font-weight:700;\n  }\n\n  @media (max-width:768px){\n    .scx-collection-intro{\n      margin:0.7rem auto 0.9rem;\n      padding:0 0.9rem;\n    }\n    .scx-collection-intro__inner{\n      padding:0.9rem 1rem 1rem;\n      border-radius:16px;\n      box-shadow:0 8px 24px rgba(0,0,0,.14),\n                  0 0 0 1px rgba(255,255,255,.7) inset;\n    }\n    .scx-collection-intro__inner::before,\n    .scx-collection-intro__inner::after{\n      width:18px;\n      height:18px;\n      top:-9px;\n    }\n    .scx-collection-intro__inner::before{\n      left:18px;\n    }\n    .scx-collection-intro__inner::after{\n      right:18px;\n    }\n    .scx-collection-intro p{\n      font-size:.88rem;\n    }\n  }\n</style>\n\n</section>"
