    "custom_liquid_3rzYxz": {
      "type": "custom-liquid",
      "name": "Custom Liquid",
      "settings": {
        "full_width": true,
        "show_space": true,
        "code": "{%- assign sc_mj_coll = collections['michael-jordan-wall-art'] -%}\n{%- if sc_mj_coll and sc_mj_coll.products_count > 0 -%}\n\n<!-- Sports Cave headline (black text + gold underline) -->\n<div class=\"sc-mj-headline\" id=\"build-your-jordan-cave\">\n  <h2 class=\"sc-mj-headline__title\">Jordan Collector Allocation</h2>\n</div>\n\n<section id=\"sc-mj-bundle\" class=\"sc-mj\" aria-label=\"Michael Jordan Collector Bonus\">\n  <!-- Product pool for JS -->\n  <script type=\"application/json\" id=\"sc-mj-pool\">\n  [\n    {%- for p in sc_mj_coll.products limit: 24 -%}\n      {%- assign m = p.featured_media | default: p.media.first -%}\n      {\n        \"id\": {{ p.id }},\n        \"title\": {{ p.title | json }},\n        \"url\": {{ p.url | json }},\n        \"image360\": {{ m | image_url: width: 360 | json }},\n        \"image560\": {{ m | image_url: width: 560 | json }},\n        \"image720\": {{ m | image_url: width: 720 | json }},\n        \"options\": {{ p.options | json }},\n        \"variants\": [\n          {%- for v in p.variants -%}\n            {\n              \"id\": {{ v.id }},\n              \"price\": {{ v.price }},\n              \"available\": {{ v.available | json }},\n              \"options\": [ {{ v.option1 | json }}, {{ v.option2 | json }}, {{ v.option3 | json }} ]\n            }{%- unless forloop.last -%},{%- endunless -%}\n          {%- endfor -%}\n        ]\n      }{%- unless forloop.last -%},{%- endunless -%}\n    {%- endfor -%}\n  ]\n  </script>\n\n  <div class=\"sc-mj__wrap\"\n       data-money-format=\"{{ shop.money_format | replace: \"'\", \"\\\\'\" }}\"\n       data-currency=\"{{ cart.currency.iso_code }}\">\n\n    <header class=\"sc-mj__head\">\n      <h3 class=\"sc-mj__title\">\n        <span class=\"w\">Allocation</span> <span class=\"hl\">Bonus</span>\n        <span class=\"dash\">—</span> <span class=\"player\">20%  2+ Editions</span>\n      </h3>\n      <button type=\"button\" class=\"sc-mj__refresh\" aria-label=\"Refresh unticked\">Refresh unticked</button>\n    </header>\n\n    <!-- Cards injected via JS -->\n    <ul class=\"sc-mj__grid\" role=\"list\" aria-live=\"polite\"></ul>\n\n    <!-- Right totals / CTA -->\n    <div class=\"sc-mj__totals\" aria-live=\"polite\">\n      <div class=\"sc-mj__badge\"><span class=\"tier\" data-tier>Buy 2+ → 15% Collector Bonus</span></div>\n      <div class=\"sc-mj__amounts\">\n        <div><span class=\"lab\">RRP</span> <span class=\"val\" data-rrp>—</span></div>\n        <div class=\"save\"><span class=\"lab\">Collector bonus</span> <span class=\"val\" data-save>—</span></div>\n        <div class=\"due\"><span class=\"lab\">Bundle price</span> <span class=\"val\" data-due>—</span></div>\n      </div>\n      <button type=\"button\" class=\"sc-mj__atc\" disabled aria-disabled=\"true\">Add bundle to cart</button>\n    </div>\n  </div>\n</section>\n\n<style>\n  .sc-mj-headline{ margin:12px auto 6px; max-width:1240px; padding:0 12px; }\n  .sc-mj-headline__title{\n    margin:0; color:#000; font-weight:700; letter-spacing:.02em;\n    font-family:var(--sc-font-ui);\n    font-size:clamp(22px,3.4vw,42px); line-height:1.06; position:relative; display:inline-block;\n  }\n  .sc-mj-headline__title::after{\n    content:\"\"; display:block; height:4px; width:220px; margin:.28rem auto 0;\n    background:linear-gradient(90deg,#F7A007 0%, #D39A2F 100%); border-radius:999px;\n  }\n\n  #sc-mj-bundle.sc-mj{\n    --mj-gold:#F7A007; --mj-ink:#fff; --mj-bg:#0a0a0a; --mj-card:#101010; --mj-line:#1e1e1e;\n    background:var(--mj-bg); color:var(--mj-ink);\n    font-family:var(--sc-font-ui);\n    border:1px solid #151515; border-radius:14px; box-shadow:0 10px 24px rgba(0,0,0,.22);\n  }\n  #sc-mj-bundle .sc-mj__wrap{\n    max-width:1240px; margin:0 auto; padding:12px 12px;\n    content-visibility:auto; contain-intrinsic-size:1px 240px;\n  }\n\n  #sc-mj-bundle .sc-mj__head{\n    display:flex; align-items:flex-start; justify-content:space-between; gap:10px; margin:2px 0 10px;\n  }\n  #sc-mj-bundle .sc-mj__title{ margin:0; font-size:clamp(18px,2.4vw,24px); font-weight:700; line-height:1.1; }\n  #sc-mj-bundle .sc-mj__title .w{ color:var(--sc-brand-ivory) } .sc-mj__title .hl{ color:var(--mj-gold) }\n  #sc-mj-bundle .sc-mj__title .dash{ opacity:.35; margin:0 .35ch; } .sc-mj__title .player{ color:var(--sc-brand-ivory); }\n  #sc-mj-bundle .sc-mj__refresh{\n    white-space:nowrap; background:#141414; color:#eee; border:1px solid #262626;\n    border-radius:10px; padding:6px 10px; font-weight:700; font-size:12px; line-height:1; cursor:pointer;\n  }\n  #sc-mj-bundle .sc-mj__refresh:active{ transform:translateY(1px) }\n\n  #sc-mj-bundle .sc-mj__grid{\n    list-style:none; margin:0; padding:0;\n    display:grid; gap:8px; grid-template-columns:repeat(3,1fr);\n  }\n\n  #sc-mj-bundle .sc-card{\n    position:relative; z-index:0;\n    background:var(--mj-card); border:1px solid var(--mj-line); border-radius:10px; overflow:hidden;\n    display:flex; flex-direction:column;\n  }\n  #sc-mj-bundle .sc-card__media{ position:relative; aspect-ratio:4/3; background:#0f0f0f; display:block; }\n  #sc-mj-bundle .sc-card__media img{ width:100%; height:100%; object-fit:cover; display:block; }\n  #sc-mj-bundle .sc-chip{\n    position:absolute; top:2px; left:2px; background:rgba(255,255,255,.08);\n    border:1px solid rgba(255,255,255,.14); border-radius:999px; padding:3px 8px; font-size:11px; font-weight:700;\n  }\n  @media (min-width: 990px){ #sc-mj-bundle .sc-chip{ display:none; } }\n\n  #sc-mj-bundle .sc-check{\n    position:absolute; top:2px; right:2px; display:flex; align-items:center; gap:6px;\n    font-size:11px; background:#0f0f0f; border:1px solid #2a2a2a; border-radius:999px; padding:3px 8px;\n  }\n  #sc-mj-bundle .sc-check input{ accent-color:var(--mj-gold); }\n\n  #sc-mj-bundle .sc-card__meta{ padding:8px; display:grid; gap:6px; }\n  #sc-mj-bundle .sc-title{\n    margin:0; font-size:13px; font-weight:700; line-height:1.2; min-height:32px;\n    display:-webkit-box; -webkit-line-clamp:2; line-clamp:2; -webkit-box-orient:vertical; overflow:hidden;\n  }\n  #sc-mj-bundle .sc-title a{ color:var(--sc-brand-ivory); text-decoration:none; }\n\n  #sc-mj-bundle .sc-opts{ display:grid; gap:6px; }\n  #sc-mj-bundle .sc-opts select{\n    width:100%; border:1px solid #2a2a2a; border-radius:8px; background:#0f0f0f; color:#e8e8e8; padding:6px 8px; font-size:12px;\n  }\n\n  #sc-mj-bundle .sc-card__buy{ padding:0 8px 8px; display:flex; align-items:center; justify-content:flex-start; }\n  #sc-mj-bundle .sc-card__price{ font-weight:700; font-size:13px; }\n  #sc-mj-bundle .sc-card__price .old{ color:#aaa; text-decoration:line-through; margin-right:6px; font-weight:700; }\n\n  #sc-mj-bundle .sc-mj__totals{\n    margin-top:12px; border-top:1px solid #1b1b1b; padding:12px 10px;\n    display:flex; flex-direction:column; gap:10px; align-items:stretch;\n    background:linear-gradient(180deg,#111,#0e0e0e);\n    border-radius:10px; position:relative; z-index:2;\n  }\n  #sc-mj-bundle .sc-mj__badge{\n    background:rgba(247,160,7,.12); border:1px solid rgba(247,160,7,.45); color:#ffd56e;\n    border-radius:999px; padding:6px 10px; font-weight:700; font-size:12px; align-self:flex-start;\n  }\n  #sc-mj-bundle .sc-mj__amounts{ display:grid; grid-template-columns:1fr auto; row-gap:6px; column-gap:10px; }\n  #sc-mj-bundle .sc-mj__amounts .lab{ color:#bdbdbd; font-weight:700; font-size:12px; }\n  #sc-mj-bundle .sc-mj__amounts .val{ font-weight:700; font-size:14px; }\n  #sc-mj-bundle .sc-mj__amounts .save .val{ color:#ffd56e; }\n  #sc-mj-bundle .sc-mj__amounts .due .val{ color:var(--sc-brand-ivory); }\n\n  #sc-mj-bundle .sc-mj__atc{\n    width:100%; background:var(--mj-gold); color:#111; border:none; border-radius:12px;\n    padding:12px 16px; font-weight:700; font-size:16px; cursor:pointer;\n    box-shadow:0 14px 28px rgba(247,160,7,.24);\n  }\n  #sc-mj-bundle .sc-mj__atc[disabled]{ opacity:.6; cursor:not-allowed; }\n\n  @media (min-width:990px){\n    #sc-mj-bundle .sc-mj__wrap{\n      display:grid;\n      grid-template-columns:minmax(0,1fr) 400px;\n      gap:28px;\n      grid-template-areas:\n        \"head head\"\n        \"grid totals\";\n      align-items:start;\n    }\n    #sc-mj-bundle .sc-mj__head{ grid-area:head; }\n    #sc-mj-bundle .sc-mj__grid{\n      grid-area:grid; min-width:0;\n      gap:20px;\n      grid-template-columns:repeat(3, minmax(240px, 1fr));\n    }\n\n    #sc-mj-bundle .sc-mj__totals{\n      grid-area:totals; margin:0; padding:16px;\n      background:linear-gradient(180deg,#121212,#0f0f0f);\n      border:1px solid #1b1b1b; border-radius:12px;\n      display:flex; flex-direction:column; gap:14px; align-self:stretch;\n      justify-self:end; z-index:5;\n    }\n    #sc-mj-bundle .sc-mj__badge{ align-self:flex-start; }\n    #sc-mj-bundle .sc-mj__amounts{ display:grid; gap:10px; }\n    #sc-mj-bundle .sc-mj__amounts > div{ display:flex; justify-content:space-between; gap:12px; }\n    #sc-mj-bundle .sc-mj__amounts .lab{ font-size:13px; }\n    #sc-mj-bundle .sc-mj__amounts .val{ font-weight:700; }\n    #sc-mj-bundle .sc-mj__atc{ width:100%; margin-top:auto; padding:14px 18px; font-size:16px; }\n  }\n\n  @media (max-width:740px){\n    #sc-mj-bundle .sc-mj__wrap{ padding:10px 8px; }\n    #sc-mj-bundle .sc-mj__title{ font-size:16px; }\n    #sc-mj-bundle .sc-mj__refresh{ font-size:11px; padding:4px 8px; }\n    #sc-mj-bundle .sc-mj__grid{ grid-template-columns:repeat(3, 1fr); gap:6px; }\n    #sc-mj-bundle .sc-card__media{ aspect-ratio:1/1; }\n    #sc-mj-bundle .sc-title{ font-size:12px; min-height:28px; }\n    #sc-mj-bundle .sc-opts select{ font-size:11px; padding:5px 6px; }\n    #sc-mj-bundle .sc-card__price{ font-size:12px; }\n  }\n</style>\n\n{% raw %}\n<script>\n(function(){\n  var root = document.getElementById('sc-mj-bundle'); if(!root) return;\n  var wrap = root.querySelector('.sc-mj__wrap');\n  var moneyFmt = wrap.getAttribute('data-money-format') || '${{amount}}';\n  var grid = root.querySelector('.sc-mj__grid');\n  var poolEl = document.getElementById('sc-mj-pool');\n  var pool = [];\n  try { pool = JSON.parse(poolEl.textContent || '[]'); } catch(e){ pool = []; }\n\n  var els = {\n    tier: root.querySelector('[data-tier]'),\n    rrp: root.querySelector('[data-rrp]'),\n    save: root.querySelector('[data-save]'),\n    due: root.querySelector('[data-due]'),\n    refresh: root.querySelector('.sc-mj__refresh'),\n    atc: root.querySelector('.sc-mj__atc')\n  };\n\n  var shownIds = [];\n\n  function toMoney(cents, format){\n    format = format || moneyFmt;\n    var noDec = /\\bamount_no_decimals\\b/.test(format);\n    var n = parseInt(cents,10); if(isNaN(n)) n = 0;\n    var val = (n/100).toFixed(noDec ? 0 : 2);\n    var parts = val.split('.');\n    var intp = parts[0].replace(/\\B(?=(\\d{3})+(?!\\d))/g, ',');\n    var out = noDec ? intp : (intp + '.' + (parts[1] || '00'));\n    return format.replace(/\\{\\{\\s*(amount|amount_no_decimals)\\s*\\}\\}/, out);\n  }\n\n  function uniqueValuesForOption(product, idx){\n    var map = {};\n    for(var i=0;i<product.variants.length;i++){\n      var val = product.variants[i].options[idx] || '';\n      if(val !== '' && !map[val]) map[val] = true;\n    }\n    return Object.keys(map);\n  }\n\n  function findVariant(product, chosen){\n    for(var i=0;i<product.variants.length;i++){\n      var v = product.variants[i], ok = true;\n      for(var j=0;j<chosen.length;j++){\n        if(String(chosen[j]||'') !== String(v.options[j]||'')){ ok = false; break; }\n      }\n      if(ok) return v;\n    }\n    return product.variants[0];\n  }\n\n  function pickNext(){\n    var available = pool.filter(function(p){ return shownIds.indexOf(p.id) === -1; });\n    if(available.length === 0){ shownIds = []; available = pool.slice(); }\n    return available[Math.floor(Math.random()*available.length)];\n  }\n\n  function setIncludeLabel(lblEl, checked){\n    lblEl.lastChild.nodeValue = checked ? ' In bundle' : ' Add to bundle';\n  }\n\n  function buildCard(product){\n    shownIds.push(product.id);\n\n    var v0 = null;\n    for(var i=0;i<product.variants.length;i++){ if(product.variants[i].available){ v0 = product.variants[i]; break; } }\n    if(!v0) v0 = product.variants[0];\n\n    var li = document.createElement('li');\n    li.className = 'sc-card';\n    li.setAttribute('data-product-id', String(product.id));\n\n    var media = document.createElement('a');\n    media.className = 'sc-card__media';\n    media.href = product.url;\n    media.setAttribute('aria-label', product.title);\n\n    var img = document.createElement('img');\n    img.src = product.image560;\n    img.setAttribute('srcset',\n      product.image360 + ' 360w, ' +\n      product.image560 + ' 560w, ' +\n      product.image720 + ' 720w'\n    );\n    img.setAttribute('sizes','(min-width: 990px) 24vw, 30vw');\n    img.width = 560; img.height = 420;\n    img.loading = 'lazy'; img.decoding = 'async'; img.alt = product.title;\n    media.appendChild(img);\n\n    var chip = document.createElement('span');\n    chip.className = 'sc-chip';\n    chip.textContent = 'Michael Jordan';\n    media.appendChild(chip);\n\n    var label = document.createElement('label');\n    label.className = 'sc-check';\n    var cb = document.createElement('input');\n    cb.type = 'checkbox'; cb.className = 'sc-inc'; cb.checked = true;\n    label.appendChild(cb);\n    label.appendChild(document.createTextNode(' In bundle'));\n    media.appendChild(label);\n\n    li.appendChild(media);\n\n    var meta = document.createElement('div');\n    meta.className = 'sc-card__meta';\n    var h = document.createElement('h4'); h.className = 'sc-title';\n    var a = document.createElement('a'); a.href = product.url; a.textContent = product.title;\n    h.appendChild(a); meta.appendChild(h);\n\n    var optsWrap = document.createElement('div');\n    optsWrap.className = 'sc-opts'; meta.appendChild(optsWrap);\n\n    var selects = [];\n    for(var oi=0; oi<product.options.length; oi++){\n      var name = product.options[oi];\n      var values = uniqueValuesForOption(product, oi);\n      if(values.length === 0) continue;\n\n      var sel = document.createElement('select');\n      sel.className = 'sc-variant'; sel.setAttribute('aria-label', name); sel.setAttribute('data-opt', String(oi));\n      for(var vi=0; vi<values.length; vi++){\n        var op = document.createElement('option');\n        op.value = values[vi]; op.textContent = values[vi];\n        sel.appendChild(op);\n      }\n      var pre = (v0.options[oi] || '');\n      if(pre && values.indexOf(pre) !== -1) sel.value = pre;\n\n      optsWrap.appendChild(sel);\n      selects.push(sel);\n    }\n\n    var buy = document.createElement('div');\n    buy.className = 'sc-card__buy';\n    var priceBox = document.createElement('div');\n    priceBox.className = 'sc-card__price';\n    var oldSpan = document.createElement('span'); oldSpan.className = 'old'; oldSpan.setAttribute('data-old','');\n    var priceSpan = document.createElement('span'); priceSpan.setAttribute('data-price','');\n    priceBox.appendChild(oldSpan); priceBox.appendChild(priceSpan);\n    buy.appendChild(priceBox);\n    meta.appendChild(buy);\n    li.appendChild(meta);\n\n    function currentVariant(){\n      var chosen = [];\n      for(var q=0;q<selects.length;q++){ chosen.push(selects[q].value || ''); }\n      return findVariant(product, chosen);\n    }\n\n    function updatePriceUI(){\n      var v = currentVariant();\n      li.setAttribute('data-variant-id', String(v.id));\n      li.setAttribute('data-variant-price', String(v.price));\n      priceSpan.textContent = toMoney(v.price);\n      oldSpan.textContent = '';\n    }\n\n    for(var z=0; z<selects.length; z++){\n      selects[z].addEventListener('change', function(){ updatePriceUI(); updateTotals(); }, {passive:true});\n    }\n    cb.addEventListener('change', function(){\n      setIncludeLabel(label, cb.checked); updateTotals();\n    }, {passive:true});\n\n    updatePriceUI();\n    return li;\n  }\n\n  function includedCards(){\n    var cards = grid.querySelectorAll('.sc-card'); var out = [];\n    for(var i=0;i<cards.length;i++){\n      var inc = cards[i].querySelector('.sc-inc'); if(inc && inc.checked) out.push(cards[i]);\n    }\n    return out;\n  }\n\n  var rafId = null;\n  function updateTotals(){\n    if(rafId) cancelAnimationFrame(rafId);\n    rafId = requestAnimationFrame(function(){\n      var inc = includedCards();\n      var count = inc.length, rrp = 0;\n      for(var i=0;i<inc.length;i++){\n        var p = parseInt(inc[i].getAttribute('data-variant-price') || '0',10);\n        if(!isNaN(p)) rrp += p;\n      }\n\n      var rate = count >= 2 ? 0.25 : 0;\n      var save = Math.round(rrp * rate);\n      var due = rrp - save;\n\n      els.tier.textContent = count >= 2\n        ? 'Buy 2+ → 15% Collector Bonus'\n        : 'Buy 2+ → 15% Collector Bonus';\n\n      els.rrp.textContent = toMoney(rrp);\n      els.save.textContent = rate ? ('-' + toMoney(save)) : toMoney(0);\n      els.due.textContent = toMoney(due);\n\n      var disabled = (count < 2);\n      els.atc.disabled = disabled;\n      els.atc.setAttribute('aria-disabled', String(disabled));\n      rafId = null;\n    });\n  }\n\n  function mountInitial(){\n    grid.innerHTML = ''; shownIds = [];\n    var picks = pool.slice(0,3);\n    for(var i=0;i<picks.length;i++){ grid.appendChild(buildCard(picks[i])); }\n    updateTotals();\n  }\n\n  function refreshUnticked(){\n    var cards = grid.querySelectorAll('.sc-card');\n    for(var i=0;i<cards.length;i++){\n      var card = cards[i];\n      var inc = card.querySelector('.sc-inc');\n      if(inc && !inc.checked){\n        var fresh = buildCard(pickNext());\n        grid.replaceChild(fresh, card);\n      }\n    }\n    updateTotals();\n  }\n\n  async function addBundleToCart(){\n    var inc = includedCards(); if(inc.length < 2) return;\n    var items = [];\n    for(var i=0;i<inc.length;i++){\n      var id = parseInt(inc[i].getAttribute('data-variant-id') || '0',10);\n      if(id) items.push({ id: id, quantity: 1 });\n    }\n    if(items.length < 2) return;\n\n    try{\n      await fetch('/cart/add.js', {\n        method: 'POST', headers: { 'Content-Type': 'application/json' },\n        body: JSON.stringify({ items: items })\n      });\n      window.location.href = '/cart';\n    }catch(e){\n      els.atc.textContent = 'Try again';\n      setTimeout(function(){ els.atc.textContent = 'Add bundle to cart'; }, 1200);\n    }\n  }\n\n  els.refresh.addEventListener('click', refreshUnticked);\n  els.atc.addEventListener('click', addBundleToCart);\n  mountInitial();\n})();\n</script>\n{% endraw %}\n\n{%- endif -%}"
      }
    },
    "custom_liquid_9NiXHA": {
      "type": "custom-liquid",
      "name": "reviews HTML",
      "settings": {
        "full_width": false,
        "show_space": false,
        "code": "{%- comment -%}\nSPORTS CAVE • Compact Floating Reviews (white, elevated, 15% scroll reveal)\n{%- endcomment -%}\n\n<section class=\"sc-fr-mini sc-fr--white sc-fr--compact sc-fr--elevated is-hidden\"\n  role=\"region\" aria-label=\"What real Jordan fans are saying\" tabindex=\"-1\">\n  <!-- Close -->\n  <button class=\"sc-fr-mini__close\" aria-label=\"Close reviews\">×</button>\n\n  <!-- Arrows -->\n  <button class=\"sc-fr-mini__nav sc-fr-mini__nav--prev\" aria-label=\"Previous review\">\n    <svg viewBox=\"0 0 24 24\" class=\"chev\"><path d=\"M15 6l-6 6 6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n  </button>\n  <button class=\"sc-fr-mini__nav sc-fr-mini__nav--next\" aria-label=\"Next review\">\n    <svg viewBox=\"0 0 24 24\" class=\"chev\"><path d=\"M9 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n  </button>\n\n  <a class=\"sc-fr-mini__card\" href=\"#scx-reviews-anchor\" aria-label=\"Read real Jordan reviews\">\n    <header class=\"sc-fr-mini__head\">\n      <span class=\"sc-fr-mini__kicker\">WHAT REAL JORDAN FANS ARE SAYING</span>\n    </header>\n\n    <div class=\"sc-fr-mini__slides\" aria-live=\"polite\">\n      <figure class=\"sc-fr-mini__slide is-active\">\n        <img src=\"{{ 'Jordan_Testimonial_2.jpg' | file_img_url: width: 220 }}\" width=\"56\" height=\"56\"\n             loading=\"lazy\" decoding=\"async\" alt=\"Customer photo: MJ wall art unboxed\">\n        <figcaption>\n          <p class=\"sc-fr-mini__quote\">\n            “Absolutely unreal. My Michael Jordan wall art looks even better in person. The colours, the detail — a true collector’s piece. Fast delivery, premium frame.”\n          </p>\n          <div class=\"sc-fr-mini__meta\">\n            <span class=\"name\">Chris M.</span>\n            <span class=\"sc-verified-badge\" aria-label=\"Verified buyer\">\n              <svg viewBox=\"0 0 20 20\" class=\"sc-verified-icon\" aria-hidden=\"true\"><path d=\"M10 .8l8.2 4.7v9L10 19.2 1.8 14.5v-9L10 .8zM9 13.6l6.1-6-1.3-1.3L9 10.1 6.3 7.4 5 8.7l4 4.9z\"/></svg>\n              <span>Verified buyer</span>\n            </span>\n            <span class=\"rating\" aria-label=\"Rating 4.9 out of 5\">\n              <strong>4.9/5</strong>\n              <span class=\"stars\" aria-hidden=\"true\">\n                <svg viewBox=\"0 0 20 20\" class=\"star\"><path d=\"M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.9L10 14.9 4.8 17.7l1-5.9L1.5 7.7l5.9-.9L10 1.5z\"/></svg>\n                <svg viewBox=\"0 0 20 20\" class=\"star\"><path d=\"M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.9L10 14.9 4.8 17.7l1-5.9L1.5 7.7l5.9-.9L10 1.5z\"/></svg>\n                <svg viewBox=\"0 0 20 20\" class=\"star\"><path d=\"M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.9L10 14.9 4.8 17.7l1-5.9L1.5 7.7l5.9-.9L10 1.5z\"/></svg>\n                <svg viewBox=\"0 0 20 20\" class=\"star\"><path d=\"M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.9L10 14.9 4.8 17.7l1-5.9L1.5 7.7l5.9-.9L10 1.5z\"/></svg>\n                <svg viewBox=\"0 0 20 20\" class=\"star\"><path d=\"M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.9L10 14.9 4.8 17.7l1-5.9L1.5 7.7l5.9-.9L10 1.5z\"/></svg>\n              </span>\n            </span>\n          </div>\n        </figcaption>\n      </figure>\n\n      <figure class=\"sc-fr-mini__slide\">\n        <img src=\"{{ 'Jordan_Testimonial.jpg' | file_img_url: width: 220 }}\" width=\"56\" height=\"56\"\n             loading=\"lazy\" decoding=\"async\" alt=\"Customer photo: MJ wall art on wall\">\n        <figcaption>\n          <p class=\"sc-fr-mini__quote\">\n            “Literally just unboxed it — looks insane! The quality is way better than I expected. Can’t wait to hang this up in the cave.”\n          </p>\n          <div class=\"sc-fr-mini__meta\">\n            <span class=\"name\">Jason R.</span>\n            <span class=\"sc-verified-badge\" aria-label=\"Verified buyer\">\n              <svg viewBox=\"0 0 20 20\" class=\"sc-verified-icon\" aria-hidden=\"true\"><path d=\"M10 .8l8.2 4.7v9L10 19.2 1.8 14.5v-9L10 .8zM9 13.6l6.1-6-1.3-1.3L9 10.1 6.3 7.4 5 8.7l4 4.9z\"/></svg>\n              <span>Verified buyer</span>\n            </span>\n            <span class=\"rating\" aria-label=\"Rating 4.9 out of 5\">\n              <strong>4.9/5</strong>\n              <span class=\"stars\" aria-hidden=\"true\">\n                <svg viewBox=\"0 0 20 20\" class=\"star\"><path d=\"M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.9L10 14.9 4.8 17.7l1-5.9L1.5 7.7l5.9-.9L10 1.5z\"/></svg>\n                <svg viewBox=\"0 0 20 20\" class=\"star\"><path d=\"M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.9L10 14.9 4.8 17.7l1-5.9L1.5 7.7l5.9-.9L10 1.5z\"/></svg>\n                <svg viewBox=\"0 0 20 20\" class=\"star\"><path d=\"M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.9L10 14.9 4.8 17.7l1-5.9L1.5 7.7l5.9-.9L10 1.5z\"/></svg>\n                <svg viewBox=\"0 0 20 20\" class=\"star\"><path d=\"M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.9L10 14.9 4.8 17.7l1-5.9L1.5 7.7l5.9-.9L10 1.5z\"/></svg>\n                <svg viewBox=\"0 0 20 20\" class=\"star\"><path d=\"M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.9L10 14.9 4.8 17.7l1-5.9L1.5 7.7l5.9-.9L10 1.5z\"/></svg>\n              </span>\n            </span>\n          </div>\n        </figcaption>\n      </figure>\n    </div>\n  </a>\n</section>\n\n<style>\n  .sc-fr-mini{\n    --gold:#F7A007; --ink:#0A0A0A;\n    position:fixed; right:16px; bottom:calc(16px + env(safe-area-inset-bottom));\n    z-index:9999; font-family:var(--sc-font-ui);\n    max-width:min(36vw,560px); width:min(36vw,560px); min-width:260px;\n    transition:opacity .28s ease, transform .28s ease, visibility .28s ease;\n  }\n  .sc-fr-mini.is-hidden{ opacity:0; visibility:hidden; transform:translateY(14px); pointer-events:none; }\n  .sc-fr-mini.is-shown{ opacity:1; visibility:visible; transform:none; }\n\n  @media (max-width: 900px){\n    .sc-fr-mini{ max-width:92vw; width:92vw; right:4vw; }\n  }\n\n  .sc-fr--white.sc-fr--compact .sc-fr-mini__card{\n    display:block; text-decoration:none; color:var(--ink);\n    background:\n      linear-gradient(#fff, #fff) padding-box,\n      linear-gradient(140deg, rgba(247,160,7,.55), rgba(0,0,0,0) 60%) border-box;\n    border:1px solid transparent; border-radius:14px; padding:10px 12px;\n    box-shadow:0 18px 48px rgba(0,0,0,.18), 0 1px 0 rgba(255,255,255,.7) inset;\n    backdrop-filter:saturate(120%);\n  }\n  \n  .sc-fr--elevated .sc-fr-mini__card::after{\n    content:\"\"; position:absolute; inset:-6px; z-index:-1; border-radius:18px;\n    background:radial-gradient(24% 40% at 80% 0%, rgba(247,160,7,.18), transparent 60%);\n    filter:blur(8px);\n  }\n\n  .sc-fr-mini__head{ display:flex; align-items:center; margin-bottom:6px; }\n  .sc-fr-mini__kicker{\n    letter-spacing:.12em; text-transform:uppercase; font-weight:700; font-size:10px; color:#333;\n    white-space:nowrap; overflow:hidden; text-overflow:ellipsis;\n  }\n  @media (max-width:480px){ .sc-fr-mini__head{ display:none; } }\n\n  \n  .sc-fr-mini__slides{ position:relative; display:grid; }\n  .sc-fr-mini__slide{\n    grid-area:1/1; display:grid; grid-template-columns:56px 1fr; gap:10px; margin:0; align-items:center;\n    opacity:0; transform:translateY(6px); transition:opacity .24s ease, transform .24s ease;\n  }\n  .sc-fr-mini__slide.is-active{ opacity:1; transform:none; }\n  .sc-fr-mini__slide img{\n    width:56px; height:56px; object-fit:cover; border-radius:10px; border:1px solid #EEE; box-shadow:0 4px 10px rgba(0,0,0,.06);\n  }\n\n  .sc-fr-mini__quote{\n    margin:0; color:#222; font-size:clamp(12px,1.2vw,13px); line-height:1.35;\n    display:-webkit-box; -webkit-box-orient:vertical; -webkit-line-clamp:3; overflow:hidden;\n  }\n\n  \n  .sc-fr-mini__meta{\n    margin-top:6px; display:flex; align-items:center; gap:10px; flex-wrap:wrap;\n    font-size:12px; color:#333;\n  }\n  .sc-fr-mini .name{ font-weight:700; }\n  .sc-verified-badge{ display:inline-flex; align-items:center; gap:5px; font-size:11px; color:#2c2c2c; }\n  .sc-verified-icon{ width:14px; height:14px; fill:#34C77B; }\n  .rating{ display:inline-flex; align-items:center; gap:6px; white-space:nowrap; }\n  .rating strong{ font-size:12px; }\n  .stars{ display:inline-flex; gap:1px; }\n  .star{ width:12px; height:12px; fill:var(--gold); display:block; }\n\n  \n  .sc-fr-mini__nav{\n    position:absolute; top:50%; transform:translateY(-50%); z-index:2;\n    width:26px; height:26px; border-radius:999px; border:1px solid #E0E0E0; background:var(--sc-brand-ivory); color:#111;\n    display:grid; place-items:center; box-shadow:0 6px 16px rgba(0,0,0,.10); cursor:pointer;\n  }\n  .sc-fr-mini__nav .chev{ width:16px; height:16px; }\n  .sc-fr-mini__nav--prev{ left:-12px; }\n  .sc-fr-mini__nav--next{ right:-12px; }\n  .sc-fr-mini__nav:focus{ outline:2px solid var(--gold); outline-offset:2px; }\n\n  \n  .sc-fr-mini__close{\n    position:absolute; top:-12px; right:-12px; width:26px; height:26px;\n    border-radius:999px; border:1px solid #E0E0E0; background:var(--sc-brand-ivory); color:#111;\n    font:700 18px/22px inherit; text-align:center; cursor:pointer; box-shadow:0 8px 20px rgba(0,0,0,.15);\n  }\n</style>\n\n<script>\n\n(function(){\n  const KEY='sc_fr_mini_hide_ts_v4';\n  const root=document.querySelector('.sc-fr-mini'); if(!root) return;\n\n  // Dismiss persistence\n  try{\n    const ts=+localStorage.getItem(KEY)||0;\n    if(Date.now()-ts < 7*24*60*60*1000){ root.remove(); return; }\n  }catch(_){}\n\n  // Show after 15% scroll progress\n  let shown=false, ticking=false;\n  const showIfThreshold=()=>{\n    const doc = document.documentElement;\n    const maxScroll = (doc.scrollHeight - window.innerHeight) || 1;\n    const pct = (window.scrollY / maxScroll) * 100;\n    if(!shown && pct >= 15){\n      shown = true;\n      root.classList.remove('is-hidden');\n      root.classList.add('is-shown');\n    }\n    ticking=false;\n  };\n  const onScroll=()=>{ if(!ticking){ ticking=true; requestAnimationFrame(showIfThreshold); } };\n  window.addEventListener('scroll', onScroll, { passive:true });\n  window.addEventListener('resize', onScroll, { passive:true });\n  // run once in case user starts mid-page\n  onScroll();\n\n  // Close\n  root.querySelector('.sc-fr-mini__close').addEventListener('click', e=>{\n    e.preventDefault(); e.stopPropagation();\n    root.remove(); try{ localStorage.setItem(KEY, Date.now()); }catch(_){}\n  });\n\n  // Slides\n  const slides=Array.from(root.querySelectorAll('.sc-fr-mini__slide'));\n  let i=0; slides[i]?.classList.add('is-active');\n\n  const prevBtn=root.querySelector('.sc-fr-mini__nav--prev');\n  const nextBtn=root.querySelector('.sc-fr-mini__nav--next');\n\n  function show(idx){\n    slides[i]?.classList.remove('is-active');\n    i=(idx+slides.length)%slides.length;\n    slides[i]?.classList.add('is-active');\n  }\n  function next(){ show(i+1); }\n  function prev(){ show(i-1); }\n\n  let timer=setInterval(next, 5000);\n  root.addEventListener('mouseenter', ()=>clearInterval(timer));\n  root.addEventListener('mouseleave', ()=>{ timer=setInterval(next, 5000); });\n\n  prevBtn.addEventListener('click', e=>{ e.preventDefault(); e.stopPropagation(); prev(); });\n  nextBtn.addEventListener('click', e=>{ e.preventDefault(); e.stopPropagation(); next(); });\n\n  root.addEventListener('keydown', e=>{ if(e.key==='ArrowRight') next(); if(e.key==='ArrowLeft') prev(); });\n})();\n</script>"
      }
