    "custom_liquid_qC7Xhe": {
      "type": "custom-liquid",
      "name": "Jordan Collection HTML",
      "settings": {
        "full_width": true,
        "show_space": false,
        "code": "{%- comment -%}\nSPORTS CAVE • MJ CARDS (PREMIUM COLLECTOR VERSION + LIVE VARIANT PRICING + CART DRAWER)\nChanges applied:\n- Removed top intro text block\n- \"The Mentality Jordan vs Bryant Wall Art\" forced first + Trending\n- \"Michael Jordan Dunk Wall Art\" forced Sold Out\n- Only \"The Mentality\" + \"Last Shot\" show \"Only a few left\"\n- All others show \"Limited Release\"\n- Premium collector card styling\n- Variant price updates live when size / frame changes\n- Variant image swaps live when variant changes\n- Secure Yours adds to cart and attempts to open cart drawer live\n- Added View Product button beside Secure Yours\n{%- endcomment -%}\n\n<link rel=\"preconnect\" href=\"https://cdn.shopify.com\" crossorigin>\n\n{%- assign coll = collections['michael-jordan-wall-art'] | default: collection -%}\n{%- assign fp = coll.products | first -%}\n{%- if fp and fp.featured_media -%}\n  <link rel=\"preload\" as=\"image\" href=\"{{ fp.featured_media | image_url: width: 1200 }}\">\n{%- endif -%}\n\n<section class=\"sc-mj-cardsELITE\" aria-label=\"Michael Jordan wall art — limited edition collector prints\">\n  <ul class=\"el-grid\" role=\"list\">\n\n    {%- assign rendered_handles = '' -%}\n\n    {%- comment -%} Pass 1: force The Mentality first {%- endcomment -%}\n    {%- for product in coll.products -%}\n      {%- assign title_lc = product.title | downcase -%}\n      {%- if title_lc contains 'mentality' -%}\n        {%- assign rendered_handles = rendered_handles | append: product.handle | append: '|' -%}\n\n        {%- assign img = product.featured_media | default: product.media.first -%}\n        {%- assign v = product.selected_or_first_available_variant -%}\n\n        {%- assign f_idx = -1 -%}{%- assign s_idx = -1 -%}\n        {%- for opt in product.options -%}\n          {%- assign o = opt | downcase -%}\n          {%- if f_idx == -1 and o contains 'frame' -%}{%- assign f_idx = forloop.index0 -%}{%- endif -%}\n          {%- if f_idx == -1 and o contains 'style' -%}{%- assign f_idx = forloop.index0 -%}{%- endif -%}\n          {%- if f_idx == -1 and o contains 'colour' -%}{%- assign f_idx = forloop.index0 -%}{%- endif -%}\n          {%- if f_idx == -1 and o contains 'color' -%}{%- assign f_idx = forloop.index0 -%}{%- endif -%}\n          {%- if s_idx == -1 and o contains 'size' -%}{%- assign s_idx = forloop.index0 -%}{%- endif -%}\n        {%- endfor -%}\n        {%- if f_idx == -1 -%}{%- assign f_idx = 0 -%}{%- endif -%}\n        {%- if s_idx == -1 -%}{%- assign s_idx = 1 -%}{%- endif -%}\n\n        {%- capture variants_json -%}\n        [\n          {%- for vr in product.variants -%}\n          {\n            \"id\": {{ vr.id }},\n            \"available\": {{ vr.available | json }},\n            \"price_fmt\": {{ vr.price | money_with_currency | json }},\n            \"o0\": {{ vr.option1 | json }},\n            \"o1\": {{ vr.option2 | json }},\n            \"o2\": {{ vr.option3 | json }},\n            \"m480\": {{ vr.featured_media | default: img | image_url: width: 480 | json }},\n            \"m720\": {{ vr.featured_media | default: img | image_url: width: 720 | json }},\n            \"m960\": {{ vr.featured_media | default: img | image_url: width: 960 | json }},\n            \"m1200\": {{ vr.featured_media | default: img | image_url: width: 1200 | json }}\n          }{%- unless forloop.last -%},{%- endunless -%}\n          {%- endfor -%}\n        ]\n        {%- endcapture -%}\n\n        {%- assign guide_img = '' -%}\n        {%- if product.metafields.custom.size_guide and product.metafields.custom.size_guide.value != blank -%}\n          {%- assign guide_img = product.metafields.custom.size_guide.value | image_url: width: 900 -%}\n        {%- else -%}\n          {%- for m in product.media -%}\n            {%- if m.media_type == 'image' and m.alt and m.alt != blank -%}\n              {%- assign alt_lc = m.alt | downcase -%}\n              {%- if alt_lc contains 'size' or alt_lc contains 'sizing' -%}\n                {%- assign guide_img = m | image_url: width: 900 -%}{%- break -%}\n              {%- endif -%}\n            {%- endif -%}\n          {%- endfor -%}\n        {%- endif -%}\n\n        {%- assign seen_frames = '' -%}{%- capture frame_swatches -%}{%- endcapture -%}\n        {%- for vr in product.variants -%}\n          {%- assign fv = vr.options[f_idx] -%}\n          {%- assign tk = '|' | append: fv | append: '|' -%}\n          {%- unless seen_frames contains tk -%}\n            {%- assign fkey = fv | replace: '\"','' | downcase -%}\n            {%- assign fid  = 'f-' | append: product.id | append: '-' | append: forloop.index -%}\n            {%- capture frame_swatches -%}\n              {{ frame_swatches }}\n              <input type=\"radio\" class=\"opt-btn visually-hidden js-opt js-frame\" id=\"{{ fid }}\" name=\"frame-{{ product.id }}\" value=\"{{ fv | escape }}\" {% if v.options[f_idx] == fv %}checked{% endif %}>\n              <label for=\"{{ fid }}\" class=\"opt-label opt-label--swatch btn\" data-swatch=\"{{ fkey }}\"><span class=\"visually-hidden js-value\">{{ fv }}</span></label>\n            {%- endcapture -%}\n            {%- assign seen_frames = seen_frames | append: tk -%}\n          {%- endunless -%}\n        {%- endfor -%}\n\n        {%- assign seen_sizes = '' -%}{%- capture size_swatches -%}{%- endcapture -%}\n        {%- for vr in product.variants -%}\n          {%- assign sv = vr.options[s_idx] -%}\n          {%- assign tk2 = '|' | append: sv | append: '|' -%}\n          {%- unless seen_sizes contains tk2 -%}\n            {%- assign sv_short = sv | split: ' - ' | first -%}\n            {%- assign sid = 's-' | append: product.id | append: '-' | append: forloop.index -%}\n            {%- capture size_swatches -%}\n              {{ size_swatches }}\n              <input type=\"radio\" class=\"opt-btn visually-hidden js-opt js-size\" id=\"{{ sid }}\" name=\"size-{{ product.id }}\" value=\"{{ sv | escape }}\" {% if v.options[s_idx] == sv %}checked{% endif %}>\n              <label for=\"{{ sid }}\" class=\"opt-label opt-label--btn btn text-center\"><span class=\"js-value\">{{ sv_short }}</span></label>\n            {%- endcapture -%}\n            {%- assign seen_sizes = seen_sizes | append: tk2 -%}\n          {%- endunless -%}\n        {%- endfor -%}\n\n        <li class=\"el-card el-card--featured\"\n            itemscope itemtype=\"https://schema.org/Product\"\n            data-variants='{{ variants_json | escape }}'\n            data-fidx=\"{{ f_idx }}\" data-sidx=\"{{ s_idx }}\">\n\n          <meta itemprop=\"name\" content=\"{{ product.title | escape }} – Michael Jordan Wall Art\">\n          <meta itemprop=\"brand\" content=\"Sports Cave\">\n          {%- if img -%}<meta itemprop=\"image\" content=\"{{ img | image_url: width: 1200 }}\">{%- endif -%}\n\n          <a class=\"el-link\" href=\"{{ product.url }}\" itemprop=\"url\" aria-label=\"{{ product.title | escape }}\">\n            {%- if img -%}\n              <img class=\"el-img\"\n                   src=\"{{ img | image_url: width: 720 }}\"\n                   srcset=\"{{ img | image_url: width: 480 }} 480w, {{ img | image_url: width: 720 }} 720w, {{ img | image_url: width: 960 }} 960w, {{ img | image_url: width: 1200 }} 1200w\"\n                   sizes=\"(min-width: 990px) 31vw, 92vw\"\n                   width=\"{{ img.width }}\" height=\"{{ img.height }}\"\n                   alt=\"{{ product.title | escape }} – Michael Jordan wall art\"\n                   loading=\"eager\"\n                   fetchpriority=\"high\"\n                   decoding=\"async\">\n            {%- endif -%}\n            <span class=\"el-badge el-badge--best\">Limited Edition</span>\n          </a>\n\n          <div class=\"el-meta\">\n            <h3 class=\"el-title\" itemprop=\"name\">{{ product.title }}</h3>\n\n            <form class=\"el-atc\" method=\"post\" action=\"/cart/add\" data-product-id=\"{{ product.id }}\" data-product-url=\"{{ product.url }}\">\n              <input type=\"hidden\" name=\"id\" value=\"{{ v.id }}\">\n\n              <div class=\"el-opts\">\n                <fieldset class=\"option-selector\" data-selector-type=\"listed\" data-option=\"Size\">\n                  <legend class=\"visually-hidden\">Artwork size</legend>\n                  <div class=\"el-size-row\">\n                    <div class=\"option-selector__btns el-sizes\">{{ size_swatches }}</div>\n                    <button type=\"button\"\n                            class=\"el-sizeguide\"\n                            data-open-sizeguide\n                            data-guide=\"{{ guide_img }}\"\n                            aria-haspopup=\"dialog\" aria-controls=\"size-guide-modal\">\n                      Size Guide\n                    </button>\n                  </div>\n                </fieldset>\n\n                <fieldset class=\"option-selector\" data-selector-type=\"listed\" data-option=\"Frame\">\n                  <legend class=\"visually-hidden\">Frame</legend>\n                  <div class=\"option-selector__btns el-frames\">{{ frame_swatches }}</div>\n                </fieldset>\n              </div>\n\n              <div class=\"el-buy\">\n                <div class=\"el-price\" itemprop=\"offers\" itemscope itemtype=\"https://schema.org/Offer\" aria-live=\"polite\">\n                  <meta itemprop=\"priceCurrency\" content=\"{{ cart.currency.iso_code }}\">\n                  <link itemprop=\"availability\" href=\"https://schema.org/{% if product.available %}InStock{% else %}OutOfStock{% endif %}\">\n                  <span class=\"el-price__val\" data-price itemprop=\"price\">{{ v.price | money_with_currency }}</span>\n                  <div class=\"el-stock\">Only a few left</div>\n                </div>\n                <div class=\"el-actions\">\n                  <button type=\"submit\" class=\"el-btn el-btn--primary\" {% unless product.available %}disabled{% endunless %} aria-label=\"Secure {{ product.title | escape }}\">\n                    <span>Secure Yours</span>\n                  </button>\n                  <a href=\"{{ product.url }}\" class=\"el-btn el-btn--ghost\" aria-label=\"View {{ product.title | escape }}\">View Product</a>\n                </div>\n              </div>\n\n              <div class=\"el-trust\">Numbered Edtions • 30 Day Guarantee</div>\n            </form>\n          </div>\n        </li>\n      {%- endif -%}\n    {%- endfor -%}\n\n    {%- comment -%} Pass 2: render remaining products {%- endcomment -%}\n    {%- for product in coll.products limit: 12 -%}\n      {%- assign handle_token = product.handle | append: '|' -%}\n      {%- unless rendered_handles contains handle_token -%}\n        {%- assign title_lc = product.title | downcase -%}\n        {%- assign img = product.featured_media | default: product.media.first -%}\n        {%- assign v = product.selected_or_first_available_variant -%}\n        {%- assign force_sold_out = false -%}\n        {%- assign stock_text = 'Limited Release' -%}\n        {%- assign badge_text = 'Limited Edition' -%}\n\n        {%- if title_lc contains 'dunk' -%}\n          {%- assign force_sold_out = true -%}\n          {%- assign badge_text = 'Sold Out' -%}\n        {%- endif -%}\n        {%- if title_lc contains 'last shot' -%}\n          {%- assign stock_text = 'Only a few left' -%}\n        {%- endif -%}\n\n        {%- assign f_idx = -1 -%}{%- assign s_idx = -1 -%}\n        {%- for opt in product.options -%}\n          {%- assign o = opt | downcase -%}\n          {%- if f_idx == -1 and o contains 'frame' -%}{%- assign f_idx = forloop.index0 -%}{%- endif -%}\n          {%- if f_idx == -1 and o contains 'style' -%}{%- assign f_idx = forloop.index0 -%}{%- endif -%}\n          {%- if f_idx == -1 and o contains 'colour' -%}{%- assign f_idx = forloop.index0 -%}{%- endif -%}\n          {%- if f_idx == -1 and o contains 'color' -%}{%- assign f_idx = forloop.index0 -%}{%- endif -%}\n          {%- if s_idx == -1 and o contains 'size' -%}{%- assign s_idx = forloop.index0 -%}{%- endif -%}\n        {%- endfor -%}\n        {%- if f_idx == -1 -%}{%- assign f_idx = 0 -%}{%- endif -%}\n        {%- if s_idx == -1 -%}{%- assign s_idx = 1 -%}{%- endif -%}\n\n        {%- capture variants_json -%}\n        [\n          {%- for vr in product.variants -%}\n          {\n            \"id\": {{ vr.id }},\n            \"available\": {% if force_sold_out %}false{% else %}{{ vr.available | json }}{% endif %},\n            \"price_fmt\": {{ vr.price | money_with_currency | json }},\n            \"o0\": {{ vr.option1 | json }},\n            \"o1\": {{ vr.option2 | json }},\n            \"o2\": {{ vr.option3 | json }},\n            \"m480\": {{ vr.featured_media | default: img | image_url: width: 480 | json }},\n            \"m720\": {{ vr.featured_media | default: img | image_url: width: 720 | json }},\n            \"m960\": {{ vr.featured_media | default: img | image_url: width: 960 | json }},\n            \"m1200\": {{ vr.featured_media | default: img | image_url: width: 1200 | json }}\n          }{%- unless forloop.last -%},{%- endunless -%}\n          {%- endfor -%}\n        ]\n        {%- endcapture -%}\n\n        {%- assign guide_img = '' -%}\n        {%- if product.metafields.custom.size_guide and product.metafields.custom.size_guide.value != blank -%}\n          {%- assign guide_img = product.metafields.custom.size_guide.value | image_url: width: 900 -%}\n        {%- else -%}\n          {%- for m in product.media -%}\n            {%- if m.media_type == 'image' and m.alt and m.alt != blank -%}\n              {%- assign alt_lc = m.alt | downcase -%}\n              {%- if alt_lc contains 'size' or alt_lc contains 'sizing' -%}\n                {%- assign guide_img = m | image_url: width: 900 -%}{%- break -%}\n              {%- endif -%}\n            {%- endif -%}\n          {%- endfor -%}\n        {%- endif -%}\n\n        {%- assign seen_frames = '' -%}{%- capture frame_swatches -%}{%- endcapture -%}\n        {%- for vr in product.variants -%}\n          {%- assign fv = vr.options[f_idx] -%}\n          {%- assign tk = '|' | append: fv | append: '|' -%}\n          {%- unless seen_frames contains tk -%}\n            {%- assign fkey = fv | replace: '\"','' | downcase -%}\n            {%- assign fid  = 'f-' | append: product.id | append: '-' | append: forloop.index -%}\n            {%- capture frame_swatches -%}\n              {{ frame_swatches }}\n              <input type=\"radio\" class=\"opt-btn visually-hidden js-opt js-frame\" id=\"{{ fid }}\" name=\"frame-{{ product.id }}\" value=\"{{ fv | escape }}\" {% if v.options[f_idx] == fv %}checked{% endif %}>\n              <label for=\"{{ fid }}\" class=\"opt-label opt-label--swatch btn\" data-swatch=\"{{ fkey }}\"><span class=\"visually-hidden js-value\">{{ fv }}</span></label>\n            {%- endcapture -%}\n            {%- assign seen_frames = seen_frames | append: tk -%}\n          {%- endunless -%}\n        {%- endfor -%}\n\n        {%- assign seen_sizes = '' -%}{%- capture size_swatches -%}{%- endcapture -%}\n        {%- for vr in product.variants -%}\n          {%- assign sv = vr.options[s_idx] -%}\n          {%- assign tk2 = '|' | append: sv | append: '|' -%}\n          {%- unless seen_sizes contains tk2 -%}\n            {%- assign sv_short = sv | split: ' - ' | first -%}\n            {%- assign sid = 's-' | append: product.id | append: '-' | append: forloop.index -%}\n            {%- capture size_swatches -%}\n              {{ size_swatches }}\n              <input type=\"radio\" class=\"opt-btn visually-hidden js-opt js-size\" id=\"{{ sid }}\" name=\"size-{{ product.id }}\" value=\"{{ sv | escape }}\" {% if v.options[s_idx] == sv %}checked{% endif %}>\n              <label for=\"{{ sid }}\" class=\"opt-label opt-label--btn btn text-center\"><span class=\"js-value\">{{ sv_short }}</span></label>\n            {%- endcapture -%}\n            {%- assign seen_sizes = seen_sizes | append: tk2 -%}\n          {%- endunless -%}\n        {%- endfor -%}\n\n        <li class=\"el-card\"\n            itemscope itemtype=\"https://schema.org/Product\"\n            data-variants='{{ variants_json | escape }}'\n            data-fidx=\"{{ f_idx }}\" data-sidx=\"{{ s_idx }}\">\n\n          <meta itemprop=\"name\" content=\"{{ product.title | escape }} – Michael Jordan Wall Art\">\n          <meta itemprop=\"brand\" content=\"Sports Cave\">\n          {%- if img -%}<meta itemprop=\"image\" content=\"{{ img | image_url: width: 1200 }}\">{%- endif -%}\n\n          <a class=\"el-link\" href=\"{{ product.url }}\" itemprop=\"url\" aria-label=\"{{ product.title | escape }}\">\n            {%- if img -%}\n              <img class=\"el-img\"\n                   src=\"{{ img | image_url: width: 720 }}\"\n                   srcset=\"{{ img | image_url: width: 480 }} 480w, {{ img | image_url: width: 720 }} 720w, {{ img | image_url: width: 960 }} 960w, {{ img | image_url: width: 1200 }} 1200w\"\n                   sizes=\"(min-width: 990px) 31vw, 92vw\"\n                   width=\"{{ img.width }}\" height=\"{{ img.height }}\"\n                   alt=\"{{ product.title | escape }} – Michael Jordan wall art\"\n                   loading=\"lazy\"\n                   fetchpriority=\"low\"\n                   decoding=\"async\">\n            {%- endif -%}\n            <span class=\"el-badge{% if force_sold_out %} el-badge--sold{% endif %}\">{{ badge_text }}</span>\n          </a>\n\n          <div class=\"el-meta\">\n            <h3 class=\"el-title\" itemprop=\"name\">{{ product.title }}</h3>\n\n            <form class=\"el-atc\" method=\"post\" action=\"/cart/add\" data-product-id=\"{{ product.id }}\" data-product-url=\"{{ product.url }}\">\n              <input type=\"hidden\" name=\"id\" value=\"{{ v.id }}\">\n\n              <div class=\"el-opts\">\n                <fieldset class=\"option-selector\" data-selector-type=\"listed\" data-option=\"Size\">\n                  <legend class=\"visually-hidden\">Artwork size</legend>\n                  <div class=\"el-size-row\">\n                    <div class=\"option-selector__btns el-sizes\">{{ size_swatches }}</div>\n                    <button type=\"button\"\n                            class=\"el-sizeguide\"\n                            data-open-sizeguide\n                            data-guide=\"{{ guide_img }}\"\n                            aria-haspopup=\"dialog\" aria-controls=\"size-guide-modal\">\n                      Size Guide\n                    </button>\n                  </div>\n                </fieldset>\n\n                <fieldset class=\"option-selector\" data-selector-type=\"listed\" data-option=\"Frame\">\n                  <legend class=\"visually-hidden\">Frame</legend>\n                  <div class=\"option-selector__btns el-frames\">{{ frame_swatches }}</div>\n                </fieldset>\n              </div>\n\n              <div class=\"el-buy\">\n                <div class=\"el-price\" itemprop=\"offers\" itemscope itemtype=\"https://schema.org/Offer\" aria-live=\"polite\">\n                  <meta itemprop=\"priceCurrency\" content=\"{{ cart.currency.iso_code }}\">\n                  <link itemprop=\"availability\" href=\"https://schema.org/{% if force_sold_out %}OutOfStock{% elsif product.available %}InStock{% else %}OutOfStock{% endif %}\">\n                  <span class=\"el-price__val\" data-price itemprop=\"price\">{{ v.price | money_with_currency }}</span>\n                  <div class=\"el-stock\">{{ stock_text }}</div>\n                </div>\n                <div class=\"el-actions\">\n                  <button type=\"submit\" class=\"el-btn el-btn--primary\" {% if force_sold_out or product.available == false %}disabled data-force-disabled=\"true\"{% endif %} aria-label=\"{% if force_sold_out %}Sold Out{% else %}Secure {{ product.title | escape }}{% endif %}\">\n                    <span>{% if force_sold_out %}Sold Out{% else %}Secure Yours{% endif %}</span>\n                  </button>\n                  <a href=\"{{ product.url }}\" class=\"el-btn el-btn--ghost\" aria-label=\"View {{ product.title | escape }}\">View Product</a>\n                </div>\n              </div>\n\n              <div class=\"el-trust\">• Numbered Editions • 30 Day Guarantee</div>\n            </form>\n          </div>\n        </li>\n      {%- endunless -%}\n    {%- endfor -%}\n  </ul>\n\n  <script type=\"application/ld+json\">\n  {\n    \"@context\":\"https://schema.org\",\n    \"@type\":\"ItemList\",\n    \"itemListElement\":[\n      {%- assign pos = 0 -%}\n      {%- assign first_item_written = false -%}\n      {%- for product in coll.products -%}\n        {%- assign title_lc = product.title | downcase -%}\n        {%- if title_lc contains 'mentality' -%}\n          {%- assign pos = pos | plus: 1 -%}\n          {%- if first_item_written %},{% endif -%}\n          {\"@type\":\"ListItem\",\"position\":{{ pos }},\"url\": {{ shop.url | append: product.url | json }} }\n          {%- assign first_item_written = true -%}\n        {%- endif -%}\n      {%- endfor -%}\n      {%- for product in coll.products -%}\n        {%- assign title_lc = product.title | downcase -%}\n        {%- unless title_lc contains 'mentality' -%}\n          {%- assign pos = pos | plus: 1 -%}\n          {%- if first_item_written %},{% endif -%}\n          {\"@type\":\"ListItem\",\"position\":{{ pos }},\"url\": {{ shop.url | append: product.url | json }} }\n          {%- assign first_item_written = true -%}\n        {%- endunless -%}\n      {%- endfor -%}\n    ]\n  }\n  </script>\n</section>\n\n<dialog id=\"size-guide-modal\" class=\"sc-size-modal\" aria-label=\"Size guide\">\n  <button type=\"button\" class=\"sc-size-close\" data-close-sizeguide aria-label=\"Close size guide\">×</button>\n  <img class=\"sc-size-img\" alt=\"Size guide\" loading=\"lazy\" decoding=\"async\" hidden>\n  <iframe class=\"sc-size-iframe\" title=\"Size guide\" loading=\"lazy\" data-src=\"/pages/sizing-chart\" hidden></iframe>\n</dialog>\n\n<style>\n.sc-mj-cardsELITE{\n  isolation:isolate;\n  background:#060606;\n  margin:0 0 14px;\n  font-family:Montserrat,system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif;\n  color:#fff;\n}\n\n.el-grid{\n  max-width:1240px;\n  margin:0 auto;\n  padding:14px 12px 18px;\n  display:grid;\n  gap:18px;\n  grid-template-columns:repeat(3,minmax(0,1fr));\n}\n@media (max-width:989px){\n  .el-grid{\n    grid-template-columns:1fr;\n    gap:14px;\n    padding:10px 8px 14px;\n    justify-items:center;\n  }\n}\n\n.el-card{\n  background:linear-gradient(180deg,#fdfdfd 0%, #f5f5f5 100%);\n  border:1px solid rgba(255,255,255,.10);\n  border-radius:18px;\n  overflow:hidden;\n  box-shadow:\n    0 10px 30px rgba(0,0,0,.22),\n    0 1px 0 rgba(255,255,255,.45) inset;\n  content-visibility:auto;\n  contain-intrinsic-size:1px 420px;\n  width:100%;\n  position:relative;\n}\n.el-card::before{\n  content:\"\";\n  position:absolute;\n  inset:0;\n  border-radius:18px;\n  padding:1px;\n  background:linear-gradient(180deg, rgba(247,160,7,.35), rgba(255,255,255,0));\n  -webkit-mask:linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);\n  -webkit-mask-composite:xor;\n  mask-composite:exclude;\n  pointer-events:none;\n}\n.el-card--featured{\n  box-shadow:\n    0 14px 34px rgba(0,0,0,.26),\n    0 0 0 1px rgba(247,160,7,.22),\n    0 1px 0 rgba(255,255,255,.5) inset;\n}\n@media (max-width:989px){\n  .el-card{ width:min(92vw,440px); }\n}\n\n.el-link{\n  display:block;\n  position:relative;\n  aspect-ratio:1/1;\n  background:#ebe7e1;\n}\n.el-img{\n  width:100%;\n  height:100%;\n  object-fit:cover;\n  display:block;\n  border-bottom:1px solid rgba(0,0,0,.06);\n}\n.el-badge{\n  position:absolute;\n  top:12px;\n  right:12px;\n  padding:7px 12px;\n  border-radius:999px;\n  background:rgba(15,15,15,.92);\n  color:#F7C35A;\n  border:1px solid rgba(247,160,7,.55);\n  font-weight:700;\n  font-size:11px;\n  letter-spacing:.08em;\n  text-transform:uppercase;\n  box-shadow:0 8px 20px rgba(0,0,0,.25);\n}\n.el-badge--best{\n  background:linear-gradient(180deg,#F7C35A,#F7A007);\n  color:#111;\n  border-color:#F7A007;\n}\n.el-badge--sold{\n  background:rgba(28,28,28,.94);\n  color:#fff;\n  border-color:rgba(255,255,255,.18);\n}\n\n.el-meta{\n  padding:12px 12px 14px;\n  color:#111;\n}\n.el-title{\n  margin:0 0 10px;\n  font-weight:700;\n  font-size:clamp(15px,1.7vw,18px);\n  line-height:1.18;\n  letter-spacing:-.01em;\n  display:-webkit-box;\n  -webkit-line-clamp:2;\n  -webkit-box-orient:vertical;\n  overflow:hidden;\n}\n\n.el-opts{\n  display:grid;\n  gap:10px;\n  margin:0 0 10px;\n}\n.option-selector__btns{\n  display:flex;\n  flex-wrap:wrap;\n  gap:8px;\n}\n.opt-label{\n  min-width:44px;\n  min-height:44px;\n  border-radius:12px;\n  border:1px solid #e3dfd9;\n  background:#fafafa;\n  display:inline-flex;\n  align-items:center;\n  justify-content:center;\n  margin:0;\n  transition:.18s ease;\n}\n.opt-label:hover{\n  border-color:#cfc8bf;\n}\n.opt-label--swatch{\n  width:44px;\n  height:44px;\n  background-size:cover;\n  background-position:center;\n}\n.opt-label--btn{\n  padding:0 12px;\n  font-weight:700;\n  font-size:13px;\n  line-height:1;\n}\n.opt-btn:checked + .opt-label{\n  box-shadow:inset 0 0 0 2px #111;\n  background:#fff;\n  border-color:#111;\n}\n\n.el-size-row{\n  display:flex;\n  align-items:center;\n  justify-content:space-between;\n  gap:8px;\n  margin-top:6px;\n}\n.el-sizes{ padding-top:8px; }\n.el-sizeguide{\n  border:none;\n  background:transparent;\n  color:#111;\n  text-decoration:underline;\n  font-weight:700;\n  font-size:12px;\n  white-space:nowrap;\n  cursor:pointer;\n}\n.el-frames{ margin-top:8px; }\n\n.el-buy{\n  display:flex;\n  align-items:flex-end;\n  justify-content:space-between;\n  gap:12px;\n}\n.el-price{\n  font-weight:700;\n  flex:1 1 auto;\n}\n.el-price__val{\n  display:block;\n  font-size:clamp(20px,2vw,22px);\n  line-height:1.05;\n  color:#111;\n}\n.el-stock{\n  margin-top:5px;\n  font-size:12px;\n  font-weight:700;\n  letter-spacing:.01em;\n  color:#8F5C00;\n  text-transform:uppercase;\n}\n.el-actions{\n  display:flex;\n  flex-direction:column;\n  gap:8px;\n  align-items:stretch;\n  flex:0 0 auto;\n}\n.el-btn{\n  border:none;\n  cursor:pointer;\n  border-radius:13px;\n  padding:12px 16px;\n  min-width:150px;\n  text-align:center;\n  color:#111;\n  font-weight:700;\n  font-size:14px;\n  text-decoration:none;\n}\n.el-btn--primary{\n  background:linear-gradient(180deg,#F7C35A,#F7A007);\n  box-shadow:0 10px 22px rgba(247,160,7,.28);\n}\n.el-btn--ghost{\n  background:#fff;\n  color:#111;\n  border:1px solid rgba(17,17,17,.16);\n  box-shadow:none;\n}\n.el-btn--ghost:hover{\n  border-color:#111;\n}\n.el-btn:active{ transform:translateY(1px); }\n.el-btn[disabled]{\n  opacity:.58;\n  cursor:not-allowed;\n  box-shadow:none;\n}\n@media (max-width:1180px){\n  .el-actions{ width:100%; }\n  .el-btn{ min-width:0; width:100%; }\n}\n@media (max-width:640px){\n  .el-buy{\n    flex-direction:column;\n    align-items:stretch;\n  }\n  .el-price{ width:100%; }\n}\n\n.el-trust{\n  margin-top:10px;\n  font-size:11px;\n  line-height:1.45;\n  font-weight:700;\n  color:#666;\n  letter-spacing:.02em;\n  text-transform:uppercase;\n}\n\n.visually-hidden{\n  position:absolute;\n  width:1px;\n  height:1px;\n  padding:0;\n  margin:-1px;\n  overflow:hidden;\n  clip:rect(0,0,0,0);\n  white-space:nowrap;\n  border:0;\n}\n\n.sc-mj-cardsELITE [data-swatch=\"black\"]{--sw:url({{ 'frame_black_swatch.png' | asset_url }})}\n.sc-mj-cardsELITE [data-swatch=\"matte black frame\"]{--sw:url({{ 'frame_black_swatch.png' | asset_url }})}\n.sc-mj-cardsELITE [data-swatch=\"white\"]{--sw:url({{ 'frame_white_swatch.png' | asset_url }})}\n.sc-mj-cardsELITE [data-swatch=\"oak\"]{--sw:url({{ 'frame_oak_swatch.png' | asset_url }})}\n.sc-mj-cardsELITE [data-swatch=\"unframed\"]{--sw:url({{ 'frame_unframed_swatch.png' | asset_url }})}\n.opt-label--swatch{background-image:var(--sw)}\n\n.sc-size-modal{\n  border:none;\n  border-radius:12px;\n  padding:0;\n  width:min(92vmin,820px);\n  height:min(92vmin,820px);\n}\n.sc-size-modal::backdrop{ background:rgba(0,0,0,.55); }\n.sc-size-img,.sc-size-iframe{\n  width:100%;\n  height:100%;\n  border:0;\n  border-radius:12px;\n  object-fit:contain;\n  background:#0a0a0a;\n}\n.sc-size-img[hidden],.sc-size-iframe[hidden]{ display:none; }\n.sc-size-close{\n  position:absolute;\n  top:6px;\n  right:8px;\n  background:rgba(0,0,0,.7);\n  color:#fff;\n  border:none;\n  border-radius:999px;\n  width:28px;\n  height:28px;\n  font-size:18px;\n  line-height:28px;\n  cursor:pointer;\n}\n</style>\n\n<script>\ndocument.addEventListener('DOMContentLoaded',function(){\n  var root = document.querySelector('.sc-mj-cardsELITE');\n  if(!root) return;\n\n  function parseJSON(el,attr){\n    try { return JSON.parse(el.getAttribute(attr) || '[]'); }\n    catch(_) { return []; }\n  }\n\n  function idx(el,attr){\n    return Number(el.getAttribute(attr) || 0);\n  }\n\n  function readChoices(card){\n    var f = card.querySelector('.js-frame.opt-btn:checked');\n    var s = card.querySelector('.js-size.opt-btn:checked');\n    return {\n      frame: f ? f.value : '',\n      size: s ? s.value : ''\n    };\n  }\n\n  function pickVariant(vars,fIdx,sIdx,c){\n    for(var i=0;i<vars.length;i++){\n      var o=[vars[i].o0,vars[i].o1,vars[i].o2];\n      if((!c.frame || String(o[fIdx]) === c.frame) && (!c.size || String(o[sIdx]) === c.size)){\n        return vars[i];\n      }\n    }\n    if(c.frame){\n      for(var j=0;j<vars.length;j++){\n        var p=[vars[j].o0,vars[j].o1,vars[j].o2];\n        if(String(p[fIdx]) === c.frame) return vars[j];\n      }\n    }\n    return vars[0] || null;\n  }\n\n  function applyVariant(card,v){\n    var idEl = card.querySelector('input[name=\"id\"]');\n    var price = card.querySelector('[data-price]');\n    var submitBtn = card.querySelector('.el-btn--primary');\n    var img = card.querySelector('.el-img');\n\n    if(!v){\n      if(submitBtn) submitBtn.disabled = true;\n      return;\n    }\n\n    if(idEl) idEl.value = v.id;\n    if(price) price.textContent = v.price_fmt || '';\n\n    if(submitBtn && !submitBtn.hasAttribute('data-force-disabled')){\n      submitBtn.disabled = (v.available === false);\n    }\n\n    if(img && v.m720){\n      img.src = v.m720;\n      img.srcset = v.m480 + ' 480w, ' + v.m720 + ' 720w, ' + v.m960 + ' 960w, ' + v.m1200 + ' 1200w';\n    }\n  }\n\n  function refresh(card){\n    var vars = parseJSON(card,'data-variants');\n    var v = pickVariant(vars, idx(card,'data-fidx'), idx(card,'data-sidx'), readChoices(card));\n    applyVariant(card,v);\n  }\n\n  function openCartDrawer(){\n    document.documentElement.dispatchEvent(new CustomEvent('cart:refresh', { bubbles:true }));\n    document.dispatchEvent(new CustomEvent('cart:refresh', { bubbles:true }));\n    document.documentElement.dispatchEvent(new CustomEvent('cart:open', { bubbles:true }));\n    document.dispatchEvent(new CustomEvent('cart:open', { bubbles:true }));\n\n    var selectors = [\n      'cart-drawer',\n      '[data-cart-drawer]',\n      '#CartDrawer',\n      '.cart-drawer',\n      'details[id*=\"CartDrawer\"]',\n      'drawer-dialog[data-drawer-type=\"cart\"]'\n    ];\n\n    for(var i=0;i<selectors.length;i++){\n      var el = document.querySelector(selectors[i]);\n      if(!el) continue;\n\n      if(el.tagName && el.tagName.toLowerCase() === 'details'){\n        el.setAttribute('open','open');\n        return true;\n      }\n\n      if(typeof el.show === 'function'){\n        try { el.show(); return true; } catch(e){}\n      }\n\n      if(typeof el.open === 'function'){\n        try { el.open(); return true; } catch(e){}\n      }\n\n      el.classList.add('is-open','open','active');\n      el.setAttribute('open','open');\n      el.setAttribute('aria-hidden','false');\n      return true;\n    }\n\n    return false;\n  }\n\n  var cards = root.querySelectorAll('.el-card');\n  for(var i=0;i<cards.length;i++) refresh(cards[i]);\n\n  root.addEventListener('change',function(e){\n    if(!e.target || !e.target.classList.contains('opt-btn')) return;\n    var card = e.target.closest('.el-card');\n    if(!card) return;\n    refresh(card);\n  },{passive:true});\n\n  root.addEventListener('submit',function(e){\n    var form = e.target;\n    if(!form.classList.contains('el-atc')) return;\n\n    e.preventDefault();\n\n    var submitBtn = form.querySelector('.el-btn--primary');\n    if(submitBtn && submitBtn.disabled) return;\n\n    var idEl = form.querySelector('input[name=\"id\"]');\n    if(!idEl || !idEl.value){\n      form.submit();\n      return;\n    }\n\n    var originalText = submitBtn ? submitBtn.textContent : '';\n\n    if(submitBtn){\n      submitBtn.disabled = true;\n      submitBtn.textContent = 'Adding…';\n    }\n\n    fetch('/cart/add.js',{\n      method:'POST',\n      headers:{\n        'Content-Type':'application/json',\n        'Accept':'application/json',\n        'X-Requested-With':'XMLHttpRequest'\n      },\n      credentials:'same-origin',\n      body:JSON.stringify({ id:idEl.value, quantity:1 })\n    })\n    .then(function(r){\n      if(!r.ok) throw new Error('Add to cart failed');\n      return r.json();\n    })\n    .then(function(){\n      var opened = openCartDrawer();\n\n      if(submitBtn){\n        submitBtn.textContent = 'Added';\n        if(!submitBtn.hasAttribute('data-force-disabled')){\n          submitBtn.disabled = false;\n        }\n        setTimeout(function(){\n          submitBtn.textContent = originalText || 'Secure Yours';\n        }, 1200);\n      }\n\n      if(!opened){\n        window.location.href = '/cart';\n      }\n    })\n    .catch(function(){\n      form.submit();\n    });\n  });\n\n  var modal = document.getElementById('size-guide-modal');\n  if(modal){\n    var img = modal.querySelector('.sc-size-img');\n    var frame = modal.querySelector('.sc-size-iframe');\n\n    root.addEventListener('click',function(e){\n      var t = e.target.closest('[data-open-sizeguide]');\n      if(!t) return;\n\n      var src = t.getAttribute('data-guide');\n      if(src && src.length > 5){\n        img.src = src;\n        img.hidden = false;\n        frame.hidden = true;\n      } else {\n        img.hidden = true;\n        frame.hidden = false;\n        if(!frame.src) frame.src = frame.getAttribute('data-src') || '/pages/sizing-chart';\n      }\n\n      if(modal.showModal) modal.showModal();\n      else modal.setAttribute('open','open');\n    });\n\n    modal.addEventListener('click',function(e){\n      if(e.target.matches('.sc-size-close') || e.target === modal){\n        if(modal.close) modal.close();\n        else modal.removeAttribute('open');\n      }\n    });\n  }\n});\n</script>\n<section aria-label=\"Collection description\" class=\"scx-collection-intro\">\n<div class=\"scx-collection-intro__inner\">\n<div aria-hidden=\"true\" class=\"scx-collection-intro__divider\"><br></div>\n<p>Own premium <strong data-start=\"321\" data-end=\"348\">Michael Jordan wall art</strong> that captures six rings, clutch moments and Bulls-era greatness. These <strong data-start=\"420\" data-end=\"449\">Michael Jordan wall decor</strong> pieces are designed for true fans — limited edition framed prints that bring championship energy into your space or man cave.</p>\n</div>\n</section>"
      }
    },
    "main": {
      "type": "main-collection",
      "disabled": true,
      "settings": {
        "show_title": false,
