.sc-retired__card-copy {\n      min-height: 72px;\n      padding: 11px 13px 12px;\n    }\n\n    #SportsCaveRetired-{{ section.id }} .sc-retired__title {\n      font-size: clamp(10px, 3.1vw, 12px);\n      line-height: 1.24;\n    }\n\n    #SportsCaveRetired-{{ section.id }} .sc-retired__final {\n      margin-top: 6px;\n      font-size: 7.5px;\n    }\n\n    #SportsCaveRetired-{{ section.id }} .sc-retired__mobile-progress {\n      display: grid;\n      margin: 11px 16px 0;\n      padding-bottom: 17px;\n      grid-template-columns: 1fr auto;\n      align-items: center;\n      gap: 8px 14px;\n    }\n\n    #SportsCaveRetired-{{ section.id }} .sc-retired__swipe {\n      color: rgba(240, 236, 228, 0.46);\n      font-size: 9px;\n      font-style: italic;\n      font-weight:500;\n      line-height: 1;\n      letter-spacing: 0.055em;\n    }\n\n    #SportsCaveRetired-{{ section.id }} .sc-retired__counter {\n      color: rgba(240, 236, 228, 0.38);\n      font-size: 8px;\n      font-weight:700;\n      line-height: 1;\n      letter-spacing: 0.08em;\n    }\n\n    #SportsCaveRetired-{{ section.id }} .sc-retired__current {\n      color: var(--sc-gold-bright);\n    }\n\n    #SportsCaveRetired-{{ section.id }} .sc-retired__counter-divider {\n      padding-inline: 3px;\n      color: rgba(240, 236, 228, 0.2);\n    }\n\n    #SportsCaveRetired-{{ section.id }} .sc-retired__progress-track {\n      position: relative;\n      display: block;\n      width: 100%;\n      height: 2px;\n      overflow: hidden;\n      border-radius: 999px;\n      background: rgba(240, 236, 228, 0.12);\n      grid-column: 1 / -1;\n    }\n\n    #SportsCaveRetired-{{ section.id }} .sc-retired__progress-fill {\n      display: block;\n      width: 100%;\n      height: 100%;\n      background: linear-gradient(90deg, var(--sc-gold), var(--sc-gold-bright));\n      transform: scaleX(0);\n      transform-origin: left center;\n      transition: transform 180ms ease;\n    }\n\n  }\n\n  @media (max-width: 374px) {\n    #SportsCa