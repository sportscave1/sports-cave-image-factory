    "custom_liquid_K3TwND": {
      "type": "custom-liquid",
      "name": "DELAY POPUP",
      "settings": {
        "full_width": true,
        "show_space": false,
        "code": "<div id=\"sc-collector-pop\" class=\"sc-collector-pop\" hidden aria-live=\"polite\">\n  <div class=\"sc-collector-card\" role=\"dialog\" aria-modal=\"false\" aria-labelledby=\"sc-collector-title\">\n    <button type=\"button\" class=\"sc-collector-close\" aria-label=\"Close\" data-close=\"1\">×</button>\n\n    <form method=\"post\" action=\"/contact#contact_form\" accept-charset=\"UTF-8\" class=\"sc-collector-form\" toolname=\"collector_access\" tooldescription=\"Prepare a signup for Sports Cave collector access and marketing emails. The customer must review the offer and press UNLOCK ACCESS to subscribe.\">\n      <input type=\"hidden\" name=\"form_type\" value=\"customer\">\n      <input type=\"hidden\" name=\"utf8\" value=\"✓\">\n      <input type=\"hidden\" name=\"contact[tags]\" value=\"{% capture sc_signup_tags %}{% render 'sc-signup-segment-tags', base_tags: 'newsletter,collector-access,popup', signup_product: product, signup_collection: collection %}{% endcapture %}{{ sc_signup_tags | escape }}\">\n      <input type=\"hidden\" name=\"contact[accepts_marketing]\" value=\"true\">\n\n      <img class=\"sc-collector-logo\" src=\"https://cdn.shopify.com/s/files/1/0722/2332/6515/files/sports-cave-sc-gold-logo-icon.webp?v=1779679393&width=122\" srcset=\"https://cdn.shopify.com/s/files/1/0722/2332/6515/files/sports-cave-sc-gold-logo-icon.webp?v=1779679393&width=61 61w, https://cdn.shopify.com/s/files/1/0722/2332/6515/files/sports-cave-sc-gold-logo-icon.webp?v=1779679393&width=122 122w, https://cdn.shopify.com/s/files/1/0722/2332/6515/files/sports-cave-sc-gold-logo-icon.webp?v=1779679393&width=183 183w\" sizes=\"(max-width: 640px) 61px, 57px\" width=\"500\" height=\"500\" alt=\"Sports Cave\">\n\n      <h2 id=\"sc-collector-title\" class=\"sc-collector-title\">UNLOCK COLLECTOR ACCESS</h2>\n\n      <p class=\"sc-collector-subtitle\">\n        Get early access and first look at new limited releases.\n      </p>\n\n      <label class=\"sc-visually-hidden\" for=\"sc-collector-email\">Email</label>\n      <div class=\"sc-collector-input-wrap\">\n        <span class=\"sc-collector-mail\" aria-hidden=\"true\">\n          <svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"none\">\n            <path d=\"M3.75 6.75h16.5v10.5H3.75V6.75Z\" stroke=\"currentColor\" stroke-width=\"1.55\"/>\n            <path d=\"m4.5 7.5 7.5 6 7.5-6\" stroke=\"currentColor\" stroke-width=\"1.55\"/>\n          </svg>\n        </span>\n        <input id=\"sc-collector-email\" class=\"sc-collector-input\" type=\"email\" name=\"contact[email]\" toolparamdescription=\"Email address the customer chooses for collector access and marketing emails\" placeholder=\"Enter your email\" required autocomplete=\"email\" inputmode=\"email\">\n      </div>\n\n      <button type=\"submit\" class=\"sc-collector-btn\">UNLOCK ACCESS</button>\n\n      <div class=\"sc-collector-note\">\n        <span aria-hidden=\"true\">\n          <svg viewBox=\"0 0 24 24\" width=\"13\" height=\"13\" fill=\"none\">\n            <path d=\"M12 3.75 19 6.5v5.25c0 4.35-2.9 7.1-7 8.5-4.1-1.4-7-4.15-7-8.5V6.5l7-2.75Z\" stroke=\"currentColor\" stroke-width=\"1.55\"/>\n            <path d=\"m8.75 12 2.1 2.1 4.4-4.75\" stroke=\"currentColor\" stroke-width=\"1.55\"/>\n          </svg>\n        </span>\n        Collector-only updates. No spam.\n      </div>\n\n      <div class=\"sc-collector-success\" hidden>\n        <div class=\"sc-success-check\" aria-hidden=\"true\">✓</div>\n        <h3>YOU’RE ON THE<br>COLLECTOR LIST</h3>\n        <p>Return to this limited release<br>before this run closes.</p>\n        <button type=\"button\" class=\"sc-success-btn\" data-scroll-variant=\"1\">RETURN TO EDITION</button>\n        <div class=\"sc-success-note\">\n          <span aria-hidden=\"true\">\n            <svg viewBox=\"0 0 24 24\" width=\"13\" height=\"13\" fill=\"none\">\n              <path d=\"M12 3.75 19 6.5v5.25c0 4.35-2.9 7.1-7 8.5-4.1-1.4-7-4.15-7-8.5V6.5l7-2.75Z\" stroke=\"currentColor\" stroke-width=\"1.55\"/>\n              <path d=\"m8.75 12 2.1 2.1 4.4-4.75\" stroke=\"currentColor\" stroke-width=\"1.55\"/>\n            </svg>\n          </span>\n          Shipping calculated at checkout.\n        </div>\n        \n      </div>\n    </form>\n  </div>\n</div>\n\n<style>\n#sc-collector-pop[hidden]{display:none!important}\n\n\n#sc-collector-pop{\n  position:fixed;z-index:2147483647;pointer-events:none;\n  font-family:var(--sc-font-ui);\n}\n#sc-collector-pop .sc-collector-card{\n  pointer-events:auto;position:relative;overflow:hidden;\n  background:radial-gradient(circle at 50% 0%,rgba(212,165,76,.055),transparent 38%),linear-gradient(180deg,rgba(13,13,13,.90),rgba(5,5,5,.94));\n  border:1px solid rgba(212,165,76,.44);\n  box-shadow:0 20px 58px rgba(0,0,0,.42),0 0 0 1px rgba(255,255,255,.025) inset;\n  animation:scCollectorIn .48s cubic-bezier(.2,.85,.2,1);\n}\n#sc-collector-pop .sc-collector-card:before{\n  content:\"\";position:absolute;pointer-events:none;border:1px solid rgba(212,165,76,.16);\n}\n@keyframes scCollectorIn{from{opacity:0;transform:translateY(18px)}to{opacity:1;transform:translateY(0)}}\n#sc-collector-pop .sc-collector-close{\n  position:absolute;border-radius:50%;border:1px solid rgba(212,165,76,.24);\n  background:rgba(0,0,0,.18);color:rgba(243,210,123,.82);cursor:pointer;z-index:3;font-weight:600;\n}\n#sc-collector-pop .sc-collector-form{position:relative;z-index:2;text-align:center}\n#sc-collector-pop .sc-collector-logo{display:block;height:auto;object-fit:contain}\n#sc-collector-pop .sc-collector-title{\n  color:#F2D17B;text-transform:uppercase;font-weight:700;letter-spacing:.072em;\n  white-space:nowrap;\n}\n#sc-collector-pop .sc-collector-subtitle{color:rgba(255,255,255,.84);font-weight:500}\n#sc-collector-pop .sc-collector-input-wrap{\n  display:flex;align-items:center;border:1px solid rgba(212,165,76,.66);background:rgba(0,0,0,.34);\n}\n#sc-collector-pop .sc-collector-mail{\n  display:flex;align-items:center;justify-content:center;color:#E5BF68;\n  border-right:1px solid rgba(212,165,76,.18);flex:0 0 auto;\n}\n#sc-collector-pop .sc-collector-input{\n  flex:1;height:100%;border:0;background:transparent;outline:0;color:var(--sc-brand-ivory);min-width:0;\n}\n#sc-collector-pop .sc-collector-input::placeholder{color:rgba(255,255,255,.52)}\n#sc-collector-pop .sc-collector-input-wrap:focus-within{box-shadow:0 0 0 3px rgba(212,165,76,.10);border-color:rgba(242,209,123,.9)}\n#sc-collector-pop .sc-collector-btn{\n  border:0;cursor:pointer;background:linear-gradient(180deg,#E0B356 0%,#C49335 100%);\n  color:#050505;font-weight:700;letter-spacing:.09em;text-transform:uppercase;\n  box-shadow:0 8px 20px rgba(0,0,0,.20);\n}\n#sc-collector-pop .sc-collector-note{\n  display:flex;align-items:center;justify-content:center;color:rgba(255,255,255,.72);line-height:1.25;\n}\n#sc-collector-pop .sc-collector-note svg{color:#D4A54C;flex:0 0 auto}\n\n#sc-collector-pop.is-success .sc-collector-logo,\n#sc-collector-pop.is-success .sc-collector-title,\n#sc-collector-pop.is-success .sc-collector-subtitle,\n#sc-collector-pop.is-success .sc-collector-input-wrap,\n#sc-collector-pop.is-success .sc-collector-btn,\n#sc-collector-pop.is-success .sc-collector-note{display:none!important}\n#sc-collector-pop.is-success .sc-collector-success{display:block!important}\n#sc-collector-pop .sc-collector-success{text-align:center}\n#sc-collector-pop .sc-success-check{\n  width:34px;height:34px;margin:0 auto 8px;border-radius:50%;\n  border:2px solid rgba(55,210,82,.78);color:#43df5c;\n  display:flex;align-items:center;justify-content:center;font-size:22px;font-weight:700;\n}\n#sc-collector-pop .sc-collector-success h3{\n  margin:0 auto 8px;color:#F2D17B;line-height:1.05;\n  letter-spacing:.072em;font-weight:700;text-transform:uppercase;white-space:nowrap;\n}\n#sc-collector-pop .sc-collector-success p{\n  margin:0 auto 12px;color:rgba(255,255,255,.84);font-weight:500;\n}\n#sc-collector-pop .sc-success-btn{\n  width:100%;border:0;cursor:pointer;background:linear-gradient(180deg,#E0B356 0%,#C49335 100%);\n  color:#050505;font-weight:700;letter-spacing:.09em;text-transform:uppercase;\n  box-shadow:0 8px 20px rgba(0,0,0,.20);\n}\n#sc-collector-pop .sc-success-note{\n  display:flex;align-items:center;justify-content:center;gap:6px;\n  color:rgba(255,255,255,.72);font-size:10.5px;line-height:1.25;margin-top:9px;\n}\n#sc-collector-pop .sc-success-note svg{color:#D4A54C;flex:0 0 auto}\n#sc-collector-pop .sc-success-urgency{\n  margin-top:6px;color:rgba(255,255,255,.48);font-size:9.5px;line-height:1.2;letter-spacing:.01em;\n}\n\n#sc-collector-pop .sc-visually-hidden{\n  position:absolute!important;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;\n  clip:rect(0,0,0,0);white-space:nowrap;border:0;\n}\n\n@media(min-width:641px){\n  #sc-collector-pop{left:18px;bottom:34px;width:430px}\n  #sc-collector-pop .sc-collector-card{width:430px;border-radius:19px;padding:14px 22px 14px}\n  #sc-collector-pop .sc-collector-card:before{inset:8px;border-radius:14px}\n  #sc-collector-pop .sc-collector-close{top:10px;right:12px;width:32px;height:32px;font-size:22px;line-height:26px;border-color:rgba(212,165,76,.20);color:rgba(243,210,123,.76)}\n  #sc-collector-pop .sc-collector-logo{width:57px;max-width:20%;margin:0 auto 6px}\n  #sc-collector-pop .sc-collector-title{margin:0 auto 6px;font-size:17px;line-height:1.05;max-width:390px;letter-spacing:.068em}\n  #sc-collector-pop .sc-collector-subtitle{margin:0 auto 10px;max-width:372px;font-size:10.5px;line-height:1.25}\n  #sc-collector-pop .sc-collector-input-wrap{height:34px;margin:0 auto 9px;max-width:360px;border-radius:9px}\n  #sc-collector-pop .sc-collector-mail{width:38px}\n  #sc-collector-pop .sc-collector-input{font-size:12px;padding:0 11px}\n  #sc-collector-pop .sc-collector-btn{width:100%;max-width:360px;height:39px;border-radius:9px;font-size:12px;letter-spacing:.085em}\n  #sc-collector-pop .sc-collector-note{margin:8px auto 0;gap:6px;font-size:10px}\n  #sc-collector-pop .sc-collector-success h3{font-size:17px;max-width:390px}\n  #sc-collector-pop .sc-collector-success p{max-width:360px;font-size:10.9px;line-height:1.28}\n  #sc-collector-pop .sc-success-btn{height:39px;border-radius:9px;font-size:12px;letter-spacing:.085em}\n  #sc-collector-pop .sc-success-note{font-size:10px}\n}\n\n@media(max-width:640px){\n  #sc-collector-pop{left:50%;bottom:8px;transform:translateX(-50%);width:100%}\n  #sc-collector-pop .sc-collector-card{\n    width:calc(100vw - 42px);max-width:560px;margin:0 auto;border-radius:18px;\n    padding:15px 18px 13px;\n  }\n  #sc-collector-pop .sc-collector-card:before{inset:8px;border-radius:14px}\n  #sc-collector-pop .sc-collector-close{top:10px;right:12px;width:34px;height:34px;font-size:24px;line-height:28px;border-color:rgba(212,165,76,.22);color:rgba(243,210,123,.78)}\n  #sc-collector-pop .sc-collector-logo{width:61px;max-width:24%;margin:0 auto 8px}\n  #sc-collector-pop .sc-collector-title{\n    margin:0 auto 8px;\n    font-size:clamp(16px,4.05vw,23px);\n    line-height:1.08;\n    max-width:100%;\n  }\n  #sc-collector-pop .sc-collector-subtitle{\n    margin:0 auto 12px;\n    max-width:430px;\n    font-size:11.2px;\n    line-height:1.34;\n  }\n  #sc-collector-pop .sc-collector-input-wrap{height:38px;margin:0 auto 10px;max-width:460px;border-radius:9px}\n  #sc-collector-pop .sc-collector-mail{width:42px}\n  #sc-collector-pop .sc-collector-input{font-size:13px;padding:0 12px}\n  #sc-collector-pop .sc-collector-btn{width:100%;max-width:460px;height:46px;border-radius:10px;font-size:13px}\n  #sc-collector-pop .sc-collector-note{margin:10px auto 0;gap:7px;font-size:11px}\n  #sc-collector-pop .sc-collector-success h3{font-size:clamp(16px,4.05vw,23px);max-width:100%;line-height:1.08}\n  #sc-collector-pop .sc-collector-success p{max-width:410px;font-size:11.6px;line-height:1.34}\n  #sc-collector-pop .sc-success-btn{height:46px;border-radius:10px;font-size:13px}\n  #sc-collector-pop .sc-success-note{font-size:11px}\n}\n\n@media(max-width:390px){\n  #sc-collector-pop .sc-collector-card{width:calc(100vw - 28px);padding:14px 14px 12px}\n  #sc-collector-pop .sc-collector-title{font-size:clamp(15px,3.95vw,19px);letter-spacing:.055em}\n  #sc-collector-pop .sc-collector-subtitle{font-size:11.2px;max-width:330px}\n  #sc-collector-pop .sc-collector-note{font-size:10.5px}\n  #sc-collector-pop .sc-collector-success h3{font-size:clamp(15px,3.95vw,19px);letter-spacing:.055em}\n  #sc-collector-pop .sc-collector-success p{font-size:11.2px;max-width:330px}\n  #sc-collector-pop .sc-success-note{font-size:10.5px}\n}\n</style>\n\n<script>\n(function(){\n  const root=document.getElementById('sc-collector-pop');if(!root)return;\n  const form=root.querySelector('.sc-collector-form');\n\n  const IS_SHOPIFY_SUBSCRIBED={% if customer and customer.accepts_marketing %}true{% else %}false{% endif %};\n\n  const CLOSE_KEY='sc_collector_closed_until',\n        JOINED_KEY='sc_collector_joined',\n        SUCCESS_KEY='sc_collector_success_pending',\n        SCROLL_KEY='sc_collector_scroll_y',\n        CLOSE_HOURS=24,\n        JOINED_DAYS=180,\n        DELAY=15000,\n        TRIGGER=.45;\n\n  const now=()=>Date.now();\n  const msHours=h=>h*60*60*1000;\n  const msDays=d=>d*24*60*60*1000;\n\n  const getNum=k=>{try{return parseInt(localStorage.getItem(k)||'0',10)||0}catch(e){return 0}};\n  const setNum=(k,v)=>{try{localStorage.setItem(k,String(v))}catch(e){}};\n  const getSession=k=>{try{return sessionStorage.getItem(k)}catch(e){return null}};\n  const setSession=(k,v)=>{try{sessionStorage.setItem(k,String(v))}catch(e){}};\n  const removeSession=k=>{try{sessionStorage.removeItem(k)}catch(e){}};\n\n  const isClosed=()=>getNum(CLOSE_KEY)>now();\n  const isJoined=()=>{\n    const t=getNum(JOINED_KEY);\n    return !!t && now()-t<msDays(JOINED_DAYS);\n  };\n\n  function suppressFor24h(){setNum(CLOSE_KEY,now()+msHours(CLOSE_HOURS))}\n  function markJoined(){setNum(JOINED_KEY,now())}\n\n\n  if(IS_SHOPIFY_SUBSCRIBED || isJoined() || isClosed()) return;\n\n  let shown=false;\n\n  function open(){if(shown)return;shown=true;root.hidden=false}\n  function close(){\n    root.hidden=true;\n    root.classList.remove('is-success');\n    suppressFor24h();\n  }\n  function showSuccess(){\n    shown=true;\n    root.hidden=false;\n    root.classList.add('is-success');\n    markJoined();\n  }\n\n  function findVariantPicker(){\n    const selectors=[\n      '.product-form','product-form','variant-selects','variant-radios',\n      '.product__info-container','.product__form','.product-form__buttons',\n      '.shopify-payment-button','form[action*=\"/cart/add\"]',\n      '[data-type=\"add-to-cart-form\"]','[id*=\"ProductSubmitButton\"]','[name=\"add\"]'\n    ];\n\n    for(const selector of selectors){\n      const el=document.querySelector(selector);\n      if(el) return el.closest('.product-form,.product__info-container,form,.product__form') || el;\n    }\n\n    const buttons=[...document.querySelectorAll('button,a,input[type=\"submit\"]')];\n    const addBtn=buttons.find(el=>(el.innerText||el.value||'').toLowerCase().includes('add to cart'));\n    return addBtn ? (addBtn.closest('form,.product-form,.product__info-container,.product__form') || addBtn) : null;\n  }\n\n  function scrollToVariantPicker(){\n    const target=findVariantPicker();\n    root.hidden=true;\n    root.classList.remove('is-success');\n    suppressFor24h();\n\n    if(target){\n      setTimeout(function(){\n        const y=target.getBoundingClientRect().top + window.pageYOffset - 90;\n        window.scrollTo({top:Math.max(0,y),behavior:'smooth'});\n      },30);\n    }\n  }\n\n  root.addEventListener('click',function(e){\n    const returnBtn=e.target.closest('[data-scroll-variant]');\n    const closeBtn=e.target.closest('[data-close]');\n\n    if(returnBtn){\n      e.preventDefault();\n      e.stopPropagation();\n      scrollToVariantPicker();\n      return false;\n    }\n\n    if(closeBtn){\n      e.preventDefault();\n      e.stopPropagation();\n      close();\n      return false;\n    }\n  },true);\n\n  document.addEventListener('keydown',function(e){\n    if(!root.hidden&&e.key==='Escape'){\n      e.preventDefault();\n      close();\n    }\n  },true);\n\n  const successPending=getSession(SUCCESS_KEY)==='1';\n  const savedScroll=parseInt(getSession(SCROLL_KEY)||'0',10)||0;\n\n  if(successPending){\n    removeSession(SUCCESS_KEY);\n    removeSession(SCROLL_KEY);\n\n    function restoreAndShow(){\n      if(savedScroll>0) window.scrollTo(0,savedScroll);\n      showSuccess();\n    }\n\n    if(document.readyState==='complete') setTimeout(restoreAndShow,80);\n    else window.addEventListener('load',function(){setTimeout(restoreAndShow,80)});\n\n    setTimeout(restoreAndShow,300);\n    return;\n  }\n\n  setTimeout(open,DELAY);\n\n  window.addEventListener('scroll',function(){\n    if(shown)return;\n    const d=document.documentElement,b=document.body,h=Math.max(d.scrollHeight,b.scrollHeight)-innerHeight;\n    if(h>0&&scrollY/h>=TRIGGER)open();\n  },{passive:true});\n\n  if(form){\n    form.addEventListener('submit',function(e){\n      const email=form.querySelector('input[type=\"email\"]');\n\n      if(email && !email.checkValidity()){\n        e.preventDefault();\n        email.reportValidity();\n        return false;\n      }\n\n      setSession(SUCCESS_KEY,'1');\n      setSession(SCROLL_KEY,String(window.scrollY||window.pageYOffset||0));\n\n      const btn=form.querySelector('.sc-collector-btn');\n      if(btn){btn.disabled=true;btn.textContent='UNLOCKING...'}\n\n      return true;\n    },true);\n  }\n})();\n</script>"
      }
