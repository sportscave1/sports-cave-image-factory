          "disabled": true,
          "settings": {
            "custom_liquid": "<!-- SPORTS CAVE • LIMITED RUN COLLECTOR SEAL -->\n<div class=\"sc-collector-pill-wrap\">\n  <div class=\"sc-collector-pill\" role=\"note\" aria-label=\"Sports Cave limited edition scarcity message\">\n    <div class=\"sc-collector-pill__seal\" aria-hidden=\"true\">\n      <img\n        src=\"https://cdn.shopify.com/s/files/1/0722/2332/6515/files/collector-series-icon-thumbnail-optimized-18kb.webp?v=1781045748\"\n        alt=\"\"\n        loading=\"lazy\"\n        width=\"66\"\n        height=\"66\"\n      >\n    </div>\n\n    <div class=\"sc-collector-pill__text\">\n     # Numbered Edition of 100\n    </div>\n  </div>\n</div>\n\n<style>\n.sc-collector-pill-wrap{\n  width:100%;\n  display:block;\n  margin:6px 0 18px;\n  padding:0;\n  box-sizing:border-box;\n}\n\n.sc-collector-pill,\n.sc-collector-pill *{\n  box-sizing:border-box;\n}\n\n.sc-collector-pill{\n  --sc-pill-text-size:11.8px;\n  --sc-pill-letter-spacing:.052em;\n  --sc-pill-text-scale:1;\n\n  position:relative;\n  display:flex;\n  align-items:center;\n  width:100%;\n  max-width:100%;\n  min-height:36px;\n  padding:0;\n  border-radius:10px;\n  background:transparent;\n  border:none;\n  box-shadow:none;\n  font-family:var(--sc-font-ui);\n  overflow:visible;\n}\n\n.sc-collector-pill:before{\n  content:\"\";\n  position:absolute;\n  top:0;\n  right:0;\n  bottom:0;\n  left:33px;\n  border-radius:10px;\n  border:1px solid rgba(212,165,76,.62);\n  background:\n    linear-gradient(180deg, rgba(245,242,234,.055), rgba(245,242,234,0) 55%),\n    linear-gradient(90deg, rgba(212,165,76,.18), rgba(212,165,76,.055) 39%, rgba(11,11,13,0) 82%),\n    #0B0B0D;\n  box-shadow:\n    0 7px 14px rgba(0,0,0,.16),\n    0 1px 0 rgba(212,165,76,.22),\n    inset 0 0 0 1px rgba(245,242,234,.032),\n    inset 0 1px 0 rgba(245,242,234,.08),\n    inset 0 -1px 0 rgba(212,165,76,.14);\n  pointer-events:none;\n}\n\n.sc-collector-pill:after{\n  content:\"\";\n  position:absolute;\n  left:98px;\n  right:14px;\n  bottom:5px;\n  height:1px;\n  background:linear-gradient(\n    90deg,\n    rgba(212,165,76,0),\n    rgba(212,165,76,.34),\n    rgba(212,165,76,0)\n  );\n  opacity:.38;\n  pointer-events:none;\n}\n\n.sc-collector-pill__seal{\n  position:absolute;\n  left:0;\n  top:50%;\n  transform:translateY(-50%);\n  width:73px;\n  height:73px;\n  display:flex;\n  align-items:center;\n  justify-content:center;\n  z-index:3;\n  flex:0 0 auto;\n}\n\n.sc-collector-pill__seal:before{\n  content:\"\";\n  position:absolute;\n  width:53px;\n  height:53px;\n  border-radius:50%;\n  background:\n    radial-gradient(circle, rgba(245,242,234,.10) 0%, rgba(11,11,13,.92) 58%, rgba(11,11,13,0) 72%);\n  box-shadow:\n    0 0 0 1px rgba(212,165,76,.22),\n    0 7px 16px rgba(0,0,0,.28);\n  z-index:-1;\n}\n\n.sc-collector-pill__seal img{\n  width:66px;\n  height:66px;\n  object-fit:contain;\n  display:block;\n  border-radius:50%;\n  filter:\n    drop-shadow(0 6px 10px rgba(0,0,0,.38))\n    drop-shadow(0 0 2px rgba(212,165,76,.46));\n}\n\n.sc-collector-pill__text{\n  position:absolute;\n  z-index:2;\n  top:50%;\n  left:76px;\n  right:14px;\n  transform:translateY(-50%) scaleX(var(--sc-pill-text-scale));\n  transform-origin:center center;\n  display:block;\n  width:auto;\n  max-width:calc(100% - 90px);\n  min-width:0;\n  color:var(--sc-brand-gold);\n  font-size:var(--sc-pill-text-size);\n  font-weight:700;\n  line-height:1;\n  letter-spacing:var(--sc-pill-letter-spacing);\n  text-transform:uppercase;\n  white-space:nowrap;\n  overflow:visible;\n  text-overflow:unset;\n  text-align:center;\n  text-shadow:0 1px 0 rgba(0,0,0,.48);\n  word-break:normal;\n  overflow-wrap:normal;\n}\n\n\n.sc-collector-pill.sc-collector-pill--tight{\n  min-height:38px;\n}\n\n.sc-collector-pill.sc-collector-pill--tight .sc-collector-pill__text{\n  white-space:normal;\n  line-height:1.04;\n  transform:translateY(-50%);\n}\n\n@media(max-width:430px){\n  .sc-collector-pill{\n    min-height:35px;\n  }\n\n  .sc-collector-pill:before{\n    left:31px;\n  }\n\n  .sc-collector-pill:after{\n    left:94px;\n    right:12px;\n  }\n\n  .sc-collector-pill__text{\n    left:73px;\n    right:12px;\n    max-width:calc(100% - 85px);\n  }\n}\n\n@media(max-width:360px){\n  .sc-collector-pill{\n    min-height:34px;\n  }\n\n  .sc-collector-pill:before{\n    left:29px;\n  }\n\n  .sc-collector-pill:after{\n    left:88px;\n    right:10px;\n  }\n\n  .sc-collector-pill__seal{\n    width:70px;\n    height:70px;\n  }\n\n  .sc-collector-pill__seal:before{\n    width:51px;\n    height:51px;\n  }\n\n  .sc-collector-pill__seal img{\n    width:63px;\n    height:63px;\n  }\n\n  .sc-collector-pill__text{\n    left:70px;\n    right:10px;\n    max-width:calc(100% - 80px);\n  }\n}\n\n@media(max-width:320px){\n  .sc-collector-pill__text{\n    left:68px;\n    right:8px;\n    max-width:calc(100% - 76px);\n  }\n}\n</style>\n\n<script>\n(function(){\n  function fitCollectorPill(pill){\n    var text = pill.querySelector('.sc-collector-pill__text');\n    if(!text) return;\n\n    var maxSize = 11.8;\n    var minSize = 7.2;\n\n    var maxSpacing = 0.052;\n    var minSpacing = 0.000;\n\n    var minScale = 0.86;\n\n    pill.classList.remove('sc-collector-pill--tight');\n    pill.style.setProperty('--sc-pill-text-size', maxSize + 'px');\n    pill.style.setProperty('--sc-pill-letter-spacing', maxSpacing + 'em');\n    pill.style.setProperty('--sc-pill-text-scale', '1');\n\n    text.style.whiteSpace = 'nowrap';\n\n    var size = maxSize;\n    var spacing = maxSpacing;\n\n    function fits(){\n      return text.scrollWidth <= text.clientWidth + 1;\n    }\n\n    \n    while(!fits() && spacing > minSpacing){\n      spacing -= 0.004;\n      pill.style.setProperty('--sc-pill-letter-spacing', Math.max(spacing, minSpacing).toFixed(3) + 'em');\n    }\n\n    \n    while(!fits() && size > minSize){\n      size -= 0.2;\n      pill.style.setProperty('--sc-pill-text-size', Math.max(size, minSize).toFixed(1) + 'px');\n    }\n\n    \n    if(!fits()){\n      var scale = Math.max(minScale, Math.min(1, (text.clientWidth / text.scrollWidth)));\n      pill.style.setProperty('--sc-pill-text-scale', scale.toFixed(3));\n    }\n\n    \n    if(text.scrollWidth * parseFloat(getComputedStyle(text).transform === 'none' ? 1 : 1) > text.clientWidth + 8){\n      if(text.scrollWidth > text.clientWidth + 12){\n        pill.classList.add('sc-collector-pill--tight');\n        pill.style.setProperty('--sc-pill-text-size', minSize + 'px');\n        pill.style.setProperty('--sc-pill-letter-spacing', minSpacing + 'em');\n        pill.style.setProperty('--sc-pill-text-scale', '1');\n        text.style.whiteSpace = 'normal';\n      }\n    }\n  }\n\n  function fitAllCollectorPills(){\n    document.querySelectorAll('.sc-collector-pill').forEach(function(pill){\n      fitCollectorPill(pill);\n    });\n  }\n\n  fitAllCollectorPills();\n  setTimeout(fitAllCollectorPills, 60);\n  setTimeout(fitAllCollectorPills, 180);\n  setTimeout(fitAllCollectorPills, 500);\n  setTimeout(fitAllCollectorPills, 1000);\n\n  window.addEventListener('resize', fitAllCollectorPills, { passive:true });\n  window.addEventListener('orientationchange', function(){\n    setTimeout(fitAllCollectorPills, 150);\n  });\n\n  document.addEventListener('shopify:section:load', fitAllCollectorPills);\n  document.addEventListener('shopify:block:select', fitAllCollectorPills);\n\n  if(document.fonts && document.fonts.ready){\n    document.fonts.ready.then(fitAllCollectorPills);\n  }\n\n  if('ResizeObserver' in window){\n    var ro = new ResizeObserver(function(){\n      fitAllCollectorPills();\n    });\n\n    document.querySelectorAll('.sc-collector-pill').forEach(function(pill){\n      ro.observe(pill);\n    });\n  }\n})();\n</script>",
            "show_in_quickbuy": false
          }
        },
        "custom_liquid_jtRdhV": {
          "type": "custom-liquid",
          "name": "Delivery Country HTML",
          "disabled": true,
          "settings": {
            "custom_liquid": "{%- comment -%}\nSPORTS CAVE • Local-Made Fulfilment and Delivery Badge — v11.0\n- 10% shorter vertically\n- Softer beige blend to match variant picker\n- Less boxed-in, more integrated\n- Premium gold micro-lines only\n- Better text hierarchy\n- Mobile compact and safe\n{%- endcomment -%}\n\n{%- liquid\n  assign sc_country_raw = localization.country.name | default: 'Australia'\n  assign sc_country = sc_country_raw\n  assign sc_show_usa_flag = false\n\n  if sc_country_raw == 'United States'\n    assign sc_country = 'USA'\n    assign sc_show_usa_flag = true\n  endif\n\n  assign sc_label = 'Made in ' | append: sc_country\n  assign sc_delivery = '2–6 Business Day Delivery'\n  assign sc_guarantee = '30-Day Guarantee'\n-%}\n\n<div class=\"sc-trust-fulfilment\" aria-label=\"{{ sc_label }}. {{ sc_delivery }}. {{ sc_guarantee }}.\">\n  <style>\n    .sc-trust-fulfilment{\n      --sc-text:#111111;\n      --sc-muted:#6F6A64;\n      --sc-gold:var(--sc-brand-gold);\n      --sc-cream:var(--sc-brand-ivory);\n      --sc-cream-soft:#FBFAF6;\n      --sc-cream-deep:#EFE7D8;\n      --sc-border:#E7DDCC;\n\n      width:100%;\n      margin:6px 0 6px;\n      font-family:var(--sc-font-ui);\n      -webkit-font-smoothing:antialiased;\n      -moz-osx-font-smoothing:grayscale;\n      contain:layout paint style;\n    }\n\n    .sc-trust-fulfilment,\n    .sc-trust-fulfilment *{\n      box-sizing:border-box;\n    }\n\n    .sc-trust-fulfilment__inner{\n      position:relative;\n      width:100%;\n      overflow:hidden;\n      border-radius:10px;\n      padding:8px 14px 8px;\n      background:\n        linear-gradient(\n          180deg,\n          rgba(255,255,255,.68) 0%,\n          rgba(245,242,234,.96) 46%,\n          rgba(239,231,216,.74) 100%\n        );\n      border:1px solid rgba(231,221,204,.92);\n      box-shadow:\n        inset 0 1px 0 rgba(255,255,255,.82),\n        inset 0 -1px 0 rgba(11,11,13,.025);\n    }\n\n    .sc-trust-fulfilment__inner:before{\n      content:\"\";\n      position:absolute;\n      inset:0;\n      pointer-events:none;\n      background:\n        radial-gradient(\n          circle at 50% -18%,\n          rgba(212,165,76,.08) 0%,\n          rgba(212,165,76,.035) 34%,\n          rgba(212,165,76,0) 70%\n        );\n    }\n\n    .sc-trust-fulfilment__top{\n      position:relative;\n      z-index:1;\n      display:flex;\n      align-items:center;\n      justify-content:center;\n      gap:9px;\n      margin-bottom:5px;\n    }\n\n    .sc-trust-fulfilment__line{\n      flex:1 1 auto;\n      height:1px;\n      min-width:22px;\n      background:linear-gradient(\n        90deg,\n        rgba(212,165,76,0) 0%,\n        rgba(212,165,76,.48) 50%,\n        rgba(212,165,76,0) 100%\n      );\n    }\n\n    .sc-trust-fulfilment__labelwrap{\n      display:inline-flex;\n      align-items:center;\n      justify-content:center;\n      gap:7px;\n      white-space:nowrap;\n      min-width:0;\n    }\n\n    .sc-trust-fulfilment__flag{\n      width:13px;\n      height:13px;\n      display:inline-flex;\n      align-items:center;\n      justify-content:center;\n      opacity:.50;\n      position:relative;\n      top:-1px;\n      flex:0 0 13px;\n    }\n\n    .sc-trust-fulfilment__flag img{\n      display:block;\n      width:13px;\n      height:13px;\n    }\n\n    .sc-trust-fulfilment__label{\n      margin:0;\n      font-size:9.3px;\n      font-weight:700;\n      letter-spacing:.19em;\n      text-transform:uppercase;\n      color:rgba(111,106,100,.76);\n      line-height:1;\n    }\n\n    .sc-trust-fulfilment__middle{\n      position:relative;\n      z-index:1;\n      display:flex;\n      align-items:center;\n      justify-content:center;\n      gap:6px;\n      text-align:center;\n    }\n\n    .sc-trust-fulfilment__clock{\n      width:13px;\n      height:13px;\n      flex:0 0 13px;\n      color:rgba(111,106,100,.84);\n      position:relative;\n      top:-.5px;\n    }\n\n    .sc-trust-fulfilment__promise{\n      margin:0;\n      color:rgba(17,17,17,.66);\n      font-size:12.4px;\n      font-weight:700;\n      line-height:1.12;\n      letter-spacing:-.01em;\n    }\n\n    .sc-trust-fulfilment__guarantee{\n      position:relative;\n      z-index:1;\n      margin-top:5px;\n      text-align:center;\n      color:rgba(111,106,100,.78);\n      font-size:9.2px;\n      font-weight:700;\n      letter-spacing:.15em;\n      text-transform:uppercase;\n      line-height:1;\n    }\n\n    @media (max-width:480px){\n      .sc-trust-fulfilment{\n        margin:6px 0 5px;\n      }\n\n      .sc-trust-fulfilment__inner{\n        padding:7px 11px 7px;\n        border-radius:10px;\n      }\n\n      .sc-trust-fulfilment__top{\n        gap:7px;\n        margin-bottom:5px;\n      }\n\n      .sc-trust-fulfilment__line{\n        min-width:15px;\n      }\n\n      .sc-trust-fulfilment__labelwrap{\n        gap:6px;\n      }\n\n      .sc-trust-fulfilment__flag{\n        width:12px;\n        height:12px;\n        flex-basis:12px;\n      }\n\n      .sc-trust-fulfilment__flag img{\n        width:12px;\n        height:12px;\n      }\n\n      .sc-trust-fulfilment__label{\n        font-size:8.2px;\n        letter-spacing:.17em;\n      }\n\n      .sc-trust-fulfilment__middle{\n        gap:5px;\n      }\n\n      .sc-trust-fulfilment__clock{\n        width:12px;\n        height:12px;\n        flex-basis:12px;\n      }\n\n      .sc-trust-fulfilment__promise{\n        font-size:11.7px;\n      }\n\n      .sc-trust-fulfilment__guarantee{\n        margin-top:5px;\n        font-size:8.2px;\n        letter-spacing:.13em;\n      }\n    }\n  </style>\n\n  <div class=\"sc-trust-fulfilment__inner\">\n    <div class=\"sc-trust-fulfilment__top\">\n      <span class=\"sc-trust-fulfilment__line\" aria-hidden=\"true\"></span>\n\n      <span class=\"sc-trust-fulfilment__labelwrap\">\n        {%- if sc_show_usa_flag -%}\n          <span class=\"sc-trust-fulfilment__flag\" aria-hidden=\"true\">\n            <img\n              src=\"https://cdn.shopify.com/s/files/1/0722/2332/6515/files/usa-flag-icon-grey-transparent-sports-cave.svg?v=1776728041\"\n              alt=\"\"\n              width=\"13\"\n              height=\"13\"\n              loading=\"eager\">\n          </span>\n        {%- endif -%}\n\n        <span class=\"sc-trust-fulfilment__label\">{{ sc_label }}</span>\n      </span>\n\n      <span class=\"sc-trust-fulfilment__line\" aria-hidden=\"true\"></span>\n    </div>\n\n    <div class=\"sc-trust-fulfilment__middle\">\n      <svg class=\"sc-trust-fulfilment__clock\" viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n        <circle cx=\"12\" cy=\"12\" r=\"9\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/>\n        <path d=\"M12 7v5l3.4 2.1\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n      </svg>\n\n      <p class=\"sc-trust-fulfilment__promise\">{{ sc_delivery }}</p>\n    </div>\n\n    <div class=\"sc-trust-fulfilment__guarantee\">{{ sc_guarantee }}</div>\n  </div>\n</div>",
            "show_in_quickbuy": false
          }
        },
        "custom_liquid_FeqTFP": {
          "type": "custom-liquid",
          "name": "CHECKOUT BUTTON HTML",
          "disabled": true,
          "settings": {
            "custom_liquid": "{%- comment -%}\n  SPORTS CAVE • Secure Edition + Checkout + Express Checkout\n  - Matched to Variant Picker sizing rhythm\n  - Truck icon removed\n  - Delivery trigger rewritten as clear clickable text: Delivery Details +\n  - Main CTA: Checkout\n  - Real Shopify dynamic express checkout button underneath\n  - Hides \"More payment options\"\n  - Delivery popup anchored from Delivery Details trigger\n{%- endcomment -%}\n\n{%- assign sc_secure_scope = section.id | default: product.id -%}\n{%- assign sc_secure_id = 'sc-secure-edition-' | append: sc_secure_scope | append: '-' | append: product.id -%}\n{%- assign sc_delivery_popup_id = sc_secure_id | append: '-delivery-popup' -%}\n{%- assign sc_secure_form_id = 'sc-secure-form-' | append: sc_secure_scope | append: '-' | append: product.id -%}\n{%- assign sc_current_variant = product.selected_or_first_available_variant -%}\n\n{%- liquid\n  assign sc_country_raw = localization.country.name | default: 'Australia'\n  assign sc_country = sc_country_raw\n  assign sc_show_usa_flag = false\n\n  if sc_country_raw == 'United States'\n    assign sc_country = 'USA'\n    assign sc_show_usa_flag = true\n  endif\n\n  assign sc_label = 'Made in ' | append: sc_country\n  assign sc_delivery = '2–6 Business Day Delivery'\n  assign sc_shipping = 'Shipping calculated at checkout'\n  assign sc_guarantee = '30-Day Guarantee'\n-%}\n\n<div\n  id=\"{{ sc_secure_id }}\"\n  class=\"sc-secure-edition\"\n  data-product-id=\"{{ product.id }}\"\n  data-current-variant=\"{{ sc_current_variant.id }}\"\n>\n  <div class=\"sc-secure-edition__step-row\">\n    <div class=\"sc-secure-edition__step-left\">\n      <span class=\"sc-secure-edition__step\">3</span>\n      <span class=\"sc-secure-edition__step-title\">Secure This Edition</span>\n    </div>\n\n    <div class=\"sc-secure-edition__delivery-wrap\">\n      <button\n        type=\"button\"\n        class=\"sc-secure-edition__delivery-trigger\"\n        data-sc-delivery-trigger\n        aria-controls=\"{{ sc_delivery_popup_id }}\"\n        aria-expanded=\"false\"\n        aria-label=\"Open delivery details\"\n        title=\"Open delivery details\"\n      >\n        <span class=\"sc-secure-edition__delivery-text\">Delivery Details</span>\n        <span class=\"sc-secure-edition__delivery-plus\" aria-hidden=\"true\">+</span>\n      </button>\n\n      <div\n        id=\"{{ sc_delivery_popup_id }}\"\n        class=\"sc-delivery-popup\"\n        data-sc-delivery-popup\n        hidden\n      >\n        <div class=\"sc-delivery-popup__card\" role=\"dialog\" aria-modal=\"false\" aria-label=\"Delivery details\">\n          <button\n            type=\"button\"\n            class=\"sc-delivery-popup__close\"\n            data-sc-delivery-close\n            aria-label=\"Close delivery popup\"\n          >\n            ×\n          </button>\n\n          <div class=\"sc-delivery-popup__brand\">SPORTS CAVE</div>\n\n          <div class=\"sc-delivery-popup__inner\" aria-label=\"{{ sc_label }}. {{ sc_delivery }}. {{ sc_shipping }}. {{ sc_guarantee }}.\">\n            <div class=\"sc-delivery-popup__top\">\n              <span class=\"sc-delivery-popup__line\" aria-hidden=\"true\"></span>\n\n              <span class=\"sc-delivery-popup__labelwrap\">\n                {%- if sc_show_usa_flag -%}\n                  <span class=\"sc-delivery-popup__flag\" aria-hidden=\"true\">\n                    <img\n                      src=\"https://cdn.shopify.com/s/files/1/0722/2332/6515/files/usa-flag-icon-grey-transparent-sports-cave.svg?v=1776728041\"\n                      alt=\"\"\n                      width=\"14\"\n                      height=\"14\"\n                      loading=\"eager\">\n                  </span>\n                {%- endif -%}\n\n                <span class=\"sc-delivery-popup__label\">{{ sc_label }}</span>\n              </span>\n\n              <span class=\"sc-delivery-popup__line\" aria-hidden=\"true\"></span>\n            </div>\n\n            <div class=\"sc-delivery-popup__middle\">\n              <svg class=\"sc-delivery-popup__clock\" viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n                <circle cx=\"12\" cy=\"12\" r=\"9\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/>\n                <path d=\"M12 7v5l3.4 2.1\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n              </svg>\n\n              <p class=\"sc-delivery-popup__promise\">{{ sc_delivery }}</p>\n            </div>\n\n            <div class=\"sc-delivery-popup__shipping\">{{ sc_shipping }}</div>\n\n            <div class=\"sc-delivery-popup__guarantee\">{{ sc_guarantee }}</div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  {%- form 'product', product, id: sc_secure_form_id, class: 'sc-secure-edition__form', data-product-id: product.id -%}\n    <input\n      type=\"hidden\"\n      name=\"id\"\n      value=\"{{ sc_current_variant.id }}\"\n      data-sc-secure-edition-variant-input\n    >\n\n    <input\n      type=\"hidden\"\n      name=\"quantity\"\n      value=\"1\"\n    >\n\n    <button\n      type=\"button\"\n      class=\"sc-secure-edition__btn\"\n      data-sc-secure-edition-button\n      aria-label=\"Checkout with selected edition\"\n      {% unless sc_current_variant.available %}disabled{% endunless %}\n    >\n      <span class=\"sc-secure-edition__label\">\n        {%- if sc_current_variant.available -%}\n          Checkout\n        {%- else -%}\n          Sold Out\n        {%- endif -%}\n      </span>\n      <span class=\"sc-secure-edition__spinner\" aria-hidden=\"true\"></span>\n    </button>\n\n    <div class=\"sc-secure-edition__express\">\n      {{ form | payment_button }}\n    </div>\n\n    <p class=\"sc-secure-edition__error\" data-sc-secure-edition-error role=\"alert\">\n      Could not secure this edition. Please try again.\n    </p>\n  {%- endform -%}\n\n  <script type=\"application/json\" data-sc-se