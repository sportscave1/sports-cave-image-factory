        "code": "<!-- SPORTS CAVE LIMITED EDITION IMAGE BADGE | MAIN IMAGE ONLY | NORMAL + SQUARE MOBILE SAFE -->\n<div id=\"sc-limited-pill-custom\" hidden aria-hidden=\"true\"></div>\n\n<style>\n\n.sc-limited-pill-host{\n  position:relative !important;\n}\n\n.sc-limited-pill{\n  position:absolute;\n  top:9px;\n  right:9px;\n  z-index:12;\n  display:inline-flex;\n  align-items:center;\n  justify-content:center;\n  box-sizing:border-box;\n  width:13.4em;\n  max-width:calc(100% - 18px);\n  aspect-ratio:7.55 / 1;\n  padding:0;\n  border-radius:999px;\n  background:#100F0F;\n  border:1px solid #BF9E65;\n  font-family:var(--sc-font-ui);\n  font-size:8.184px;\n  font-weight:600;\n  line-height:1;\n  letter-spacing:.075em;\n  text-transform:uppercase;\n  white-space:nowrap;\n  pointer-events:none;\n  user-select:none;\n  -webkit-font-smoothing:antialiased;\n}\n\n.sc-limited-pill__text{\n  display:inline-flex;\n  align-items:center;\n  column-gap:.4em;\n}\n\n@media(max-width:749px){\n  .sc-limited-pill{\n    top:7px;\n    right:7px;\n    font-size:7.254px;\n  }\n}\n\n@media(max-width:370px){\n  .sc-limited-pill{\n    top:6px;\n    right:6px;\n    font-size:6.696px;\n  }\n}\n\n\n.thumbnails .sc-limited-pill,\n.thumbnail .sc-limited-pill,\n.thumbnail-list .sc-limited-pill,\n.product__media-thumbnail .sc-limited-pill,\n.product-media-thumbs .sc-limited-pill,\n.product__media-list--thumbnails .sc-limited-pill,\n[data-thumbnail] .sc-limited-pill,\n.sc-square-mobile-rail .sc-limited-pill,\n.sc-square-mobile-thumb .sc-limited-pill,\n.slider-nav .sc-limited-pill,\n.size-guide .sc-limited-pill,\n.size-chart .sc-limited-pill,\n[id*=\"size-guide\"] .sc-limited-pill,\n[id*=\"SizeGuide\"] .sc-limited-pill,\n[id*=\"size-chart\"] .sc-limited-pill,\n[id*=\"SizeChart\"] .sc-limited-pill,\n.scx-stickyp .sc-limited-pill,\n.sc-stickyp .sc-limited-pill,\n.cart-drawer .sc-limited-pill,\n#CartDrawer .sc-limited-pill,\n.quick-add-modal .sc-limited-pill,\n.modal .sc-limited-pill,\n.drawer .sc-limited-pill,\n[aria-modal=\"true\"] .sc-limited-pill{\n  display:none !important;\n}\n</style>\n\n<script>\n(function(){\n  if(window.__sportsCaveLimitedEditionNormalAndSquareSafe === true) return;\n  window.__sportsCaveLimitedEditionNormalAndSquareSafe = true;\n\n  var excludedSelector = [\n    '.thumbnails',\n    '.thumbnail',\n    '.thumbnail-list',\n    '.product__media-thumbnail',\n    '.product-media-thumbs',\n    '.product__media-list--thumbnails',\n    '[data-thumbnail]',\n    '.sc-square-mobile-rail',\n    '.sc-square-mobile-thumb',\n    '.slider-nav',\n    '.size-guide',\n    '.size-chart',\n    '[id*=\"size-guide\"]',\n    '[id*=\"SizeGuide\"]',\n    '[id*=\"size-chart\"]',\n    '[id*=\"SizeChart\"]',\n    '.scx-stickyp',\n    '.sc-stickyp',\n    '.cart-drawer',\n    '#CartDrawer',\n    '.quick-add-modal',\n    '.modal',\n    '.drawer',\n    '[aria-modal=\"true\"]'\n  ].join(',');\n\n  var skipWords = [\n    'size guide',\n    'size chart',\n    'shipping',\n    'delivery',\n    'returns',\n    'return',\n    'guarantee',\n    'money back',\n    'review',\n    'reviews',\n    'payment',\n    'afterpay',\n    'paypal',\n    'visa',\n    'mastercard',\n    'frame guide',\n    'swatch'\n  ];\n\n  function isExcluded(el){\n    return !!(el && el.closest && el.closest(excludedSelector));\n  }\n\n  function shouldSkipImage(img){\n    if(!img) return true;\n\n    var alt = String(img.getAttribute('alt') || '').toLowerCase();\n    var src = String(img.currentSrc || img.src || '').toLowerCase();\n\n    for(var i = 0; i < skipWords.length; i++){\n      var word = skipWords[i];\n      var slug = word.replace(/\\s+/g,'-');\n\n      if(\n        alt.indexOf(word) > -1 ||\n        src.indexOf(word) > -1 ||\n        src.indexOf(slug) > -1\n      ){\n        return true;\n      }\n    }\n\n    return false;\n  }\n\n  function createBadge(){\n    var badge = document.createElement('div');\n    badge.className = 'sc-limited-pill';\n    badge.setAttribute('aria-label','Limited edition');\n\n    var text = document.createElement('span');\n    text.className = 'sc-limited-pill__text';\n    // Keep each word's colour independent of Shopify theme text styles.\n    var limited = document.createElement('span');\n    limited.textContent = 'Limited';\n    limited.style.setProperty('color', '#BA9B66', 'important');\n\n    var edition = document.createElement('span');\n    edition.textContent = 'Edition';\n    edition.style.setProperty('color', '#F2E6D3', 'important');\n\n    text.appendChild(limited);\n    text.appendChild(document.createTextNode(' '));\n    text.appendChild(edition);\n\n    badge.appendChild(text);\n    return badge;\n  }\n\n  function cleanGalleryBadges(gallery){\n    if(!gallery) return;\n\n    gallery.querySelectorAll('.sc-limited-pill').forEach(function(badge){\n      badge.remove();\n    });\n\n    gallery.querySelectorAll('.sc-limited-pill-host[data-sc-limited-badge-added=\"1\"]').forEach(function(host){\n      host.classList.remove('sc-limited-pill-host');\n      delete host.dataset.scLimitedBadgeAdded;\n    });\n  }\n\n  function getNativeActiveSlide(gallery){\n    return (\n      gallery.querySelector('.main-image .slider__item.is-active') ||\n      gallery.querySelector('.main-image .slider__item[aria-hidden=\"false\"]') ||\n      gallery.querySelector('.main-image .slider__item')\n    );\n  }\n\n  function getNativeBadgeHost(activeSlide, img){\n    return (\n      img.closest('.media') ||\n      img.closest('.product__media') ||\n      img.closest('.product-media') ||\n      img.closest('.rimage-outer-wrapper') ||\n      img.closest('.image-wrapper') ||\n      img.closest('.product__modal-opener') ||\n      activeSlide\n    );\n  }\n\n  function applyNativeBadge(gallery){\n    var activeSlide = getNativeActiveSlide(gallery);\n    if(!activeSlide || isExcluded(activeSlide)) return false;\n\n    var img = activeSlide.querySelector('img');\n    if(!img || shouldSkipImage(img)) return false;\n\n    var host = getNativeBadgeHost(activeSlide, img);\n    if(!host || isExcluded(host)) return false;\n\n    host.classList.add('sc-limited-pill-host');\n    host.dataset.scLimitedBadgeAdded = '1';\n    host.appendChild(createBadge());\n\n    return true;\n  }\n\n  function getSquareActiveSlide(gallery){\n    return (\n      gallery.querySelector('.sc-square-mobile-slide.is-active') ||\n      gallery.querySelector('.sc-square-mobile-slide:not([inert])') ||\n      gallery.querySelector('.sc-square-mobile-slide')\n    );\n  }\n\n  function applySquareMobileBadge(gallery){\n    var squareMain = gallery.querySelector('.sc-square-mobile-main');\n    if(!squareMain || isExcluded(squareMain)) return false;\n\n    var activeSlide = getSquareActiveSlide(gallery);\n    if(!activeSlide || isExcluded(activeSlide)) return false;\n\n    var img = activeSlide.querySelector('img');\n    if(!img || shouldSkipImage(img)) return false;\n\n    squareMain.classList.add('sc-limited-pill-host');\n    squareMain.dataset.scLimitedBadgeAdded = '1';\n    squareMain.appendChild(createBadge());\n\n    return true;\n  }\n\n  function squareGalleryIsVisible(gallery){\n    var square = gallery.querySelector('.sc-square-mobile-gallery');\n    if(!square) return false;\n\n    var style = window.getComputedStyle(square);\n    return style.display !== 'none' && style.visibility !== 'hidden' && square.offsetParent !== null;\n  }\n\n  function applyBadgeToGallery(gallery){\n    if(!gallery || isExcluded(gallery)) return;\n\n    cleanGalleryBadges(gallery);\n\n    if(squareGalleryIsVisible(gallery)){\n      applySquareMobileBadge(gallery);\n      return;\n    }\n\n    applyNativeBadge(gallery);\n  }\n\n  function applyBadges(){\n    document.querySelectorAll('media-gallery, .media-gallery, [id*=\"MediaGallery\"]').forEach(function(gallery){\n      applyBadgeToGallery(gallery);\n    });\n  }\n\n  function scheduleApply(delay){\n    clearTimeout(window.__scLimitedNormalSquareTimer);\n    window.__scLimitedNormalSquareTimer = setTimeout(applyBadges, delay || 90);\n  }\n\n  if(document.readyState === 'loading'){\n    document.addEventListener('DOMContentLoaded', function(){\n      scheduleApply(80);\n    });\n  }else{\n    scheduleApply(80);\n  }\n\n  window.addEventListener('load', function(){\n    setTimeout(applyBadges, 150);\n    setTimeout(applyBadges, 500);\n  });\n\n  window.addEventListener('resize', function(){\n    scheduleApply(120);\n  });\n\n  document.addEventListener('shopify:section:load', function(){\n    scheduleApply(120);\n  });\n\n  document.addEventListener('shopify:section:select', function(){\n    scheduleApply(120);\n  });\n\n  document.addEventListener('product:variant-change', function(){\n    scheduleApply(120);\n    setTimeout(applyBadges, 320);\n  });\n\n  document.addEventListener('variant:change', function(){\n    scheduleApply(120);\n    setTimeout(applyBadges, 320);\n  });\n\n  document.addEventListener('click', function(e){\n    var gallery = e.target.closest('media-gallery, .media-gallery, [id*=\"MediaGallery\"]');\n    if(!gallery) return;\n    if(isExcluded(e.target)) return;\n\n    setTimeout(applyBadges, 120);\n    setTimeout(applyBadges, 350);\n  }, true);\n\n  document.addEventListener('touchend', function(e){\n    var gallery = e.target.closest('media-gallery, .media-gallery, [id*=\"MediaGallery\"]');\n    if(!gallery) return;\n    if(isExcluded(e.target)) return;\n\n    setTimeout(applyBadges, 180);\n    setTimeout(applyBadges, 420);\n  }, true);\n\n  function bindSquareScrollWatchers(){\n    document.querySelectorAll('.sc-square-mobile-track:not([data-sc-limited-scroll-watch=\"true\"])').forEach(function(track){\n      track.dataset.scLimitedScrollWatch = 'true';\n\n      var ticking = false;\n\n      track.addEventListener('scroll', function(){\n        if(ticking) return;\n\n        ticking = true;\n        window.requestAnimationFrame(function(){\n          ticking = false;\n          scheduleApply(70);\n        });\n      }, { passive:true });\n    });\n  }\n\n  function observeGalleries(){\n    document.querySelectorAll('media-gallery, .media-gallery, [id*=\"MediaGallery\"]').forEach(function(gallery){\n      if(gallery.dataset.scLimitedObserverAttached === '1') return;\n\n      gallery.dataset.scLimitedObserverAttached = '1';\n\n      var observer = new MutationObserver(function(){\n        bindSquareScrollWatchers();\n        scheduleApply(90);\n      });\n\n      observer.observe(gallery,{\n        childList:true,\n        subtree:true,\n        attributes:true,\n        attributeFilter:['class','inert']\n      });\n    });\n\n    bindSquareScrollWatchers();\n  }\n\n  observeGalleries();\n  setTimeout(observeGalleries, 500);\n  setTimeout(applyBadges, 650);\n})();\n</script>"
