        "code": "{%- liquid\nassign sc_bundle_ready_label = 'ADD BUNDLE TO CART'\n-%}\n<div class=\"related-products\"\ndata-section-id=\"{{ section.id }}\"\ndata-url=\"{{ routes.product_recommendations_url }}?section_id={{ section.id }}&limit=10&product_id={{ product.id }}\"\n{%- render 'animation-attrs', attrs: 'data-cc-animate' -%}>\n{%- liquid\nassign sc_bundle_eligible_count = 0\nassign sc_product_enabled_raw = product.metafields.sports_cave.edition_enabled.value\nassign sc_product_enabled_text = sc_product_enabled_raw | append: '' | downcase | strip\nassign sc_product_enabled = false\nif sc_product_enabled_raw == true or sc_product_enabled_text == 'true' or sc_product_enabled_text == '1' or sc_product_enabled_text == 'yes'\nassign sc_product_enabled = true\nendif\nassign sc_product_total = product.metafields.sports_cave.edition_total.value | default: 0 | plus: 0\nassign sc_product_next = product.metafields.sports_cave.edition_next_number.value | default: 0 | plus: 0\nassign sc_product_sold = product.metafields.sports_cave.edition_sold_count.value | default: 0 | plus: 0\nassign sc_product_remaining = product.metafields.sports_cave.edition_remaining.value | default: 0 | plus: 0\nassign sc_product_status = product.metafields.sports_cave.edition_status.value | default: '' | downcase | strip\nassign sc_product_status_blocked = false\nif sc_product_status contains 'sold out' or sc_product_status contains 'sold_out' or sc_product_status contains 'expired' or sc_product_status contains 'disabled' or sc_product_status contains 'archive' or sc_product_status contains 'inactive' or sc_product_status contains 'unavailable' or sc_product_status contains 'ended'\nassign sc_product_status_blocked = true\nendif\nassign sc_product_eligible = false\nif product.available and sc_product_enabled and sc_product_total > 0 and sc_product_next > 0 and sc_product_next <= sc_product_total and sc_product_sold < sc_product_total and sc_product_remaining > 0 and sc_product_status_blocked == false\nassign sc_product_eligible = true\nassign sc_bundle_eligible_count = sc_bundle_eligible_count | plus: 1\nendif\nfor sc_candidate in recommendations.products\nunless sc_candidate.id == product.id\nassign sc_candidate_enabled_raw = sc_candidate.metafields.sports_cave.edition_enabled.value\nassign sc_candidate_enabled_text = sc_candidate_enabled_raw | append: '' | downcase | strip\nassign sc_candidate_enabled = false\nif sc_candidate_enabled_raw == true or sc_candidate_enabled_text == 'true' or sc_candidate_enabled_text == '1' or sc_candidate_enabled_text == 'yes'\nassign sc_candidate_enabled = true\nendif\nassign sc_candidate_total = sc_candidate.metafields.sports_cave.edition_total.value | default: 0 | plus: 0\nassign sc_candidate_next = sc_candidate.metafields.sports_cave.edition_next_number.value | default: 0 | plus: 0\nassign sc_candidate_sold = sc_candidate.metafields.sports_cave.edition_sold_count.value | default: 0 | plus: 0\nassign sc_candidate_remaining = sc_candidate.metafields.sports_cave.edition_remaining.value | default: 0 | plus: 0\nassign sc_candidate_status = sc_candidate.metafields.sports_cave.edition_status.value | default: '' | downcase | strip\nassign sc_candidate_status_blocked = false\nif sc_candidate_status contains 'sold out' or sc_candidate_status contains 'sold_out' or sc_candidate_status contains 'expired' or sc_candidate_status contains 'disabled' or sc_candidate_status contains 'archive' or sc_candidate_status contains 'inactive' or sc_candidate_status contains 'unavailable' or sc_candidate_status contains 'ended'\nassign sc_candidate_status_blocked = true\nendif\nif sc_candidate.available and sc_candidate_enabled and sc_candidate_total > 0 and sc_candidate_next > 0 and sc_candidate_next <= sc_candidate_total and sc_candidate_sold < sc_candidate_total and sc_candidate_remaining > 0 and sc_candidate_status_blocked == false\nassign sc_bundle_eligible_count = sc_bundle_eligible_count | plus: 1\nendif\nendunless\nendfor\n-%}\n{% if recommendations.performed and sc_bundle_eligible_count >= 2 %}\n<div class=\"container{% if settings.use_fullwidth_layout %} container--no-max{% endif %} fully-spaced-row\"><div class=\"sc-mj-headline\" id=\"sc-bundle-upsell-headline\"><div class=\"sc-mj-headline__plaque\" role=\"group\" aria-label=\"Black Friday\"><div class=\"sc-gift-eyebrow\">EARLY GIFTING. BIGGER MOMENTS.</div><h2 class=\"sc-mj-headline__title\">THE <span>GIFT</span> EDIT</h2><div class=\"sc-mj-headline__sep\"></div><p class=\"sc-mj-headline__sub\">Limited time: 25% off 2+ editions.</p><div class=\"sc-gift-tag\">GIVE MORE<br>THAN A GIFT</div><div class=\"sc-gift-perks\" aria-label=\"Black Friday benefits\"><div class=\"sc-gift-perk\"><span class=\"sc-gift-perk__icon\"><svg viewBox=\"0 0 32 32\"><path d=\"M7 13.5h18v12H7z\"/><path d=\"M16 13.5v12\"/><path d=\"M6 9.5h20v4H6z\"/><path d=\"M16 9.5c0-3.2 1.8-5 4.4-5 1.8 0 3.1 1.1 3.1 2.7 0 1.4-1 2.3-2.8 2.3H16z\"/><path d=\"M16 9.5c0-3.2-1.8-5-4.4-5-1.8 0-3.1 1.1-3.1 2.7 0 1.4 1 2.3 2.8 2.3H16z\"/></svg></span><span>For the fan who<br>has everything</span></div><div class=\"sc-gift-perk\"><span class=\"sc-gift-perk__icon sc-gift-perk__icon--edition\"><span class=\"sc-edition-mark\">100</span></span><span>Choose their<br>legends</span></div><div class=\"sc-gift-perk\"><span class=\"sc-gift-perk__icon\"><svg viewBox=\"0 0 32 32\"><path d=\"m16 4.8 2.9 5.9 6.6 1-4.8 4.7 1.1 6.6-5.8-3.1-5.8 3.1 1.1-6.6-4.8-4.7 6.6-1z\"/></svg></span><span>Build their<br>collection</span></div><div class=\"sc-gift-perk\"><span class=\"sc-gift-perk__icon\"><svg viewBox=\"0 0 32 32\"><path d=\"M16 25.7 8.8 18.9c-2.5-2.4-2.9-6.1-.8-8.4 1.9-2.1 5.2-2.1 7.1-.1l.9.9.9-.9c1.9-2 5.2-2 7.1.1 2.1 2.3 1.8 6-.8 8.4z\"/></svg></span><span>Made to be<br>remembered</span></div></div></div></div><section id=\"sc-mj-bundle\" class=\"sc-mj\" aria-label=\"Sports Cave Black Friday\"><script type=\"application/json\" id=\"sc-mj-pool\">\n[\n{%- assign sc_json_first = true -%}\n{%- if sc_product_eligible -%}\n{\n\"id\": {{ product.id }},\n\"title\": {{ product.title | json }},\n\"url\": {{ product.url | json }},\n\"image560\": {{ product.featured_media | default: product.media.first | image_url: width: 560 | json }},\n\"options\": {{ product.options | json }},\n\"editionEligible\": true,\n\"editionNext\": {{ sc_product_next }},\n\"editionTotal\": {{ sc_product_total }},\n\"variants\": [\n{%- for v in product.variants -%}\n{\n\"id\": {{ v.id }},\n\"price\": {{ v.price }},\n\"compare_at\": {{ v.compare_at_price | default: v.price }},\n\"price_money\": {{ v.price | money | json }},\n\"compare_at_money\": {{ v.compare_at_price | default: v.price | money | json }},\n\"available\": {{ v.available | json }},\n\"image\":{% if v.featured_media %}{{ v.featured_media.preview_image | image_url: width: 560 | json }}{% else %}null{% endif %},\n\"options\":[{{ v.option1 | json }},{{ v.option2 | json }},{{ v.option3 | json }}]\n}{%- unless forloop.last -%},{%- endunless -%}\n{%- endfor -%}\n]\n}\n{%- assign sc_json_first = false -%}\n{%- endif -%}\n{%- for p in recommendations.products -%}\n{%- unless p.id == product.id -%}\n{%- liquid\nassign sc_p_enabled_raw = p.metafields.sports_cave.edition_enabled.value\nassign sc_p_enabled_text = sc_p_enabled_raw | append: '' | downcase | strip\nassign sc_p_enabled = false\nif sc_p_enabled_raw == true or sc_p_enabled_text == 'true' or sc_p_enabled_text == '1' or sc_p_enabled_text == 'yes'\nassign sc_p_enabled = true\nendif\nassign sc_p_total = p.metafields.sports_cave.edition_total.value | default: 0 | plus: 0\nassign sc_p_next = p.metafields.sports_cave.edition_next_number.value | default: 0 | plus: 0\nassign sc_p_sold = p.metafields.sports_cave.edition_sold_count.value | default: 0 | plus: 0\nassign sc_p_remaining = p.metafields.sports_cave.edition_remaining.value | default: 0 | plus: 0\nassign sc_p_status = p.metafields.sports_cave.edition_status.value | default: '' | downcase | strip\nassign sc_p_status_blocked = false\nif sc_p_status contains 'sold out' or sc_p_status contains 'sold_out' or sc_p_status contains 'expired' or sc_p_status contains 'disabled' or sc_p_status contains 'archive' or sc_p_status contains 'inactive' or sc_p_status contains 'unavailable' or sc_p_status contains 'ended'\nassign sc_p_status_blocked = true\nendif\nassign sc_p_eligible = false\nif p.available and sc_p_enabled and sc_p_total > 0 and sc_p_next > 0 and sc_p_next <= sc_p_total and sc_p_sold < sc_p_total and sc_p_remaining > 0 and sc_p_status_blocked == false\nassign sc_p_eligible = true\nendif\n-%}\n{%- if sc_p_eligible -%}\n{%- unless sc_json_first -%},{%- endunless -%}\n{\n\"id\": {{ p.id }},\n\"title\": {{ p.title | json }},\n\"url\": {{ p.url | json }},\n\"image560\": {{ p.featured_media | default: p.media.first | image_url: width: 560 | json }},\n\"options\": {{ p.options | json }},\n\"editionEligible\": true,\n\"editionNext\": {{ sc_p_next }},\n\"editionTotal\": {{ sc_p_total }},\n\"variants\": [\n{%- for v in p.variants -%}\n{\n\"id\": {{ v.id }},\n\"price\": {{ v.price }},\n\"compare_at\": {{ v.compare_at_price | default: v.price }},\n\"price_money\": {{ v.price | money | json }},\n\"compare_at_money\": {{ v.compare_at_price | default: v.price | money | json }},\n\"available\": {{ v.available | json }},\n\"image\":{% if v.featured_media %}{{ v.featured_media.preview_image | image_url: width: 560 | json }}{% else %}null{% endif %},\n\"options\":[{{ v.option1 | json }},{{ v.option2 | json }},{{ v.option3 | json }}]\n}{%- unless forloop.last -%},{%- endunless -%}\n{%- endfor -%}\n]\n}\n{%- assign sc_json_first = false -%}\n{%- endif -%}\n{%- endunless -%}\n{%- endfor -%}\n]\n</script><div class=\"sc-mj__wrap\"\ndata-money-format=\"{{ shop.money_format | replace: \"'\", \"\\\\'\" | escape }}\"\ndata-currency=\"{{ cart.currency.iso_code | escape }}\"\ndata-locale=\"{{ request.locale.iso_code | default: localization.language.iso_code | default: 'en' | escape }}\"\ndata-cart-add-url=\"{{ routes.cart_add_url }}.js\"\ndata-cart-url=\"{{ routes.cart_url }}.js\"\ndata-root-url=\"{{ routes.root_url }}\"><div class=\"sc-mj__carousel\"><button class=\"sc-mj__carousel-btn sc-mj__carousel-prev\" aria-label=\"Previous recommended editions\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M14.5 6.5 9 12l5.5 5.5\"/></svg></button><ul class=\"sc-mj__grid\" aria-live=\"polite\"></ul><button class=\"sc-mj__carousel-btn sc-mj__carousel-next\" aria-label=\"Next recommended editions\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"m9.5 6.5 5.5 5.5-5.5 5.5\"/></svg></button></div><div class=\"sc-mj__totals\" aria-live=\"polite\"><div class=\"sc-mj__summary-head\"><div class=\"sc-mj__badge\"><span class=\"sc-mj__gift-icon\"><svg viewBox=\"0 0 24 24\"><path d=\"M4 10h16v10H4zM12 10v10M3 7h18v3H3zM12 7c0-4 6-4 6 0M12 7c0-4-6-4-6 0\"/></svg></span><span><strong class=\"tier\" data-tier>Choose 2 editions to unlock 25% off</strong><small data-saving-message>Pair two editions and your collector saving applies automatically.</small></span></div></div><div class=\"sc-mj__amounts\"><div class=\"row\"><span class=\"lab\">Edition value (RRP)</span><span class=\"val\" data-rrp>—</span></div><div class=\"row sc-subtotal-row\"><span class=\"lab\">Edition subtotal</span><span class=\"val\" data-subtotal>—</span></div><div class=\"row\"><span class=\"lab\">Collector saving (20%)</span><span class=\"val\" data-discount>—</span></div><div class=\"row due\"><span class=\"lab\">You pay</span><span class=\"val\" data-due>—</span></div></div><div class=\"sc-mj__script\"><span>Own The<br>Moments</span></div><button type=\"button\" class=\"sc-mj__atc\" disabled aria-disabled=\"true\"><span class=\"sc-mj__atc-spinner\"></span><span class=\"sc-mj__bag\"><svg viewBox=\"0 0 24 24\"><path d=\"M6.5 8.5h11l1 12h-13l1-12Z\"></path><path d=\"M9 8.5V6.8a3 3 0 0 1 6 0v1.7\"></path></svg></span><span class=\"sc-mj__atc-label\">Select 2 editions to save 25%</span><span class=\"sc-mj__arrow\">→</span></button></div></div></section><div class=\"sz\" hidden><div class=\"szp\" role=\"dialog\" aria-modal=\"true\" aria-label=\"Artwork preview\"><button type=\"button\" class=\"sx\" aria-label=\"Close preview\">×</button><img alt=\"\"></div></div><style>body.szo{overflow:hidden}.sz[hidden]{display:none}.sz{position:fixed;inset:0;z-index:2147483646;background:rgba(0,0,0,.78);display:grid;place-items:center;padding:3vh 3vw;box-sizing:border-box}.szp{position:relative;width:min(80vw,1200px);height:min(80dvh,850px);max-height:calc(100dvh - 40px);display:grid;place-items:center;box-sizing:border-box;padding:50px 18px 18px;background:#0B0B0D;border:1px solid rgba(212,165,76,.5);border-radius:18px;box-shadow:0 24px 70px rgba(0,0,0,.62);overflow:hidden}.szp img{display:block;width:100%;height:100%;min-width:0;min-height:0;object-fit:contain;object-position:center}.sx{position:absolute;top:9px;right:9px;z-index:5;width:38px;height:38px;padding:0;border:1px solid rgba(212,165,76,.7);border-radius:50%;background:#0B0B0D;color:#F5F2EA;font:300 28px/1 Arial;display:grid;place-items:center;cursor:pointer;touch-action:manipulation;pointer-events:auto}.sx:hover{border-color:#D4A54C}.sx:focus-visible{outline:2px solid #D4A54C;outline-offset:2px}#sc-mj-bundle .sc-chip{display:none!important}.sc-mj-headline{margin:14px auto 4px;max-width:1320px;padding:0 12px;text-align:center}.sc-mj-headline__plaque{width:min(1180px,100%);margin:auto;padding:27px 22px 0;border-radius:22px;position:relative;overflow:hidden;background:url('https://cdn.shopify.com/s/files/1/0722/2332/6515/files/sports-cave-early-gift-edit-upsell-banner.webp?v=1790297764') center center/100% 100% no-repeat;border:1px solid rgba(212,165,76,.30);box-shadow:0 18px 44px rgba(0,0,0,.34),inset 0 1px rgba(245,242,234,.045)}.sc-gift-eyebrow{font:750 10px/1 Montserrat,system-ui,sans-serif;letter-spacing:.42em;color:#c8c2ba;margin-bottom:10px}.sc-mj-headline__title{margin:0;text-transform:uppercase;font-family:Georgia,'Times New Roman',