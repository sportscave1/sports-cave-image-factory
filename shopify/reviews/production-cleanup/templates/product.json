15;\n  letter-spacing:-.005em;\n}\n\n#{{ sc_secure_id }} .sc-delivery-popup__shipping{\n  position:relative;\n  z-index:1;\n  margin-top:10px;\n  text-align:center;\n  color:#9E7422;\n  font-size:11px;\n  font-weight:700;\n  letter-spacing:.13em;\n  text-transform:uppercase;\n  line-height:1.15;\n}\n\n#{{ sc_secure_id }} .sc-delivery-popup__guarantee{\n  position:relative;\n  z-index:1;\n  margin-top:10px;\n  text-align:center;\n  color:rgba(17,17,17,.56);\n  font-size:10px;\n  font-weight:700;\n  letter-spacing:.16em;\n  text-transform:uppercase;\n  line-height:1;\n}\n\n@keyframes scSecureEditionSpin-{{ product.id }}{\n  to{ transform:rotate(360deg); }\n}\n\n@media(min-width:990px){\n  #{{ sc_secure_id }}{\n    margin-top:10px;\n  }\n\n  #{{ sc_secure_id }} .sc-secure-edition__btn,\n  #{{ sc_secure_id }} .shopify-payment-button__button{\n    min-height:52px;\n  }\n\n  #{{ sc_secure_id }} .sc-secure-edition__label{\n    font-size:16px;\n  }\n}\n\n@media(max-width:430px){\n  #{{ sc_secure_id }}{\n    margin:9px 0 8px;\n  }\n\n  #{{ sc_secure_id }} .sc-secure-edition__step-row{\n    gap:8px;\n    margin-bottom:7px;\n  }\n\n  #{{ sc_secure_id }} .sc-secure-edition__step-title{\n    font-size:.82rem;\n  }\n\n  #{{ sc_secure_id }} .sc-secure-edition__delivery-trigger{\n    gap:5px;\n    padding-left:6px;\n    min-height:34px;\n    font-size:11.5px;\n  }\n\n  #{{ sc_secure_id }} .sc-secure-edition__delivery-trigger::after{\n    left:6px;\n    right:20px;\n    bottom:5px;\n  }\n\n  #{{ sc_secure_id }} .sc-secure-edition__delivery-plus{\n    width:15px;\n    height:15px;\n    flex-basis:15px;\n    font-size:12px;\n  }\n\n  #{{ sc_secure_id }} .sc-secure-edition__btn,\n  #{{ sc_secure_id }} .shopify-payment-button__button{\n    min-height:52px;\n  }\n\n  #{{ sc_secure_id }} .sc-secure-edition__label{\n    font-size:14.8px;\n    letter-spacing:.07em;\n  }\n\n  #{{ sc_secure_id }} .sc-delivery-popup{\n    top:33px;\n    right:-2px;\n    width:min(94vw,410px);\n  }\n\n  #{{ sc_secure_id }} .sc-delivery-popup__card::before{\n    right:27px;\n  }\n\n  #{{ sc_secure_id }} .sc-delivery-popup__close{\n    width:32px;\n    height:32px;\n    font-size:23px;\n    top:-12px;\n    right:-7px;\n  }\n\n  #{{ sc_secure_id }} .sc-delivery-popup__inner{\n    padding:19px 13px 13px;\n    border-radius:16px;\n  }\n\n  #{{ sc_secure_id }} .sc-delivery-popup__top{\n    gap:8px;\n    margin-bottom:7px;\n  }\n\n  #{{ sc_secure_id }} .sc-delivery-popup__line{\n    min-width:16px;\n  }\n\n  #{{ sc_secure_id }} .sc-delivery-popup__label{\n    font-size:8.8px;\n    letter-spacing:.18em;\n  }\n\n  #{{ sc_secure_id }} .sc-delivery-popup__promise{\n    font-size:12.3px;\n  }\n\n  #{{ sc_secure_id }} .sc-delivery-popup__shipping{\n    font-size:9px;\n    letter-spacing:.11em;\n    margin-top:8px;\n  }\n\n  #{{ sc_secure_id }} .sc-delivery-popup__guarantee{\n    margin-top:8px;\n    font-size:8.9px;\n    letter-spacing:.14em;\n  }\n}\n\n@media(max-width:390px){\n  #{{ sc_secure_id }} .sc-secure-edition__step-title{\n    font-size:.78rem;\n  }\n\n  #{{ sc_secure_id }} .sc-secure-edition__delivery-trigger{\n    font-size:10.9px;\n    gap:4px;\n  }\n\n  #{{ sc_secure_id }} .sc-secure-edition__label{\n    font-size:14px;\n    letter-spacing:.065em;\n  }\n\n  #{{ sc_secure_id }} .sc-delivery-popup{\n    right:-4px;\n    width:min(95vw,390px);\n  }\n}\n\n@media(max-width:350px){\n  #{{ sc_secure_id }} .sc-secure-edition__delivery-text{\n    font-size:10.4px;\n  }\n\n  #{{ sc_secure_id }} .sc-secure-edition__delivery-plus{\n    width:14px;\n    height:14px;\n    flex-basis:14px;\n    font-size:11px;\n  }\n\n  #{{ sc_secure_id }} .sc-secure-edition__label{\n    font-size:13.2px;\n    letter-spacing:.055em;\n  }\n\n  #{{ sc_secure_id }} .sc-delivery-popup{\n    right:-2px;\n    width:min(96vw,360px);\n  }\n}\n\n@media(prefers-reduced-motion:reduce){\n  #{{ sc_secure_id }} .sc-secure-edition__btn,\n  #{{ sc_secure_id }} .sc-delivery-popup__card,\n  #{{ sc_secure_id }} .sc-secure-edition__delivery-trigger{\n    transition:none!important;\n  }\n\n  #{{ sc_secure_id }} .sc-secure-edition__spinner{\n    animation:none!important;\n  }\n}\n</style>\n\n<script>\n(function(){\n  var root = document.getElementById({{ sc_secure_id | json }});\n  if(!root || root.dataset.bound === '1') return;\n  root.dataset.bound = '1';\n\n  var form = root.querySelector('.sc-secure-edition__form');\n  var btn = root.querySelector('[data-sc-secure-edition-button]');\n  var err = root.querySelector('[data-sc-secure-edition-error]');\n  var variantsEl = root.querySelector('[data-sc-secure-edition-variants]');\n  var variantInput = root.querySelector('[data-sc-secure-edition-variant-input]');\n\n  var deliveryTrigger = root.querySelector('[data-sc-delivery-trigger]');\n  var deliveryPopup = root.querySelector('[data-sc-delivery-popup]');\n  var deliveryCloseEls = root.querySelectorAll('[data-sc-delivery-close]');\n\n  if(!form || !btn || !variantsEl || !variantInput) return;\n\n  var VARIANT_MAP = {};\n\n  try{\n    VARIANT_MAP = JSON.parse(variantsEl.textContent || '{}');\n  }catch(e){\n    VARIANT_MAP = {};\n  }\n\n  function routeRoot(){\n    var rootPath = '/';\n\n    try{\n      if(window.Shopify && window.Shopify.routes && window.Shopify.routes.root){\n        rootPath = window.Shopify.routes.root;\n      }\n    }catch(e){}\n\n    rootPath = String(rootPath || '/');\n\n    if(rootPath.slice(-1) !== '/'){\n      rootPath += '/';\n    }\n\n    return rootPath;\n  }\n\n  function findMainProductForm(){\n    var productInfo =\n      root.closest('[id^=\"ProductInfo-\"]') ||\n      document.querySelector('#ProductInfo-{{ section.id }}') ||\n      document.querySelector('[id^=\"ProductInfo-\"]') ||\n      document;\n\n    return productInfo.querySelector('form[action*=\"/cart/add\"] input[name=\"id\"]') ||\n      document.querySelector('form[action*=\"/cart/add\"] input[name=\"id\"]');\n  }\n\n  function getVariantId(){\n    var mainIdInput = findMainProductForm();\n\n    if(mainIdInput && mainIdInput.value){\n      return String(mainIdInput.value || '');\n    }\n\n    return String(variantInput.value || '');\n  }\n\n  function getCurrentVariant(){\n    var id = getVariantId();\n    return id && VARIANT_MAP[id] ? VARIANT_MAP[id] : null;\n  }\n\n  function syncButton(){\n    var variant = getCurrentVariant();\n    var label = btn.querySelector('.sc-secure-edition__label');\n    var id = getVariantId();\n\n    if(id){\n      variantInput.value = id;\n      root.dataset.currentVariant = id;\n    }\n\n    if(!variant){\n      btn.disabled = false;\n      if(label) label.textContent = 'Checkout';\n      return;\n    }\n\n    if(variant.available === false){\n      btn.disabled = true;\n      if(label) label.textContent = 'Sold Out';\n      return;\n    }\n\n    btn.disabled = false;\n    if(label) label.textContent = 'Checkout';\n  }\n\n  function openDeliveryPopup(){\n    if(!deliveryPopup || !deliveryTrigger) return;\n\n    deliveryPopup.removeAttribute('hidden');\n\n    window.requestAnimationFrame(function(){\n      deliveryPopup.classList.add('is-open');\n      deliveryTrigger.setAttribute('aria-expanded','true');\n    });\n  }\n\n  function closeDeliveryPopup(){\n    if(!deliveryPopup || !deliveryTrigger) return;\n\n    deliveryPopup.classList.remove('is-open');\n    deliveryTrigger.setAttribute('aria-expanded','false');\n\n    window.setTimeout(function(){\n      deliveryPopup.setAttribute('hidden','');\n    },170);\n  }\n\n  function toggleDeliveryPopup(){\n    if(!deliveryPopup || !deliveryTrigger) return;\n\n    if(deliveryPopup.hasAttribute('hidden')){\n      openDeliveryPopup();\n    }else{\n      closeDeliveryPopup();\n    }\n  }\n\n  if(deliveryTrigger && deliveryPopup){\n    deliveryTrigger.addEventListener('click',function(e){\n      e.preventDefault();\n      e.stopPropagation();\n      toggleDeliveryPopup();\n    });\n\n    deliveryCloseEls.forEach(function(closeEl){\n      closeEl.addEventListener('click',function(e){\n        e.preventDefault();\n        e.stopPropagation();\n        closeDeliveryPopup();\n      });\n    });\n\n    document.addEventListener('click',function(e){\n      if(deliveryPopup.hasAttribute('hidden')) return;\n\n      if(!deliveryPopup.contains(e.target) && !deliveryTrigger.contains(e.target)){\n        closeDeliveryPopup();\n      }\n    });\n\n    document.addEventListener('keydown',function(e){\n      if(e.key === 'Escape' && !deliveryPopup.hasAttribute('hidden')){\n        closeDeliveryPopup();\n      }\n    });\n  }\n\n  async function secureEdition(){\n    syncButton();\n\n    if(!form || btn.disabled) return;\n\n    btn.disabled = true;\n    btn.classList.add('is-loading');\n    btn.setAttribute('aria-busy','true');\n\n    if(err) err.classList.remove('is-visible');\n\n    try{\n      var fd = new FormData(form);\n      var variantId = getVariantId();\n\n      if(!variantId){\n        throw new Error('No variant selected');\n      }\n\n      fd.set('id',variantId);\n      fd.set('quantity','1');\n      fd.delete('sections');\n      fd.delete('sections_url');\n\n      var response = await fetch(routeRoot() + 'cart/add.js',{\n        method:'POST',\n        headers:{ 'Accept':'application/json' },\n        body:fd,\n        credentials:'same-origin'\n      });\n\n      if(!response.ok){\n        throw new Error('Could not add to cart');\n      }\n\n      window.location.href = routeRoot() + 'checkout';\n    }catch(error){\n      if(err) err.classList.add('is-visible');\n\n      btn.disabled = false;\n      btn.classList.remove('is-loading');\n      btn.removeAttribute('aria-busy');\n\n      syncButton();\n    }\n  }\n\n  btn.addEventListener('click',function(e){\n    e.preventDefault();\n    secureEdition();\n  });\n\n  document.addEventListener('change',syncButton,{ passive:true, capture:true });\n  document.addEventListener('input',syncButton,{ passive:true, capture:true });\n\n  document.addEventListener('click',function(){\n    window.requestAnimationFrame(syncButton);\n  },{ passive:true, capture:true });\n\n  document.addEventListener('variant:change',syncButton,{ passive:true, capture:true });\n  document.addEventListener('product:variant-change',syncButton,{ passive:true, capture:true });\n\n  var mainIdInput = findMainProductForm();\n\n  if(mainIdInput){\n    new MutationObserver(syncButton).observe(mainIdInput,{\n      attributes:true,\n      attributeFilter:['value']\n    });\n\n    var last = mainIdInput.value;\n\n    window.setInterval(function(){\n      if(mainIdInput.value !== last){\n        last = mainIdInput.value;\n        syncButton();\n      }\n    },250);\n  }\n\n  syncButton();\n})();\n</script>",
