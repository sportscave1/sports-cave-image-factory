    },
    "custom_liquid_AXHkJp": {
      "type": "custom-liquid",
      "disabled": true,
      "name": "EDITION JOURNEY HTML",
      "settings": {
        "full_width": true,
        "show_space": true,
        "code": "{%- liquid\nassign sc_ej_enabled_raw = product.metafields.sports_cave.edition_enabled.value\nassign sc_ej_enabled_text = sc_ej_enabled_raw | append: '' | downcase | strip\nassign sc_ej_enabled = false\nif sc_ej_enabled_raw == true or sc_ej_enabled_text == 'true' or sc_ej_enabled_text == '1' or sc_ej_enabled_text == 'yes'\nassign sc_ej_enabled = true\nendif\nassign sc_ej_total_raw = product.metafields.sports_cave.edition_total.value\nassign sc_ej_next_raw = product.metafields.sports_cave.edition_next_number.value\nassign sc_ej_remaining_raw = product.metafields.sports_cave.edition_remaining.value\nassign sc_ej_valid = false\nif sc_ej_enabled and sc_ej_total_raw != blank\nif sc_ej_next_raw != blank or sc_ej_remaining_raw != blank\nassign sc_ej_valid = true\nendif\nendif\nassign sc_ej_total = sc_ej_total_raw | default: 100 | plus: 0\nassign sc_ej_next = sc_ej_next_raw | default: 0 | plus: 0\nassign sc_ej_remaining = sc_ej_remaining_raw | default: -1 | plus: 0\nif sc_ej_next_raw == blank and sc_ej_remaining_raw != blank and sc_ej_total > 0\nassign sc_ej_next = sc_ej_total | minus: sc_ej_remaining | plus: 1\nendif\nif sc_ej_next < 1\nassign sc_ej_next = 1\nendif\nif sc_ej_remaining_raw == blank and sc_ej_total > 0\nassign sc_ej_remaining = sc_ej_total | minus: sc_ej_next | plus: 1\nendif\nif sc_ej_remaining < 0\nassign sc_ej_remaining = 0\nendif\nif sc_ej_remaining > sc_ej_total\nassign sc_ej_remaining = sc_ej_total\nendif\nassign sc_ej_retired = false\nif sc_ej_remaining <= 0 or sc_ej_next > sc_ej_total\nassign sc_ej_retired = true\nendif\nif sc_ej_retired and sc_ej_total_raw != blank\nif sc_ej_next_raw != blank or sc_ej_remaining_raw != blank\nassign sc_ej_valid = true\nendif\nendif\nassign sc_ej_claimed = sc_ej_next | minus: 1\nif sc_ej_retired\nassign sc_ej_claimed = sc_ej_total\nendif\nif sc_ej_claimed < 0\nassign sc_ej_claimed = 0\nendif\nif sc_ej_claimed > sc_ej_total\nassign sc_ej_claimed = sc_ej_total\nendif\nassign sc_ej_progress = 0\nif sc_ej_total > 0\nassign sc_ej_progress = sc_ej_claimed | times: 100.0 | divided_by: sc_ej_total | round: 2\nendif\n-%}{%- if sc_ej_valid and sc_ej_total > 0 -%}<section\nid=\"SportsCaveEditionJourney-{{ product.id }}-{{ section.id }}\"\nclass=\"sc-edition-journey sc-edition-journey--journey-only{% if sc_ej_retired %} sc-edition-journey--retired{% endif %}\"\nstyle=\"--sc-ej-progress: {{ sc_ej_progress }}%;\"\naria-labelledby=\"sc-edition-journey-title-{{ product.id }}\"\n><div class=\"sc-edition-journey__inner\"><div class=\"sc-edition-journey__heading-row\"><span class=\"sc-edition-journey__heading-line\" aria-hidden=\"true\"></span><h2\nid=\"sc-edition-journey-title-{{ product.id }}\"\nclass=\"sc-edition-journey__heading\"\n>\nThe Edition Journey\n</h2><span class=\"sc-edition-journey__heading-line\" aria-hidden=\"true\"></span></div><div\nclass=\"sc-edition-journey__progress\"\nrole=\"progressbar\"\naria-label=\"{{ sc_ej_claimed }} of {{ sc_ej_total }} editions claimed\"\naria-valuemin=\"0\"\naria-valuemax=\"{{ sc_ej_total }}\"\naria-valuenow=\"{{ sc_ej_claimed }}\"\n><span class=\"sc-edition-journey__track\" aria-hidden=\"true\"></span><span class=\"sc-edition-journey__fill\" aria-hidden=\"true\"></span><span class=\"sc-edition-journey__node sc-edition-journey__node--released\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\"><path d=\"m6.5 12.4 3.3 3.3 7.7-8.1\"></path></svg></span>\n{%- unless sc_ej_retired -%}<span class=\"sc-edition-journey__node sc-edition-journey__node--current\" aria-hidden=\"true\"><span class=\"sc-edition-journey__node-number\">{{ sc_ej_claimed }}</span></span>\n{%- endunless -%}<span class=\"sc-edition-journey__node sc-edition-journey__node--retired\" aria-hidden=\"true\">\n{%- if sc_ej_retired -%}<svg viewBox=\"0 0 24 24\"><path d=\"m6.5 12.4 3.3 3.3 7.7-8.1\"></path></svg>\n{%- else -%}<span class=\"sc-edition-journey__node-number\">{{ sc_ej_total }}</span>\n{%- endif -%}</span></div><div class=\"sc-edition-journey__milestones\"><div class=\"sc-edition-journey__milestone\"><h3>Released</h3><p>{{ sc_ej_total }} individually numbered</p></div><div class=\"sc-edition-journey__milestone sc-edition-journey__milestone--claimed\"><h3>\n{%- if sc_ej_retired -%}\nSold Out\n{%- else -%}\n{{ sc_ej_claimed }} Claimed\n{%- endif -%}</h3><p>\n{%- if sc_ej_retired -%}\nNow held by collectors\n{%- else -%}\nOnly {{ sc_ej_remaining }} remain\n{%- endif -%}</p></div><div class=\"sc-edition-journey__milestone\"><h3>\n{%- if sc_ej_retired -%}\nArchived\n{%- else -%}\nArchived\n{%- endif -%}</h3><p>\n{%- if sc_ej_retired -%}\nThis edition will not return\n{%- else -%}\nNever reprinted after sell-out\n{%- endif -%}</p></div></div></div></section><style>.sc-edition-journey,.sc-edition-journey *{box-sizing:border-box}.sc-edition-journey{--sc-ej-black:#0b0b0d;--sc-ej-black-soft:#111113;--sc-ej-warm:#f5f2ea;--sc-ej-muted:#c9c0b1;--sc-ej-gold:#d4a54c;--sc-ej-gold-soft:#e8c978;width:100%;margin:24px auto 18px;padding:0 14px;color:var(--sc-ej-warm);font-family:var(--sc-font-ui);-webkit-font-smoothing:antialiased;text-rendering:geometricPrecision}.sc-edition-journey__inner{position:relative;width:100%;max-width:1220px;margin:0 auto;padding:14px 26px 18px;overflow:hidden;border:1px solid rgba(212,165,76,.42);border-radius:14px;background:radial-gradient(circle at 50% -35%,rgba(212,165,76,.08) 0,rgba(212,165,76,0) 48%),linear-gradient(108deg,rgba(255,255,255,.022) 0,rgba(255,255,255,0) 36%),linear-gradient(180deg,var(--sc-ej-black-soft) 0,#08090a 100%);box-shadow:inset 0 1px 0 rgba(255,255,255,.035),inset 0 -1px 0 rgba(212,165,76,.06),0 10px 24px rgba(0,0,0,.14)}.sc-edition-journey__inner::before{content:\"\";position:absolute;inset:0;pointer-events:none;background:linear-gradient(120deg,rgba(255,255,255,.026),transparent 32%)}.sc-edition-journey__heading-row{position:relative;z-index:1;display:grid;grid-template-columns:minmax(38px,136px) auto minmax(38px,136px);align-items:center;justify-content:center;gap:16px;max-width:580px;margin:0 auto}.sc-edition-journey__heading{margin:0;color:#ded6c9;font-size:clamp(14px, 1.25vw, 18px);font-weight:700;line-height:1;letter-spacing:.18em;text-align:center;text-transform:uppercase;white-space:nowrap}.sc-edition-journey__heading-line{width:100%;height:1px;background:linear-gradient(90deg,rgba(212,165,76,0),rgba(212,165,76,.52))}.sc-edition-journey__heading-line:last-child{transform:scaleX(-1)}.sc-edition-journey__progress{position:relative;z-index:1;height:34px;margin:16px 12% 0}.sc-edition-journey__fill,.sc-edition-journey__track{position:absolute;top:15px;left:0;height:2px;border-radius:999px}.sc-edition-journey__track{right:0;background:rgba(212,165,76,.34)}.sc-edition-journey__fill{width:var(--sc-ej-progress);max-width:100%;background:linear-gradient(90deg,var(--sc-ej-gold),var(--sc-ej-gold-soft));box-shadow:0 0 8px rgba(212,165,76,.3)}.sc-edition-journey__node{position:absolute;top:16px;display:grid;place-items:center;border-radius:999px;transform:translate(-50%,-50%)}.sc-edition-journey__node svg{width:58%;height:58%;overflow:visible}.sc-edition-journey__node path{fill:none;stroke:currentColor;stroke-width:2.35;stroke-linecap:round;stroke-linejoin:round}.sc-edition-journey__node-number{display:none}.sc-edition-journey__node--released{left:0;width:34px;height:34px;border:1px solid rgba(212,165,76,.88);background:radial-gradient(circle at 34% 25%,rgba(255,255,255,.38),transparent 38%),linear-gradient(145deg,var(--sc-ej-gold-soft),#ad7928);color:var(--sc-ej-black);box-shadow:0 0 14px rgba(212,165,76,.27),inset 0 1px 0 rgba(255,255,255,.25)}.sc-edition-journey__node--current{left:var(--sc-ej-progress);width:24px;height:24px;border:1px solid rgba(232,201,120,.7);background:radial-gradient(circle at 35% 28%,rgba(255,255,255,.26),transparent 35%),linear-gradient(145deg,var(--sc-ej-gold-soft),#b87e27);box-shadow:0 0 11px rgba(212,165,76,.25)}.sc-edition-journey__node--retired{left:100%;width:26px;height:26px;border:2px solid rgba(212,165,76,.84);background:var(--sc-ej-black);color:var(--sc-ej-black);box-shadow:0 0 8px rgba(212,165,76,.13)}.sc-edition-journey--retired .sc-edition-journey__node--retired{border-width:1px;background:radial-gradient(circle at 34% 25%,rgba(255,255,255,.38),transparent 38%),linear-gradient(145deg,var(--sc-ej-gold-soft),#ad7928);box-shadow:0 0 16px rgba(212,165,76,.3)}.sc-edition-journey__milestones{position:relative;z-index:1;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));align-items:start;gap:16px;margin-top:6px}.sc-edition-journey__milestone{min-width:0;text-align:center}.sc-edition-journey__milestone h3{margin:0 0 5px;color:var(--sc-ej-gold);font-size:clamp(11px, 1vw, 14px);font-weight:700;line-height:1.1;letter-spacing:.05em;text-transform:uppercase}.sc-edition-journey__milestone p{margin:0;color:var(--sc-ej-muted);font-size:clamp(10px, .92vw, 12.5px);font-weight:600;line-height:1.38;letter-spacing:-.01em}.sc-edition-journey__tabs{width:100%;max-width:1360px;margin:9px auto 0;padding-bottom:2px}.sc-edition-journey__details{display:block;width:100%;height:auto;margin:0;overflow:visible}.sc-edition-journey__details+.sc-edition-journey__details{margin-top:10px}.sc-edition-journey__tab-toggle{position:relative;display:flex;width:100%;height:48px;align-items:center;justify-content:space-between;min-height:48px;margin:0;padding:0 18px;overflow:visible;border:1px solid rgba(212,165,76,.34);border-radius:11px;background:radial-gradient(circle at 50% -70%,rgba(212,165,76,.06),transparent 52%),linear-gradient(180deg,#101113 0,#090a0b 100%);color:var(--sc-ej-gold-soft);cursor:pointer;list-style:none;font-size:10.5px;font-weight:700;line-height:1;letter-spacing:.09em;text-transform:uppercase;box-shadow:inset 0 1px 0 rgba(255,255,255,.03),0 8px 18px rgba(0,0,0,.11);transition:border-color 180ms ease,color 180ms ease}.sc-edition-journey__details:not([open])>.sc-edition-journey__tab-toggle{border-radius:11px}.sc-edition-journey__tab-toggle:hover{border-color:rgba(212,165,76,.55);color:#f2d