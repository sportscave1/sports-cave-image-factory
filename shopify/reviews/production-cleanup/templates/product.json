n: none;\n    }\n  }\n</style>\n\n<div class=\"sc-cave-utility\">\n  <button\n    type=\"button\"\n    class=\"sc-cave-utility__button\"\n    data-sc-wall-preview-trigger\n    aria-haspopup=\"dialog\"\n    aria-label=\"See this edition on your wall. Preview in your room.\"\n  >\n\n    <span class=\"sc-cave-utility__left\">\n\n      <span\n        class=\"sc-cave-utility__icon\"\n        aria-hidden=\"true\"\n      >\n        <svg\n          viewBox=\"0 0 24 24\"\n          fill=\"none\"\n          stroke=\"currentColor\"\n          stroke-width=\"1.7\"\n          stroke-linecap=\"round\"\n          stroke-linejoin=\"round\"\n        >\n          <rect\n            x=\"4\"\n            y=\"5\"\n            width=\"16\"\n            height=\"14\"\n            rx=\"1.5\"\n          />\n          <path d=\"M8 15l3-3 2.5 2.5L16 12l2 3\"/>\n          <circle\n            cx=\"16.5\"\n            cy=\"9\"\n            r=\"1.3\"\n          />\n        </svg>\n      </span>\n\n      <span class=\"sc-cave-utility__copy\">\n        <strong>SEE IT ON YOUR WALL</strong>\n        <small>\n          Preview this edition in your space.\n        </small>\n      </span>\n\n    </span>\n\n    <span\n      class=\"sc-cave-utility__action\"\n      aria-hidden=\"true\"\n    >\n      <span class=\"sc-cave-utility__action-label\">\n        PREVIEW IN MY ROOM\n      </span>\n\n      <span class=\"sc-cave-utility__arrow\">\n        →\n      </span>\n    </span>\n\n  </button>\n</div>"
