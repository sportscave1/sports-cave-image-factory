ition:relative;\n\n      flex:\n        0 0 70vw;\n\n      scroll-snap-align:\n        center;\n\n      scroll-snap-stop:\n        always;\n\n      border-radius:\n        18px;\n\n      overflow:hidden;\n\n      background:#000;\n\n      border:\n        1px solid var(--edge);\n\n      box-shadow:\n        0 18px 34px rgba(0,0,0,.38),\n        inset 0 0 0 1px rgba(245,242,234,.035);\n\n      aspect-ratio:\n        9 / 16;\n\n      transform:\n        translateZ(0);\n\n      -webkit-transform:\n        translateZ(0);\n    }\n\n\n\n    @supports not (aspect-ratio:9/16) {\n\n      .scv__card::before {\n\n        content:\"\";\n\n        display:block;\n\n        padding-top:177.78%;\n      }\n    }\n\n\n\n    .scv__card::after {\n\n      content:\"\";\n\n      position:absolute;\n\n      inset:0;\n\n      pointer-events:none;\n\n      background:\n        linear-gradient(\n          135deg,\n          #151515,\n          #0e0e0e\n        );\n\n      opacity:1;\n\n      transition:\n        opacity .14s ease;\n\n      z-index:1;\n    }\n\n\n\n    .scv__card.is-loaded::after {\n\n      opacity:0;\n    }\n\n\n\n    .scv__video {\n\n      position:absolute;\n\n      inset:0;\n\n      width:100%;\n\n      height:100%;\n\n      object-fit:cover;\n\n      display:block;\n\n      background:#000;\n\n      transform:\n        translateZ(0);\n\n      -webkit-transform:\n        translateZ(0);\n\n      backface-visibility:\n        hidden;\n\n      -webkit-backface-visibility:\n        hidden;\n    }\n\n\n\n    .scv__caption {\n\n      position:absolute;\n\n      left:0;\n\n      right:0;\n\n      bottom:0;\n\n      z-index:3;\n\n      padding:\n        46px 11px 11px;\n\n      background:\n        linear-gradient(\n          180deg,\n          rgba(11,11,13,0) 0%,\n          rgba(11,11,13,.70) 48%,\n          rgba(11,11,13,.97) 100%\n        );\n\n      display:flex;\n\n      align-items:flex-end;\n\n      justify-content:flex-start;\n\n      min-height:86px;\n\n      pointer-e