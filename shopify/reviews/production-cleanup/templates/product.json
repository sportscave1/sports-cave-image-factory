n\n\n      <!-- ==================================================\n           CARD 2\n           MADE TO HANG PROUDLY\n      =================================================== -->\n\n      <figure\n        class=\"scv__card\"\n\n        data-name=\"Made to Hang Proudly — Limited Edition Sports Wall Art — Video 2\"\n\n        data-desc=\"Limited edition sports wall art made to hang proudly in collector spaces, fan caves, and rooms that mean something.\"\n\n        data-src=\"https://cdn.shopify.com/videos/c/o/v/d30e5ba1bb7a49069713efc63ddcd828.mp4\"\n\n        data-thumb=\"https://cdn.shopify.com/s/files/1/0722/2332/6515/files/preview_images/d30e5ba1bb7a49069713efc63ddcd828.thumbnail.0000000000.jpg?v=1760168943\"\n\n        data-date=\"2024-11-01\"\n      >\n\n        <video\n          class=\"scv__video\"\n          muted\n          playsinline\n          loop\n          preload=\"none\"\n          aria-label=\"Limited edition sports wall art made to hang proudly in real fan spaces\"\n          poster=\"https://cdn.shopify.com/s/files/1/0722/2332/6515/files/preview_images/d30e5ba1bb7a49069713efc63ddcd828.thumbnail.0000000000.jpg?v=1760168943\"\n        >\n          <track kind=\"captions\" srclang=\"en\" label=\"English captions\" src=\"{{ 'scv-accessible-caption-2.vtt' | asset_url }}\">\n        </video>\n\n\n        <figcaption class=\"scv__caption\">\n\n          <span class=\"scv__caption-pill\">\n            Made to Hang Proudly\n          </span>\n\n        </figcaption>\n\n      </figure>\n\n\n\n      <!-- ==================================================\n           CARD 3\n           LIMITED EDITION FRAMED SPORT ART\n      =================================================== -->\n\n      <figure\n        class=\"scv__card\"\n\n        data-name=\"Limited Edition Framed Sports Art — Real Wall Video 3\"\n\n        data-desc=\"Collector-grade framed sports art shown on a real wall. Premium Sports Cave editions built to be seen, not scrolled past.\"\n\n        data-src=\"https://cdn.shopify.com/videos/c/o/v/a1fa2f132dc144309952645fbd4bb814.mp4\"\n\n        data-thumb=\"https://cdn.shopify.com/s/files/1/0722/2332/6515/files/preview_images/a1fa2f132dc144309952645fbd4bb814.thumbnail.0000000000.jpg?v=1743979525\"\n\n        data-date=\"2024-11-01\"\n      >\n\n        <video\n          class=\"scv__video\"\n          muted\n          playsinline\n          loop\n          preload=\"none\"\n          aria-label=\"Collector-grade framed sports art shown on a real wall\"\n          poster=\"https://cdn.shopify.com/s/files/1/0722/2332/6515/files/preview_images/a1fa2f132dc144309952645fbd4bb814.thumbnail.0000000000.jpg?v=1743979525\"\n        >\n          <track kind=\"captions\" srclang=\"en\" label=\"English captions\" src=\"{{ 'scv-accessible-caption-3.vtt' | asset_url }}\">\n        </video>\n\n\n        <figcaption class=\"scv__caption\">\n\n          <span class=\"scv__caption-pill\">\n            Limited Edition Framed Sport Art\n          </span>\n\n        </figcaption>\n\n      </figure>\n\n\n\n      <!-- ==================================================\n           CARD 4\n           BUILT FOR FAN SPACES\n      =================================================== -->\n\n      <figure\n        class=\"scv__card\"\n\n        data-name=\"Built for Fan Spaces — Premium Sports Wall Art — Video 4\"\n\n        data-desc=\"Premium sports wall art built for fan spaces, home offices, and collector walls. Made to feel big the moment it goes up.\"\n\n        data-src=\"https://cdn.shopify.com/videos/c/o/v/f68df3ea92ce4152bb7f542098ee7165.mp4\"\n\n        data-thumb=\"https://cdn.shopify.com/s/files/1/0722/2332/6515/files/preview_images/f68df3ea92ce4152bb7f542098ee7165.thumbnail.0000000000.jpg?v=1760167345\"\n\n        data-date=\"2024-11-01\"\n      >\n\n        <video\n          class=\"scv__video\"\n          muted\n          playsinline\n          loop\n          preload=\"none\"\n          aria-label=\"Premium sports wall art built for fan spaces and collector walls\"\n          poster=\"https://cdn.shopify.com/s/files/1/0722/2332/6515/files/preview_images/f68df3ea92ce4152bb7f542098ee7165.thumbnail.0000000000.jpg?v=1760167345\"\n        >\n          <track kind=\"captions\" srclang=\"en\" label=\"English captions\" src=\"{{ 'scv-accessible-caption-4.vtt' | asset_url }}\">\n        </video>\n\n\n        <figcaption class=\"scv__caption\">\n\n          <span class=\"scv__caption-pill\">\n            Built for Fan Spaces\n          </span>\n\n        </figcaption>\n\n      </figure>\n\n    </div>\n\n  </div>\n\n\n\n  <style>\n\n    .shopify-section:has(#sc-video-carousel),\n    .section:has(#sc-video-carousel),\n    .custom-liquid:has(#sc-video-carousel) {\n      background:#0B0B0D !important;\n      margin-top:0 !important;\n      padding-top:0 !important;\n    }\n\n\n    .scv,\n    .scv * {\n      box-sizing:border-box;\n    }\n\n\n    .scv {\n\n      --bg:#0B0B0D;\n      --bg-card:#111214;\n      --ink:#F5F2EA;\n      --muted:#A6A19A;\n      --gold:#D4A54C;\n      --edge:rgba(212,165,76,.16);\n\n      position:relative;\n\n      margin:0;\n\n      padding:46px 0 16px;\n\n      background:\n        radial-gradient(\n          circle at top center,\n          rgba(212,165,76,.065),\n          transparent 42%\n        ),\n        linear-gradient(\n          180deg,\n          #0B0B0D 0%,\n          #0B0B0D 100%\n        );\n\n      color:var(--ink);\n\n      font-family:\n        Montserrat,\n        system-ui,\n        -apple-system,\n        BlinkMacSystemFont,\n        \"Segoe UI\",\n        Roboto,\n        Arial,\n        sans-serif;\n\n      border-top:\n        1px solid rgba(212,165,76,.10);\n\n      border-bottom:\n        1px solid rgba(212,165,76,.10);\n\n      box-shadow:\n        0 -42px 0 0 #0B0B0D,\n        0 34px 0 0 #0B0B0D;\n\n      isolation:isolate;\n\n      contain:content;\n\n      overflow:hidden;\n    }\n\n\n\n    .scv::before {\n\n      content:\"\";\n\n      positi