   const track =\n        root.querySelector(\n          '.scv__track'\n        );\n\n\n      const cards = [\n        ...root.querySelectorAll(\n          '.scv__card'\n        )\n      ];\n\n\n      if (\n        !track ||\n        !cards.length\n      ) {\n\n        return;\n      }\n\n\n\n      const desktopQuery =\n        window.matchMedia(\n          '(min-width:1024px)'\n        );\n\n\n      let framePending =\n        false;\n\n\n\n      \n\n      const prepareVideo = (\n        video\n      ) => {\n\n        if (!video) return;\n\n\n        video.muted =\n          true;\n\n\n        video.defaultMuted =\n          true;\n\n\n        video.playsInline =\n          true;\n\n\n        video.loop =\n          true;\n\n\n        video.setAttribute(\n          'muted',\n          ''\n        );\n\n\n        video.setAttribute(\n          'playsinline',\n          ''\n        );\n\n\n        video.setAttribute(\n          'webkit-playsinline',\n          ''\n        );\n\n\n        video.setAttribute(\n          'loop',\n          ''\n        );\n      };\n\n\n\n      \n\n      const attemptPlay = (\n        video\n      ) => {\n\n        if (!video) return;\n\n\n        if (\n          video.dataset.shouldPlay !== '1'\n        ) {\n\n          return;\n        }\n\n\n        if (\n          document.hidden\n        ) {\n\n          return;\n        }\n\n\n        const card =\n          video.closest(\n            '.scv__card'\n          );\n\n\n        if (!card) return;\n\n\n        bindSource(\n          card\n        );\n\n\n        prepareVideo(\n          video\n        );\n\n\n        video.preload =\n          'auto';\n\n\n        let playPromise;\n\n\n        try {\n\n          playPromise =\n            video.play();\n        }\n\n        catch (e) {\n\n          playPromise =\n            null;\n        }\n\n\n        if (\n          playPromise &&\n          typeof playPromise.catch === 'function'\n        ) {\n\n          playPromise.catch(\n            () => {\n\n              if (\n                video.dataset.shouldPlay !== '1' ||\n                document.hidden\n              ) {\n\n                return;\n              }\n\n\n              const retries =\n                Number(\n                  video.dataset.playRetries || 0\n                );\n\n\n              if (\n                retries >= 3\n              ) {\n\n                return;\n              }\n\n\n              video.dataset.playRetries =\n                String(\n                  retries + 1\n                );\n\n\n              window.setTimeout(\n                () => {\n\n                  if (\n                    video.dataset.shouldPlay === '1' &&\n                    !document.hidden\n                  ) {\n\n                    attemptPlay(\n                      video\n                    );\n                  }\n\n                },\n\n                250 +\n                retries * 250\n              );\n            }\n          );\n        }\n      };\n\n\n\n      \n\n      const bindSource = (\n        card\n      ) => {\n\n        if (!card) return;\n\n\n        const video =\n          card.querySelector(\n            '.scv__video'\n          );\n\n\n        if (!video) return;\n\n\n        if (\n          video.dataset.bound === '1'\n        ) {\n\n          return;\n        }\n\n\n        const src =\n          (\n            card.dataset.src || ''\n          ).trim();\n\n\n        if (!src) return;\n\n\n        prepareVideo(\n          video\n        );\n\n\n        video.dataset.bound =\n          '1';\n\n\n        video.dataset.playRetries =\n          '0';\n\n\n        video.dataset.loadRetries =\n          '0';\n\n\n        video.preload =\n          'metadata';\n\n\n\n        const revealVideo =\n          () => {\n\n            card.classList.add(\n              'is-loaded'\n            );\n          };\n\n\n\n        const recoverPlayback =\n          () => {\n\n            if (\n              video.dataset.shouldPlay === '1' &&\n              !document.hidden\n            ) {\n\n              attemptPlay(\n                video\n              );\n            }\n          };\n\n\n\n        video.addEventListener(\n          'loadeddata',\n          () => {\n\n            revealVideo();\n\n            recoverPlayback();\n          }\n        );\n\n\n        video.addEventListener(\n          'canplay',\n          () => {\n\n            revealVideo();\n\n            recoverPlayback();\n          }\n        );\n\n\n        video.addEventListener(\n          'playing',\n          () => {\n\n            revealVideo();\n\n            video.dataset.playRetries =\n              '0';\n          }\n        );\n\n\n        video.addEventListener(\n          'pause',\n          () => {\n\n            if (\n              video.dataset.shouldPlay !== '1' ||\n              document.hidden\n            ) {\n\n              return;\n            }\n\n\n            window.setTimeout(\n              recoverPlayback,\n              120\n            );\n          }\n        );\n\n\n        video.addEventListener(\n          'waiting',\n          () => {\n\n            if (\n              video.dataset.shouldPlay !== '1'\n            ) {\n\n              return;\n            }\n\n\n            window.setTimeout(\n              recoverPlayback,\n              250\n            );\n          }\n        );\n\n\n        video.addEventListener(\n          'stalled',\n          () => {\n\n            if (\n              video.dataset.shouldPlay !== '1'\n            ) {\n\n              return;\n            }\n\n\n            window.setTimeout(\n              recoverPlayback,\n              350\n            );\n          }\n        );\n\n\n        video.addEventListener(\n          'ended',\n          () => {\n\n            if (\n              video.dataset.shouldPlay !== '1'\n            ) {\n\n              return;\n            }\n\n\n            try {\n\n              video.currentTime =\n                0;\n            }\n\n            catch (e) {}\n\n\n            recoverPlayback();\n          }\n        );\n\n\n        video.addEventListener(\n          'error',\n          () => {\n\n            revealVideo();\n\n\n            if (\n              video.dataset.shouldPlay !== '1'\n            ) {\n\n              return;\n            }\n\n\n            const retries =\n              Number(\n                video.dataset.loadRetries || 0\n              );\n\n\n            if (\n              retries >= 2\n            ) {\n\n              return;\n            }\n\n\n            video.dataset.loadRetries =\n              String(\n                retries + 1\n              );\n\n\n            window.setTimeout(\n              () => {\n\n                if (\n                  video.dataset.shouldPlay !== '1'\n                ) {\n\n                  return;\n                }\n\n\n                try {\n\n                  video.pause();\n\n\n                  video.src =\n                    src;\n\n\n                  video.load();\n\n\n                  attemptPlay(\n                    video\n                  );\n                }\n\n                catch (e) {}\n\n              },\n\n              500 *\n              (\n                retries + 1\n              )\n            );\n          }\n        );\n\n\n        video.src =\n          src;\n\n\n        try {\n\n          video.load();\n        }\n\n        catch (e) {}\n      };\n\n\n\n      \n\n      const setCardPlayback = (\n        card,\n        shouldPlay\n      ) => {\n\n        const video =\n          card.querySelector(\n            '.scv__video'\n          );\n\n\n        if (!video) return;\n\n\n        const desired =\n          shouldPlay\n            ? '1'\n            : '0';\n\n\n        if (\n          video.dataset.shouldPlay === desired\n        ) {\n\n          if (\n            shouldPlay &&\n            video.paused &&\n            !document.hidden\n          ) {\n\n            attemptPlay(\n              video\n            );\n          }\n\n\n          return;\n        }\n\n\n        video.dataset.shouldPlay =\n          desired;\n\n\n        if (\n          shouldPlay\n        ) {\n\n          bindSource(\n            card\n          );\n\n\n          video.dataset.playRetries =\n            '0';\n\n\n          attemptPlay(\n            video\n          );\n        }\n\n        else {\n\n          video.dataset.playRetries =\n            '0';\n\n\n          if (\n            !video.paused\n          ) {\n\n            try {\n\n              video.pause();\n            }\n\n            catch (e) {}\n          }\n        }\n      };\n\n\n\n      const pauseEverything =\n        () => {\n\n          cards.forEach(\n            card => {\n\n              const video =\n                card.querySelector(\n                  '.scv__video'\n                );\n\n\n              if (!video) return;\n\n\n              video.dataset.shouldPlay =\n                '0';\n\n\n              if (\n                !video.paused\n              ) {\n\n                try {\n\n                  video.pause();\n                }\n\n                catch (e) {}\n              }\n            }\n          );\n        };\n\n\n\n      \n\n      const getVisibleRatio = (\n        element\n      ) => {\n\n        if (!element) return 0;\n\n\n        const rect =\n          element.getBoundingClientRect();\n\n\n        if (\n          rect.width <= 0 ||\n          rect.height <= 0\n        ) {\n\n          return 0;\n        }\n\n\n        const viewportWidth =\n          window.innerWidth ||\n          document.documentElement.clientWidth;\n\n\n        const viewportHeight =\n          window.innerHeight ||\n          document.documentElement.clientHeight;\n\n\n        const visibleWidth =\n          Math.max(\n            0,\n\n            Math.min(\n              rect.right,\n              viewportWidth\n            )\n\n            -\n\n            Math.max(\n              rect.left,\n              0\n            )\n          );\n\n\n        const visibleHeight =\n          Math.max(\n            0,\n\n            Math.min(\n              rect.bottom,\n              viewportHeight\n            )\n\n            -\n\n            Math.max(\n              rect.top,\n              0\n            )\n          );\n\n\n        const visibleArea =\n          visibleWidth *\n          visibleHeight;\n\n\n        const totalArea =\n          rect.width *\n          rect.height;\n\n\n        return Math.max(\n          0,\n\n          Math.min(\n            1,\n            visibleArea /\n            totalArea\n          )\n        );\n      };\n\n\n\n      \n\n      const updatePlayback =\n        () => {\n\n          if (\n            document.hidden\n          ) {\n\n            pauseEverything();\n\n            return;\n          }\n\n\n          \n\n          if (\n            desktopQuery.matches\n          ) {\n\n            cards.forEach(\n              card => {\n\n                const ratio =\n                  getVisibleRatio(\n                    card\n                  );\n\n\n                setCardPlayback(\n                  card,\n                  ratio >= 0.25\n                );\n              }\n            );\n\n\n            return;\n          }\n\n\n          \n\n          let bestCard =\n            null;\n\n\n          let bestRatio =\n            0;\n\n\n          cards.forEach(\n            card => {\n\n              const ratio =\n                getVisibleRatio(\n                  card\n                );\n\n\n              if (\n                ratio > bestRatio\n              ) {\n\n                bestRatio =\n                  ratio;\n\n\n                bestCard =\n                  card;\n              }\n            }\n          );\n\n\n          cards.forEach(\n            card => {\n\n              setCardPlayback(\n\n                card,\n\n                card === bestCard &&\n                bestRatio >= 0.20\n              );\n            }\n          );\n        };\n\n\n\n      \n\n      const schedulePlaybackUpdate =\n        () => {\n\n          if (\n            framePending\n          ) {\n\n            return;\n          }\n\n\n          framePending =\n            true;\n\n\n          requestAnimationFrame(\n            () => {\n\n              framePending =\n                false;\n\n\n              updatePlayback();\n            }\n          );\n        };\n\n\n\n      \n\n      if (\n        'IntersectionObserver' in window\n      ) {\n\n        const loadObserver =\n          new IntersectionObserver(\n\n            entries => {\n\n              entries.forEach(\n                entry => {\n\n                  if (\n                    !entry.isIntersecting\n                  ) {\n\n                    return;\n                  }\n\n\n                  bindSource(\n                    entry.target\n                  );\n\n\n                  loadObserver.unobserve(\n                    entry.target\n                  );\n                }\n              );\n            },\n\n            {\n\n              root:null,\n\n              rootMargin:\n                '700px 350px 700px 350px',\n\n              threshold:\n                0.01\n            }\n          );\n\n\n        cards.forEach(\n          card => {\n\n            loadObserver.observe(\n              card\n            );\n          }\n        );\n      }\n\n      else {\n\n        cards.forEach(\n          bindSource\n        );\n      }\n\n\n\n      \n\n      window.addEventListener(\n        'scroll',\n        schedulePlaybackUpdate,\n        {\n          passive:true\n        }\n      );\n\n\n      track.addEventListener(\n        'scroll',\n        schedulePlaybackUpdate,\n        {\n          passive:true\n        }\n      );\n\n\n      window.addEventListener(\n        'resize',\n        schedulePlaybackUpdate,\n        {\n          passive:true\n        }\n      );\n\n\n      window.addEventListener(\n        'orientationchange',\n        schedulePlaybackUpdate,\n        {\n          passive:true\n        }\n      );\n\n\n\n      \n\n      const handleBreakpointChange =\n        () => {\n\n          pauseEverything();\n\n          schedulePlaybackUpdate();\n        };\n\n\n      if (\n        desktopQuery.addEventListener\n      ) {\n\n        desktopQuery.addEventListener(\n          'change',\n          handleBreakpointChange\n        );\n      }\n\n      else if (\n        desktopQuery.addListener\n      ) {\n\n        desktopQuery.addListener(\n          handleBreakpointChange\n        );\n      }\n\n\n\n      \n\n      document.addEventListener(\n        'visibilitychange',\n        () => {\n\n          if (\n            document.hidden\n          ) {\n\n            pauseEverything();\n          }\n\n          else {\n\n            schedulePlaybackUpdate();\n          }\n        }\n      );\n\n\n      window.addEventListener(\n        'pageshow',\n        schedulePlaybackUpdate\n      );\n\n\n      window.addEventListener(\n        'focus',\n        schedulePlaybackUpdate\n      );\n\n\n\n      \n\n      const recoverAfterInteraction =\n        () => {\n\n          cards.forEach(\n            card => {\n\n              const video =\n                card.querySelector(\n                  '.scv__video'\n                );\n\n\n              if (!video) return;\n\n\n              video.dataset.playRetries =\n                '0';\n            }\n          );\n\n\n          schedulePlaybackUpdate();\n        };\n\n\n      window.addEventListener(\n        'pointerdown',\n        recoverAfterInteraction,\n        {\n          passive:true\n        }\n      );\n\n\n      window.addEventListener(\n        'touchstart',\n        recoverAfterInteraction,\n        {\n          passive:true\n        }\n      );\n\n\n      window.addEventListener(\n        'keydown',\n        recoverAfterInteraction\n      );\n\n\n\n      \n\n      schedulePlaybackUpdate();\n\n\n      window.setTimeout(\n        schedulePlaybackUpdate,\n        250\n      );\n\n\n      window.setTimeout(\n        schedulePlaybackUpdate,\n        900\n      );\n\n\n\n      \n\n      try {\n\n        const pageUrl =\n          location.href.split(\n            '#'\n          )[0];\n\n\n        const toAbsoluteUrl =\n          url =>\n            new URL(\n              url,\n              location.origin\n            ).href;\n\n\n        const graph =\n          cards\n            .map(\n              (\n                figure,\n                index\n              ) => {\n\n                const name =\n                  (\n                    figure.dataset.name ||\n                    ''\n                  ).trim();\n\n\n                const description =\n                  (\n                    figure.dataset.desc ||\n                    ''\n                  ).trim();\n\n\n                const contentUrl =\n                  (\n                    figure.dataset.src ||\n                    ''\n                  ).trim();\n\n\n                const thumbnail =\n                  (\n                    figure.dataset.thumb ||\n                    ''\n                  ).trim();\n\n\n                if (\n                  !name ||\n                  !description ||\n                  !contentUrl ||\n                  !thumbnail\n                ) {\n\n                  return null;\n                }\n\n\n                const uploadDate =\n\n                  figure.dataset.date ||\n\n                  new Date()\n                    .toISOString()\n                    .slice(\n                      0,\n                      10\n                    );\n\n\n                return {\n\n                  \"@type\":\n                    \"VideoObject\",\n\n                  \"@id\":\n                    pageUrl +\n                    `#video-${index + 1}`,\n\n                  \"name\":\n                    name,\n\n                  \"description\":\n                    description,\n\n                  \"thumbnailUrl\":[\n                    toAbsoluteUrl(\n                      thumbnail\n                    )\n                  ],\n\n                  \"contentUrl\":\n                    contentUrl,\n\n                  \"uploadDate\":\n                    uploadDate\n                };\n              }\n            )\n\n            .filter(\n              Boolean\n            );\n\n\n        if (\n          graph.length\n        ) {\n\n          const structuredData =\n            document.createElement(\n              'script'\n            );\n\n\n          structuredData.type =\n            'application/ld+json';\n\n\n          structuredData.text =\n            JSON.stringify({\n\n              \"@context\":\n                \"https://schema.org\",\n\n              \"@graph\":\n                graph\n            });\n\n\n          root.appendChild(\n            structuredData\n          );\n        }\n      }\n\n      catch (e) {}\n\n    })();\n\n  </script>\n\n\n\n  <noscript>\n\n    <div class=\"sr-only\">\n      Sports Cave videos showing collector-grade framed sports art on real walls, fan spaces, and gift-ready home displays.\n    </div>\n\n  </noscript>\n\n</section>"
