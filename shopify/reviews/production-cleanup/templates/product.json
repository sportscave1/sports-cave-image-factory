        "custom_liquid_4rDqmW": {
          "type": "custom-liquid",
          "name": "Payment Icons HTML",
          "disabled": true,
          "settings": {
            "custom_liquid": "{%- comment -%}\nSPORTS CAVE • Payment Rail — v10.3\n- Cleaner compressed cards\n- Larger logos so payment brands dominate\n- Still horizontally scrollable\n- Discover removed\n- Order: Shop Pay, PayPal, Visa, Mastercard, Amex, Apple Pay, Google Pay, Afterpay, eftpos, UnionPay\n{%- endcomment -%}\n\n<div class=\"sc-secure\" role=\"region\" aria-label=\"Trusted payment providers\">\n  <style>\n    .sc-secure{\n      margin:-4px 0 8px;\n      width:100%;\n      font-family:var(--sc-font-ui);\n    }\n\n    .sc-secure,\n    .sc-secure *{\n      box-sizing:border-box;\n    }\n\n    .sc-secure__rail{\n      position:relative;\n      width:100%;\n      overflow:hidden;\n    }\n\n    .sc-secure__rail::before,\n    .sc-secure__rail::after{\n      content:\"\";\n      position:absolute;\n      top:0;\n      bottom:0;\n      width:16px;\n      z-index:2;\n      pointer-events:none;\n    }\n\n    .sc-secure__rail::before{\n      left:0;\n      background:linear-gradient(to right, rgba(255,255,255,.96), rgba(255,255,255,0));\n    }\n\n    .sc-secure__rail::after{\n      right:0;\n      background:linear-gradient(to left, rgba(255,255,255,.96), rgba(255,255,255,0));\n    }\n\n    .sc-secure__list{\n      display:flex;\n      align-items:center;\n      gap:7px;\n      margin:0;\n      padding:3px 3px 7px;\n      list-style:none;\n      overflow-x:auto;\n      overflow-y:hidden;\n      scroll-snap-type:x proximity;\n      -webkit-overflow-scrolling:touch;\n      scrollbar-width:none;\n      cursor:grab;\n    }\n\n    .sc-secure__list:active{\n      cursor:grabbing;\n    }\n\n    .sc-secure__list::-webkit-scrollbar{\n      display:none;\n    }\n\n    .sc-secure__item{\n      flex:0 0 auto;\n      scroll-snap-align:start;\n      display:flex;\n      align-items:center;\n      justify-content:center;\n    }\n\n    .sc-secure__box{\n      height:34px;\n      min-width:60px;\n      padding:2px 6px;\n      display:flex;\n      align-items:center;\n      justify-content:center;\n      background:var(--sc-brand-ivory);\n      border:1px solid rgba(17,17,17,.16);\n      border-radius:5px;\n      box-shadow:\n        0 1px 2px rgba(11,11,13,.035),\n        inset 0 1px 0 rgba(255,255,255,.85);\n      overflow:hidden;\n      transition:transform .12s ease, box-shadow .12s ease, border-color .12s ease;\n    }\n\n    .sc-secure__box:hover{\n      transform:translateY(-1px);\n      border-color:rgba(17,17,17,.24);\n      box-shadow:\n        0 3px 7px rgba(11,11,13,.055),\n        inset 0 1px 0 rgba(255,255,255,.9);\n    }\n\n    .sc-secure__box--wide{\n      min-width:76px;\n      padding-left:7px;\n      padding-right:7px;\n    }\n\n    .sc-secure__img{\n      display:block;\n      width:auto;\n      max-width:100%;\n      object-fit:contain;\n    }\n\n    .sc-secure__box--shop .sc-secure__img{\n      height:28px;\n    }\n\n    .sc-secure__box--paypal .sc-secure__img{\n      height:27px;\n    }\n\n    .sc-secure__box--visa .sc-secure__img{\n      height:18px;\n    }\n\n    .sc-secure__box--mastercard .sc-secure__img{\n      height:25px;\n    }\n\n    .sc-secure__box--amex .sc-secure__img{\n      height:25px;\n    }\n\n    .sc-secure__box--apple .sc-secure__img{\n      height:27px;\n    }\n\n    .sc-secure__box--google .sc-secure__img{\n      height:26px;\n    }\n\n    .sc-secure__box--afterpay .sc-secure__img{\n      height:27px;\n    }\n\n    .sc-secure__box--eftpos .sc-secure__img,\n    .sc-secure__box--union .sc-secure__img{\n      height:21px;\n    }\n\n    @media (max-width:600px){\n      .sc-secure{\n        margin:-2px 0 6px;\n      }\n\n      .sc-secure__list{\n        gap:7px;\n        padding:2px 2px 6px;\n      }\n\n      .sc-secure__box{\n        height:33px;\n        min-width:58px;\n        padding:2px 6px;\n        border-radius:5px;\n      }\n\n      .sc-secure__box--wide{\n        min-width:74px;\n      }\n\n      .sc-secure__rail::before,\n      .sc-secure__rail::after{\n        width:12px;\n      }\n    }\n  </style>\n\n  <div class=\"sc-secure__rail\">\n    <ul class=\"sc-secure__list\" tabindex=\"0\" aria-label=\"Accepted payment methods\">\n\n      <li class=\"sc-secure__item\">\n        <span class=\"sc-secure__box sc-secure__box--shop\">\n          <img class=\"sc-secure__img\" src=\"https://cdn.shopify.com/s/files/1/0673/9928/6958/files/shop-pay-icon.svg?v=1757323240\" alt=\"Shop Pay\" loading=\"lazy\">\n        </span>\n      </li>\n\n      <li class=\"sc-secure__item\">\n        <span class=\"sc-secure__box sc-secure__box--wide sc-secure__box--paypal\">\n          <img class=\"sc-secure__img\" src=\"https://cdn.shopify.com/s/files/1/0673/9928/6958/files/paypal-icon.svg?v=1757323240\" alt=\"PayPal\" loading=\"lazy\">\n        </span>\n      </li>\n\n      <li class=\"sc-secure__item\">\n        <span class=\"sc-secure__box sc-secure__box--visa\">\n          <img class=\"sc-secure__img\" src=\"https://cdn.shopify.com/s/files/1/0673/9928/6958/files/visa-icon.svg?v=1757323240\" alt=\"Visa\" loading=\"lazy\">\n        </span>\n      </li>\n\n      <li class=\"sc-secure__item\">\n        <span class=\"sc-secure__box sc-secure__box--mastercard\">\n          <img class=\"sc-secure__img\" src=\"https://cdn.shopify.com/s/files/1/0673/9928/6958/files/mastercard-icon.svg?v=1757323240\" alt=\"Mastercard\" loading=\"lazy\">\n        </span>\n      </li>\n\n      <li class=\"sc-secure__item\">\n        <span class=\"sc-secure__box sc-secure__box--amex\">\n          <img class=\"sc-secure__img\" src=\"https://cdn.shopify.com/s/files/1/0673/9928/6958/files/american-express-icon.svg?v=1757323240\" alt=\"American Express\" loading=\"lazy\">\n        </span>\n      </li>\n\n      <li class=\"sc-secure__item\">\n        <span class=\"sc-secure__box sc-secure__box--apple\">\n          <img class=\"sc-secure__img\" src=\"https://cdn.shopify.com/s/files/1/0673/9928/6958/files/apple-pay-icon.svg?v=1757323240\" alt=\"Apple Pay\" loading=\"lazy\">\n        </span>\n      </li>\n\n      <li class=\"sc-secure__item\">\n        <span class=\"sc-secure__box sc-secure__box--google\">\n          <img class=\"sc-secure__img\" src=\"https://cdn.shopify.com/s/files/1/0673/9928/6958/files/google-pay-icon.svg?v=1757323240\" alt=\"Google Pay\" loading=\"lazy\">\n        </span>\n      </li>\n\n      <li class=\"sc-secure__item\">\n        <span class=\"sc-secure__box sc-secure__box--wide sc-secure__box--afterpay\">\n          <img class=\"sc-secure__img\" src=\"https://cdn.shopify.com/s/files/1/0722/2332/6515/files/afterpay-icon_825251ed-b161-4e01-a010-06f9d908a9d6.svg?v=1773711410\" alt=\"Afterpay\" loading=\"lazy\">\n        </span>\n      </li>\n\n      <li class=\"sc-secure__item\">\n        <span class=\"sc-secure__box sc-secure__box--eftpos\">\n          <img class=\"sc-secure__img\" src=\"https://cdn.shopify.com/s/files/1/0673/9928/6958/files/eftpos-icon.svg?v=1757323240\" alt=\"eftpos\" loading=\"lazy\">\n        </span>\n      </li>\n\n      <li class=\"sc-secure__item\">\n        <span class=\"sc-secure__box sc-secure__box--union\">\n          <img class=\"sc-secure__img\" src=\"https://cdn.shopify.com/s/files/1/0673/9928/6958/files/union-pay-icon.svg?v=1757323240\" alt=\"UnionPay\" loading=\"lazy\">\n        </span>\n      </li>\n\n    </ul>\n  </div>\n</div>",
