          "settings": {
            "custom_liquid": "<style>\n  .sc-cave-utility {\n    width: 100%;\n    margin: 14px 0 16px;\n  }\n\n  .sc-cave-utility__button {\n    box-sizing: border-box;\n    position: relative;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 16px;\n\n    width: 100%;\n    min-height: 68px;\n    margin: 0;\n    padding: 13px 16px;\n\n    border: 1px solid rgba(211, 169, 68, 0.28);\n    border-radius: 9px;\n\n    background:\n      radial-gradient(\n        circle at 15% -40%,\n        rgba(211, 169, 68, 0.08),\n        transparent 55%\n      ),\n      linear-gradient(\n        180deg,\n        #121315 0%,\n        #0d0e10 100%\n      );\n\n    color: #f1eee7;\n\n    font-family: var(--sc-font-ui);\n    font: inherit;\n    text-align: left;\n    text-transform: none;\n    letter-spacing: normal;\n    white-space: normal;\n\n    box-shadow:\n      inset 0 1px 0 rgba(255, 255, 255, 0.025);\n\n    cursor: pointer;\n\n    transition:\n      background 180ms ease,\n      border-color 180ms ease,\n      transform 180ms ease;\n  }\n\n  .sc-cave-utility__button:hover {\n    border-color: rgba(211, 169, 68, 0.55);\n\n    background:\n      radial-gradient(\n        circle at 15% -40%,\n        rgba(211, 169, 68, 0.12),\n        transparent 55%\n      ),\n      linear-gradient(\n        180deg,\n        #151517 0%,\n        #101113 100%\n      );\n\n    transform: translateY(-1px);\n  }\n\n  .sc-cave-utility__button:active {\n    transform: translateY(0);\n  }\n\n  .sc-cave-utility__button:focus-visible {\n    outline: 1px solid #d3a944;\n    outline-offset: 3px;\n  }\n\n  .sc-cave-utility__button:disabled {\n    opacity: 0.65;\n    cursor: wait;\n    transform: none;\n  }\n\n  .sc-cave-utility__left {\n    display: flex;\n    align-items: center;\n    gap: 12px;\n    min-width: 0;\n  }\n\n  .sc-cave-utility__icon {\n    display: grid;\n    place-items: center;\n    flex: 0 0 34px;\n\n    width: 34px;\n    height: 34px;\n\n    border: 1px solid rgba(211, 169, 68, 0.24);\n    border-radius: 7px;\n\n    background: rgba(211, 169, 68, 0.045);\n    color: #d3a944;\n  }\n\n  .sc-cave-utility__icon svg {\n    width: 18px;\n    height: 18px;\n  }\n\n  .sc-cave-utility__copy {\n    min-width: 0;\n  }\n\n  .sc-cave-utility__copy strong {\n    display: block;\n    margin: 0;\n\n    color: #f1eee7;\n\n    font-size: 13px;\n    font-weight: 700;\n    line-height: 1.3;\n    letter-spacing: 0.01em;\n  }\n\n  .sc-cave-utility__copy small {\n    display: block;\n    margin-top: 3px;\n\n    color: #aaa59c;\n\n    font-size: 11.5px;\n    font-weight: 500;\n    line-height: 1.4;\n  }\n\n  .sc-cave-utility__arrow {\n    flex: 0 0 auto;\n\n    color: #d3a944;\n\n    font-size: 20px;\n    font-weight: 500;\n    line-height: 1;\n\n    transition: transform 180ms ease;\n  }\n\n  .sc-cave-utility__button:hover .sc-cave-utility__arrow {\n    transform: translateX(3px);\n  }\n\n  @media (max-width: 749px) {\n    .sc-cave-utility {\n      margin: 12px 0 14px;\n    }\n\n    .sc-cave-utility__button {\n      min-height: 64px;\n      padding: 11px 13px;\n      gap: 12px;\n      border-radius: 10px;\n    }\n\n    .sc-cave-utility__left {\n      gap: 10px;\n    }\n\n    .sc-cave-utility__icon {\n      flex-basis: 32px;\n      width: 32px;\n      height: 32px;\n    }\n\n    .sc-cave-utility__copy strong {\n      font-size: 12.5px;\n    }\n\n    .sc-cave-utility__copy small {\n      font-size: 11px;\n    }\n  }\n</style>\n\n<div class=\"sc-cave-utility\">\n  <button\n    type=\"button\"\n    class=\"sc-cave-utility__button\"\n    data-sc-wall-preview-trigger\n    aria-haspopup=\"dialog\"\n    aria-label=\"See this edition on your wall at true scale\"\n  >\n    <span class=\"sc-cave-utility__left\">\n\n      <span class=\"sc-cave-utility__icon\" aria-hidden=\"true\">\n        <svg\n          viewBox=\"0 0 24 24\"\n          fill=\"none\"\n          stroke=\"currentColor\"\n          stroke-width=\"1.7\"\n          stroke-linecap