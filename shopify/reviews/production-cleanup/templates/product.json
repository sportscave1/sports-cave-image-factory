splay:none}.sc-edition-journey__faq-item>summary::marker{content:\"\"}.sc-edition-journey__faq-plus{position:relative;width:16px;height:16px;flex:0 0 16px;color:var(--sc-ej-gold-soft)}.sc-edition-journey__faq-plus::after,.sc-edition-journey__faq-plus::before{content:\"\";position:absolute;top:50%;left:50%;width:12px;height:1.5px;border-radius:999px;background:currentColor;transform:translate(-50%,-50%);transition:transform 180ms ease,opacity 180ms ease}.sc-edition-journey__faq-plus::after{transform:translate(-50%,-50%) rotate(90deg)}.sc-edition-journey__faq-item[open] .sc-edition-journey__faq-plus::after{opacity:0;transform:translate(-50%,-50%) rotate(0)}.sc-edition-journey__faq-answer{max-width:1060px;padding:0 34px 14px 4px}.sc-edition-journey__faq-answer p{margin:0;color:rgba(245,242,234,.68);font-size:10.5px;font-weight:500;line-height:1.58}.sc-edition-journey__faq-answer a{color:var(--sc-ej-gold-soft);text-decoration:underline;text-underline-offset:2px}.sc-edition-journey__proof-item{display:grid;grid-template-columns:34px minmax(0,1fr);align-items:center;gap:11px;min-width:0;padding:1px clamp(10px,1.35vw,20px)}.sc-edition-journey__proof-item+.sc-edition-journey__proof-item{border-left:1px solid rgba(212,165,76,.14)}.sc-edition-journey__proof-icon{display:grid;place-items:center;width:32px;height:32px;color:var(--sc-ej-gold-soft)}.sc-edition-journey__proof-icon svg{display:block;width:100%;height:100%;fill:none;stroke:currentColor;stroke-width:1.55;stroke-linecap:round;stroke-linejoin:round}.sc-edition-journey__proof-copy{display:grid;gap:2px;min-width:0}.sc-edition-journey__proof-copy strong{color:var(--sc-ej-gold-soft);font-size:clamp(9.5px, .72vw, 11px);font-weight:700;line-height:1.15;letter-spacing:.055em;text-transform:uppercase}.sc-edition-journey__proof-copy>span{color:rgba(245,242,234,.66);font-size:clamp(9px, .66vw, 10.3px);font-weight:500;line-height:1.3}.sc-legacy,.sc-legacy-tab{--sc-legacy-black:#08090a;--sc-legacy-panel:#101113;--sc-legacy-ivory:#