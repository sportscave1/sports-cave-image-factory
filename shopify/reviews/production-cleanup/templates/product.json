        "code": "<style>\n  \n\n  .sc-cave-utility {\n    box-sizing: border-box;\n    width: 100%;\n    margin: 14px 0 16px;\n  }\n\n  .sc-cave-utility__button {\n    box-sizing: border-box;\n    appearance: none;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 16px;\n\n    width: 100%;\n    min-height: 70px;\n    margin: 0;\n    padding: 13px 20px;\n\n    border: 1px solid rgba(212,165,76,.24);\n    border-radius: 9px;\n\n    background:\n      radial-gradient(\n        ellipse at 12% 0%,\n        rgba(212,165,76,.045),\n        transparent 55%\n      ),\n      #0B0B0D;\n\n    color: var(--sc-brand-ivory);\n    font-family: var(--sc-font-ui);\n    font-size: 13px;\n    text-align: left;\n    text-transform: none;\n    letter-spacing: normal;\n    white-space: normal;\n    box-shadow: none;\n    cursor: pointer;\n\n    transition:\n      border-color 180ms ease,\n      background-color 180ms ease;\n  }\n\n  .sc-cave-utility__button:hover {\n    border-color: rgba(212,165,76,.55);\n    background-color: #121214;\n  }\n\n  .sc-cave-utility__button:focus-visible {\n    outline: 2px solid #D4A54C;\n    outline-offset: 3px;\n  }\n\n  .sc-cave-utility__button:disabled {\n    opacity: .6;\n    cursor: wait;\n  }\n\n  \n\n  .sc-cave-utility__left {\n    display: flex;\n    align-items: center;\n    gap: 13px;\n    min-width: 0;\n  }\n\n  .sc-cave-utility__icon {\n    box-sizing: border-box;\n    display: grid;\n    place-items: center;\n    flex: 0 0 36px;\n    width: 36px;\n    height: 36px;\n\n    border: 1px solid rgba(212,165,76,.28);\n    border-radius: 7px;\n    background: rgba(212,165,76,.055);\n    color: var(--sc-brand-gold);\n  }\n\n  .sc-cave-utility__icon svg {\n    display: block;\n    width: 19px;\n    height: 19px;\n  }\n\n  .sc-cave-utility__copy {\n    display: flex;\n    flex-direction: column;\n    gap: 4px;\n    min-width: 0;\n  }\n\n  .sc-cave-utility__copy strong {\n    display: block;\n    margin: 0;\n   