        "full_width": true,
        "show_space": false,
        "code": "{%- liquid\n  assign sc_country_code = localization.country.iso_code | default: request.country.iso_code | default: 'AU'\n  assign sc_bundle_ready_label = 'ADD EDITIONS TO CART'\n\n-%}\n\n<div class=\"related-products\"\n     data-section-id=\"{{ section.id }}\"\n     data-url=\"{{ routes.product_recommendations_url }}?section_id={{ section.id }}&limit=10&intent=related&product_id={{ product.id }}\"\n     {%- render 'animation-attrs', attrs: 'data-cc-animate' -%}>\n\n  {%- assign sc_bundle_eligible = 0 -%}\n  {%- assign sc_bundle_products = blank -%}\n  {%- if recommendations.performed and product.available and product.featured_image != blank and product.metafields.sports_cave.edition_archived.value != true and product.metafields.sports_cave.edition_remaining.value != 0 -%}\n    {%- capture sc_sport_handle -%}{% render 'sc-reco-sport-collection', edition: product %}{%- endcapture -%}\n    {%- assign sc_sport_handle = sc_sport_handle | strip -%}\n    {%- assign sc_sport_pool = collections[sc_sport_handle].products -%}\n    {%- capture sc_bundle_market_handle -%}{% render 'sc-market-best-sellers-handle' %}{%- endcapture -%}\n    {%- assign sc_bundle_market_handle = sc_bundle_market_handle | strip -%}\n    {%- assign sc_market_best_products = collections[sc_bundle_market_handle].products -%}\n    {%- assign sc_cart_ids = cart.items | map: 'product_id' -%}\n    {%- assign sc_seen = product.id | prepend: '|' | append: '|' -%}\n    {%- capture sc_bundle_products -%}\n      [\n        {% render 'sc-bundle-product-data', edition: product %}\n        {%- for sc_source in (1..2) -%}\n          {%- assign sc_candidate_products = recommendations.products -%}\n          {%- if sc_source == 2 -%}{%- assign sc_candidate_products = sc_sport_pool -%}{%- endif -%}\n          {%- for candidate in sc_candidate_products limit: 18 -%}\n            {%- assign sc_candidate_key = candidate.id | prepend: '|' | append: '|' -%}\n            {%- if sc_seen contains sc_candidate_key or sc_cart_ids contains candidate.id -%}{%- continue -%}{%- endif -%}\n            {%- if candidate.available and candidate.featured_image != blank and candidate.metafields.sports_cave.edition_archived.value != true and candidate.metafields.sports_cave.edition_remaining.value != 0 -%}\n              ,{% render 'sc-bundle-product-data', edition: candidate %}\n              {%- assign sc_seen = sc_seen | append: candidate.id | append: '|' -%}\n              {%- assign sc_bundle_eligible = sc_bundle_eligible | plus: 1 -%}\n              {%- if sc_bundle_eligible == 14 -%}{%- break -%}{%- endif -%}\n            {%- endif -%}\n          {%- endfor -%}\n          {%- if sc_bundle_eligible == 14 -%}{%- break -%}{%- endif -%}\n        {%- endfor -%}\n      ]\n    {%- endcapture -%}\n  {%- endif -%}\n  {% if sc_bundle_eligible > 0 %}\n    <div class=\"container{% if settings.use_fullwidth_layout %} container--no-max{% endif %} fully-spaced-row\">\n\n      <div class=\"sc-mj-headline\" id=\"sc-bundle-upsell-headline\">\n        <div class=\"sc-mj-headline__plaque\" role=\"group\" aria-label=\"Collector bundles\">\n          <h2 class=\"sc-mj-headline__title\">COMPLETE YOUR COLLECTION</h2>\n          <div class=\"sc-mj-headline__sep\" aria-hidden=\"true\"></div>\n          <p class=\"sc-mj-headline__sub\">Limited time: 25% off 2+ editions.</p>\n        </div>\n      </div>\n\n      <section id=\"sc-mj-bundle\" class=\"sc-mj\" aria-label=\"Sports Cave collector bundles\">\n        <script type=\"application/json\" id=\"sc-mj-pool\">{{ sc_bundle_products }}</script>\n        <script type=\"application/json\" id=\"sc-mj-market-best\">[{%- for edition in sc_market_best_products limit: 20 -%}{{ edition.id | json }}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}]</script>\n        <div class=\"sc-mj__wrap\"\n             data-money-format=\"{{ shop.money_format | replace: \"'\", \"\\\\'\" | escape }}\"\n             data-currency=\"{{ cart.currency.iso_code | escape }}\"\n             data-locale=\"{{ request.locale.iso_code | default: localization.language.iso_code | default: 'en' | escape }}\"\n             data-cart-add-url=\"{{ routes.cart_add_url }}.js\"\n             data-cart-url=\"{{ routes.cart_url }}.js\"\n             data-root-url=\"{{ routes.root_url }}\">\n\n          <header class=\"sc-mj__head\">\n            <h3 class=\"sc-mj__title\">\n              <span class=\"w\">Recommended</span> <span class=\"hl\">Editions</span>\n              <span class=\"player\"></span>\n            </h3>\n            <button type=\"button\" class=\"sc-mj__refresh\" aria-label=\"Refresh unticked\">\n              Refresh unticked\n            </button>\n          </header>\n\n          <ul class=\"sc-mj__grid\" role=\"list\" aria-live=\"polite\"></ul>\n\n          <div class=\"sc-mj__totals\" aria-live=\"polite\">\n            <div class=\"sc-mj__badge\">\n              <span class=\"tier\" data-tier>Select 2 editions to unlock 25% off</span>\n            </div>\n\n            <div class=\"sc-mj__amounts\">\n              <div class=\"row\">\n                <span class=\"lab\">Gallery value</span>\n                <span class=\"val\" data-rrp>—</span>\n              </div>\n              <div class=\"row\">\n                <span class=\"lab\">Bundle subtotal</span>\n                <span class=\"val\" data-subtotal>—</span>\n              </div>\n              <div class=\"row\">\n                <span class=\"lab\">Collector bonus</span>\n                <span class=\"val\" data-discount>—</span>\n              </div>\n              <div class=\"row due\">\n                <span class=\"lab\">You pay</span>\n                <span class=\"val\" data-due>—</span>\n              </div>\n            </div>\n\n            <button type=\"button\" class=\"sc-mj__atc\" disabled aria-disabled=\"true\">\n              <span class=\"sc-mj__atc-spinner\" aria-hidden=\"true\"></span>\n              <span class=\"sc-mj__atc-label\">Select 2 editions to secure 25% off</span>\n            </button>\n\n          </div>\n        </div>\n      </section>\n\n      <style>\n        #sc-mj-bundle .sc-chip{ display:none !important; }\n\n        .sc-mj-headline{\n          margin:14px auto 10px;\n          max-width:1240px;\n          padding:0 12px;\n          text-align:center;\n        }\n\n        .sc-mj-headline__plaque{\n          display:inline-block;\n          width:min(980px, 100%);\n          padding:13px 14px 12px;\n          border-radius:16px;\n          position:relative;\n          background:\n            radial-gradient(circle at top center, rgba(212,165,76,.075), transparent 58%),\n            linear-gradient(180deg, #141416 0%, #0B0B0D 100%);\n          border:1px solid rgba(212,165,76,.22);\n          box-shadow:\n            0 14px 30px rgba(0,0,0,.22),\n            inset 0 1px 0 rgba(245,242,234,.045);\n        }\n\n        .sc-mj-headline__title{\n          margin:0;\n          text-transform:uppercase;\n          letter-spacing:.12em;\n          font-weight:950;\n          font-family:Montserrat,system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif;\n          font-size:clamp(14px, 2.4vw, 24px);\n          line-height:1.15;\n          display:block;\n          color:#F5F2EA;\n        }\n\n        .sc-mj-headline__sep{\n          display:block;\n          width:112px;\n          height:2px;\n          margin:6px auto 0;\n          border-radius:0;\n          background:linear-gradient(\n            90deg,\n            rgba(212,165,76,0) 0%,\n            rgba(212,165,76,.58) 18%,\n            #D4A54C 50%,\n            rgba(212,165,76,.58) 82%,\n            rgba(212,165,76,0) 100%\n          );\n          opacity:1;\n          box-shadow:none;\n        }\n\n        .sc-mj-headline__sub{\n          margin:8px 0 0;\n          font-size:12px;\n          color:#A6A19A;\n          font-family:Montserrat,system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif;\n          font-weight:700;\n          letter-spacing:.01em;\n        }\n\n        @media (max-width:520px){\n          .sc-mj-headline__plaque{ padding:11px 12px; }\n          .sc-mj-headline__sub{ font-size:11px; }\n        }\n\n        #sc-mj-bundle.sc-mj{\n          --mj-gold:#D4A54C;\n          --mj-orange:#F7A007;\n          --mj-ink:#F5F2EA;\n          --mj-muted:#A6A19A;\n          --mj-bg:#0B0B0D;\n          --mj-card:#111214;\n          --mj-card-soft:#151518;\n          --mj-line:rgba(212,165,76,.15);\n          --mj-line-strong:rgba(212,165,76,.34);\n\n          background:\n            radial-gradient(circle at top left, rgba(212,165,76,.06), transparent 38%),\n            linear-gradient(180deg, #101012 0%, #0B0B0D 100%);\n          color:var(--mj-ink);\n          font-family:Montserrat,system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif;\n          border:1px solid rgba(212,165,76,.13);\n          border-radius:16px;\n          box-shadow:0 14px 30px rgba(0,0,0,.26);\n          overflow:hidden;\n        }\n\n        #sc-mj-bundle .sc-mj__wrap{\n          max-width:1240px;\n          margin:0 auto;\n          padding:13px 12px;\n          content-visibility:auto;\n          contain-intrinsic-size:1px 240px;\n        }\n\n        #sc-mj-bundle .sc-mj__head{\n          display:flex;\n          align-items:flex-start;\n          justify-content:space-between;\n          gap:10px;\n          margin:2px 0 10px;\n        }\n\n        #sc-mj-bundle .sc-mj__title{\n          margin:0;\n          font-size:clamp(18px,2.4vw,24px);\n          font-weight:950;\n          line-height:1.1;\n          letter-spacing:-.015em;\n        }\n\n        #sc-mj-bundle .sc-mj__title .w{ color:#F5F2EA; }\n        #sc-mj-bundle .sc-mj__title .hl{ color:var(--mj-gold); }\n\n        #sc-mj-bundle .sc-mj__title .player{\n          color:#A6A19A;\n          font-size:.85em;\n          font-weight:750;\n        }\n\n        #sc-mj-bundle .sc-mj__refresh{\n          white-space:nowrap;\n          background:rgba(245,242,234,.04);\n          color:#F5F2EA;\n          border:1px solid rgba(212,165,76,.20);\n          border-radius:10px;\n          padding:7px 10px;\n          font-weight:850;\n          font-size:12px;\n          line-height:1;\n          cursor:pointer;\n          transition:background .16s ease, border-color .16s ease, color .16s ease, transform .16s ease;\n        }\n\n        #sc-mj-bundle .sc-mj__refresh:hover{\n          background:rgba(212,165,76,.08);\n          border-color:rgba(212,165,76,.42);\n          color:#D4A54C;\n        }\n\n        #sc-mj-bundle .sc-mj__refresh:active{ transform:translateY(1px); }\n\n        #sc-mj-bundle .sc-mj__grid{\n          list-style:none;\n          margin:0;\n          padding:0;\n          display:grid;\n          gap:8px;\n          grid-template-columns:repeat(3, minmax(0,1fr));\n        }\n\n        #sc-mj-bundle .sc-card{\n          position:relative;\n          z-index:0;\n          background:\n            linear-gradient(180deg, rgba(245,242,234,.035), rgba(245,242,234,.018)),\n            var(--mj-card);\n          border:1px solid var(--mj-line);\n          border-radius:12px;\n          overflow:hidden;\n          display:flex;\n          flex-direction:column;\n          box-shadow:0 8px 18px rgba(0,0,0,.18);\n          transition:border-color .18s ease, transform .18s ease, box-shadow .18s ease;\n        }\n\n        #sc-mj-bundle .sc-card:hover{\n          border-color:var(--mj-line-strong);\n          transform:translateY(-1px);\n          box-shadow:0 14px 26px rgba(0,0,0,.25);\n        }\n\n        #sc-mj-bundle .sc-card__media{\n          position:relative;\n          aspect-ratio:1/1;\n          background:#0B0B0D;\n          display:block;\n          overflow:hidden;\n        }\n\n        #sc-mj-bundle .sc-card__media img{\n          width:100%;\n          height:100%;\n          object-fit:cover;\n          object-position:center;\n          display:block;\n          transition:transform .28s ease, opacity .28s ease;\n        }\n\n        #sc-mj-bundle .sc-card:hover .sc-card__media img{\n          transform:scale(1.025);\n          opacity:.97;\n        }\n\n        #sc-mj-bundle .sc-check{\n          position:absolute;\n          top:7px;\n          right:7px;\n          display:inline-flex;\n          align-items:center;\n          gap:6px;\n          font-size:11px;\n          background:rgba(11,11,13,.90);\n          border:1px solid rgba(212,165,76,.26);\n          border-radius:999px;\n          padding:4px 10px;\n          white-space:nowrap;\n          z-index:2;\n          color:#F5F2EA;\n          box-shadow:0 8px 18px rgba(0,0,0,.24);\n        }\n\n        #sc-mj-bundle .sc-check input{\n          accent-color:var(--mj-gold);\n        }\n\n        #sc-mj-bundle .sc-card__meta{\n          padding:9px;\n          display:grid;\n          gap:7px;\n        }\n\n        #sc-mj-bundle .sc-title{\n          margin:0;\n          font-size:13px;\n          font-weight:900;\n          line-height:1.2;\n          min-height:32px;\n          display:-webkit-box;\n          -webkit-line-clamp:2;\n          line-clamp:2;\n          -webkit-box-orient:vertical;\n          overflow:hidden;\n        }\n\n        #sc-mj-bundle .sc-title a{\n          color:#F5F2EA;\n          text-decoration:none;\n        }\n\n        #sc-mj-bundle .sc-title a:hover{\n          color:#D4A54C;\n        }\n\n        #sc-mj-bundle .sc-opts{\n          display:grid;\n          gap:6px;\n        }\n\n        #sc-mj-bundle .sc-opts select{\n          width:100%;\n          border:1px solid rgba(245,242,234,.12);\n          border-radius:9px;\n          background:#0B0B0D;\n          color:#F5F2EA;\n          padding:7px 9px;\n          font-size:12px;\n          font-weight:700;\n          outline:none;\n        }\n\n        #sc-mj-bundle .sc-opts select:focus{\n          border-color:rgba(212,165,76,.58);\n          box-shadow:0 0 0 2px rgba(212,165,76,.12);\n        }\n\n        #sc-mj-bundle .sc-opts select option:disabled{\n          color:#6F6A64;\n        }\n\n        #sc-mj-bundle .sc-card__buy{\n          padding:0 9px 9px;\n          display:flex;\n          align-items:center;\n          justify-content:flex-start;\n        }\n\n        #sc-mj-bundle .sc-card__price{\n          font-weight:950;\n          font-size:13px;\n          color:#F5F2EA;\n        }\n\n        #sc-mj-bundle .sc-card__price .old{\n          color:#A6A19A;\n          text-decoration:line-through;\n          margin-right:6px;\n          font-weight:750;\n        }\n\n        #sc-mj-bundle .sc-mj__totals{\n          margin-top:12px;\n          border-top:1px solid rgba(212,165,76,.13);\n          padding:12px 10px;\n          display:flex;\n          flex-direction:column;\n          gap:10px;\n          align-items:stretch;\n          background:\n            radial-gradient(circle at top center, rgba(212,165,76,.075), transparent 52%),\n            linear-gradient(180deg,#151518,#101012);\n          border-radius:12px;\n          position:relative;\n          z-index:2;\n          box-shadow:inset 0 1px 0 rgba(245,242,234,.035);\n        }\n\n        #sc-mj-bundle .sc-mj__badge{\n          background:rgba(212,165,76,.10);\n          border:1px solid rgba(212,165,76,.40);\n          color:#D4A54C;\n          border-radius:999px;\n          padding:7px 11px;\n          font-weight:900;\n          font-size:12px;\n          align-self:flex-start;\n        }\n\n        #sc-mj-bundle .sc-mj__amounts{\n          display:grid;\n          row-gap:7px;\n        }\n\n        #sc-mj-bundle .sc-mj__amounts .row{\n          display:flex;\n          align-items:center;\n          justify-content:space-between;\n          column-gap:10px;\n        }\n\n        #sc-mj-bundle .sc-mj__amounts .lab{\n          color:#A6A19A;\n          font-weight:750;\n          font-size:12px;\n        }\n\n        #sc-mj-bundle .sc-mj__amounts .val{\n          color:#F5F2EA;\n          font-weight:950;\n          font-size:14px;\n        }\n\n        #sc-mj-bundle .sc-mj__amounts .due{\n          margin-top:3px;\n          padding-top:9px;\n          border-top:1px solid rgba(245,242,234,.08);\n        }\n\n        #sc-mj-bundle .sc-mj__amounts .due .lab,\n        #sc-mj-bundle .sc-mj__amounts .due .val{\n          color:#F5F2EA;\n          font-size:15px;\n        }\n\n        #sc-mj-bundle .sc-mj__atc{\n          width:100%;\n          background:#D4A54C;\n          color:#111111;\n          border:1px solid rgba(212,165,76,.70);\n          border-radius:12px;\n          padding:12px 16px;\n          font-weight:950;\n          font-size:15px;\n          cursor:pointer;\n          box-shadow:0 14px 28px rgba(0,0,0,.22), 0 0 0 1px rgba(245,242,234,.04) inset;\n          display:inline-flex;\n          align-items:center;\n          justify-content:center;\n          gap:8px;\n          position:relative;\n          text-transform:uppercase;\n          letter-spacing:.02em;\n          transition:transform .18s ease, box-shadow .18s ease, background .18s ease;\n        }\n\n        #sc-mj-bundle .sc-mj__atc:hover:not([disabled]){\n          transform:translateY(-1px);\n          background:#DEB65C;\n          box-shadow:0 18px 34px rgba(0,0,0,.28), 0 0 0 1px rgba(245,242,234,.05) inset;\n        }\n\n        #sc-mj-bundle .sc-mj__atc[disabled]{\n          opacity:.62;\n          cursor:not-allowed;\n          background:#6F6A64;\n          color:#F5F2EA;\n          border-color:rgba(245,242,234,.10);\n          box-shadow:none;\n        }\n\n        #sc-mj-bundle .sc-mj__note{\n          margin:0;\n          font-size:11px;\n          color:#A6A19A;\n          opacity:.95;\n          line-height:1.35;\n        }\n\n        #sc-mj-bundle .sc-mj__atc-spinner{\n          width:16px;\n          height:16px;\n          border-radius:50%;\n          border:2px solid rgba(17,17,17,.28);\n          border-top-color:#111111;\n          display:inline-block;\n          opacity:0;\n          transform:scale(.6);\n          transition:opacity .16s ease, transform .16s ease;\n        }\n\n        #sc-mj-bundle .sc-mj__atc[disabled] .sc-mj__atc-spinner{\n          border-color:rgba(245,242,234,.22);\n          border-top-color:#F5F2EA;\n        }\n\n        #sc-mj-bundle .sc-mj__atc.is-busy .sc-mj__atc-spinner{\n          opacity:1;\n          transform:scale(1);\n          animation:scmj-spin .8s linear infinite;\n        }\n\n        @keyframes scmj-spin{ to { transform:rotate(360deg); } }\n\n        @media (min-width:990px){\n          #sc-mj-bundle .sc-mj__wrap{\n            display:grid;\n            grid-template-columns:minmax(0,1fr) 400px;\n            gap:28px;\n            grid-template-areas:\n              \"head head\"\n              \"grid totals\";\n            align-items:start;\n          }\n\n          #sc-mj-bundle .sc-mj__head{ grid-area:head; }\n\n          #sc-mj-bundle .sc-mj__grid{\n            grid-area:grid;\n            min-width:0;\n            gap:20px;\n            grid-template-columns:repeat(3, minmax(240px, 1fr));\n          }\n\n          #sc-mj-bundle .sc-mj__totals{\n            grid-area:totals;\n            margin:0;\n            padding:16px;\n            background:\n              radial-gradient(circle at top center, rgba(212,165,76,.08), transparent 55%),\n              linear-gradient(180deg,#151518,#0F1012);\n            border:1px solid rgba(212,165,76,.16);\n            border-radius:14px;\n            gap:14px;\n            align-self:stretch;\n            justify-self:end;\n            z-index:5;\n          }\n        }\n\n        @media (max-width:740px){\n          #sc-mj-bundle .sc-mj__wrap{ padding:10px 8px; }\n          #sc-mj-bundle .sc-mj__title{ font-size:16px; }\n          #sc-mj-bundle .sc-mj__refresh{ font-size:11px; padding:5px 8px; }\n          #sc-mj-bundle .sc-mj__grid{ grid-template-columns:repeat(2, minmax(0,1fr)); gap:8px; }\n          #sc-mj-bundle .sc-card:nth-child(n+3){ display:none; }\n          #sc-mj-bundle .sc-title{ font-size:12px; min-height:28px; }\n          #sc-mj-bundle .sc-opts select{ font-size:11px; padding:6px 7px; }\n          #sc-mj-bundle .sc-card__price{ font-size:12px; }\n          #sc-mj-bundle .sc-check{ font-size:10.5px; padding:4px 8px; }\n        }\n\n        @media (hover:none){\n          #sc-mj-bundle .sc-card:hover{\n            transform:none;\n            box-shadow:0 8px 18px rgba(0,0,0,.18);\n          }\n\n          #sc-mj-bundle .sc-card:hover .sc-card__media img{\n            transform:none;\n            opacity:1;\n          }\n        }\n\n        @media (prefers-reduced-motion:reduce){\n          #sc-mj-bundle *,\n          #sc-mj-bundle *::before,\n          #sc-mj-bundle *::after{\n            transition:none !important;\n            animation:none !important;\n          }\n        }\n      </style>\n\n    </div>\n  {% endif %}\n</div>\n\n<script>\n(function(){\n  function loadProductRecommendationsIntoSection(){\n    var productRecommendationsSection = document.getElementById(\"shopify-section-{{ section.id }}\")?.querySelector(\".related-products\");\n    if (!productRecommendationsSection || !productRecommendationsSection.dataset.url) return;\n\n    var request = new XMLHttpRequest();\n    request.open(\"GET\", productRecommendationsSection.dataset.url);\n    request.onload = function() {\n      if (request.status >= 200 && request.status < 300) {\n        var container = document.createElement(\"div\");\n        container.innerHTML = request.response;\n        var inner = container.querySelector(\".related-products\");\n        if (inner) {\n          productRecommendationsSection.innerHTML = inner.innerHTML;\n          if (window.scInitBundleUpsell) window.scInitBundleUpsell();\n        }\n      }\n    };\n    request.send();\n  }\n\n  document.addEventListener(\"shopify:section:load\", function(event) {\n    if (document.querySelector('[data-section-id=\"' + event.detail.sectionId + '\"].related-products')) {\n      loadProductRecommendationsIntoSection();\n    }\n  });\n\n  const section = document.getElementById(\"shopify-section-{{ section.id }}\")?.querySelector(\".related-products\");\n  if (!section || !section.dataset.url) return;\n  if (!('IntersectionObserver' in window)) {\n    loadProductRecommendationsIntoSection();\n    return;\n  }\n  const observer = new IntersectionObserver(entries => {\n    if (!entries.some(entry => entry.isIntersecting)) return;\n    observer.disconnect();\n    loadProductRecommendationsIntoSection();\n  }, { rootMargin: '360px 0px' });\n  observer.observe(section);\n})();\n\nwindow.scInitBundleUpsell = window.scInitBundleUpsell || function(){\n  var root = document.getElementById('sc-mj-bundle');\n  if (!root || root.dataset.scHydrated === '1') return;\n  root.dataset.scHydrated = '1';\n\n  var wrap = root.querySelector('.sc-mj__wrap');\n  var moneyFmt = wrap ? (wrap.getAttribute('data-money-format') || '${{amount}}') : '${{amount}}';\n  var activeCurrency = wrap ? (wrap.getAttribute('data-currency') || 'USD') : 'USD';\n  var activeLocale = wrap ? (wrap.getAttribute('data-locale') || document.documentElement.lang || navigator.language || 'en') : (document.documentElement.lang || navigator.language || 'en');\n  var cartAddUrl = wrap ? (wrap.getAttribute('data-cart-add-url') || '/cart/add.js') : '/cart/add.js';\n  var cartUrl = wrap ? (wrap.getAttribute('data-cart-url') || '/cart.js') : '/cart.js';\n  var rootUrl = wrap ? (wrap.getAttribute('data-root-url') || '/') : '/';\n\n  var grid = root.querySelector('.sc-mj__grid');\n  var poolEl = document.getElementById('sc-mj-pool');\n  var pool = [];\n  try { pool = JSON.parse(poolEl.textContent || '[]'); } catch(e){ pool = []; }\n\n  var els = {\n    tier: root.querySelector('[data-tier]'),\n    rrp: root.querySelector('[data-rrp]'),\n    subtotal: root.querySelector('[data-subtotal]'),\n    discount: root.querySelector('[data-discount]'),\n    due: root.querySelector('[data-due]'),\n    refresh: root.querySelector('.sc-mj__refresh'),\n    atc: root.querySelector('.sc-mj__atc'),\n    atcLabel: root.querySelector('.sc-mj__atc-label')\n  };\n\n  function formatAmount(cents, decimals, decimalMark, thousandsMark){\n    var n = parseInt(cents, 10);\n    if (isNaN(n)) n = 0;\n\n    var amount = Math.abs(n / 100).toFixed(decimals);\n    var parts = amount.split('.');\n    var dollars = parts[0].replace(/\\B(?=(\\d{3})+(?!\\d))/g, thousandsMark);\n    var centsPart = parts[1] || '';\n\n    return (n < 0 ? '-' : '') + dollars + (decimals ? decimalMark + centsPart : '');\n  }\n\n  function formatWithShopifyPattern(cents, format){\n    if (!format || typeof format !== 'string') return '';\n\n    var placeholderMatch = format.match(/\\{\\{\\s*([^}]+?)\\s*\\}\\}/);\n    if (!placeholderMatch) return '';\n\n    var token = placeholderMatch[1];\n    var value = '';\n\n    switch (token) {\n      case 'amount':\n        value = formatAmount(cents, 2, '.', ',');\n        break;\n      case 'amount_no_decimals':\n        value = formatAmount(cents, 0, '.', ',');\n        break;\n      case 'amount_with_comma_separator':\n        value = formatAmount(cents, 2, ',', '.');\n        break;\n      case 'amount_no_decimals_with_comma_separator':\n        value = formatAmount(cents, 0, ',', '.');\n        break;\n      case 'amount_with_space_separator':\n        value = formatAmount(cents, 2, '.', ' ');\n        break;\n      case 'amount_no_decimals_with_space_separator':\n        value = formatAmount(cents, 0, '.', ' ');\n        break;\n      case 'amount_with_period_and_space_separator':\n        value = formatAmount(cents, 2, '.', ' ');\n        break;\n      case 'amount_with_apostrophe_separator':\n        value = formatAmount(cents, 2, '.', \"'\");\n        break;\n    }\n\n    return value ? format.replace(placeholderMatch[0], value) : '';\n  }\n\n  function formatWithIntl(cents){\n    var n = parseInt(cents, 10);\n    if (isNaN(n)) n = 0;\n\n    try {\n      return new Intl.NumberFormat(activeLocale || undefined, {\n        style: 'currency',\n        currency: activeCurrency || 'USD',\n        currencyDisplay: 'symbol'\n      }).format(n / 100);\n    } catch(_) {\n      return '';\n    }\n  }\n\n  function toMoney(cents, format){\n    var intl = formatWithIntl(cents);\n    if (intl) return intl;\n\n    var shopifyPattern = formatWithShopifyPattern(cents, format || moneyFmt);\n    if (shopifyPattern) return shopifyPattern;\n\n    return '$' + formatAmount(cents, 2, '.', ',');\n  }\n\n  function hasAvailableVariant(product){\n    for (var i=0;i<product.variants.length;i++){\n      if (product.variants[i].available) return true;\n    }\n    return false;\n  }\n\n  function firstAvailableVariant(product){\n    for (var i=0;i<product.variants.length;i++){\n      if (product.variants[i].available) return product.variants[i];\n    }\n    return product.variants[0];\n  }\n\n  function uniqueValuesForOption(product, idx){\n    var map = {};\n    var restrictToAvailable = hasAvailableVariant(product);\n\n    for (var i=0;i<product.variants.length;i++){\n      var variant = product.variants[i];\n      if (restrictToAvailable && !variant.available) continue;\n\n      var val = variant.options[idx] || '';\n      if (val !== '' && !map[val]) map[val] = true;\n    }\n\n    return Object.keys(map);\n  }\n\n  function findVariant(product, chosen){\n    var exactUnavailable = null;\n\n    for (var i=0;i<product.variants.length;i++){\n      var v = product.variants[i];\n      var ok = true;\n\n      for (var j=0;j<chosen.length;j++){\n        if (String(chosen[j] || '') !== String(v.options[j] || '')) {\n          ok = false;\n          break;\n        }\n      }\n\n      if (ok && v.available) return v;\n      if (ok && !exactUnavailable) exactUnavailable = v;\n    }\n\n    return exactUnavailable || firstAvailableVariant(product);\n  }\n\n  function getUsedIds(){\n    var cards = grid.querySelectorAll('.sc-card');\n    var out = [];\n    for (var i=0;i<cards.length;i++){\n      var pid = parseInt(cards[i].getAttribute('data-product-id') || '0',10);\n      if (pid && out.indexOf(pid) === -1) out.push(pid);\n    }\n    return out;\n  }\n\n  var candidateById = new Map(pool.slice(1).map(candidate => [String(candidate.id), candidate]));\n  var marketBest = [];\n  try {\n    marketBest = JSON.parse(root.querySelector('#sc-mj-market-best')?.textContent || '[]')\n      .map(id => candidateById.get(String(id))).filter(Boolean);\n  } catch (error) {}\n  var ranked = window.SportsCaveRecommendations?.rank(pool[0], pool.slice(1), { bestsellers: marketBest });\n  if (ranked?.length) pool = [pool[0], ...ranked.map(row => row.product)];\n\n  var poolOrder = [];\n  function rebuildOrder(){\n    poolOrder = [];\n    for (var i=1;i<pool.length;i++) poolOrder.push(i);\n    // Keep the closest match first and only rotate peers with similar scores.\n    if (ranked?.length > 2) {\n      var peerEnd = 2;\n      while (peerEnd < ranked.length && ranked[1].score - ranked[peerEnd].score <= 10) peerEnd++;\n      for (var j=peerEnd-1;j>1;j--){\n        var r = 1 + Math.floor(Math.random() * j);\n        var tmp = poolOrder[j];\n        poolOrder[j] = poolOrder[r];\n        poolOrder[r] = tmp;\n      }\n    }\n  }\n  rebuildOrder();\n\n  function removeIndexFromOrder(idx){\n    for (var i=0;i<poolOrder.length;i++){\n      if (poolOrder[i] === idx){\n        poolOrder.splice(i,1);\n        break;\n      }\n    }\n  }\n\n  function pickNext(usedIds){\n    if (!Array.isArray(usedIds)) usedIds = [];\n    if (!poolOrder.length) rebuildOrder();\n\n    for (var i=0;i<poolOrder.length;i++){\n      var idx = poolOrder[i];\n      var p = pool[idx];\n      if (!p) continue;\n      if (usedIds.indexOf(p.id) === -1){\n        poolOrder.splice(i,1);\n        return p;\n      }\n    }\n\n    rebuildOrder();\n\n    for (var k=0;k<poolOrder.length;k++){\n      var idx2 = poolOrder[k];\n      var p2 = pool[idx2];\n      if (p2 && usedIds.indexOf(p2.id) === -1){\n        poolOrder.splice(k,1);\n        return p2;\n      }\n    }\n\n    return null;\n  }\n\n  function setIncludeLabel(lblEl, checked){\n    lblEl.lastChild.nodeValue = checked ? ' In bundle' : ' Add to bundle';\n  }\n\n  function optionValueIsPossible(product, selectIndex, optionValue, selects){\n    var restrictToAvailable = hasAvailableVariant(product);\n\n    for (var i=0;i<product.variants.length;i++){\n      var v = product.variants[i];\n      if (restrictToAvailable && !v.available) continue;\n      if (String(v.options[selectIndex] || '') !== String(optionValue || '')) continue;\n\n      var ok = true;\n\n      for (var j=0;j<selects.length;j++){\n        if (j === selectIndex) continue;\n\n        var current = selects[j].value || '';\n        if (current && String(v.options[j] || '') !== String(current)) {\n          ok = false;\n          break;\n        }\n      }\n\n      if (ok) return true;\n    }\n\n    return false;\n  }\n\n  function syncSelectAvailability(product, selects){\n    if (!selects.length) return;\n\n    for (var i=0;i<selects.length;i++){\n      var sel = selects[i];\n      var firstEnabled = null;\n\n      for (var j=0;j<sel.options.length;j++){\n        var opt = sel.options[j];\n        var possible = optionValueIsPossible(product, i, opt.value, selects);\n        opt.disabled = !possible;\n\n        if (possible && !firstEnabled) firstEnabled = opt;\n      }\n\n      if (sel.selectedOptions[0] && sel.selectedOptions[0].disabled && firstEnabled) {\n        sel.value = firstEnabled.value;\n      }\n    }\n  }\n\n  function buildCard(product, defaultChecked){\n    var v0 = firstAvailableVariant(product);\n\n    var li = document.createElement('li');\n    li.className = 'sc-card';\n    li.setAttribute('data-product-id', String(product.id));\n    if (product.id !== pool[0]?.id) window.SportsCaveRecommendationMeasurement?.register(li,'product_bundle',product.id);\n\n    var media = document.createElement('a');\n    media.className = 'sc-card__media';\n    media.href = product.url;\n    media.setAttribute('aria-label', product.title);\n\n    var img = document.createElement('img');\n    img.src = product.image560;\n    img.setAttribute('srcset',\n      product.image360 + ' 360w, ' +\n      product.image560 + ' 560w, ' +\n      product.image720 + ' 720w'\n    );\n    img.setAttribute('sizes','(min-width: 990px) 24vw, 100vw');\n    img.width = 560;\n    img.height = 560;\n    img.loading = 'lazy';\n    img.decoding = 'async';\n    img.alt = product.title;\n    media.appendChild(img);\n\n    var label = document.createElement('label');\n    label.className = 'sc-check';\n    var cb = document.createElement('input');\n    cb.type = 'checkbox';\n    cb.className = 'sc-inc';\n    cb.checked = !!defaultChecked;\n    label.appendChild(cb);\n    label.appendChild(document.createTextNode(defaultChecked ? ' In bundle' : ' Add to bundle'));\n    media.appendChild(label);\n\n    li.appendChild(media);\n\n    var meta = document.createElement('div');\n    meta.className = 'sc-card__meta';\n\n    var h = document.createElement('h4');\n    h.className = 'sc-title';\n    var a = document.createElement('a');\n    a.href = product.url;\n    a.textContent = product.title;\n    h.appendChild(a);\n    meta.appendChild(h);\n\n    var optsWrap = document.createElement('div');\n    optsWrap.className = 'sc-opts';\n    meta.appendChild(optsWrap);\n\n    var selects = [];\n    for (var oi=0; oi<product.options.length; oi++){\n      var name = product.options[oi];\n      var values = uniqueValuesForOption(product, oi);\n      if (values.length === 0) continue;\n\n      var sel = document.createElement('select');\n      sel.className = 'sc-variant';\n      sel.setAttribute('aria-label', name);\n      sel.setAttribute('data-opt', String(oi));\n\n      for (var vi=0; vi<values.length; vi++){\n        var op = document.createElement('option');\n        op.value = values[vi];\n        op.textContent = values[vi];\n        sel.appendChild(op);\n      }\n\n      var pre = v0 && v0.options ? (v0.options[oi] || '') : '';\n      if (pre && values.indexOf(pre) !== -1) sel.value = pre;\n\n      optsWrap.appendChild(sel);\n      selects.push(sel);\n    }\n\n    var buy = document.createElement('div');\n    buy.className = 'sc-card__buy';\n\n    var priceBox = document.createElement('div');\n    priceBox.className = 'sc-card__price';\n\n    var oldSpan = document.createElement('span');\n    oldSpan.className = 'old';\n    oldSpan.setAttribute('data-old','');\n\n    var priceSpan = document.createElement('span');\n    priceSpan.setAttribute('data-price','');\n\n    priceBox.appendChild(oldSpan);\n    priceBox.appendChild(priceSpan);\n    buy.appendChild(priceBox);\n    meta.appendChild(buy);\n    li.appendChild(meta);\n\n    function currentVariant(){\n      var chosen = [];\n      for (var q=0;q<selects.length;q++) chosen.push(selects[q].value || '');\n      return findVariant(product, chosen);\n    }\n\n    function updatePriceUI(){\n      syncSelectAvailability(product, selects);\n\n      var v = currentVariant();\n      if (!v) return;\n\n      var price = parseInt(v.price || 0, 10);\n      var rrp = parseInt(v.compare_at || v.price || 0, 10);\n\n      li.setAttribute('data-variant-id', String(v.id));\n      li.setAttribute('data-variant-price', String(price));\n      li.setAttribute('data-variant-rrp', String(rrp));\n\n      if (rrp > price){\n        oldSpan.textContent = v.compare_at_money || toMoney(rrp);\n      } else {\n        oldSpan.textContent = '';\n      }\n\n      priceSpan.textContent = v.price_money || toMoney(price);\n    }\n\n    for (var z=0; z<selects.length; z++){\n      selects[z].addEventListener('change', function(){\n        updatePriceUI();\n        updateTotals();\n      }, { passive:true });\n    }\n\n    cb.addEventListener('change', function(){\n      setIncludeLabel(label, cb.checked);\n      updateTotals();\n    }, { passive:true });\n\n    updatePriceUI();\n    return li;\n  }\n\n  function includedCards(){\n    var cards = grid.querySelectorAll('.sc-card');\n    var out = [];\n    for (var i=0;i<cards.length;i++){\n      var inc = cards[i].querySelector('.sc-inc');\n      if (inc && inc.checked) out.push(cards[i]);\n    }\n    return out;\n  }\n\n  var rafId = null;\n  function updateTotals(){\n    if (rafId) cancelAnimationFrame(rafId);\n\n    rafId = requestAnimationFrame(function(){\n      var inc = includedCards();\n      var count = inc.length;\n      var rrpTotal = 0;\n      var saleTotal = 0;\n\n      for (var i=0;i<inc.length;i++){\n        var p = parseInt(inc[i].getAttribute('data-variant-price') || '0', 10);\n        var r = parseInt(inc[i].getAttribute('data-variant-rrp') || '0', 10);\n        if (!isNaN(p)) saleTotal += p;\n        if (!isNaN(r)) rrpTotal += r;\n      }\n\n      var rate = count >= 2 ? 0.25 : 0;\n      var extraDiscount = Math.round(saleTotal * rate);\n      var due = saleTotal - extraDiscount;\n\n      if (count >= 2){\n        els.tier.textContent = '25% collector bonus unlocked';\n        if (els.atcLabel) els.atcLabel.textContent = {{ sc_bundle_ready_label | json }};\n      } else {\n        els.tier.textContent = 'Select 2 editions to unlock 25% off';\n        if (els.atcLabel) els.atcLabel.textContent = 'Select 2 editions to secure 25% off';\n      }\n\n      if (els.rrp) els.rrp.textContent = toMoney(rrpTotal);\n      if (els.subtotal) els.subtotal.textContent = toMoney(saleTotal);\n      if (els.discount) els.discount.textContent = extraDiscount > 0 ? '-' + toMoney(extraDiscount) : toMoney(0);\n      if (els.due) els.due.textContent = toMoney(due);\n\n      var disabled = count < 2;\n      if (els.atc){\n        els.atc.disabled = disabled;\n        els.atc.setAttribute('aria-disabled', String(disabled));\n      }\n\n      rafId = null;\n    });\n  }\n\n  function mountInitial(){\n    grid.innerHTML = '';\n    if (!pool.length) return;\n\n    var used = [];\n    var first = pool[0];\n    used.push(first.id);\n    removeIndexFromOrder(0);\n    grid.appendChild(buildCard(first, true));\n\n    var second = pickNext(used);\n    if (second){\n      used.push(second.id);\n      grid.appendChild(buildCard(second, true));\n    }\n\n    var third = pickNext(used);\n    if (third){\n      used.push(third.id);\n      grid.appendChild(buildCard(third, false));\n    }\n\n    updateTotals();\n  }\n\n  function refreshUnticked(){\n    var cards = grid.querySelectorAll('.sc-card');\n    var used = getUsedIds();\n\n    for (var i=0;i<cards.length;i++){\n      var card = cards[i];\n      var inc = card.querySelector('.sc-inc');\n      if (inc && !inc.checked){\n        var freshProduct = pickNext(used);\n        if (!freshProduct) continue;\n        used.push(freshProduct.id);\n        var freshCard = buildCard(freshProduct, false);\n        grid.replaceChild(freshCard, card);\n      }\n    }\n\n    updateTotals();\n  }\n\n  function getDrawerEl(){\n    return document.querySelector('cart-drawer, #CartDrawer, #Cart-Drawer, .cart-drawer, .drawer.js-cart-drawer');\n  }\n\n  function openCartDrawer(){\n    try { window.dispatchEvent(new CustomEvent('cart:open',{bubbles:true,detail:{source:'sc-bundle'}})); } catch(_) {}\n    try{\n      var el = getDrawerEl();\n      if (!el) return;\n      if (typeof el.open === 'function'){ el.open(); return; }\n      if ((el.tagName || '').toLowerCase() === 'cart-drawer'){ el.setAttribute('open',''); return; }\n      el.setAttribute('aria-hidden','false');\n      el.classList.add('is-open');\n      document.documentElement.classList.add('no-scroll');\n    } catch(_) {}\n  }\n\n  function applySectionsHTML(map){\n    if (!map) return;\n    Object.keys(map).forEach(function(id){\n      var html = map[id];\n      var host = document.getElementById('shopify-section-' + id);\n      if (host && html) host.innerHTML = html;\n    });\n  }\n\n  function updateHeaderBubbles(count){\n    try{\n      Array.prototype.slice.call(document.querySelectorAll('#cart-icon-bubble, .cart-count-bubble, [data-cart-count-bubble], [data-cart-count], .header__icon--cart .cart-count, .cart__badge, #CartCount, .site-header__cart .count'))\n        .forEach(function(el){\n          var span = el.querySelector('[aria-hidden=\"true\"]') || el.firstElementChild || el;\n          if (span) span.textContent = String(count);\n          el.setAttribute('data-cart-count', String(count));\n          if ('hidden' in el) el.hidden = (count === 0);\n          el.classList.toggle('is-empty', count === 0);\n        });\n    } catch(_) {}\n  }\n\n  async function refreshSectionsAndCounts(ids){\n    try{\n      if (ids && ids.length){\n        var base = rootUrl || '/';\n        if (base.charAt(base.length - 1) !== '/') base += '/';\n\n        var res = await fetch(base + '?sections=' + encodeURIComponent(ids.join(',')), {\n          headers:{ 'Accept':'application/json' },\n          credentials:'same-origin'\n        });\n\n        var json = await res.json();\n        applySectionsHTML(json);\n      }\n    } catch(_) {}\n\n    try{\n      var r = await fetch(cartUrl, {\n        headers:{ 'Accept':'application/json' },\n        credentials:'same-origin'\n      });\n\n      var j = await r.json();\n      var c = j && typeof j.item_count === 'number' ? j.item_count : 0;\n      updateHeaderBubbles(c);\n    } catch(_) {}\n  }\n\n  function detectSectionIds(){\n    var ids = new Set();\n    var drawer = getDrawerEl();\n\n    if (drawer){\n      var sec = drawer.closest('section[id^=\"shopify-section-\"]');\n      if (sec) ids.add(sec.id.replace('shopify-section-',''));\n      drawer.querySelectorAll('[data-section-id]').forEach(function(n){\n        if (n.dataset.sectionId) ids.add(n.dataset.sectionId);\n      });\n    }\n\n    if (document.getElementById('shopify-section-header')) ids.add('header');\n    ids.add('cart-drawer');\n    ids.add('cart-icon-bubble');\n    return Array.from(ids);\n  }\n\n  async function addBundleToCartDrawer(variantIds){\n    var sectionIds = detectSectionIds();\n    var measurement = window.SportsCaveRecommendationMeasurement;\n    var eventId = measurement?.attributionId();\n    var anchorVariants = new Set(pool[0].variants.map(variant => Number(variant.id)));\n\n    var response = await fetch(cartAddUrl, {\n      method: 'POST',\n      headers: { 'Content-Type':'application/json', 'Accept':'application/json' },\n      body: JSON.stringify({\n        items: variantIds.map(function(id){\n          var item = {id:id, quantity:1};\n          if (eventId && !anchorVariants.has(id)) item.properties = {_sc_reco_event:eventId};\n          return item;\n        })\n      }),\n      credentials:'same-origin'\n    });\n\n    if (!response.ok) throw new Error('Bundle could not be added');\n    try {\n      var confirmation = await response.json();\n      var addons = Array.isArray(confirmation.items)\n        ? confirmation.items\n          .filter(item => variantIds.includes(Number(item.variant_id || item.id)) && String(item.product_id) !== String(pool[0].id))\n          .map(item => item.product_id)\n        : [];\n      if (eventId && addons.length) measurement.record('add_to_cart','product_bundle',addons,eventId);\n    } catch (_) {}\n    await refreshSectionsAndCounts(sectionIds);\n    openCartDrawer();\n    setTimeout(openCartDrawer, 160);\n  }\n\n  async function handleAddBundle(){\n    var inc = includedCards();\n    if (inc.length < 2) return;\n\n    var ids = [];\n    for (var i=0;i<inc.length;i++){\n      var id = parseInt(inc[i].getAttribute('data-variant-id') || '0', 10);\n      if (id) ids.push(id);\n    }\n    if (ids.length < 2) return;\n\n    els.atc.classList.add('is-busy');\n    els.atc.disabled = true;\n\n    try {\n      await addBundleToCartDrawer(ids);\n    } catch(_) {\n      if (els.atcLabel) els.atcLabel.textContent = 'Could not add bundle — try again';\n    }\n\n    els.atc.classList.remove('is-busy');\n    els.atc.disabled = false;\n  }\n\n  if (els.refresh) els.refresh.addEventListener('click', refreshUnticked);\n  if (els.atc){\n    els.atc.addEventListener('click', function(e){\n      e.preventDefault();\n      handleAddBundle();\n    });\n  }\n\n  mountInitial();\n  window.SportsCaveRecommendationMeasurement?.start();\n};\n</script>"
      }
    },
