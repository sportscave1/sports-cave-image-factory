        "custom_liquid_RwYDad": {
          "type": "custom-liquid",
          "name": "quote html",
          "disabled": true,
          "settings": {
            "custom_liquid": "{%- comment -%}\nSPORTS CAVE • Legacy snippet (collector caption under Limited Edition plaque)\n{%- endcomment -%}\n\n<style>\n  .scx-legacy-snippet{\n    position: relative;\n\n    \n    margin: 3px 4px 10px;\n    padding-left: 12px;\n\n    font-family: var(--sc-font-ui);\n    font-size: 12.1px;\n    line-height: 1.4;\n    font-style: italic;\n    font-weight: 500;\n\n    \n    color: #3d3123;\n    background: transparent;\n    border: none;\n    border-radius: 0;\n    box-shadow: none;\n\n    white-space: nowrap;\n    overflow: hidden;\n    text-overflow: ellipsis;\n  }\n\n  \n  .scx-legacy-snippet::before{\n    content: \"\";\n    position: absolute;\n    left: 0;\n    top: 4px;\n    bottom: 4px;\n    width: 1.5px;\n    border-radius: 999px;\n    background: linear-gradient(180deg,#f7d27a,#c89b32);\n    opacity: 0.28; \n  }\n\n  .scx-legacy-snippet span::before{\n    content: \"“\";\n    margin-right: 2px;\n    color: inherit;\n  }\n  .scx-legacy-snippet span::after{\n    content: \"”\";\n    color: inherit;\n  }\n\n  @media (max-width: 767px){\n    .scx-legacy-snippet{\n      font-size: 11.6px;\n      margin: 3px 4px 8px;\n      padding-left: 10px;\n    }\n  }\n</style>\n\n{%- assign desc = product.description | strip_html | strip -%}\n{%- if desc != blank -%}\n  {%- assign sentences = desc | split: '.' -%}\n  {%- assign first  = sentences[0] | strip -%}\n  {%- assign second = sentences[1] | default: '' | strip -%}\n\n  {%- assign first_words = first | split: ' ' -%}\n  {%- assign first_word_count = first_words | size -%}\n\n  {%- assign combined = first -%}\n\n  {%- if first_word_count <= 4 and second != '' -%}\n    {%- assign combined = combined | append: '. ' | append: second -%}\n  {%- endif -%}\n\n  {%- assign preview = combined | truncate: 120, '…' -%}\n\n  <p class=\"scx-legacy-snippet\">\n    <span>{{ preview }}</span>\n  </p>\n{%- endif -%}",
            "show_in_quickbuy": false
          }
        },
        "custom_liquid_79ekki": {
          "type": "custom-liquid",
          "name": "lifestyle mockups html",
          "settings": {
            "custom_liquid": "{% comment %}\nSPORTS CAVE • Lifestyle Product Images\nShows ONLY product media image 2 and 3.\nCompact 1:1 cards.\nNo cropping.\nPopup is injected directly into <body> so it overlays correctly.\nSmall white close button included.\n{% endcomment %}\n\n{%- liquid\n  assign sc_lifestyle_total = 0\n\n  for media in product.media\n    if media.media_type == 'image'\n      if forloop.index == 2 or forloop.index == 3\n        assign sc_lifestyle_total = sc_lifestyle_total | plus: 1\n      endif\n    endif\n  endfor\n-%}\n\n{%- if sc_lifestyle_total > 0 -%}\n<style>\n  .sc-life23,\n  .sc-life23 *{\n    box-sizing:border-box;\n  }\n\n  .sc-life23{\n    width:100%;\n    margin:0;\n    padding:0 0 22px;\n    background:#0B0B0D;\n    overflow:hidden;\n    font-family:\"Montserrat\",system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif;\n  }\n\n  .sc-life23__track{\n    width:100%;\n    display:flex;\n    gap:12px;\n    overflow-x:auto;\n    overflow-y:hidden;\n    scroll-snap-type:x mandatory;\n    -webkit-overflow-scrolling:touch;\n    scrollbar-width:none;\n    padding:0 13px;\n  }\n\n  .sc-life23__track::-webkit-scrollbar{\n    display:none;\n  }\n\n  .sc-life23__item{\n    flex:0 0 74vw;\n    width:74vw;\n    max-width:340px;\n    aspect-ratio:1 / 1;\n    display:block;\n    margin:0;\n    padding:0;\n    appearance:none;\n    border:1px solid rgba(212,165,76,.34);\n    border-radius:13px;\n    overflow:hidden;\n    background:#0B0B0D;\n    cursor:zoom-in;\n    scroll-snap-align:center;\n    box-shadow:\n      0 14px 34px rgba(0,0,0,.38),\n      inset 0 1px 0 rgba(255,255,255,.04);\n    -webkit-tap-highlight-color:transparent;\n  }\n\n  .sc-life23__item img{\n    display:block;\n    width:100%;\n    height:100%;\n    object-fit:contain;\n    object-position:center;\n    border:0;\n    margin:0;\n    padding:0;\n    background:#0B0B0D;\n  }\n\n  @media(min-width:750px){\n    .sc-life23{\n      padding:0 0 26px;\n    }\n\n    .sc-life23__track{\n      max-width:920px;\n      margin:0 auto;\n      padding:0 20px;\n      display:grid;\n      grid-template-columns:repeat({{ sc_lifestyle_total }}, minmax(0,1fr));\n      gap:16px;\n      overflow:visible;\n    }\n\n    .sc-life23__item{\n      width:100%;\n      max-width:420px;\n      flex:none;\n      aspect-ratio:1 / 1;\n      border-radius:15px;\n      justify-self:center;\n    }\n  }\n\n  .sc-life23-modal{\n    --sc-life23-atc-space:0px;\n\n    position:fixed!important;\n    top:0!important;\n    left:0!important;\n    right:0!important;\n    bottom:var(--sc-life23-atc-space)!important;\n    z-index:2147483600!important;\n    display:flex!important;\n    align-items:center!important;\n    justify-content:center!important;\n    padding:54px 12px 18px!important;\n    background:rgba(11,11,13,.965)!important;\n    backdrop-filter:blur(10px)!important;\n    -webkit-backdrop-filter:blur(10px)!important;\n    overscroll-behavior:contain!important;\n    pointer-events:auto!important;\n    cursor:zoom-out;\n  }\n\n  .sc-life23-modal[hidden]{\n    display:none!important;\n  }\n\n  .sc-life23-modal,\n  .sc-life23-modal *{\n    box-sizing:border-box!important;\n  }\n\n  .sc-life23-modal__stage{\n    position:relative!important;\n    width:100%!important;\n    height:100%!important;\n    display:flex!important;\n    align-items:center!important;\n    justify-content:center!important;\n    pointer-events:auto!important;\n  }\n\n  .sc-life23-modal__img{\n    display:block!important;\n    width:auto!important;\n    height:auto!important;\n    max-width:96vw!important;\n    max-height:100%!important;\n    object-fit:contain!important;\n    object-position:center!important;\n    border-radius:10px!important;\n    border:1px solid rgba(212,165,76,.3)!important;\n    box-shadow:0 24px 70px rgba(0,0,0,.72)!important;\n    background:#0B0B0D!important;\n    cursor:default!important;\n    pointer-events:auto!important;\n  }\n\n  .sc-life23-modal__close{\n    position:fixed!important;\n    top:calc(env(safe-area-inset-top,0px) + 12px)!important;\n    right:12px!important;\n    z-index:2147483647!important;\n    width:36px!important;\n    height:36px!important;\n    min-width:36px!important;\n    min-height:36px!important;\n    max-width:36px!important;\n    max-height:36px!important;\n    padding:0!important;\n    margin:0!important;\n    display:flex!important;\n    align-items:center!important;\n    justify-content:center!important;\n    appearance:none!important;\n    -webkit-appearance:none!important;\n    border:1px solid rgba(255,255,255,.5)!important;\n    border-radius:999px!important;\n    background:rgba(0,0,0,.72)!important;\n    color:#FFFFFF!important;\n    font-size:25px!important;\n    line-height:1!important;\n    font-weight:400!important;\n    font-family:Arial,Helvetica,sans-serif!important;\n    text-align:center!important;\n    text-decoration:none!important;\n    cursor:pointer!important;\n    box-shadow:0 10px 26px rgba(0,0,0,.56)!important;\n    opacity:1!important;\n    visibility:visible!important;\n    pointer-events:auto!important;\n    -webkit-tap-highlight-color:transparent!important;\n  }\n\n  .sc-life23-modal__close span{\n    display:block!important;\n    width:auto!important;\n    height:auto!important;\n    color:#FFFFFF!important;\n    font-size:25px!important;\n    line-height:1!important;\n    font-weight:400!important;\n    transform:translateY(-1px)!important;\n    pointer-events:none!important;\n  }\n\n  .sc-life23-modal__close::before,\n  .sc-life23-modal__close::after{\n    display:none!important;\n    content:none!important;\n  }\n\n  .sc-life23-modal__close:focus-visible{\n    outline:2px solid #D4A54C!important;\n    outline-offset:3px!important;\n  }\n\n  html.sc-life23-locked,\n  body.sc-life23-locked{\n    overflow:hidden!important;\n  }\n\n  body.sc-life23-modal-open .sticky-add-to-cart,\n  body.sc-life23-modal-open .sticky-atc,\n  body.sc-life23-modal-open .product-sticky-form,\n  body.sc-life23-modal-open .product-form-sticky,\n  body.sc-life23-modal-open [data-sticky-add-to-cart],\n  body.sc-life23-modal-open [data-sticky-atc],\n  body.sc-life23-modal-open [class*=\"sticky-add-to-cart\" i],\n  body.sc-life23-modal-open [class*=\"sticky-atc\" i]{\n    z-index:2147483646!important;\n  }\n</style>\n\n<div class=\"sc-life23 sc-life23--slideshow\" data-sc-life23>\n  <div class=\"sc-life23__track\">\n    {%- for media in product.media -%}\n      {%- if media.media_type == 'image' -%}\n        {%- if forloop.index == 2 or forloop.index == 3 -%}\n          <button\n            type=\"button\"\n            class=\"sc-life23__item\"\n            data-sc-life23-open\n            data-full=\"{{ media.preview_image | image_url: width: 1800 }}\"\n            aria-label=\"Open lifestyle product image\">\n            <img\n              src=\"{{ media.preview_image | image_url: width: 800 }}\"\n              srcset=\"\n                {{ media.preview_image | image_url: width: 500 }} 500w,\n                {{ media.preview_image | image_url: width: 800 }} 800w,\n                {{ media.preview_image | image_url: width: 1100 }} 1100w,\n                {{ media.preview_image | image_url: width: 1400 }} 1400w\"\n              sizes=\"(max-width: 989px) 100vw, 420px\"\n              alt=\"{{ media.alt | default: product.title | escape }}\"\n              loading=\"lazy\"\n              decoding=\"async\">\n          </button>\n        {%- endif -%}\n      {%- endif -%}\n    {%- endfor -%}\n  </div>\n  {%- if sc_lifestyle_total > 1 -%}\n  <div class=\"sc-life23__pagination\">\n  {%- for i in (1..sc_lifestyle_total) -%}\n  <button type=\"button\" class=\"sc-life23__dot\" aria-label=\"{{ product.title | escape }} — {{ i }}\" aria-current=\"{% if forloop.first %}true{% else %}false{% endif %}\"></button>\n  {%- endfor -%}\n  </div>\n  {%- endif -%}\n</div>\n\n<script>\n  (() => {\n    const state = window.__SC_LIFE23_STATE__ || {\n      scrollY: 0,\n      lastTrigger: null,\n      upgradeTimer: null,\n      modalOpen: false,\n      originalBodyStyle: {}\n    };\n\n    window.__SC_LIFE23_STATE__ = state;\n\n    const getModal = () => {\n      let modal = document.querySelector('[data-sc-life23-modal]');\n\n      if (!modal) {\n        modal = document.createElement('div');\n        modal.className = 'sc-life23-modal';\n        modal.setAttribute('data-sc-life23-modal', '');\n        modal.setAttribute('role', 'dialog');\n        modal.setAttribute('aria-modal', 'true');\n        modal.setAttribute('aria-label', 'Lifestyle product image preview');\n        modal.setAttribute('aria-hidden', 'true');\n        modal.hidden = true;\n\n        modal.innerHTML = `\n          <div class=\"sc-life23-modal__stage\" data-sc-life23-stage>\n            <button type=\"button\" class=\"sc-life23-modal__close\" data-sc-life23-close aria-label=\"Close image\">\n              <span aria-hidden=\"true\">×</span>\n            </button>\n            <img class=\"sc-life23-modal__img\" data-sc-life23-img alt=\"\" decoding=\"async\">\n          </div>\n        `;\n      }\n\n      \n      if (modal.parentElement !== document.body) {\n        document.body.appendChild(modal);\n      }\n\n      if (!modal.dataset.scLife23Bound) {\n        modal.dataset.scLife23Bound = 'true';\n\n        modal.addEventListener('click', (event) => {\n          const stage = modal.querySelector('[data-sc-life23-stage]');\n          const closeBtn = modal.querySelector('[data-sc-life23-close]');\n\n          if (\n            event.target === modal ||\n            event.target === stage ||\n            event.target === closeBtn ||\n            closeBtn.contains(event.target)\n          ) {\n            closeModal();\n          }\n        });\n\n        document.addEventListener('keydown', (event) => {\n          if (event.key === 'Escape' && !modal.hidden) {\n            closeModal();\n          }\n        });\n\n        window.addEventListener('resize', () => {\n          if (state.modalOpen) {\n            setAddToCartSpace(modal);\n          }\n        });\n      }\n\n      return modal;\n    };\n\n    const findStickyAddToCartSpace = () => {\n      const selectors = [\n        '[data-sticky-add-to-cart]',\n        '[data-sticky-atc]',\n        '.sticky-add-to-cart',\n        '.sticky-atc',\n        '.product-sticky-form',\n        '.product-form-sticky',\n        '[class*=\"sticky-add-to-cart\" i]',\n        '[class*=\"sticky-atc\" i]'\n      ];\n\n      const candidates = [];\n\n      selectors.forEach((selector) => {\n        document.querySelectorAll(selector).forEach((el) => candidates.push(el));\n      });\n\n      \n      document.querySelectorAll('button,a,div,section,form').forEach((el) => {\n        const text = (el.textContent || '').trim();\n\n        if (!/add to cart|add to bag|buy now|secure yours|checkout/i.test(text)) return;\n\n        const style = window.getComputedStyle(el);\n        const rect = el.getBoundingClientRect();\n\n        if (\n          (style.position === 'fixed' || style.position === 'sticky') &&\n          rect.height >= 38 &&\n          rect.height <= 150 &&\n          rect.width >= 140 &&\n          rect.bottom >= window.innerHeight - 12\n        ) {\n          candidates.push(el);\n        }\n      });\n\n      for (const el of candidates) {\n        const style = window.getComputedStyle(el);\n        const rect = el.getBoundingClientRect();\n\n        if (\n          rect.height > 0 &&\n          rect.width > 0 &&\n          rect.bottom >= window.innerHeight - 14 &&\n          (style.position === 'fixed' || style.position === 'sticky')\n        ) {\n          const space = Math.ceil(window.innerHeight - rect.top);\n          return Math.min(Math.max(space, 58), 150);\n        }\n      }\n\n      return 0;\n    };\n\n    const setAddToCartSpace = (modal) => {\n      const space = findStickyAddToCartSpace();\n      modal.style.setProperty('--sc-life23-atc-space', `${space}px`);\n    };\n\n    const lockPage = () => {\n      state.scrollY = window.pageYOffset || document.documentElement.scrollTop || 0;\n\n      state.originalBodyStyle = {\n        position: document.body.style.position,\n        top: document.body.style.top,\n        left: document.body.style.left,\n        right: document.body.style.right,\n        width: document.body.style.width\n      };\n\n      document.documentElement.classList.add('sc-life23-locked');\n      document.body.classList.add('sc-life23-locked', 'sc-life23-modal-open');\n      document.body.dataset.scLife23ScrollY = String(state.scrollY);\n\n      document.body.style.position = 'fixed';\n      document.body.style.top = `-${state.scrollY}px`;\n      document.body.style.left = '0';\n      document.body.style.right = '0';\n      document.body.style.width = '100%';\n    };\n\n    const unlockPage = () => {\n      const storedY = parseInt(document.body.dataset.scLife23ScrollY || String(state.scrollY || 0), 10) || 0;\n      const html = document.documentElement;\n      const oldScrollBehavior = html.style.scrollBehavior;\n\n      document.documentElement.classList.remove('sc-life23-locked');\n      document.body.classList.remove('sc-life23-locked', 'sc-life23-modal-open');\n\n      document.body.style.position = state.originalBodyStyle.position || '';\n      document.body.style.top = state.originalBodyStyle.top || '';\n      document.body.style.left = state.originalBodyStyle.left || '';\n      document.body.style.right = state.originalBodyStyle.right || '';\n      document.body.style.width = state.originalBodyStyle.width || '';\n\n      delete document.body.dataset.scLife23ScrollY;\n\n      html.style.scrollBehavior = 'auto';\n      window.scrollTo(0, storedY);\n\n      requestAnimationFrame(() => {\n        window.scrollTo(0, storedY);\n        html.style.scrollBehavior = oldScrollBehavior;\n      });\n    };\n\n    const openModal = (btn) => {\n      const modal = getModal();\n      const modalImg = modal.querySelector('[data-sc-life23-img]');\n      const closeBtn = modal.querySelector('[data-sc-life23-close]');\n      const img = btn.querySelector('img');\n\n      const instantSrc = img ? (img.currentSrc || img.src) : '';\n      const fullSrc = btn.getAttribute('data-full') || instantSrc;\n\n      if (!instantSrc && !fullSrc) return;\n\n      state.lastTrigger = btn;\n      state.modalOpen = true;\n\n      if (state.upgradeTimer) {\n        clearTimeout(state.upgradeTimer);\n        state.upgradeTimer = null;\n      }\n\n      modalImg.alt = img ? (img.alt || '') : '';\n      modalImg.src = instantSrc || fullSrc;\n\n      setAddToCartSpace(modal);\n      lockPage();\n\n      modal.hidden = false;\n      modal.setAttribute('aria-hidden', 'false');\n\n      requestAnimationFrame(() => {\n        closeBtn.style.display = 'flex';\n        closeBtn.style.opacity = '1';\n        closeBtn.style.visibility = 'visible';\n\n        try {\n          closeBtn.focus({ preventScroll: true });\n        } catch (error) {}\n      });\n\n      \n      if (fullSrc && fullSrc !== modalImg.src) {\n        state.upgradeTimer = window.setTimeout(() => {\n          const preload = new Image();\n\n          preload.onload = () => {\n            if (!modal.hidden) {\n              modalImg.src = fullSrc;\n            }\n          };\n\n          preload.src = fullSrc;\n        }, 80);\n      }\n    };\n\n    function closeModal(){\n      const modal = document.querySelector('[data-sc-life23-modal]');\n      if (!modal || modal.hidden) return;\n\n      const modalImg = modal.querySelector('[data-sc-life23-img]');\n\n      if (state.upgradeTimer) {\n        clearTimeout(state.upgradeTimer);\n        state.upgradeTimer = null;\n      }\n\n      state.modalOpen = false;\n\n      modal.hidden = true;\n      modal.setAttribute('aria-hidden', 'true');\n      modal.style.setProperty('--sc-life23-atc-space', '0px');\n\n      if (modalImg) {\n        modalImg.removeAttribute('src');\n      }\n\n      unlockPage();\n\n      if (state.lastTrigger && typeof state.lastTrigger.focus === 'function') {\n        try {\n          state.lastTrigger.focus({ preventScroll: true });\n        } catch (error) {}\n      }\n\n      state.lastTrigger = null;\n      document.dispatchEvent(new Event('sc-life23-resume'));\n    }\n\n    const init = () => {\n      getModal();\n\n      document.querySelectorAll('[data-sc-life23]:not([data-sc-ready])').forEach((root) => {\n        root.setAttribute('data-sc-ready', 'true');\n\n        const track = root.querySelector('.sc-life23__track');\n        const slides = Array.from(track.children);\n        const dots = Array.from(root.querySelectorAll('.sc-life23__dot'));\n        const activeIndex = () => Math.min(slides.length - 1, Math.round(Math.abs(track.scrollLeft) / (track.clientWidth || 1)));\n        let pending = false;\n        const updateDots = () => {\n        pending = false;\n        const active = activeIndex();\n        dots.forEach((dot, index) => dot.setAttribute('aria-current', String(index === active)));\n        };\n        track.addEventListener('scroll', () => {\n        if (!pending) { pending = true; requestAnimationFrame(updateDots); }\n        }, { passive: true });\n        let goTo = index => track.scrollTo({left:slides[index].offsetLeft-slides[0].offsetLeft,behavior:'instant'});\n        dots.forEach((dot,index)=>dot.addEventListener('click',()=>goTo(index)));\n\n\n\n        // Only visible mobile slideshows own a timer; desktop and reduced motion stay manual.\n        if (slides.length > 1 && 'IntersectionObserver' in window && typeof Element.prototype.animate === 'function') {\n        const mobile = matchMedia('(max-width:989px)');\n        const reduced = matchMedia('(prefers-reduced-motion:reduce)');\n        let visible = false, timer = 0, generation = 0, overlay = null, animation = null, touching = false, gesture = null, suppressClick = 0;\n        const eligible = () => visible && mobile.matches && !reduced.matches && !document.hidden && !state.modalOpen && !touching && root.isConnected;\n        const stop = () => {\n        clearTimeout(timer); timer = 0; generation++;\n        animation?.cancel(); animation = null;\n        overlay?.remove(); overlay = null;\n        };\n        const schedule = () => {\n        clearTimeout(timer); timer = 0;\n        if (eligible()) timer = setTimeout(advance, 5000);\n        };\n        const advance = () => {\n        timer=0;\n        if(eligible()) goTo((activeIndex()+1)%slides.length);\n        };\n        goTo = async next => {\n        stop();\n        const active=activeIndex();\n        if(next===active){schedule();return;}\n        if(!mobile.matches || reduced.matches){\n        track.scrollTo({left:slides[next].offsetLeft-slides[0].offsetLeft,behavior:'instant'});\n        updateDots();schedule();return;\n        }\n        const token=++generation;\n        const incoming = slides[next].querySelector('img');\n        const outgoing = slides[active].querySelector('img');\n        incoming.loading = 'eager';\n        try { await incoming.decode(); } catch (_) { schedule(); return; }\n        if (token !== generation || document.hidden || state.modalOpen || !root.isConnected) return;\n        overlay = document.createElement('img');\n        overlay.className = 'sc-life23__fade';\n        overlay.alt = '';\n        overlay.setAttribute('aria-hidden','true');\n        overlay.src = outgoing.currentSrc || outgoing.src;\n        root.append(overlay);\n        track.scrollTo({left:slides[next].offsetLeft-slides[0].offsetLeft,behavior:'instant'});\n        updateDots();\n        animation = overlay.animate([{opacity:1},{opacity:0}],{duration:500,easing:'ease-in-out'});\n        try { await animation.finished; } catch (_) { return; }\n        if (token !== generation) return;\n        overlay.remove(); overlay = null; animation = null;\n        schedule();\n        };\n        const sync = () => { stop(); schedule(); };\n        const observer = new IntersectionObserver(entries => {\n        visible = entries[0].isIntersecting && entries[0].intersectionRatio >= .35;\n        sync();\n        }, {threshold:[0,.35]});\n        observer.observe(root);\n        if (mobile.matches) root.classList.add('sc-life23--fade-ready');\n        mobile.addEventListener('change', () => root.classList.toggle('sc-life23--fade-ready', mobile.matches));\n        root.addEventListener('pointerdown', event => {\n        touching=true;stop();\n        gesture=mobile.matches && track.contains(event.target) && event.isPrimary && event.button===0 ? {id:event.pointerId,x:event.clientX,y:event.clientY} : null;\n        },{passive:true});\n        const release = event => {\n        if(!touching)return;\n        touching=false;\n        const start=gesture;gesture=null;\n        if(start && event.type!=='pointercancel' && event.pointerId===start.id){\n        const dx=event.clientX-start.x,dy=event.clientY-start.y;\n        if(Math.abs(dx)>=32 && Math.abs(dx)>Math.abs(dy)*1.25){\n        suppressClick=performance.now()+500;\n        const active=activeIndex();\n        goTo(Math.max(0,Math.min(slides.length-1,active+(dx<0?1:-1))));\n        return;\n        }\n        }\n        schedule();\n        };\n        track.addEventListener('click',event=>{\n        if(performance.now()<suppressClick){event.preventDefault();event.stopImmediatePropagation();}\n        },true);\n        window.addEventListener('pointerup',release,{passive:true});\n        window.addEventListener('pointercancel',release,{passive:true});\n        track.addEventListener('scroll', () => { if (!overlay) schedule(); }, {passive:true});\n        root.addEventListener('click',schedule);\n        mobile.addEventListener('change',sync);\n        reduced.addEventListener('change',sync);\n        document.addEventListener('visibilitychange',sync);\n        document.addEventListener('sc-life23-resume',sync);\n        document.addEventListener('shopify:section:unload',event => {\n        if (!event.target.contains(root)) return;\n        stop(); observer.disconnect();\n        mobile.removeEventListener('change',sync);\n        reduced.removeEventListener('change',sync);\n        document.removeEventListener('visibilitychange',sync);\n        document.removeEventListener('sc-life23-resume',sync);\n        window.removeEventListener('pointerup',release);\n        window.removeEventListener('pointercancel',release);\n        });\n        }\n\n        root.querySelectorAll('[data-sc-life23-open]').forEach((btn) => {\n          btn.addEventListener('click', () => openModal(btn));\n        });\n      });\n    };\n\n    if (document.readyState === 'loading') {\n      document.addEventListener('DOMContentLoaded', init);\n    } else {\n      init();\n    }\n\n    document.addEventListener('shopify:section:load', init);\n  })();\n</script>\n{%- endif -%}",
