ransition:\n      background .18s ease,\n      border-color .18s ease,\n      transform .12s ease,\n      box-shadow .12s ease;\n  }\n\n  .scx-collection-nav__link:hover,\n  .scx-collection-nav__link:focus-visible{\n    border-color:#f7d37a;\n    background:linear-gradient(135deg,rgba(247,211,122,.18),rgba(199,154,50,.22));\n    transform:translateY(-1px);\n    box-shadow:\n      0 10px 20px rgba(0,0,0,.55),\n      0 0 0 1px rgba(247,211,122,.65);\n    outline:none;\n  }\n\n  \n  @media (min-width:900px){\n    .scx-collection-nav__shell{\n      gap:0;\n    }\n    .scx-collection-nav__arrow{\n      display:none;\n    }\n    .scx-collection-nav__track{\n      overflow:visible;\n      flex-wrap:nowrap;\n      justify-content:space-between;\n      padding:.15rem 0 .05rem;\n    }\n    .scx-collection-nav__link{\n      flex:1 1 0;\n      max-width:none;\n      padding:.38rem .75rem; \n      font-size:.86rem;\n    }\n  }\n\n  @media (max-width:768px){\n    .scx-collection-nav{\n      margin-top:1.8rem;\n      padding:1.6rem 1.1rem 1.9rem;\n    }\n    .scx-collection-nav__title{\n      font-size:1rem;\n    }\n    .scx-collection-nav__copy{\n      font-size:.86rem;\n    }\n  }\n</style>\n\n<section class=\"scx-collection-nav\" role=\"navigation\" aria-label=\"Browse more sports wall art collections\">\n  <div class=\"scx-collection-nav__inner\">\n    <h2 class=\"scx-collection-nav__title\">\n      Find your perfect sports wall art\n    </h2>\n    <p class=\"scx-collection-nav__copy\">\n      Build your own wall of fame.\n\n    <div class=\"scx-collection-nav__shell\" data-scx-collection-nav>\n      <button class=\"scx-collection-nav__arrow scx-collection-nav__arrow--prev\" type=\"button\" aria-label=\"Scroll collections left\">\n        ‹\n      </button>\n\n      <div class=\"scx-collection-nav__track\">\n        <a class=\"scx-collection-nav__link\" href=\"/collections/soccer\">Football Wall Art</a>\n        <a class=\"scx-collection-nav__link\" href=\"/collections/nba\">N