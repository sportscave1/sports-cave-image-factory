{% if sc_wall_deferred_content %}
{% doc %}Current product context for the on-demand, photo-first wall preview. @param {product} product - Current product.{% enddoc %}

{%- liquid
assign sc_wall_product = product
assign sc_wall_frame_option_position = 0

for option in sc_wall_product.options_with_values
assign sc_wall_option_name = option.name | downcase
if sc_wall_option_name contains 'frame'
assign sc_wall_frame_option_position = option.position
break
elsif sc_wall_option_name contains 'style'
assign sc_wall_frame_option_position = option.position
break
endif
endfor

assign sc_wall_black_image = blank
assign sc_wall_oak_image = blank
assign sc_wall_white_image = blank

for variant in sc_wall_product.variants
assign sc_wall_frame_value = ''
case sc_wall_frame_option_position
when 1
assign sc_wall_frame_value = variant.option1
when 2
assign sc_wall_frame_value = variant.option2
when 3
assign sc_wall_frame_value = variant.option3
endcase

assign sc_wall_frame_value_down = sc_wall_frame_value | default: '' | downcase

if variant.featured_image != blank
if sc_wall_black_image == blank and sc_wall_frame_value_down contains 'black'
assign sc_wall_black_image = variant.featured_image
endif
if sc_wall_oak_image == blank and sc_wall_frame_value_down contains 'oak'
assign sc_wall_oak_image = variant.featured_image
endif
if sc_wall_white_image == blank and sc_wall_frame_value_down contains 'white'
assign sc_wall_white_image = variant.featured_image
endif
endif

if sc_wall_black_image != blank and sc_wall_oak_image != blank and sc_wall_white_image != blank
break
endif
endfor

if sc_wall_black_image == blank or sc_wall_oak_image == blank or sc_wall_white_image == blank
for media in sc_wall_product.media
if media.media_type == 'image'
assign sc_wall_media_alt = media.alt | default: '' | downcase
if sc_wall_black_image == blank and sc_wall_media_alt contains 'black'
assign sc_wall_black_image = media.preview_image
endif
if sc_wall_oak_image == blank and sc_wall_media_alt contains 'oak'
assign sc_wall_oak_image = media.preview_image
endif
if sc_wall_white_image == blank and sc_wall_media_alt contains 'white'
assign sc_wall_white_image = media.preview_image
endif
endif

if sc_wall_black_image != blank and sc_wall_oak_image != blank and sc_wall_white_image != blank
break
endif
endfor
endif

if sc_wall_black_image == blank
assign sc_wall_black_image = sc_wall_product.featured_image
endif
if sc_wall_oak_image == blank
assign sc_wall_oak_image = sc_wall_black_image
endif
if sc_wall_white_image == blank
assign sc_wall_white_image = sc_wall_black_image
endif

assign sc_wall_black_url = ''
assign sc_wall_oak_url = ''
assign sc_wall_white_url = ''

if sc_wall_black_image != blank
assign sc_wall_black_url = sc_wall_black_image | image_url: width: 2000, height: 2000, crop: 'center'
endif
if sc_wall_oak_image != blank
assign sc_wall_oak_url = sc_wall_oak_image | image_url: width: 2000, height: 2000, crop: 'center'
endif
if sc_wall_white_image != blank
assign sc_wall_white_url = sc_wall_white_image | image_url: width: 2000, height: 2000, crop: 'center'
endif

assign sc_wall_logo_url = 'https://cdn.shopify.com/s/files/1/0722/2332/6515/files/sports-cave-logo-email-header.png?v=1790838922'

assign sc_wall_country = localization.country.iso_code | default: 'AU'
assign sc_wall_unit = 'cm'
if sc_wall_country == 'US' or sc_wall_country == 'LR' or sc_wall_country == 'MM'
assign sc_wall_unit = 'in'
endif

assign sc_wall_currency_iso = cart.currency.iso_code | default: localization.country.currency.iso_code | default: shop.currency

assign sc_wall_edition_total_raw = sc_wall_product.metafields.sports_cave.edition_total.value
assign sc_wall_edition_next_raw = sc_wall_product.metafields.sports_cave.edition_next_number.value
assign sc_wall_edition_total = sc_wall_edition_total_raw | default: 100 | plus: 0
assign sc_wall_edition_next = sc_wall_edition_next_raw | default: 1 | plus: 0
if sc_wall_edition_total < 1
assign sc_wall_edition_total = 100
endif
if sc_wall_edition_next < 1
assign sc_wall_edition_next = 1
endif

comment
Wall visualizer purchase gate intentionally follows Edition Ops, not Shopify inventory.
Sports Cave collector runs are 100 editions. The sticky buy button stays live through #100
and only closes when the next edition metafield has moved beyond 100.
endcomment
assign sc_wall_edition_expired = false
if sc_wall_edition_next_raw != blank and sc_wall_edition_next > 100
assign sc_wall_edition_expired = true
endif

assign sc_wall_instance_id = section.id | default: sc_wall_product.id
assign sc_wall_id = 'sc-wall-visualizer-' | append: sc_wall_product.id | append: '-' | append: sc_wall_instance_id
-%}

<div
id="{{ sc_wall_id }}"
class="sc-wall-v1" data-sc-wall-js="{{ 'sports-cave-wall-preview.js' | asset_url }}" data-sc-wall-css="{{ 'sports-cave-wall-preview.css' | asset_url }}"
data-sc-wall-root
data-product-id="{{ sc_wall_product.id }}"
data-product-handle="{{ sc_wall_product.handle | escape }}"
data-product-title="{{ sc_wall_product.title | escape }}"
data-black-url="{{ sc_wall_black_url | escape }}"
data-oak-url="{{ sc_wall_oak_url | escape }}"
data-white-url="{{ sc_wall_white_url | escape }}"
data-logo-url="{{ sc_wall_logo_url | escape }}"
data-unit="{{ sc_wall_unit | escape }}"
data-customer-logged-in="{% if customer %}1{% else %}0{% endif %}"
data-customer-id="{% if customer %}{{ customer.id | escape }}{% endif %}"
data-customer-name="{% if customer %}{{ customer.first_name | escape }}{% if customer.last_name != blank %} {{ customer.last_name | escape }}{% endif %}{% endif %}"
data-customer-email="{% if customer %}{{ customer.email | escape }}{% endif %}"
data-market-country-code="{{ localization.country.iso_code | escape }}"
data-market-country-name="{{ localization.country.name | escape }}"
data-edition-expired="{% if sc_wall_edition_expired %}1{% else %}0{% endif %}"
data-wall-inbox-url="https://sports-cave-image-factory.onrender.com/api/wall-previews"
>
<script type="application/json" data-sc-wall-product-data>{"options":{{ sc_wall_product.options | json }},"variants":{{ sc_wall_product.variants | json }},"formatted":{ {%- for variant in sc_wall_product.variants -%}{%- capture sc_wall_price -%}{{- variant.price | money_without_trailing_zeros -}}{%- endcapture -%}"{{ variant.id }}":{"price":{{ sc_wall_price | strip_html | remove: sc_wall_currency_iso | strip | json }}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}}}</script>

<div class="sc-wall-v1__overlay" data-sc-wall-overlay hidden aria-hidden="true" data-nosnippet>
 <div id="{{ sc_wall_id }}-dialog" class="sc-wall-v1__dialog" data-sc-wall-dialog role="dialog" aria-modal="true" aria-label="Preview in my cave">
  <div class="sc-wall-v1__modal" data-sc-wall-modal>
   <div class="sc-wall-v1__header"><span class="sc-wall-v1__header-title">Your wall preview</span><div class="sc-wall-v1__header-actions"><span data-sc-wall-save-wrap hidden><button type="button" data-sc-wall-save title="Download preview" aria-label="Download preview"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 3v12m-4-4 4 4 4-4M4 16v5h16v-5"/></svg></button><button type="button" data-sc-wall-share-preview title="Share preview" aria-label="Share preview"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 16V3m-4 4 4-4 4 4M5 12v9h14v-9"/></svg></button></span><button class="sc-wall-v1__close" type="button" data-sc-wall-close title="Close preview" aria-label="Close preview"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m6 6 12 12M18 6 6 18"/></svg></button></div></div>
   <div class="sc-wall-v1__intro" data-sc-wall-intro>
    <h2>Take a photo of your wall</h2>
    <div class="sc-wall-v1__intro-actions">
     <button class="sc-wall-v1__primary" type="button" data-sc-wall-camera>Take photo</button>
     <button class="sc-wall-v1__secondary" type="button" data-sc-wall-upload>Upload</button>
    </div>
    <p data-sc-wall-device-note hidden role="status"></p>
   </div>
   <input type="file" accept="image/*" capture="environment" data-sc-wall-camera-input hidden aria-label="Take a wall photo">
   <input type="file" accept="image/*" data-sc-wall-upload-input hidden aria-label="Upload a wall photo">
   <div class="sc-wall-v1__camera-live" data-sc-wall-live-camera hidden>
    <div class="sc-wall-v1__camera-shell">
     <video class="sc-wall-v1__camera-video" data-sc-wall-camera-video autoplay playsinline muted></video>
     <div class="sc-wall-v1__camera-bar">
      <button class="sc-wall-v1__secondary" type="button" data-sc-wall-camera-library>Upload</button>
      <button class="sc-wall-v1__camera-capture" type="button" data-sc-wall-camera-capture aria-label="Take photo"><span aria-hidden="true"></span></button>
     </div>
    </div>
   </div>
   <div class="sc-wall-v1__editor" data-sc-wall-editor hidden>
    <div class="sc-wall-v1__stage-wrap">
     <div class="sc-wall-v1__stage" data-sc-wall-stage>
      <img class="sc-wall-v1__room" data-sc-wall-room alt="Your room" width="1200" height="900">
      <canvas class="sc-wall-v1__art" data-sc-wall-art width="1" height="1" hidden role="img" aria-label="{{ product.title | escape }} in your room"></canvas>
<div class="sc-wall-v1__tap-demo" data-sc-wall-tap-demo hidden aria-hidden="true">
<span class="sc-wall-v1__tap-demo-line"></span>
<span class="sc-wall-v1__tap-demo-dot sc-wall-v1__tap-demo-dot--a"></span>
<span class="sc-wall-v1__tap-demo-dot sc-wall-v1__tap-demo-dot--b"></span>
<span class="sc-wall-v1__tap-demo-finger">
<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
<path d="M9 11V5.2a2 2 0 0 1 4 0V10"></path>
<path d="M13 10V7.5a2 2 0 0 1 4 0V11"></path>
<path d="M17 11V9.7a2 2 0 0 1 4 0V15c0 4-2.5 7-6.5 7H13c-2.2 0-4-1-5.2-2.8L4.7 15a2 2 0 0 1 3-2.5L9 14V11"></path>
</svg>
</span>
</div>
      <span class="sc-wall-v1__measure-point" data-sc-wall-point-a hidden aria-hidden="true"></span><span class="sc-wall-v1__measure-point" data-sc-wall-point-b hidden aria-hidden="true"></span><span class="sc-wall-v1__measure-line" data-sc-wall-measure-line hidden aria-hidden="true"></span>
      <span class="sc-wall-v1__art-fx" data-sc-wall-art-fx hidden aria-hidden="true"></span>
     </div>
    </div>
    <p data-sc-wall-art-error hidden role="status">Artwork could not load. <button type="button" class="sc-wall-v1__secondary" data-sc-wall-art-retry>Try again</button></p>

    <div class="sc-wall-v1__scale-tools" data-sc-wall-scale-help>
      <strong data-sc-wall-scale-status>See the real size on your wall</strong>
      <p data-sc-wall-scale-copy>Measure something in your photo to preview each size accurately.</p>
      <div class="sc-wall-v1__scale-actions"><button type="button" data-sc-wall-skip-scale hidden>Skip true scale</button><button type="button" data-sc-wall-scale-start>Set true scale</button><button type="button" data-sc-wall-scale-cancel hidden>Cancel</button></div>
      <div class="sc-wall-v1__scale-entry" data-sc-wall-scale-entry hidden>
        <label for="{{ sc_wall_id }}-measurement">Distance (<span data-sc-wall-measurement-unit>{{ sc_wall_unit }}</span>)</label>
        <div><input id="{{ sc_wall_id }}-measurement" data-sc-wall-reference-measurement type="text" inputmode="decimal" autocomplete="off"><select data-sc-wall-unit-select aria-label="Measurement unit"><option value="cm"{% if sc_wall_unit == 'cm' %} selected{% endif %}>cm</option><option value="in"{% if sc_wall_unit == 'in' %} selected{% endif %}>in</option></select><button type="button" class="sc-wall-v1__secondary" data-sc-wall-submit-measurement>Apply scale</button></div>
      </div>
      <p data-sc-wall-flow-error role="alert"></p>
    </div>
    <div class="sc-wall-v1__purchase" data-sc-wall-sticky-buy hidden>
      <div class="sc-wall-v1__sizes" role="group" aria-label="Artwork size">
        {% for option in sc_wall_product.options_with_values %}
          {% assign sc_size_name = option.name | downcase %}
          {% if sc_size_name contains 'size' %}
            {% for value in option.values %}<button type="button" class="sc-wall-v1__size" data-sc-wall-size-option data-size-raw="{{ value | escape }}" data-size-index="{{ forloop.index0 }}" aria-pressed="false"><span>{{ value | escape }}</span><small data-sc-wall-size-dims></small></button>{% endfor %}
          {% endif %}
        {% endfor %}
      </div>
      <button class="sc-wall-v1__cart" type="button" data-sc-wall-sticky-secure><span class="sc-wall-v1__cart-spinner" aria-hidden="true"></span><span data-sc-wall-cart-label aria-live="polite">Add To Cart</span><span data-sc-wall-cart-price></span></button>
      <p data-sc-wall-cart-error role="alert"></p>
    </div>
    <p data-sc-wall-share-note role="status"></p>
   </div>
<div class="sc-wall-v1__download-gate" data-sc-wall-download-gate hidden aria-hidden="true">
<div class="sc-wall-v1__download-card" role="dialog" aria-modal="true" aria-labelledby="{{ sc_wall_id }}-download-title">
<button type="button" class="sc-wall-v1__download-close" data-sc-wall-download-close aria-label="Close download form">
<svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
<path d="M6 6l12 12M18 6 6 18"></path>
</svg>
</button>
<div class="sc-wall-v1__download-eyebrow">SPORTS CAVE</div>
<h3 id="{{ sc_wall_id }}-download-title">Download your wall preview</h3>
<p class="sc-wall-v1__download-copy">Enter your details to save your finished preview.</p>
<div class="sc-wall-v1__download-fields">
<input type="text" autocomplete="name" maxlength="120" placeholder="Name" data-sc-wall-download-name aria-label="Name">
<input type="email" autocomplete="email" inputmode="email" maxlength="254" placeholder="Email" data-sc-wall-download-email aria-label="Email address">
</div>
<label class="sc-wall-v1__download-consent">
<input type="checkbox" data-sc-wall-download-consent checked>
<span>Allow Sports Cave to feature this wall preview.</span>
</label>
<p class="sc-wall-v1__download-error" data-sc-wall-download-error aria-live="polite"></p>
<button type="button" class="sc-wall-v1__download-confirm" data-sc-wall-download-confirm>Download Preview</button>
</div>
</div>
   <button class="sc-wall-v1__continue" type="button" data-sc-wall-keep-browsing>Close &amp; continue shopping</button>
  </div>
 </div>
</div>
</div>





{% else %}
<div data-sc-wall-root data-product-id="{{ product.id }}" data-sc-wall-js="{{ 'sports-cave-wall-preview.js' | asset_url }}" data-sc-wall-css="{{ 'sports-cave-wall-preview.css' | asset_url }}" data-sc-wall-artwork="{{ 'sports-cave-wall-artwork.js' | asset_url }}" data-sc-wall-loading="Preparing your wall preview…" data-sc-wall-error="Your wall preview could not load. Please try again."></div>
{% endif %}

