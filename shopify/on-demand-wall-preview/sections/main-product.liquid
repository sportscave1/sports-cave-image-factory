<script type="application/json" id="sc-variant-media-data-{{ section.id }}">
  {
    "sectionId": {{ section.id | json }},
    "productId": {{ product.id | json }},
    "optionNames": {{ product.options | json }},
    "variants": [
      {%- for variant in product.variants -%}
        {
          "id": {{ variant.id | json }},
          "mediaId": {%- if variant.featured_media -%}{{ variant.featured_media.id | json }}{%- else -%}null{%- endif -%},
          "options": {{ variant.options | json }}
        }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ]
  }
</script>

<script>
  (() => {
    const SECTION_ID = {{ section.id | json }};
    const PRODUCT_ID = {{ product.id | json }};
    const dataEl = document.getElementById(`sc-variant-media-data-${SECTION_ID}`);

    let variantMediaData = null;
    try {
      variantMediaData = dataEl ? JSON.parse(dataEl.textContent || '{}') : null;
    } catch (error) {
      variantMediaData = null;
    }

    const safeSelectorId = (value) => String(value || '').replace(/[^a-zA-Z0-9_-]/g, '\\$&');

    const getVariantById = (variantId) => {
      if (!variantMediaData || !variantMediaData.variants) return null;
      return variantMediaData.variants.find((variant) => String(variant.id) === String(variantId)) || null;
    };

    const getSelectedOptionValues = (productForm) => {
      if (!productForm) return [];

      const values = [];
      const checked = productForm.querySelectorAll('input[type="radio"]:checked, input[type="checkbox"]:checked');
      checked.forEach((input) => {
        if (input && input.value) values.push(String(input.value));
      });

      const selects = productForm.querySelectorAll('select');
      selects.forEach((select) => {
        if (select && select.value) values.push(String(select.value));
      });

      return values.filter(Boolean);
    };

    const resolveMediaIdFromVariant = (variantId, productForm = null) => {
      const variant = getVariantById(variantId);
      if (variant && variant.mediaId) return String(variant.mediaId);

      /* Fallback: if the chosen size variant has no media assigned, find another variant
         with the same selected frame/finish option that does have media. This keeps frame
         swatches synced even when only one size per frame has a featured image assigned. */
      if (!variantMediaData || !variantMediaData.variants || !variant) return null;

      const selectedValues = getSelectedOptionValues(productForm);
      const optionNames = (variantMediaData.optionNames || []).map((name) => String(name || '').toLowerCase());
      const frameOptionIndex = optionNames.findIndex((name) => (
        name.includes('frame') ||
        name.includes('finish') ||
        name.includes('colour') ||
        name.includes('color') ||
        name.includes('style')
      ));

      if (frameOptionIndex >= 0) {
        const selectedFrame = variant.options && variant.options[frameOptionIndex];
        if (selectedFrame) {
          const frameMatch = variantMediaData.variants.find((candidate) => (
            candidate.mediaId &&
            candidate.options &&
            String(candidate.options[frameOptionIndex]) === String(selectedFrame)
          ));
          if (frameMatch && frameMatch.mediaId) return String(frameMatch.mediaId);
        }
      }

      if (selectedValues.length) {
        const broadMatch = variantMediaData.variants.find((candidate) => (
          candidate.mediaId &&
          candidate.options &&
          candidate.options.some((option) => selectedValues.includes(String(option)))
        ));
        if (broadMatch && broadMatch.mediaId) return String(broadMatch.mediaId);
      }

      return null;
    };

    const syncNativeGalleryToMedia = (mediaGallery, mediaId) => {
      if (!mediaGallery || !mediaId) return;

      const mediaSelector = `[data-media-id="${safeSelectorId(mediaId)}"]`;
      const thumb = mediaGallery.querySelector(`.thumbnails ${mediaSelector} a, .thumbnails ${mediaSelector} button, .thumbnail${mediaSelector}`);

      if (thumb) {
        try {
          thumb.dispatchEvent(new MouseEvent('click', { bubbles: true, cancelable: true, view: window }));
        } catch (error) {
          thumb.click();
        }
      }

      const slider = mediaGallery.querySelector('.main-image .slider, .main-image .slider--no-scrollbar');
      const slides = Array.from(mediaGallery.querySelectorAll('.main-image .slider__item[data-media-id]'));
      const target = slides.find((slide) => String(slide.dataset.mediaId) === String(mediaId));

      if (target) {
        slides.forEach((slide) => {
          const isActive = slide === target;
          slide.classList.toggle('is-active', isActive);
          if (isActive) {
            slide.removeAttribute('tabindex');
          } else {
            slide.setAttribute('tabindex', '-1');
          }
        });

        if (slider) {
          slider.scrollTo({ left: target.offsetLeft, behavior: 'smooth' });
        }
      }

      const collageItems = Array.from(mediaGallery.querySelectorAll('.product-media-collage__item[data-media-id]'));
      collageItems.forEach((item) => item.classList.toggle('is-active', String(item.dataset.mediaId) === String(mediaId)));

      const nativeThumbItems = Array.from(mediaGallery.querySelectorAll('.thumbnails .slider__item[data-media-id]'));
      nativeThumbItems.forEach((item) => item.classList.toggle('is-active', String(item.dataset.mediaId) === String(mediaId)));
    };

    const initSportsCaveSquareMobileGallery = (root = document) => {
      const galleries = root.querySelectorAll('.js-sc-square-mobile-gallery:not([data-sc-ready="true"])');

      galleries.forEach((gallery) => {
        gallery.dataset.scReady = 'true';

        const track = gallery.querySelector('.sc-square-mobile-track');
        const rail = gallery.querySelector('.sc-square-mobile-rail');
        const prevBtn = gallery.querySelector('[data-sc-square-prev]');
        const nextBtn = gallery.querySelector('[data-sc-square-next]');
        const dotsWrap = gallery.querySelector('[data-sc-square-dots]');
        const thumbs = Array.from(gallery.querySelectorAll('.sc-square-mobile-thumb'));
        const slides = Array.from(gallery.querySelectorAll('.sc-square-mobile-slide'));
        let activeIndex = 0;

        if (!track || !thumbs.length || !slides.length) return;

        const setActive = (index, scrollThumb = true) => {
          activeIndex = Math.max(0, Math.min(slides.length - 1, Number(index) || 0));

          if (dotsWrap) {
            if (dotsWrap.childElementCount !== slides.length) {
              dotsWrap.innerHTML = '';
              slides.forEach((slide, dotIndex) => {
                const dot = document.createElement('span');
                dot.className = 'sc-square-mobile-dot' + (dotIndex === activeIndex ? ' is-active' : '');
                dot.setAttribute('data-sc-square-dot', '');
                dot.setAttribute('aria-hidden', 'true');
                dotsWrap.appendChild(dot);
              });
            }

            Array.from(dotsWrap.children).forEach((dot, dotIndex) => {
              dot.classList.toggle('is-active', dotIndex === activeIndex);
            });
          }

          thumbs.forEach((thumb, i) => {
            const isActive = i === activeIndex;
            thumb.classList.toggle('is-active', isActive);
            if (isActive) {
              thumb.setAttribute('aria-current', 'true');
            } else {
              thumb.removeAttribute('aria-current');
            }
          });

          slides.forEach((slide, i) => {
            const isActive = i === activeIndex;
            slide.classList.toggle('is-active', isActive);
            slide.toggleAttribute('inert', !isActive);
          });

          if (scrollThumb && thumbs[activeIndex]) {
            thumbs[activeIndex].scrollIntoView({ block: 'nearest', inline: 'nearest', behavior: 'smooth' });
          }
        };

        const getSlideLeft = (index, slide) => {
          const width = track.clientWidth || track.getBoundingClientRect().width || slide.getBoundingClientRect().width || 1;
          return Math.max(0, Math.round(index * width));
        };

        const scrollToSlide = (index, behavior = 'smooth') => {
          const slide = slides[index];
          if (!slide) return;

          const left = getSlideLeft(index, slide);
          setActive(index);

          try {
            track.scrollTo({ left, behavior });
          } catch (error) {
            track.scrollLeft = left;
          }

          window.setTimeout(() => {
            if (Math.abs(track.scrollLeft - left) > 3) {
              track.scrollLeft = left;
            }
            setActive(index);
          }, 80);
        };

        const scrollToMediaId = (mediaId, behavior = 'smooth') => {
          const index = slides.findIndex((slide) => String(slide.dataset.mediaId) === String(mediaId));
          if (index < 0) return false;
          scrollToSlide(index, behavior);
          return true;
        };

        gallery.__scSquareGallery = {
          scrollToSlide,
          scrollToMediaId,
          setActive
        };

        if (slides.length < 2) {
          if (prevBtn) prevBtn.hidden = true;
          if (nextBtn) nextBtn.hidden = true;
        } else {
          if (prevBtn) {
            prevBtn.addEventListener('click', (event) => {
              event.preventDefault();
              event.stopPropagation();
              scrollToSlide((activeIndex - 1 + slides.length) % slides.length);
            }, { passive:false });
          }

          if (nextBtn) {
            nextBtn.addEventListener('click', (event) => {
              event.preventDefault();
              event.stopPropagation();
              scrollToSlide((activeIndex + 1) % slides.length);
            }, { passive:false });
          }
        }

        thumbs.forEach((thumb, index) => {
          const activateThumb = (event) => {
            if (event) event.preventDefault();
            scrollToSlide(index);
          };

          thumb.addEventListener('click', activateThumb, { passive: false });
          thumb.addEventListener('pointerup', activateThumb, { passive: false });
        });

        let ticking = false;
        track.addEventListener('scroll', () => {
          if (ticking) return;
          ticking = true;
          window.requestAnimationFrame(() => {
            const width = track.clientWidth || 1;
            const index = Math.max(0, Math.min(slides.length - 1, Math.round(track.scrollLeft / width)));
            setActive(index, false);
            ticking = false;
          });
        }, { passive: true });

        const startIndex = Number(gallery.dataset.initialIndex || 0);
        requestAnimationFrame(() => {
          if (slides[startIndex]) {
            track.scrollLeft = slides[startIndex].offsetLeft;
            setActive(startIndex, false);
          }
          if (rail) rail.scrollTop = 0;
        });
      });
    };

    const syncSquareGalleryToMedia = (mediaGallery, mediaId) => {
      const squareGallery = mediaGallery ? mediaGallery.querySelector('.js-sc-square-mobile-gallery') : null;
      if (!squareGallery || !mediaId) return false;

      if (squareGallery.__scSquareGallery && typeof squareGallery.__scSquareGallery.scrollToMediaId === 'function') {
        return squareGallery.__scSquareGallery.scrollToMediaId(mediaId);
      }

      const slide = squareGallery.querySelector(`.sc-square-mobile-slide[data-media-id="${safeSelectorId(mediaId)}"]`);
      const slides = Array.from(squareGallery.querySelectorAll('.sc-square-mobile-slide'));
      const index = slides.indexOf(slide);
      if (index < 0) return false;

      const track = squareGallery.querySelector('.sc-square-mobile-track');
      const thumbs = Array.from(squareGallery.querySelectorAll('.sc-square-mobile-thumb'));
      if (track && slide) track.scrollTo({ left: slide.offsetLeft, behavior: 'smooth' });
      slides.forEach((item, i) => item.classList.toggle('is-active', i === index));
      thumbs.forEach((item, i) => item.classList.toggle('is-active', i === index));

      const dotsWrap = squareGallery.querySelector('[data-sc-square-dots]');
      if (dotsWrap) {
        if (dotsWrap.childElementCount !== slides.length) {
          dotsWrap.innerHTML = '';
          slides.forEach((slideEl, dotIndex) => {
            const dot = document.createElement('span');
            dot.className = 'sc-square-mobile-dot' + (dotIndex === index ? ' is-active' : '');
            dot.setAttribute('data-sc-square-dot', '');
            dot.setAttribute('aria-hidden', 'true');
            dotsWrap.appendChild(dot);
          });
        }

        Array.from(dotsWrap.children).forEach((dot, dotIndex) => {
          dot.classList.toggle('is-active', dotIndex === index);
        });
      }

      return true;
    };

    const syncMedia = (productForm, mediaId) => {
      if (!mediaId) return;
      const mediaGallery = productForm ? productForm.querySelector('media-gallery') : document.querySelector(`product-form[data-product-id="${PRODUCT_ID}"] media-gallery, product-form media-gallery`);
      if (!mediaGallery) return;

      syncSquareGalleryToMedia(mediaGallery, mediaId);
      syncNativeGalleryToMedia(mediaGallery, mediaId);
    };

    const getVariantIdFromEvent = (event) => {
      const detail = event && event.detail ? event.detail : null;
      if (!detail) return null;

      if (detail.variant && detail.variant.id) return detail.variant.id;
      if (detail.currentVariant && detail.currentVariant.id) return detail.currentVariant.id;
      if (detail.id) return detail.id;
      if (detail.variantId) return detail.variantId;

      return null;
    };

    const getCurrentVariantInput = (productForm) => {
      if (!productForm) return null;
      const formId = 'product-form-' + SECTION_ID + '-' + PRODUCT_ID;
      const escapedFormId = window.CSS && window.CSS.escape ? window.CSS.escape(formId) : formId;
      return productForm.querySelector(`form[id="${escapedFormId}"] input[name="id"], form.js-product-form input[name="id"], input[name="id"]`);
    };

    const getCurrentVariantId = (productForm) => {
      const input = getCurrentVariantInput(productForm);
      return input && input.value ? input.value : null;
    };

    const syncFromVariantId = (productForm, variantId) => {
      if (!variantId) return;
      const mediaId = resolveMediaIdFromVariant(variantId, productForm);
      if (mediaId) syncMedia(productForm, mediaId);
    };

    const bindVariantMediaSync = (root = document) => {
      const productForms = root.querySelectorAll('product-form.js-product:not([data-sc-variant-media-sync="true"])');

      productForms.forEach((productForm) => {
        productForm.dataset.scVariantMediaSync = 'true';
        let lastVariantId = getCurrentVariantId(productForm);
        let pollTimer = null;

        const run = (variantId = null) => {
          const id = variantId || getCurrentVariantId(productForm);
          if (!id) return;
          lastVariantId = String(id);
          syncFromVariantId(productForm, id);
        };

        const queueRun = (variantId = null) => {
          window.requestAnimationFrame(() => run(variantId));
          window.setTimeout(() => run(variantId), 80);
          window.setTimeout(() => run(variantId), 180);
        };

        const startPollingVariantInput = () => {
          if (pollTimer) window.clearInterval(pollTimer);
          let count = 0;
          pollTimer = window.setInterval(() => {
            count += 1;
            const currentVariantId = getCurrentVariantId(productForm);
            if (currentVariantId && String(currentVariantId) !== String(lastVariantId)) {
              lastVariantId = String(currentVariantId);
              run(currentVariantId);
            }
            if (count >= 30) {
              window.clearInterval(pollTimer);
              pollTimer = null;
            }
          }, 60);
        };

        ['variant:change', 'variant-change', 'product:variant-change', 'theme:variant:change', 'on:variant:change'].forEach((eventName) => {
          productForm.addEventListener(eventName, (event) => {
            queueRun(getVariantIdFromEvent(event));
            startPollingVariantInput();
          });

          document.addEventListener(eventName, (event) => {
            if (!event.target || productForm.contains(event.target) || event.target === productForm) {
              queueRun(getVariantIdFromEvent(event));
              startPollingVariantInput();
            }
          });
        });

        productForm.addEventListener('change', () => {
          queueRun();
          startPollingVariantInput();
        }, true);

        productForm.addEventListener('click', (event) => {
          const target = event.target;
          if (!target) return;

          /* Do not touch size-guide/modal/gallery buttons. The size guide uses its own
             theme modal logic and must be allowed to open normally. */
          if (target.closest('modal-opener, [data-modal], [aria-haspopup="dialog"], .size-chart, .size-guide, .size_chart, .size-guide-link, .size-chart-link, [data-size-chart], [data-size-guide]')) {
            return;
          }

          if (target.closest('input[type="radio"], input[type="checkbox"], select, label[for], .swatch, [data-option-selector]')) {
            queueRun();
            startPollingVariantInput();
          }
        }, true);

        const input = getCurrentVariantInput(productForm);
        if (input) {
          let observedValue = input.value;
          const observer = new MutationObserver(() => {
            if (input.value !== observedValue) {
              observedValue = input.value;
              queueRun(input.value);
            }
          });
          observer.observe(input, { attributes: true, attributeFilter: ['value'] });
        }

        queueRun(lastVariantId);
      });
    };

    const initAll = (root = document) => {
      initSportsCaveSquareMobileGallery(root);
      bindVariantMediaSync(root);
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => initAll());
    } else {
      initAll();
    }

    document.addEventListener('shopify:section:load', (event) => initAll(event.target));
  })();
</script>


