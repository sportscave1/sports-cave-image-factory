# Sports Cave daily staff reporting
RESEND_API_KEY=replace_with_render_secret
ACTIVITY_DIGEST_ENABLED=false
ACTIVITY_DIGEST_FROM=Sports Cave OS <daily@reports.sportscaveshop.com>
ACTIVITY_DIGEST_TO=owner@example.com
ACTIVITY_DIGEST_REPLY_TO=owner@example.com
ACTIVITY_DIGEST_TIMEZONE=Australia/Sydney
ACTIVITY_DIGEST_HOUR=17
SPORTS_CAVE_REPORTING_OWNER_EMAIL=owner@example.com

# Existing account bootstrap fallback used only when the dedicated owner value is absent.
SPORTS_CAVE_ADMIN_EMAIL=owner@example.com

# Local terminal deployment. Keep real values in the shell environment or
# .render/deploy-hook.txt; never commit the hook URL or API key.
SPORTS_CAVE_RENDER_DEPLOY_HOOK_URL=
SPORTS_CAVE_RENDER_API_KEY=
SPORTS_CAVE_RENDER_SERVICE_ID=

# Google SEO Phase 1. Keep all values in Render or the local shell, never in source.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Optional Daily Planner planning help. Keep the key server-side.
OPENAI_API_KEY=
OPENAI_PLANNING_MODEL=
OPENAI_PLANNING_TIMEOUT_SECONDS=25

# Meta Posting. Keep real IDs and credentials in Render, never in source.
META_ACCESS_TOKEN=
META_PAGE_ACCESS_TOKEN=
META_APP_ID=
META_APP_SECRET=
META_AD_ACCOUNT_ID=
META_FACEBOOK_PAGE_ID=
META_INSTAGRAM_ACTOR_ID=
META_COLLECTION_TEMPLATE_AD_ID=
META_API_VERSION=v26.0

# V16 production quality policy: local/off by default; requires approved standards and migration.
AUTO_EDITIONS_V16_AUTO_APPROVAL_ENABLED=false

# V17 continuous mapped backlog: activate only after approved server/companion release.
AUTO_EDITIONS_V17_CONTINUOUS_ENABLED=false

# Requires reviewed additive heartbeat migration; local/off until explicitly released.
WORKER_HEALTH_TELEMETRY_ENABLED=false

# Owner-selected technical TEST completion; enable only with its dedicated release/migration.
AUTO_EDITIONS_TECHNICAL_FLOW_ENABLED=false
# Additive Product Uploads TEST route. Manual prompts/mapping remain available.
# Requires product_upload_intakes migration. Never enable in production from a local preview.
PRODUCT_UPLOAD_AUTOMATIC_ENABLED=false
# Optional storefront host for precise /products/<handle> lookups (no scheme).
SHOPIFY_PUBLIC_DOMAIN=

# Resumable new-session capability is closed until authorised production acceptance.
# Keep legacy transfers available. Never infer acceptance from deployed code/schema.
COMPANION_RESUMABLE_UPLOADS_ENABLED=false
# Only after real provider, native PostgreSQL locking/restart and retention checks:
# COMPANION_RESUMABLE_ACCEPTANCE=provider-postgres-retention-v1
# COMPANION_RESUMABLE_ACCEPTANCE_GENERATION=<exact generation fingerprint>
# COMPANION_RESUMABLE_ACCEPTANCE_EVIDENCE_SHA256=<reviewed acceptance report SHA-256>
