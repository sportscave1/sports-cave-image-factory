{
  "manifest_version": 3,
  "name": "Sports Cave Upload Companion",
  "description": "Starts the ChatGPT project workflow when Product Uploads confirms the Dropbox save.",
  "version": "1.0.2",
  "permissions": ["storage"],
  "background": {"service_worker": "worker.js"},
  "content_scripts": [
    {
      "matches": ["https://sports-cave-image-factory.onrender.com/component/product_upload_gallery.product_upload_gallery/*"],
      "js": ["os-bridge.js"],
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": ["https://chatgpt.com/g/g-p-6a387a17627081918e1700ec2783a12b/project*"],
      "js": ["composer.js"],
      "run_at": "document_idle"
    }
  ]
}
