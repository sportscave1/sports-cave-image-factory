{
  "manifest_version": 3,
  "name": "Sports Cave Companion",
  "description": "Processes designs, uploads, Meta Ads and guarded Prodigi order preparation through the paired Edge desktop.",
  "version": "1.7.55",
  "action": {"default_title": "Sports Cave Companion"},
  "permissions": [
    "storage",
    "alarms",
    "downloads"
  ],
  "host_permissions": [
    "https://sports-cave-image-factory.onrender.com/*",
    "https://dashboard.prodigi.com/*",
    "https://sandbox-beta-dashboard.pwinty.com/*",
    "https://chatgpt.com/*",
    "https://*.oaiusercontent.com/*"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://dashboard.prodigi.com/orders/*/detail", "https://sandbox-beta-dashboard.pwinty.com/orders/*/detail"],
      "js": ["prodigi-wait.js", "prodigi-page.js", "prodigi-dashboard-qa.js", "inbox-page.js", "prodigi-signin-page.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://dashboard.prodigi.com/login*"],
      "js": ["prodigi-signin-page.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://sports-cave-image-factory.onrender.com/*"],
      "js": ["queue-wake.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://chatgpt.com/g/g-p-6a6bd98cd6f081918788b544dcdecfc2*", "https://chatgpt.com/library*"],
      "js": ["ad-downloads.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://chatgpt.com/library*"],
      "js": ["ad-library.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://sports-cave-image-factory.onrender.com/component/product_upload_gallery.product_upload_gallery/*"
      ],
      "js": [
        "os-bridge.js"
      ],
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://chatgpt.com/g/g-p-6a387a17627081918e1700ec2783a12b*",
        "https://chatgpt.com/g/g-p-6a1e449948e881919c1e345006d63654*",
        "https://chatgpt.com/g/g-p-6a6bd98cd6f081918788b544dcdecfc2*"
      ],
      "js": [
        "composer.js",
        "ad-repair.js",
        "ad-artifacts.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
